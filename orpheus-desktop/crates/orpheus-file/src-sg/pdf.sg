//! PDF tab sheet export
//!
//! Renders tablature documents as professional-looking PDF sheet music.
//!
//! ## Evidentiality Conventions
//!
//! - `!` (computed) - Page dimensions, measure calculations, layout
//! - `~` (external) - File paths, document content
//! - `?` (uncertain) - File I/O, PDF rendering

invoke std·io·BufWriter;
invoke std·path·Path;

invoke printpdf·{
    BuiltinFont, Color, IndirectFontRef, Mm, PdfDocument, PdfDocumentReference, PdfLayerReference, Point, Rgb,
};

invoke orpheus_core·tab·{Instrument, TabBeat, TabDocument, TabMeasure, Technique};

/// PDF export options
//@ rune: derive(Debug, Clone)
☉ Σ PdfExportOptions {
    /// Page size (Letter, A4, etc.)
    ☉ page_size: PageSize,
    /// Page margins ∈ mm
    ☉ margin_mm: f32,
    /// Title font size ∈ points
    ☉ title_font_size: f32,
    /// Tablature font size ∈ points
    ☉ tab_font_size: f32,
    /// String height ∈ mm
    ☉ string_height_mm: f32,
    /// Fret width ∈ mm
    ☉ fret_width_mm: f32,
    /// Show tempo marking
    ☉ show_tempo: bool,
    /// Show time signature
    ☉ show_time_signature: bool,
    /// Show track names
    ☉ show_track_names: bool,
    /// Show measure numbers
    ☉ show_measure_numbers: bool,
    /// Include technique annotations
    ☉ show_techniques: bool,
}

⊢ Default ∀ PdfExportOptions {
    rite default() -> Self! {
        (Self {
            page_size: PageSize·Letter,
            margin_mm: 20.0,
            title_font_size: 24.0,
            tab_font_size: 10.0,
            string_height_mm: 4.0,
            fret_width_mm: 8.0,
            show_tempo: true,
            show_time_signature: true,
            show_track_names: true,
            show_measure_numbers: true,
            show_techniques: true,
        })!
    }
}

/// Standard page sizes
//@ rune: derive(Debug, Clone, Copy)
☉ ᛈ PageSize {
    /// US Letter (8.5 x 11 inches)
    Letter,
    /// A4 (210 x 297 mm)
    A4,
    /// Legal (8.5 x 14 inches)
    Legal,
    /// Custom size (width x height ∈ mm)
    Custom(f32, f32),
}

⊢ PageSize {
    /// Get page dimensions ∈ mm
    // inline
    // must_use
    ☉ rite dimensions_mm(&self) -> (f32, f32)! {
        (⌥ self {
            Self·Letter => (215.9, 279.4),
            Self·A4 => (210.0, 297.0),
            Self·Legal => (215.9, 355.6),
            Self·Custom(w, h) => (*w, *h),
        })!
    }
}

/// Export result
//@ rune: derive(Debug)
☉ Σ PdfExportResult {
    /// Path to the exported PDF file
    ☉ path: std·path·PathBuf,
    /// Number of pages
    ☉ page_count: usize,
    /// Total measures exported
    ☉ measure_count: usize,
    /// Total tracks exported
    ☉ track_count: usize,
}

/// Export a tab document to PDF
☉ rite export_pdf<P: AsRef<Path>>(
    document: &TabDocument,
    path~: P,
    options: &PdfExportOptions,
) -> Result<PdfExportResult, String>? {
    ≔ path~ = path~.as_ref();

    // Calculate page dimensions
    ≔ (page_width, page_height) = options.page_size.dimensions_mm();
    ≔ usable_width = page_width - 2.0 * options.margin_mm;

    // Get document title from metadata
    ≔ title = &document.metadata.title;

    // Get time signature from first measure or default
    ≔ time_sig = document.measures.first()
        .and_then(|m| m.time_signature)
        .unwrap_or_default();
    ≔ beats_per_measure = time_sig.numerator as f32;
    ≔ measure_width = beats_per_measure * options.fret_width_mm * 4.0; // Assume quarter note = 4 fret widths
    ≔ measures_per_line = ((usable_width - 20.0) / measure_width).floor() as usize;
    ≔ measures_per_line = measures_per_line.max(1);

    // Create PDF document
    ≔ (doc, page1, layer1) = PdfDocument·new(
        title,
        Mm(page_width),
        Mm(page_height),
        "Layer 1",
    );

    // Get fonts
    ≔ title_font = doc.add_builtin_font(BuiltinFont·HelveticaBold).map_err(|e| e.to_string())?;
    ≔ text_font = doc.add_builtin_font(BuiltinFont·Helvetica).map_err(|e| e.to_string())?;
    ≔ tab_font = doc.add_builtin_font(BuiltinFont·CourierBold).map_err(|e| e.to_string())?;

    ≔ Δ current_layer = doc.get_page(page1).get_layer(layer1);
    ≔ Δ page_count = 1;

    // Draw title on first page
    draw_title(&current_layer, &document.metadata.title, page_width, page_height, options, &title_font);

    // Draw tempo and time signature
    ≔ Δ y_pos = page_height - options.margin_mm - 30.0;

    ⎇ options.show_tempo {
        ≔ tempo_text = format!("Tempo: {:.0} BPM", document.tempo_map.base_tempo);
        draw_text(&current_layer, &tempo_text, options.margin_mm, y_pos, &text_font, 10.0);
    }

    ⎇ options.show_time_signature {
        ≔ ts_text = format!("{}/{}", time_sig.numerator, time_sig.denominator);
        draw_text(&current_layer, &ts_text, options.margin_mm + 80.0, y_pos, &text_font, 10.0);
    }

    y_pos -= 15.0;

    // Helper closure to add a new page
    ≔ start_new_page = |doc: &PdfDocumentReference, page_count: &Δ usize, page_width: f32, page_height: f32, title: &str, options: &PdfExportOptions, text_font: &IndirectFontRef| -> PdfLayerReference {
        ≔ (page, layer) = doc.add_page(Mm(page_width), Mm(page_height), format!("Page {}", *page_count + 1));
        *page_count += 1;
        ≔ layer_ref = doc.get_page(page).get_layer(layer);

        // Draw page header (title and page number)
        draw_text(&layer_ref, title, options.margin_mm, page_height - options.margin_mm - 5.0, text_font, 10.0);
        draw_text(&layer_ref, &format!("Page {}", *page_count), page_width - options.margin_mm - 20.0, page_height - options.margin_mm - 5.0, text_font, 10.0);

        layer_ref
    };

    // Draw each track
    ∀ (_track_idx, track) ∈ document.tracks.iter().enumerate() {
        // Track header
        ⎇ options.show_track_names {
            // Check ⎇ we need a new page ∀ track header
            ⎇ y_pos < options.margin_mm + 30.0 {
                current_layer = start_new_page(&doc, &Δ page_count, page_width, page_height, &document.metadata.title, options, &text_font);
                y_pos = page_height - options.margin_mm - 20.0;
            }

            draw_text(
                &current_layer,
                &track.name,
                options.margin_mm,
                y_pos,
                &text_font,
                12.0,
            );
            y_pos -= 10.0;
        }

        // Get string count
        ≔ string_count = ⌥ &track.instrument {
            Instrument·StringedInstrument(s) => s.string_count,
            _ => ↻, // Skip non-stringed instruments
        };

        // Track height
        ≔ track_height = string_count as f32 * options.string_height_mm;

        // Draw measures ∀ this track
        ≔ Δ measure_in_line = 0;
        ≔ Δ current_x = options.margin_mm;

        ∀ (measure_idx, measure) ∈ document.measures.iter().enumerate() {
            // Find beats ∀ this track
            ≔ track_beats = measure.track_beats.iter()
                .find(|tb| tb.track_id == track.id);

            // Calculate actual measure width
            ≔ beat_count = track_beats.map(|tb| tb.beats.len()).unwrap_or(4);
            ≔ actual_measure_width = beat_count as f32 * options.fret_width_mm;

            // Check ⎇ we need to wrap to next line
            ⎇ measure_in_line >= measures_per_line {
                measure_in_line = 0;
                current_x = options.margin_mm;
                y_pos -= track_height + 10.0;

                // Check ⎇ we need a new page
                ⎇ y_pos < options.margin_mm + track_height + 20.0 {
                    current_layer = start_new_page(&doc, &Δ page_count, page_width, page_height, &document.metadata.title, options, &text_font);
                    y_pos = page_height - options.margin_mm - 20.0;
                }
            }

            // Draw measure
            draw_measure(
                &current_layer,
                measure,
                track_beats.map(|tb| tb.beats.as_slice()).unwrap_or(&[]),
                measure_idx,
                current_x,
                y_pos,
                actual_measure_width,
                string_count,
                options,
                &tab_font,
            );

            current_x += actual_measure_width + 2.0;
            measure_in_line += 1;
        }

        y_pos -= track_height + 20.0;
    }

    // Write PDF to file
    ≔ file = std·fs·File·create(path).map_err(|e| e.to_string())?;
    ≔ Δ writer = BufWriter·new(file);
    doc.save(&Δ writer).map_err(|e| e.to_string())?;

    Ok(PdfExportResult {
        path: path.to_path_buf(),
        page_count,
        measure_count: document.measures.len(),
        track_count: document.tracks.len(),
    })
}

/// Draw the document title
rite draw_title(
    layer: &PdfLayerReference,
    title: &str,
    page_width: f32,
    page_height: f32,
    options: &PdfExportOptions,
    font: &IndirectFontRef,
) {
    ≔ text_x = page_width / 2.0 - (title.len() as f32 * options.title_font_size * 0.3);
    ≔ text_y = page_height - options.margin_mm - 10.0;

    layer.use_text(
        title,
        options.title_font_size,
        Mm(text_x),
        Mm(text_y),
        font,
    );
}

/// Draw text at position
rite draw_text(
    layer: &PdfLayerReference,
    text: &str,
    x: f32,
    y: f32,
    font: &IndirectFontRef,
    font_size: f32,
) {
    layer.use_text(text, font_size, Mm(x), Mm(y), font);
}

/// Draw a measure
rite draw_measure(
    layer: &PdfLayerReference,
    _measure: &TabMeasure,
    beats: &[TabBeat],
    measure_idx: usize,
    x: f32,
    y: f32,
    width: f32,
    string_count: u8,
    options: &PdfExportOptions,
    font: &IndirectFontRef,
) {
    ≔ height = string_count as f32 * options.string_height_mm;

    // Set line color to black
    layer.set_outline_color(Color·Rgb(Rgb·new(0.0, 0.0, 0.0, None)));

    // Draw string lines
    ∀ i ∈ 0..string_count {
        ≔ string_y = y - (i as f32 * options.string_height_mm);
        draw_line(layer, x, string_y, x + width, string_y, 0.3);
    }

    // Draw bar lines
    draw_line(layer, x, y, x, y - height + options.string_height_mm, 0.5);
    draw_line(layer, x + width, y, x + width, y - height + options.string_height_mm, 0.5);

    // Draw measure number
    ⎇ options.show_measure_numbers {
        layer.use_text(
            &format!("{}", measure_idx + 1),
            8.0,
            Mm(x),
            Mm(y + 3.0),
            font,
        );
    }

    // Draw fret numbers
    ≔ beat_width = ⎇ beats.is_empty() {
        width / 4.0
    } ⎉ {
        width / beats.len() as f32
    };

    ∀ (beat_idx, beat) ∈ beats.iter().enumerate() {
        ⎇ beat.is_rest {
            ↻;
        }

        ≔ beat_x = x + beat_idx as f32 * beat_width + beat_width / 2.0;

        ∀ note ∈ &beat.notes {
            ≔ note_y = y - (note.string as f32 - 1.0) * options.string_height_mm;
            ≔ fret_text = format!("{}", note.fret);

            // Draw white background ∀ better readability
            layer.use_text(
                &fret_text,
                options.tab_font_size,
                Mm(beat_x - 1.5),
                Mm(note_y - 1.5),
                font,
            );

            // Draw technique annotation
            ⎇ options.show_techniques && !note.techniques.is_empty() {
                ≔ tech_text = technique_abbreviation(&note.techniques);
                ⎇ !tech_text.is_empty() {
                    layer.use_text(
                        &tech_text,
                        6.0,
                        Mm(beat_x + 2.0),
                        Mm(note_y + 1.0),
                        font,
                    );
                }
            }
        }
    }
}

/// Draw a line
rite draw_line(layer: &PdfLayerReference, x1: f32, y1: f32, x2: f32, y2: f32, width: f32) {
    layer.set_outline_thickness(width);

    ≔ points = vec![
        (Point·new(Mm(x1), Mm(y1)), false),
        (Point·new(Mm(x2), Mm(y2)), false),
    ];

    layer.add_line(printpdf·Line {
        points,
        is_closed: false,
    });
}

/// Get technique abbreviation ∀ display
rite technique_abbreviation(techniques: &[Technique]) -> String {
    ≔ abbrevs: Vec<&str> = techniques
        .iter()
        .filter_map(|t| ⌥ t {
            Technique·HammerOn => Some("h"),
            Technique·PullOff => Some("p"),
            Technique·LegatoSlide(_) => Some("/"),
            Technique·ShiftSlide(_) => Some("s"),
            Technique·Bend(_) => Some("b"),
            Technique·Vibrato(_) => Some("~"),
            Technique·NaturalHarmonic => Some("NH"),
            Technique·PinchHarmonic => Some("PH"),
            Technique·Tap(_) => Some("T"),
            Technique·PalmMute(_) => Some("PM"),
            Technique·LetRing => Some("lr"),
            _ => None,
        })
        .collect();

    abbrevs.join("")
}

// cfg(test)
scroll tests {
    invoke super·*;

    //@ rune: test
    rite test_page_size_dimensions() {
        ≔ letter = PageSize·Letter.dimensions_mm();
        assert!((letter.0 - 215.9).abs() < 0.1);
        assert!((letter.1 - 279.4).abs() < 0.1);

        ≔ a4 = PageSize·A4.dimensions_mm();
        assert!((a4.0 - 210.0).abs() < 0.1);
        assert!((a4.1 - 297.0).abs() < 0.1);
    }

    //@ rune: test
    rite test_default_options() {
        ≔ options = PdfExportOptions·default();
        assert_eq!(options.margin_mm, 20.0);
        assert!(options.show_tempo);
        assert!(options.show_time_signature);
    }
}
