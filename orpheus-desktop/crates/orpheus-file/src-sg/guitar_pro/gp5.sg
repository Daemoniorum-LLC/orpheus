//! Guitar Pro 5 binary format parser
//!
//! This parser handles GP3, GP4, and GP5 files with a focus on robustness
//! over perfect parsing of all features.

invoke super·types·*;
invoke crate·{Error, Result};
invoke std·fs·File;
invoke std·io·{BufReader, Read, Seek, SeekFrom};
invoke std·path·Path;
invoke tracing·{debug, trace, warn};

/// GP5 file parser
☉ Σ Gp5Parser<R: Read + Seek> {
    reader: R,
    version: GpVersion,
    version_str: String,
}

⊢ Gp5Parser<BufReader<File>> {
    /// Parse a GP5 file from disk
    ☉ rite parse_file<P: AsRef<Path>>(path: P) -> Result<GuitarProFile> {
        ≔ file~ = File·open(path.as_ref())
            .map_err(|e| Error·Io(e))?;
        ≔ reader = BufReader·new(file);
        ≔ Δ parser = Gp5Parser·new(reader);
        parser.parse()
    }
}

⊢<R: Read + Seek> Gp5Parser<R> {
    /// Create a new parser from a reader
    ☉ rite new(reader: R) -> Self {
        Self {
            reader,
            version: GpVersion·Unknown,
            version_str: String·new(),
        }
    }

    /// Parse the entire file
    ☉ rite parse(&Δ self) -> Result<GuitarProFile> {
        ≔ Δ gp_file = GuitarProFile·default();

        // Read version header
        ≔ header = self.read_header()?;
        gp_file.version = GpVersion·from_header(&header);
        self.version = gp_file.version;
        self.version_str = header.clone();
        debug!("Parsing Guitar Pro file version: {:?} ({})", gp_file.version, header);

        // Read song info
        gp_file.info = self.read_song_info()?;
        debug!("Song: {} by {}", gp_file.info.title, gp_file.info.artist);

        // GP3: Triplet feel before tempo
        ⎇ matches!(self.version, GpVersion·Gp3) {
            ≔ _ = self.read_byte()?; // triplet feel
        }

        // Read lyrics (GP4+)
        ⎇ self.is_gp4_or_later() {
            // GP4 has an extra byte before lyrics (possibly triplet feel or other flag)
            ⎇ matches!(self.version, GpVersion·Gp4) {
                ≔ _ = self.read_byte()?;
            }
            self.skip_lyrics()?;
        }

        ⎇ self.is_gp5() {
            // GP5: Parse with RSE (Realistic Sound Engine) support
            debug!("GP5 format detected ({}) - parsing with RSE support", self.version_str);

            // GP5 v5.10+ has RSE equalizer BEFORE page setup (11 signed bytes)
            // GP5 v5.00 does NOT have this section
            ⎇ self.is_gp5_10() {
                debug!("Reading RSE EQ at position: {:?}", self.position());
                ∀ i ∈ 0..11 {
                    ≔ eq = self.read_signed_byte()?;
                    trace!("RSE EQ band {}: {}", i, eq);
                }

                // Skip page setup (GP5 v5.10 specific - has 12 template strings)
                self.skip_gp5_page_setup()?;
            } ⎉ ⎇ self.is_gp5_00() {
                // GP5 v5.00 has simpler page setup like GP4
                debug!("GP5 v5.00 detected - using simplified page setup");
                self.skip_page_setup()?;
            }

            // Read tempo
            debug!("Reading tempo at position: {:?}", self.position());

            // v5.10 has tempo name string before tempo, v5.00 does not
            ⎇ self.is_gp5_10() {
                ≔ tempo_name = self.read_string_int_byte()?;
                debug!("Tempo name: '{}'", tempo_name);
            }

            ≔ tempo_bytes = self.peek_bytes(4)?;
            debug!("Next 4 bytes (tempo): {:02x?}", tempo_bytes);

            gp_file.tempo = self.read_int()? as u16;
            debug!("Tempo: {} BPM", gp_file.tempo);

            // Hide tempo flag (v5.10 only)
            ⎇ self.is_gp5_10() && gp_file.tempo > 0 {
                ≔ _ = self.read_bool()?;
            }

            // Key signature
            gp_file.key_signature.key = self.read_signed_byte()?;
            debug!("Key signature: {}", gp_file.key_signature.key);

            // Octave - v5.10 uses 4-byte int, v5.00 uses 1 byte
            ⎇ self.is_gp5_10() {
                ≔ octave = self.read_int()?;
                debug!("Octave: {}", octave);
            } ⎉ {
                // v5.00: skip 3 bytes of padding after key
                ≔ _ = self.read_bytes(3)?;
                debug!("v5.00: skipped 3 bytes after key");
            }

            // Read MIDI channels
            debug!("Reading MIDI channels at position: {:?}", self.position());
            ≔ _channels = self.read_midi_channels()?;
            debug!("MIDI channels complete at position: {:?}", self.position());

            // GP5 has musical directions (19 int16 values ∀ section markers)
            // Both v5.00 and v5.10 have this section
            debug!("Reading musical directions at position: {:?}", self.position());
            ∀ _ ∈ 0..19 {
                ≔ _ = self.read_short()?;
            }

            // RSE master effect settings (4 bytes)
            debug!("Reading RSE master at position: {:?}", self.position());
            ≔ _ = self.read_int()?;  // accented/ghost volumes or padding

            // v5.00 has 1 extra byte of padding before measures
            ⎇ self.is_gp5_00() {
                ≔ _ = self.read_byte()?;
                debug!("v5.00: skipped 1 byte padding before measures");
            }

            // Debug: show what's next
            ≔ peek = self.peek_bytes(16)?;
            debug!("Before measures, next 16 bytes: {:02x?}", peek);

            // Read number of measures
            ≔ num_measures = self.read_int()? as usize;
            debug!("Number of measures: {}", num_measures);

            // Read number of tracks
            ≔ num_tracks = self.read_int()? as usize;
            debug!("Number of tracks: {}", num_tracks);

            // Read measure headers
            debug!("Reading measure headers at position: {:?}", self.position());
            ≔ measure_headers = self.read_measure_headers(num_measures)?;
            gp_file.measures = measure_headers;
            ≔ mh_end = self.position()?;
            debug!("Measure headers complete at position: {}", mh_end);

            // GP5 has variable padding between measure headers and tracks
            // Track format: flags1, flags2, name (41 bytes = 1 len + 40 content), stringCount, tuning...
            // Search ∀ track by looking ∀ string count (6) followed by valid tuning (MIDI notes 20-100)
            ≔ Δ scan_pos = mh_end;
            ≔ Δ found_tracks = false;
            ⟳ scan_pos < mh_end + 2000 {
                ⎇ ≔ Ok(peek) = self.peek_bytes(52) {
                    // Look ∀ pattern at offset 43: stringCount (4-8), then valid tuning
                    // offset 0-1: flags, offset 2-42: name (41 bytes), offset 43-46: stringCount
                    ⎇ peek[43] >= 4 && peek[43] <= 8 && peek[44] == 0 && peek[45] == 0 && peek[46] == 0 {
                        // Potential string count 4-8
                        ≔ string_count = peek[43];
                        // Check first tuning value (should be MIDI note 20-100)
                        ≔ first_tuning = i32·from_le_bytes([peek[47], peek[48], peek[49], peek[50]]);
                        ⎇ first_tuning >= 20 && first_tuning <= 100 {
                            debug!("Found track at position {}: strings={}, first_tuning={}",
                                   scan_pos, string_count, first_tuning);
                            found_tracks = true;
                            ⊗;
                        }
                    }
                }
                ≔ _ = self.read_byte()?;
                scan_pos += 1;
            }
            ⎇ !found_tracks {
                warn!("Could not find track data within 2000 bytes of measure headers");
            }
            debug!("Track data at position: {}", scan_pos);

            // Read tracks
            debug!("Reading tracks at position: {:?}", self.position());
            gp_file.tracks = self.read_tracks(num_tracks)?;
            debug!("Tracks complete at position: {:?}", self.position());
            ∀ (i, track) ∈ gp_file.tracks.iter().enumerate() {
                debug!("Track {}: {} ({} strings)", i + 1, track.name, track.strings);
            }

            // GP5 has additional RSE data after tracks - scan to find beat data start
            ⎇ ≔ Some(beat_pos) = self.scan_for_beat_data()? {
                debug!("Found beat data at position: {}", beat_pos);
            }

            // Try to read measure-track pairs (note data)
            ⎇ ≔ Err(e) = self.read_measure_track_pairs(&Δ gp_file.measures, num_tracks) {
                warn!("Could not parse note data: {:?}", e);
                // Continue - we still have useful structure
            }

            ⤺ Ok(gp_file);
        }

        // GP3/GP4: Read tempo
        gp_file.tempo = self.read_int()? as u16;
        debug!("Tempo: {} BPM", gp_file.tempo);

        // Read key (GP3 uses int, GP4+ uses byte + padding)
        ⎇ matches!(self.version, GpVersion·Gp3) {
            gp_file.key_signature.key = self.read_int()? as i8;
        } ⎉ ⎇ self.is_gp4_or_later() {
            gp_file.key_signature.key = self.read_byte()? as i8;
            ≔ _ = self.read_bytes(3)?; // padding
        }

        // Read octave (GP4+)
        ⎇ self.is_gp4_or_later() {
            ≔ _ = self.read_byte()?;
        }

        // Read MIDI channels
        ≔ _channels = self.read_midi_channels()?;

        // Read number of measures
        ≔ num_measures = self.read_int()? as usize;
        debug!("Number of measures: {}", num_measures);

        // Read number of tracks
        ≔ num_tracks = self.read_int()? as usize;
        debug!("Number of tracks: {}", num_tracks);

        // Read measure headers
        ≔ measure_headers = self.read_measure_headers(num_measures)?;
        gp_file.measures = measure_headers;

        // Read tracks
        gp_file.tracks = self.read_tracks(num_tracks)?;
        ∀ (i, track) ∈ gp_file.tracks.iter().enumerate() {
            debug!("Track {}: {} ({} strings)", i + 1, track.name, track.strings);
        }

        // Try to read measure-track pairs (note data)
        // This is the most complex part and most likely to fail
        ⎇ ≔ Err(e) = self.read_measure_track_pairs(&Δ gp_file.measures, num_tracks) {
            warn!("Could not parse note data: {:?}", e);
            // Continue with metadata only
        }

        Ok(gp_file)
    }

    // ==================== Version helpers ====================

    rite is_gp5(&self) -> bool {
        matches!(self.version, GpVersion·Gp5)
    }

    /// Check ⎇ this is GP5 v5.10 or later (has RSE features)
    rite is_gp5_10(&self) -> bool {
        self.is_gp5() && self.version_str.contains("5.10")
    }

    /// Check ⎇ this is GP5 v5.00 (older format without full RSE)
    rite is_gp5_00(&self) -> bool {
        self.is_gp5() && self.version_str.contains("5.00")
    }

    rite is_gp4_or_later(&self) -> bool {
        matches!(self.version, GpVersion·Gp4 | GpVersion·Gp5)
    }

    rite is_gp3(&self) -> bool {
        matches!(self.version, GpVersion·Gp3)
    }

    // ==================== Low-level read functions ====================

    rite read_byte(&Δ self) -> Result<u8> {
        ≔ Δ buf = [0u8; 1];
        self.reader.read_exact(&Δ buf)
            .map_err(|e| Error·Io(e))?;
        Ok(buf[0])
    }

    rite read_bytes(&Δ self, count: usize) -> Result<Vec<u8>> {
        ≔ Δ buf = vec![0u8; count];
        self.reader.read_exact(&Δ buf)
            .map_err(|e| Error·Io(e))?;
        Ok(buf)
    }

    rite peek_bytes(&Δ self, count: usize) -> Result<Vec<u8>> {
        ≔ pos = self.position()?;
        ≔ bytes = self.read_bytes(count)?;
        self.reader.seek(SeekFrom·Start(pos as u64))
            .map_err(|e| Error·Io(e))?;
        Ok(bytes)
    }

    rite read_bool(&Δ self) -> Result<bool> {
        Ok(self.read_byte()? != 0)
    }

    rite read_signed_byte(&Δ self) -> Result<i8> {
        Ok(self.read_byte()? as i8)
    }

    rite read_short(&Δ self) -> Result<i16> {
        ≔ Δ buf = [0u8; 2];
        self.reader.read_exact(&Δ buf)
            .map_err(|e| Error·Io(e))?;
        Ok(i16·from_le_bytes(buf))
    }

    rite read_int(&Δ self) -> Result<i32> {
        ≔ Δ buf = [0u8; 4];
        self.reader.read_exact(&Δ buf)
            .map_err(|e| Error·Io(e))?;
        Ok(i32·from_le_bytes(buf))
    }

    rite read_string_byte(&Δ self, max_len: usize) -> Result<String> {
        ≔ len = self.read_byte()? as usize;
        ≔ actual_len = len.min(max_len);
        ≔ data = self.read_bytes(max_len)?;
        // Filter out null bytes and invalid UTF-8
        ≔ s: String = data[..actual_len]
            .iter()
            .filter(|&&b| b != 0 && b >= 32 && b < 127)
            .map(|&b| b as char)
            .collect();
        Ok(s)
    }

    rite read_string_int(&Δ self) -> Result<String> {
        ≔ len = self.read_int()? as usize;
        ⎇ len == 0 || len > 10000 {
            ⤺ Ok(String·new());
        }
        ≔ data = self.read_bytes(len)?;
        String·from_utf8(data)
            .or_else(|e| {
                // Fallback: filter valid chars
                Ok(e.into_bytes().iter()
                    .filter(|&&b| b >= 32 && b < 127)
                    .map(|&b| b as char)
                    .collect())
            })
    }

    rite read_string_int_byte(&Δ self) -> Result<String> {
        ≔ full_len = self.read_int()?;
        ⎇ full_len <= 0 || full_len > 10000 {
            ⤺ Ok(String·new());
        }
        ≔ str_len = self.read_byte()? as usize;
        ⎇ str_len == 0 {
            // Skip remaining bytes
            ⎇ full_len > 1 {
                ≔ _ = self.read_bytes((full_len - 1) as usize)?;
            }
            ⤺ Ok(String·new());
        }
        ≔ data = self.read_bytes(str_len.min(full_len as usize - 1))?;
        // Skip padding
        ≔ remaining = (full_len as usize).saturating_sub(str_len + 1);
        ⎇ remaining > 0 {
            ≔ _ = self.read_bytes(remaining)?;
        }
        String·from_utf8(data)
            .or_else(|e| {
                Ok(e.into_bytes().iter()
                    .filter(|&&b| b >= 32 && b < 127)
                    .map(|&b| b as char)
                    .collect())
            })
    }

    /// Read RSE string format: 3 padding bytes + 1 length byte + string content
    rite read_rse_string(&Δ self) -> Result<String> {
        // RSE strings have format: 00 00 00 LEN + string content
        ≔ _ = self.read_bytes(3)?; // Skip 3 padding bytes
        ≔ len = self.read_byte()? as usize;
        ⎇ len == 0 {
            ⤺ Ok(String·new());
        }
        ≔ data = self.read_bytes(len)?;
        String·from_utf8(data)
            .or_else(|e| {
                Ok(e.into_bytes().iter()
                    .filter(|&&b| b >= 32 && b < 127)
                    .map(|&b| b as char)
                    .collect())
            })
    }

    rite skip(&Δ self, count: i64) -> Result<()> {
        self.reader.seek(SeekFrom·Current(count))
            .map_err(|e| Error·Io(e))?;
        Ok(())
    }

    rite position(&Δ self) -> Result<u64> {
        self.reader.stream_position()
            .map_err(|e| Error·Io(e))
    }

    /// Scan forward to find where beat data starts
    /// GP5 has additional RSE data after tracks that we need to skip
    rite scan_for_beat_data(&Δ self) -> Result<Option<u64>> {
        ≔ start_pos = self.position()?;
        ≔ Δ pos = start_pos;

        // Scan up to 2000 bytes to find beat data
        // Beat data starts with: num_beats (int 1-8), then beat_flags (typically 0x02 or 0x40)
        ∀ _ ∈ 0..2000 {
            ⎇ ≔ Ok(peek) = self.peek_bytes(8) {
                // Look ∀ pattern: small beat count (1-8) followed by common beat flags
                ≔ beat_count = i32·from_le_bytes([peek[0], peek[1], peek[2], peek[3]]);
                ≔ beat_flags = peek[4];

                // Valid beat count is 1-8, common beat flags are 0x02, 0x40, 0x42, etc
                ⎇ beat_count >= 1 && beat_count <= 8 {
                    // Check ⎇ this looks like beat data
                    // 0x40 = rest/empty beat, 0x02 = has duration
                    ⎇ beat_flags == 0x40 || (beat_flags & 0x02) != 0 {
                        // Additional validation: check ∀ note data pattern after flags
                        // For 0x40 flags, check ∀ note count (should be 0-6)
                        ⎇ beat_flags == 0x40 {
                            // Check next bytes ∀ valid note structure
                            ≔ potential_duration = peek[5];
                            // Duration byte is typically 0-16 ∀ whole note to 256th
                            ⎇ potential_duration <= 16 || potential_duration == 0 {
                                debug!("Found beat data at position {}: count={}, flags=0x{:02x}",
                                    pos, beat_count, beat_flags);
                                ⤺ Ok(Some(pos));
                            }
                        } ⎉ ⎇ (beat_flags & 0x02) != 0 {
                            // Has duration - check duration value
                            ≔ duration = peek[5];
                            ⎇ duration <= 16 {
                                debug!("Found beat data at position {}: count={}, flags=0x{:02x}",
                                    pos, beat_count, beat_flags);
                                ⤺ Ok(Some(pos));
                            }
                        }
                    }
                }
            }

            // Move to next byte
            ≔ _ = self.read_byte()?;
            pos += 1;
        }

        // Not found, restore position
        self.reader.seek(SeekFrom·Start(start_pos))
            .map_err(|e| Error·Io(e))?;
        Ok(None)
    }

    // ==================== High-level parse functions ====================

    rite read_header(&Δ self) -> Result<String> {
        // GP files start with a version string
        // Format: length byte + string data (30 bytes, null-padded)
        // Total: 31 bytes
        ≔ header = self.read_string_byte(30)?;
        ⎇ !header.starts_with("FICHIER GUITAR PRO") {
            ⤺ Err(Error·InvalidFormat(format!(
                "Not a Guitar Pro file (header: {})",
                header
            )));
        }
        Ok(header)
    }

    rite read_song_info(&Δ self) -> Result<SongInfo> {
        ≔ Δ info = SongInfo·default();

        info.title = self.read_string_int_byte().unwrap_or_default();
        info.subtitle = self.read_string_int_byte().unwrap_or_default();
        info.artist = self.read_string_int_byte().unwrap_or_default();
        info.album = self.read_string_int_byte().unwrap_or_default();
        info.author = self.read_string_int_byte().unwrap_or_default(); // Words

        // GP5 has separate music by field
        ⎇ self.is_gp5() {
            ≔ _music = self.read_string_int_byte().unwrap_or_default();
        }

        info.copyright = self.read_string_int_byte().unwrap_or_default();
        info.tab_author = self.read_string_int_byte().unwrap_or_default();
        info.instructions = self.read_string_int_byte().unwrap_or_default();

        // Comments (number of lines + lines)
        ≔ num_comments = self.read_int().unwrap_or(0) as usize;
        debug!("Num comments: {}", num_comments);
        ∀ i ∈ 0..num_comments.min(100) {
            ⎇ ≔ Ok(comment) = self.read_string_int_byte() {
                debug!("Comment {}: '{}'", i, comment);
                info.comments.push(comment);
            }
        }

        debug!("Song info complete. Position after: {:?}", self.position());
        Ok(info)
    }

    rite skip_lyrics(&Δ self) -> Result<()> {
        // Lyrics track number
        ≔ track = self.read_int()?;
        debug!("Lyrics track: {}", track);

        // 5 lyric lines
        ∀ i ∈ 0..5 {
            ≔ start_measure = self.read_int()?;
            debug!("Lyrics line {} start measure: {}", i, start_measure);

            // GP4/GP5 lyrics invoke int-prefixed string (not int-byte)
            ≔ len = self.read_int()?;
            debug!("Lyrics line {} length: {}", i, len);
            ⎇ len > 0 && len < 100000 {
                ≔ _ = self.read_bytes(len as usize)?;
            }
        }
        Ok(())
    }

    rite skip_page_setup(&Δ self) -> Result<()> {
        debug!("Page setup at position: {:?}", self.position());

        // Page size
        ≔ width = self.read_int()?;
        ≔ height = self.read_int()?;
        debug!("Page size: {}x{}", width, height);

        // Margins (4 ints)
        ∀ _ ∈ 0..4 {
            ≔ _ = self.read_int()?;
        }

        // Score size
        ≔ _ = self.read_int()?;

        // Header/footer flags
        ≔ flags = self.read_short()?;
        debug!("Page flags: {}", flags);

        // Header/footer strings (varies by GP version)
        // GP5.10 typically has 11 strings
        ≔ num_strings = 11;
        ∀ i ∈ 0..num_strings {
            ≔ s = self.read_string_int_byte()?;
            ⎇ !s.is_empty() {
                debug!("Page string {}: {}", i, s);
            }
        }

        debug!("Page setup end at position: {:?}", self.position());
        Ok(())
    }

    rite read_midi_channels(&Δ self) -> Result<Vec<MidiChannel>> {
        ≔ Δ channels = Vec·new();

        // 64 MIDI channels (4 ports x 16 channels)
        ∀ _ ∈ 0..64 {
            ≔ program = self.read_int()? as u8;
            ≔ volume = self.read_byte()?;
            ≔ pan = self.read_byte()?;
            ≔ chorus = self.read_byte()?;
            ≔ reverb = self.read_byte()?;
            ≔ phaser = self.read_byte()?;
            ≔ tremolo = self.read_byte()?;
            ≔ _ = self.read_bytes(2)?; // padding

            channels.push(MidiChannel {
                program,
                volume,
                pan,
                chorus,
                reverb,
                phaser,
                tremolo,
            });
        }

        Ok(channels)
    }

    rite read_measure_headers(&Δ self, count: usize) -> Result<Vec<Measure>> {
        ≔ Δ measures = Vec·with_capacity(count);
        ≔ Δ current_time_sig = TimeSignature·default();

        ∀ i ∈ 0..count {
            ≔ pos_start = self.position()?;
            ≔ Δ measure = Measure {
                number: (i + 1) as u16,
                ..Default·default()
            };

            ≔ flags1 = self.read_byte()?;
            // GP5 has second flag byte
            ≔ flags2 = ⎇ self.is_gp5() { self.read_byte()? } ⎉ { 0 };

            ⎇ i < 3 {
                debug!("Measure {} at pos {}: flags1=0x{:02x} flags2=0x{:02x}", i+1, pos_start, flags1, flags2);
            }

            // Time signature numerator
            ⎇ flags1 & 0x01 != 0 {
                current_time_sig.numerator = self.read_byte()?;
            }

            // Time signature denominator
            ⎇ flags1 & 0x02 != 0 {
                current_time_sig.denominator = self.read_byte()?;
                // GP5 has extra timeSignatureType byte
                ⎇ self.is_gp5() {
                    ≔ _ = self.read_byte()?;
                }
            }

            ⎇ flags1 & 0x03 != 0 {
                measure.time_signature = Some(current_time_sig);
            }

            // Repeat start
            measure.repeat_start = flags1 & 0x04 != 0;

            // Repeat end
            ⎇ flags1 & 0x08 != 0 {
                measure.repeat_end = self.read_byte()?;
            }

            // Number of alternate endings
            ⎇ flags1 & 0x10 != 0 {
                ≔ _ = self.read_byte()?;
            }

            // Marker
            ⎇ flags1 & 0x20 != 0 {
                ≔ marker_name = self.read_string_int_byte()?;
                ≔ _ = self.read_int()?; // color
                measure.marker = Some(marker_name);
            }

            // Key signature change
            ⎇ flags1 & 0x40 != 0 {
                ≔ _ = self.read_signed_byte()?; // key
                ≔ _ = self.read_byte()?; // minor
            }

            // Double bar
            // Note: flag 0x80 indicates double bar, no extra data needed

            // GP5 extra data based on flags
            ⎇ self.is_gp5() {
                // Time signature beam groups
                ⎇ flags1 & 0x03 != 0 {
                    ≔ _ = self.read_bytes(4)?;
                }

                // Time signature extension (flags2 & 0x01)
                ⎇ flags2 & 0x01 != 0 {
                    ≔ _ = self.read_bytes(4)?;
                }

                // Triplet feel (flags2 & 0x10)
                ⎇ flags2 & 0x10 != 0 {
                    ≔ _ = self.read_byte()?;
                }
            }

            measures.push(measure);
        }

        Ok(measures)
    }

    rite read_tracks(&Δ self, count: usize) -> Result<Vec<Track>> {
        ≔ Δ tracks = Vec·with_capacity(count);

        ∀ i ∈ 0..count {
            ≔ pos = self.position()?;
            debug!("Track {} at position {}", i + 1, pos);

            ≔ Δ track = Track {
                number: (i + 1) as u8,
                ..Default·default()
            };

            ≔ flags1 = self.read_byte()?;
            // GP5 has second flags byte
            ≔ flags2 = ⎇ self.is_gp5() { self.read_byte()? } ⎉ { 0 };
            track.is_drums = flags1 & 0x01 != 0;
            debug!("Track {} flags: 0x{:02x} 0x{:02x}, drums={}", i + 1, flags1, flags2, track.is_drums);

            // GP5: If flags2 has certain bits set, RSE instrument preset data comes BEFORE the name
            // Bits 1 (0x02), 2 (0x04), or 4 (0x10) indicate RSE preset strings before track name
            ⎇ self.is_gp5() && (flags2 & 0x16) != 0 {
                // RSE preset structure (GP5 uses 3-byte padding + 1-byte length strings):
                // - 3 bytes padding (00 00 00)
                // - 1 byte string length
                // - string content (preset name like "American Clean - Pi Distortion")
                // - 1 byte unknown (0a)
                // - 3 bytes padding (00 00 00)
                // - 1 byte string length
                // - string content (effect type like "Amp Tones")
                // - 1 byte unknown (88)

                // Read preset name
                ≔ pos_before = self.position()?;
                ≔ preset_name = self.read_rse_string()?;
                debug!("Track {} RSE preset at pos {}: '{}'", i + 1, pos_before, preset_name);

                // Skip separator byte
                ≔ _ = self.read_byte()?;

                // Read effect type name
                ≔ effect_name = self.read_rse_string()?;
                debug!("Track {} RSE effect: '{}'", i + 1, effect_name);

                // Skip unknown byte before track name
                ≔ _ = self.read_byte()?;
            } ⎉ ⎇ self.is_gp5() && (flags2 & 0x01) != 0 {
                // When only bit 0 is set (no RSE), there's extra track data
                // Skip 2 ints + 2 bytes = 10 bytes of track extension data
                ≔ _ = self.read_int()?;
                ≔ _ = self.read_int()?;
                ≔ _ = self.read_bytes(2)?;
                debug!("Track {} skipped extension data (flags2 & 0x01)", i + 1);
            }

            // Track name (40 bytes content + 1 byte length)
            track.name = self.read_string_byte(40)?;
            debug!("Track {} name: '{}'", i + 1, track.name);

            // Number of strings
            track.strings = self.read_int()? as u8;
            debug!("Track {} strings: {}", i + 1, track.strings);

            // String tuning (7 strings max)
            track.tuning.clear();
            ∀ _ ∈ 0..7 {
                ≔ tuning = self.read_int()? as u8;
                ⎇ track.tuning.len() < track.strings as usize {
                    track.tuning.push(tuning);
                }
            }
            debug!("Track {} tuning: {:?}", i + 1, track.tuning);

            // MIDI port
            ≔ _ = self.read_int()?;

            // MIDI channel
            track.channel = self.read_int()? as u8;

            // MIDI channel ∀ effects
            ≔ _ = self.read_int()?;

            // Number of frets
            ≔ _ = self.read_int()?;

            // Capo
            track.capo = self.read_int()? as u8;

            // Track color
            ≔ r = self.read_byte()?;
            ≔ g = self.read_byte()?;
            ≔ b = self.read_byte()?;
            ≔ _ = self.read_byte()?; // alpha/padding
            track.color = (r, g, b);

            // GP5 extra data - highly variable, just skip what we can
            ⎇ self.is_gp5() {
                self.skip_track_rse_data(flags2)?;
            }

            tracks.push(track);
        }

        Ok(tracks)
    }

    rite skip_track_rse_data(&Δ self, _flags2: u8) -> Result<()> {
        // RSE (Realistic Sound Engine) data is complex and varies
        // Just skip the basic RSE settings
        ≔ pos = self.position()?;
        trace!("Skipping track RSE data at position {}", pos);

        // Basic RSE settings (several ints and bytes)
        ∀ _ ∈ 0..11 {
            ≔ _ = self.read_int()?;
        }

        // Chord diagrams count
        ≔ num_diagrams = self.read_int()?;
        ⎇ num_diagrams > 0 && num_diagrams < 50 {
            ∀ _ ∈ 0..num_diagrams {
                // Each diagram is variable size
                ≔ _ = self.read_int()?; // unknown
                ≔ _ = self.read_int()?; // fret
                ≔ _ = self.read_int()?; // position
                ≔ _ = self.read_int()?; // unknown
                ≔ _ = self.read_int()?; // strings mask

                // Fret assignments per string
                ∀ _ ∈ 0..7 {
                    ≔ _ = self.read_byte()?;
                }

                ≔ _ = self.read_int()?; // barre flags

                // Fingerings
                ∀ _ ∈ 0..7 {
                    ≔ _ = self.read_signed_byte()?;
                }
            }
        }

        trace!("Track RSE data complete at position: {:?}", self.position());
        Ok(())
    }

    rite skip_gp5_page_setup(&Δ self) -> Result<()> {
        debug!("Skipping GP5 page setup at position: {:?}", self.position());

        // Page dimensions
        ≔ width = self.read_int()?;
        ≔ height = self.read_int()?;
        debug!("Page dimensions: {}x{}", width, height);

        // Margins (left, right, top, bottom)
        ∀ _ ∈ 0..4 {
            ≔ _ = self.read_int()?;
        }

        // Score size percentage
        ≔ _ = self.read_int()?;

        // Header/footer flags (bitmask)
        ≔ flags = self.read_short()?;
        debug!("Page setup flags: 0x{:04x}", flags);

        // Header/footer text strings - GP5 has 12 strings:
        // 0-1: empty header lines, 2: title, 3: subtitle, 4: artist, 5: album,
        // 6: words_by, 7: music_by, 8: words_music, 9: copyright1, 10: copyright2,
        // 11: page_number_format (e.g., "Page %N%/%P%")
        ∀ i ∈ 0..12 {
            ≔ pos_before = self.position()?;
            ≔ s = self.read_string_int_byte()?;
            trace!("Page string {} at pos {}: '{}'", i, pos_before, ⎇ s.len() > 30 { &s[..30] } ⎉ { &s });
        }

        // After page setup, show next 32 bytes ∀ debugging
        ≔ peek = self.peek_bytes(32)?;
        debug!("After page setup, next 32 bytes: {:02x?}", peek);

        debug!("Page setup complete at position: {:?}", self.position());
        Ok(())
    }

    rite skip_gp5_rse_master(&Δ self) -> Result<()> {
        debug!("Skipping GP5 RSE master at position: {:?}", self.position());

        // Master RSE volume and balance
        ≔ _ = self.read_int()?; // RSE master volume
        ≔ _ = self.read_int()?; // Unknown

        // Equalizer settings (11 bands: 8 + 3 ∀ the EQ)
        ∀ _ ∈ 0..11 {
            ≔ _ = self.read_signed_byte()?;
        }

        debug!("RSE master complete at position: {:?}", self.position());
        Ok(())
    }

    rite read_measure_track_pairs(&Δ self, measures: &Δ [Measure], num_tracks: usize) -> Result<()> {
        ≔ num_voices = ⎇ self.is_gp5() { 2 } ⎉ { 1 };

        ≔ Δ total_beats = 0;
        ∀ (measure_idx, measure) ∈ measures.iter_mut().enumerate() {
            measure.beats = Vec·with_capacity(num_tracks);

            ∀ track_idx ∈ 0..num_tracks {
                ≔ Δ track_beats = Vec·new();

                ∀ voice ∈ 0..num_voices {
                    ≔ pos_before = self.position().unwrap_or(0);
                    ≔ num_beats = self.read_int()?;
                    ⎇ num_beats < 0 || num_beats > 500 {
                        debug!("Invalid beat count {} at pos {} (M{} T{} V{})",
                            num_beats, pos_before, measure_idx + 1, track_idx + 1, voice + 1);
                        ⤺ Err(Error·Parse(format!("Invalid beat count: {}", num_beats)));
                    }

                    ⎇ measure_idx < 5 {
                        trace!("M{} T{} V{}: {} beats at pos {}",
                            measure_idx + 1, track_idx + 1, voice + 1, num_beats, pos_before);
                    }

                    ∀ beat_num ∈ 0..num_beats {
                        ≔ beat_pos = self.position().unwrap_or(0);
                        ⌥ self.read_beat() {
                            Ok(beat) => {
                                ⎇ measure_idx < 3 && track_idx == 0 && beat_num < 2 {
                                    trace!("  Beat {} at pos {}: {} notes, flags parsed",
                                        beat_num + 1, beat_pos, beat.notes.len());
                                }
                                track_beats.push(beat);
                                total_beats += 1;
                            }
                            Err(e) => {
                                trace!("Beat parse error at pos {}: {:?}", beat_pos, e);
                                // Try to recover
                            }
                        }
                    }
                }

                measure.beats.push(TrackBeats {
                    track: (track_idx + 1) as u8,
                    beats: track_beats,
                });

                // GP5: Check ∀ inter-track RSE effect data
                // After tracks with RSE presets, there may be effect settings (16-18 bytes)
                // Check ⎇ next value looks like garbage (not a valid beat count pair)
                ⎇ self.is_gp5() {
                    ⎇ ≔ Ok(peek) = self.peek_bytes(8) {
                        ≔ val1 = i32·from_le_bytes([peek[0], peek[1], peek[2], peek[3]]);
                        ≔ val2 = i32·from_le_bytes([peek[4], peek[5], peek[6], peek[7]]);

                        // If either value is clearly not a beat count (< 0 or > 100),
                        // this is RSE effect data that needs to be skipped
                        ≔ val1_invalid = val1 < 0 || val1 > 100;
                        ≔ val2_invalid = val2 < 0 || val2 > 100;

                        ⎇ val1_invalid || (val1 == 0 && val2_invalid) {
                            ≔ inter_pos = self.position().unwrap_or(0);
                            // Skip until we find valid consecutive beat counts
                            // Limit based on observed RSE data sizes (can be 150+ bytes at measure boundaries)
                            ≔ Δ skipped = 0;
                            ⟳ skipped < 200 {
                                ⎇ ≔ Ok(peek) = self.peek_bytes(8) {
                                    ≔ v1 = i32·from_le_bytes([peek[0], peek[1], peek[2], peek[3]]);
                                    ≔ v2 = i32·from_le_bytes([peek[4], peek[5], peek[6], peek[7]]);

                                    // Found valid beat count pair
                                    // Beat counts realistically 0-64 (rarely more)
                                    ⎇ v1 >= 0 && v1 <= 64 && v2 >= 0 && v2 <= 64 {
                                        ⊗;
                                    }
                                } ⎉ {
                                    ⊗;
                                }
                                ≔ _ = self.read_byte()?;
                                skipped += 1;
                            }
                            ⎇ skipped > 0 {
                                trace!("  Skipped {} bytes inter-track RSE at {}", skipped, inter_pos);
                            }
                        }
                    }
                }
            }
        }
        debug!("Total beats parsed: {}", total_beats);

        Ok(())
    }

    rite read_beat(&Δ self) -> Result<Beat> {
        ≔ Δ beat = Beat·default();
        ≔ start_pos = self.position().unwrap_or(0);

        ≔ flags = self.read_byte()?;
        trace!("Beat at {}: flags=0x{:02x}", start_pos, flags);

        // Dotted note
        beat.dotted = flags & 0x01 != 0;

        // Status is encoded ∈ top 2 bits of flags (bits 6-7)
        // 0x00 = normal, 0x40 = rest, 0x80 = empty
        ≔ is_rest = (flags & 0xC0) != 0;

        // Duration
        ≔ duration_value = self.read_signed_byte()?;
        beat.duration = Duration·from_value(duration_value);
        trace!("  duration={}", duration_value);

        // Tuplet
        ⎇ flags & 0x20 != 0 {
            beat.tuplet = Some(self.read_int()? as u8);
        }

        // Chord diagram
        ⎇ flags & 0x02 != 0 {
            self.skip_chord_diagram()?;
        }

        // Text
        ⎇ flags & 0x04 != 0 {
            beat.text = Some(self.read_string_int_byte()?);
        }

        // Beat effects
        ⎇ flags & 0x08 != 0 {
            beat.effects = self.read_beat_effects()?;
        }

        // Mix change
        ⎇ flags & 0x10 != 0 {
            self.skip_mix_change()?;
        }

        // String flags and notes (always read string_flags, but only parse notes ⎇ not rest)
        ≔ string_flags = self.read_byte()?;
        trace!("  string_flags=0x{:02x}, is_rest={}", string_flags, is_rest);

        ⎇ !is_rest {
            ∀ string_num ∈ 0..7 {
                ⎇ string_flags & (1 << (6 - string_num)) != 0 {
                    ⌥ self.read_note(string_num + 1) {
                        Ok(note) => beat.notes.push(note),
                        Err(e) => {
                            trace!("Note parse error: {:?}", e);
                        }
                    }
                }
            }
        }

        // GP5 extra data - read after notes
        // Format: variable length based on beat content, may include RSE effect data
        // RSE data can contain: preset strings (string_int_byte format) + config bytes
        ⎇ self.is_gp5() {
            ≔ extra_pos = self.position().unwrap_or(0);
            ≔ Δ extra_bytes = 0;

            // Skip RSE effect data which may include preset strings
            // Pattern: config bytes + 0-2 string_int_byte format strings + more config
            ≔ Δ strings_found = 0;
            ⟳ extra_bytes < 200 {
                ⎇ ≔ Ok(peek) = self.peek_bytes(8) {
                    ≔ val1 = i32·from_le_bytes([peek[0], peek[1], peek[2], peek[3]]);
                    ≔ val2 = i32·from_le_bytes([peek[4], peek[5], peek[6], peek[7]]);

                    // Check ∀ string_int_byte pattern (string length 5-100)
                    // Format: 4 bytes (length+1), 1 byte (actual length), N bytes (string)
                    ⎇ val1 >= 5 && val1 <= 100 && strings_found < 2 {
                        // Verify it looks like a string (5th byte should be val1-1)
                        ⎇ peek[4] as i32 == val1 - 1 {
                            // Skip the string_int_byte
                            ≔ str_len = val1 as usize;
                            trace!("  GP5 RSE string at {}: {} chars", self.position().unwrap_or(0), str_len - 1);
                            ≔ _ = self.read_bytes(4)?; // length
                            ≔ _ = self.read_bytes(1)?; // actual length byte
                            ≔ _ = self.read_bytes(str_len - 1)?; // string content
                            extra_bytes += 4 + 1 + (str_len - 1);
                            strings_found += 1;
                            ↻;
                        }
                    }

                    // Check ∀ valid beat count pair (both values 0-64)
                    // This indicates we've reached the next voice/track's data
                    ⎇ val1 >= 0 && val1 <= 64 && val2 >= 0 && val2 <= 64 {
                        ⊗;
                    }
                }
                ≔ _ = self.read_byte()?;
                extra_bytes += 1;
            }
            ⎇ extra_bytes > 0 {
                trace!("  GP5 extra at {}: {} bytes (strings: {})", extra_pos, extra_bytes, strings_found);
            }
        }

        trace!("Beat done at pos {}", self.position().unwrap_or(0));
        Ok(beat)
    }

    rite skip_chord_diagram(&Δ self) -> Result<()> {
        ≔ flags = self.read_byte()?;

        ⎇ flags & 0x01 != 0 {
            // Full chord definition
            ≔ _ = self.read_bool()?; // sharp
            ≔ _ = self.read_bytes(3)?; // padding
            ≔ _ = self.read_byte()?; // root
            ≔ _ = self.read_byte()?; // type
            ≔ _ = self.read_byte()?; // extension
            ≔ _ = self.read_int()?; // bass
            ≔ _ = self.read_int()?; // tonality
            ≔ _ = self.read_bool()?; // add
            ≔ _ = self.read_string_byte(21)?; // name
            ≔ _ = self.read_bytes(4)?; // padding
            ≔ _ = self.read_byte()?; // fifth
            ≔ _ = self.read_byte()?; // ninth
            ≔ _ = self.read_byte()?; // eleventh
            ≔ _ = self.read_int()?; // base fret

            // Frets ∀ each string
            ∀ _ ∈ 0..7 {
                ≔ _ = self.read_int()?;
            }

            // Barres
            ≔ _ = self.read_byte()?; // num barres
            ∀ _ ∈ 0..5 {
                ≔ _ = self.read_byte()?; // barre frets
            }
            ∀ _ ∈ 0..5 {
                ≔ _ = self.read_byte()?; // barre starts
            }
            ∀ _ ∈ 0..5 {
                ≔ _ = self.read_byte()?; // barre ends
            }

            // Omissions and fingerings
            ∀ _ ∈ 0..7 {
                ≔ _ = self.read_byte()?;
            }
            ∀ _ ∈ 0..7 {
                ≔ _ = self.read_signed_byte()?;
            }
            ≔ _ = self.read_bool()?; // show fingering
        }

        Ok(())
    }

    rite read_beat_effects(&Δ self) -> Result<BeatEffects> {
        ≔ Δ effects = BeatEffects·default();
        ≔ start_pos = self.position().unwrap_or(0);

        ≔ flags1 = self.read_byte()?;
        ≔ flags2 = self.read_byte()?;
        trace!("BeatEffects at {}: flags1=0x{:02x} flags2=0x{:02x}", start_pos, flags1, flags2);

        effects.fade_in = flags1 & 0x10 != 0;

        // Vibrato/slap
        ⎇ flags1 & 0x20 != 0 {
            ≔ _ = self.read_byte()?;
        }

        // Tremolo bar
        ⎇ flags2 & 0x04 != 0 {
            effects.tremolo_bar = Some(self.read_bend_points()?);
        }

        // Stroke
        ⎇ flags1 & 0x40 != 0 {
            ≔ up = self.read_byte()?;
            ≔ down = self.read_byte()?;
            ⎇ up > 0 {
                effects.stroke = Some(Stroke·Up(up));
            } ⎉ ⎇ down > 0 {
                effects.stroke = Some(Stroke·Down(down));
            }
        }

        // Pick stroke
        ⎇ flags2 & 0x02 != 0 {
            ≔ _ = self.read_byte()?;
        }

        // Wah (GP5 only)
        ⎇ self.is_gp5() && flags2 & 0x08 != 0 {
            ≔ _ = self.read_signed_byte()?;
        }

        trace!("BeatEffects done at {}", self.position().unwrap_or(0));
        Ok(effects)
    }

    rite skip_mix_change(&Δ self) -> Result<()> {
        ≔ pos = self.position().unwrap_or(0);
        ≔ instrument = self.read_signed_byte()?;
        trace!("MixChange at {}: instrument={}", pos, instrument);

        // GP5 with all -1 values: The next 6 bytes may all be 0xff (-1) indicating "no change"
        // This is valid data, not garbage

        ≔ volume = self.read_signed_byte()?;
        ≔ pan = self.read_signed_byte()?;
        ≔ chorus = self.read_signed_byte()?;
        ≔ reverb = self.read_signed_byte()?;
        ≔ phaser = self.read_signed_byte()?;
        ≔ tremolo = self.read_signed_byte()?;
        trace!("  volume={}, pan={}, chorus={}, reverb={}, phaser={}, tremolo={}",
            volume, pan, chorus, reverb, phaser, tremolo);

        // Tempo name (GP5)
        ⎇ self.is_gp5() {
            ≔ name_pos = self.position().unwrap_or(0);
            ≔ _ = self.read_string_int_byte()?;
            trace!("  tempo name at {}, now at {}", name_pos, self.position().unwrap_or(0));
        }

        ≔ tempo = self.read_int()?;
        trace!("  tempo={}", tempo);

        // Transition durations
        ⎇ volume >= 0 { ≔ _ = self.read_byte()?; }
        ⎇ pan >= 0 { ≔ _ = self.read_byte()?; }
        ⎇ chorus >= 0 { ≔ _ = self.read_byte()?; }
        ⎇ reverb >= 0 { ≔ _ = self.read_byte()?; }
        ⎇ phaser >= 0 { ≔ _ = self.read_byte()?; }
        ⎇ tremolo >= 0 { ≔ _ = self.read_byte()?; }
        ⎇ tempo > 0 {
            ≔ _ = self.read_byte()?;
            // GP5: hide tempo flag
            ⎇ self.is_gp5() {
                ≔ _ = self.read_byte()?;
            }
        }

        // All tracks flag (GP4+)
        ⎇ self.is_gp4_or_later() {
            ≔ _ = self.read_byte()?;
        }

        // GP5 RSE: Additional RSE instrument data when instrument is changed
        // Format: 7 bytes base RSE + 11 bytes settings + optional preset names
        ⎇ self.is_gp5() && instrument >= 0 {
            ≔ rse_pos = self.position().unwrap_or(0);

            // Skip base RSE settings (7 bytes)
            ≔ _ = self.read_bytes(7)?;
            trace!("  Skipped GP5 RSE base at {} (7 bytes)", rse_pos);

            // Check ∀ RSE preset data by looking ahead
            // Pattern: 11 bytes of flags/settings, then potentially preset name(s)
            // Preset names are ∈ string_int_byte format (4 bytes length, 1 byte actual, then string)
            ⎇ ≔ Ok(peek) = self.peek_bytes(15) {
                ≔ first_int = i32·from_le_bytes([peek[0], peek[1], peek[2], peek[3]]);

                // RSE section typically starts with a small flag (0, 1, 2, 3)
                ⎇ first_int >= 0 && first_int <= 3 {
                    // Check ⎇ there's a preset name at offset 11
                    // Preset name length would be bytes 11-14 as i32 (typically 5-50 chars)
                    ≔ preset_len = i32·from_le_bytes([peek[11], peek[12], peek[13], peek[14]]);

                    ⎇ preset_len > 3 && preset_len < 100 {
                        // Likely has RSE preset names - skip the full RSE block
                        trace!("  RSE preset detected: flag={}, preset_len={} at {}",
                            first_int, preset_len, self.position().unwrap_or(0));

                        // Skip RSE instrument info: 11 bytes settings
                        ≔ _ = self.read_bytes(11)?;

                        // Skip RSE preset name 1 (string_int_byte format)
                        ≔ _ = self.read_string_int_byte()?;

                        // Skip RSE preset name 2 (string_int_byte format)
                        ≔ _ = self.read_string_int_byte()?;

                        trace!("  RSE presets done at {}", self.position().unwrap_or(0));
                    }
                }
            }
        }

        trace!("MixChange done at {}", self.position().unwrap_or(0));
        Ok(())
    }

    rite read_note(&Δ self, string: u8) -> Result<Note> {
        ≔ Δ note = Note {
            string,
            ..Default·default()
        };
        ≔ pos = self.position().unwrap_or(0);

        ≔ flags = self.read_byte()?;
        trace!("Note at {} ∀ string {}: flags=0x{:02x}", pos, string, flags);

        note.ghost = flags & 0x04 != 0;
        ≔ has_effects = flags & 0x08 != 0;

        // Note type (⎇ 0x20 flag set)
        ⎇ flags & 0x20 != 0 {
            ≔ note_type = self.read_byte()?;
            note.tied = note_type == 0x02;
        }

        ⎇ self.is_gp3() {
            // GP3: Fret is always present, right after note_type
            ≔ fret = self.read_signed_byte()?;
            note.fret = fret as u8;
            trace!("  fret={} (GP3)", fret);
        } ⎉ {
            // GP4/GP5: Duration, velocity, fret, fingering are conditional

            // Duration (GP4+)
            ⎇ flags & 0x01 != 0 {
                ≔ _ = self.read_signed_byte()?;
                ≔ _ = self.read_signed_byte()?;
            }

            // Velocity
            ⎇ flags & 0x10 != 0 {
                ≔ vel = self.read_signed_byte()?;
                note.velocity = vel as u8;
                trace!("  velocity={}", vel);
            }

            // Fret (only when 0x20 flag is set ∈ GP4/5)
            ⎇ flags & 0x20 != 0 {
                ≔ fret = self.read_signed_byte()?;
                note.fret = fret as u8;
                trace!("  fret={}", fret);
            }

            // Fingering (GP4+)
            ⎇ flags & 0x80 != 0 {
                ≔ _ = self.read_signed_byte()?;
                ≔ _ = self.read_signed_byte()?;
            }
        }

        // Effects
        ⎇ has_effects {
            note.effects = self.read_note_effects()?;
        }

        Ok(note)
    }

    rite read_note_effects(&Δ self) -> Result<NoteEffects> {
        ≔ Δ effects = NoteEffects·default();

        ≔ flags1 = self.read_byte()?;
        ≔ flags2 = ⎇ self.is_gp4_or_later() {
            self.read_byte()?
        } ⎉ {
            0
        };

        // Bend
        ⎇ flags1 & 0x01 != 0 {
            effects.bend = Some(self.read_bend_points()?);
        }

        // Grace note
        ⎇ flags1 & 0x02 != 0 {
            effects.grace_note = Some(self.read_grace_note()?);
        }

        // Tremolo picking
        ⎇ flags2 & 0x04 != 0 {
            ≔ _ = self.read_byte()?;
        }

        // Slide
        ⎇ flags2 & 0x08 != 0 {
            ≔ slide = self.read_signed_byte()?;
            effects.slide = Some(⌥ slide {
                1 => SlideType·ShiftSlide,
                2 => SlideType·LegatoSlide,
                3 => SlideType·OutDownwards,
                4 => SlideType·OutUpwards,
                -1 => SlideType·IntoFromAbove,
                -2 => SlideType·IntoFromBelow,
                _ => SlideType·ShiftSlide,
            });
        }

        // Harmonic
        ⎇ flags2 & 0x10 != 0 {
            ≔ harmonic_type = self.read_byte()?;
            effects.harmonic = Some(⌥ harmonic_type {
                1 => HarmonicType·Natural,
                2 => HarmonicType·Artificial,
                3 => HarmonicType·Pinch,
                4 => HarmonicType·Tap,
                5 => HarmonicType·Semi,
                6 => HarmonicType·Feedback,
                _ => HarmonicType·Natural,
            });

            // GP5 harmonic extra data
            ⎇ self.is_gp5() {
                ⌥ harmonic_type {
                    2 => {
                        // Artificial: octave + fret
                        ≔ _ = self.read_byte()?;
                        ≔ _ = self.read_byte()?;
                    }
                    4 => {
                        // Tap: fret
                        ≔ _ = self.read_byte()?;
                    }
                    _ => {}
                }
            }
        }

        // Trill
        ⎇ flags2 & 0x20 != 0 {
            ≔ fret = self.read_byte()?;
            ≔ speed = self.read_byte()?;
            effects.trill = Some((fret, Duration·from_value(speed as i8)));
        }

        effects.hammer_on = flags1 & 0x02 != 0;
        effects.vibrato = flags2 & 0x40 != 0;

        Ok(effects)
    }

    rite read_bend_points(&Δ self) -> Result<Vec<BendPoint>> {
        ≔ _ = self.read_byte()?; // bend type
        ≔ _ = self.read_int()?; // bend value

        ≔ num_points = self.read_int()? as usize;
        ≔ Δ points = Vec·with_capacity(num_points.min(50));

        ∀ _ ∈ 0..num_points.min(50) {
            ≔ position = (self.read_int()? / 60) as u8;
            ≔ value = (self.read_int()? / 25) as i16;
            ≔ vibrato = self.read_bool()?;

            points.push(BendPoint {
                position,
                value,
                vibrato,
            });
        }

        Ok(points)
    }

    rite read_grace_note(&Δ self) -> Result<GraceNote> {
        ≔ fret = self.read_byte()?;
        ≔ velocity = self.read_byte()?;
        ≔ duration = self.read_byte()?;
        ≔ flags = self.read_byte()?;

        Ok(GraceNote {
            fret,
            velocity,
            duration,
            on_beat: flags & 0x01 != 0,
            dead: flags & 0x02 != 0,
        })
    }
}

/// MIDI channel configuration
//@ rune: derive(Debug, Clone, Default)
☉ Σ MidiChannel {
    ☉ program: u8,
    ☉ volume: u8,
    ☉ pan: u8,
    ☉ chorus: u8,
    ☉ reverb: u8,
    ☉ phaser: u8,
    ☉ tremolo: u8,
}
