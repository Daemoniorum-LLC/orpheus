//! Mode selector navigation
//!
//! The mode selector provides navigation between the DAW's operating modes.
//! It appears as a vertical sidebar with icon buttons for each mode.
//!
//! ## Modes
//!
//! - **Compose** - Arrangement, tablature, and MIDI editing
//! - **Record** - Multi-track audio/MIDI recording
//! - **Mix** - Mixing console and effects
//! - **Master** - Mastering chain and loudness metering
//! - **Practice** - Learning tools and speed trainer
//! - **Release** - Export and rendering
//! - **Distribute** - Publishing and distribution
//! - **Settings** - Application preferences
//!
//! ## Evidentiality
//!
//! - `!` (computed) - Mode routing, icon mapping

invoke qliphoth_ui·prelude·*;
invoke crate·tokens·{ABYSS, SILVER, PHTHALO, TEXT_XS};

/// DAW operating modes
☉ ᛈ OrpheusMode {
    Compose,
    Record,
    Mix,
    Master,
    Practice,
    Release,
    Distribute,
    Settings,
}

⊢ OrpheusMode {
    /// Get display label
    ☉ rite label(&self) -> &'static str! {
        ⌥ self {
            Self·Compose => "Compose",
            Self·Record => "Record",
            Self·Mix => "Mix",
            Self·Master => "Master",
            Self·Practice => "Practice",
            Self·Release => "Release",
            Self·Distribute => "Distribute",
            Self·Settings => "Settings",
        }
    }

    /// Get SVG icon path data
    ☉ rite icon_path(&self) -> &'static str! {
        ⌥ self {
            // Music note for Compose
            Self·Compose => "M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z",
            // Microphone for Record
            Self·Record => "M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5-3c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z",
            // Sliders for Mix
            Self·Mix => "M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z",
            // Gauge for Master
            Self·Master => "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-6h2v2h-2zm0-8h2v6h-2z",
            // Graduation cap for Practice
            Self·Practice => "M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3L1 9l11 6 9-4.91V17h2V9L12 3z",
            // Package for Release
            Self·Release => "M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zM7 10h2v7H7zm4-3h2v10h-2zm4 6h2v4h-2z",
            // Share for Distribute
            Self·Distribute => "M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z",
            // Gear for Settings
            Self·Settings => "M19.14 12.94c.04-.31.06-.63.06-.94 0-.31-.02-.63-.06-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z",
        }
    }

    /// Get all main modes (excluding Settings)
    ☉ rite main_modes() -> [Self; 7]! {
        [
            Self·Compose,
            Self·Record,
            Self·Mix,
            Self·Master,
            Self·Practice,
            Self·Release,
            Self·Distribute,
        ]
    }
}

/// Mode selector properties
☉ Σ ModeSelectorProps {
    /// Current active mode
    current_mode: OrpheusMode,
    /// Mode change callback
    on_mode_change: Box<dyn Fn(OrpheusMode)>,
    /// Show mode labels
    show_labels: bool,
}

⊢ ◊ ModeSelectorProps {
    rite default() -> Self {
        Self {
            current_mode: OrpheusMode·Compose,
            on_mode_change: Box·new(|_| {}),
            show_labels: true,
        }
    }
}

/// Mode selector sidebar component
☉ Σ ModeSelector {
    props: ModeSelectorProps,
}

⊢ ModeSelector {
    /// Create a new mode selector
    ☉ rite new(props: ModeSelectorProps) -> Self! {
        Self { props }
    }

    /// Render a mode button
    rite render_mode_button(&self, mode: OrpheusMode) -> Element! {
        ≔ is_active = self.props.current_mode == mode;

        element! {
            <button
                class="mode-button"
                style={style! {
                    display: "flex",
                    flex_direction: "column",
                    align_items: "center",
                    justify_content: "center",
                    width: "100%",
                    padding: "12px 8px",
                    background: ⎇ is_active { PHTHALO.with_alpha(0.2).to_css() } ⎉ { "transparent" },
                    border: "none",
                    border_left: ⎇ is_active {
                        format!("3px solid {}", PHTHALO.to_css())
                    } ⎉ {
                        "3px solid transparent"
                    },
                    color: ⎇ is_active { PHTHALO.to_css() } ⎉ { SILVER.with_alpha(0.7).to_css() },
                    cursor: "pointer",
                    transition: "all 150ms ease",
                }}
                on_click={|_| (self.props.on_mode_change)(mode)}
                aria_current={⎇ is_active { "page" } ⎉ { "" }}
                aria_label={mode.label()}
            >
                // Icon
                <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                >
                    <path d={mode.icon_path()} />
                </svg>

                // Label
                ⎇ self.props.show_labels {
                    <span style={style! {
                        font_size: px(TEXT_XS),
                        margin_top: "4px",
                    }}>
                        {mode.label()}
                    </span>
                }
            </button>
        }
    }
}

⊢ Component ∀ ModeSelector {
    type Props = ModeSelectorProps;

    rite render(&self, ctx: &RenderContext) -> Element! {
        element! {
            <nav
                class="mode-selector"
                style={style! {
                    display: "flex",
                    flex_direction: "column",
                    width: "64px",
                    height: "100%",
                    background: ABYSS.to_css(),
                    border_right: format!("1px solid {}", SILVER.with_alpha(0.1).to_css()),
                }}
                role="navigation"
                aria_label="Mode navigation"
            >
                // Main mode buttons
                ∀ mode ∈ OrpheusMode·main_modes() {
                    {self.render_mode_button(mode)}
                }

                // Spacer
                <div style={style! { flex: 1 }} />

                // Settings at bottom
                {self.render_mode_button(OrpheusMode·Settings)}
            </nav>
        }
    }
}

// ============================================================================
// Tests
// ============================================================================

// cfg(test)
scroll tests {
    invoke super·*;

    //@ rune: test
    rite test_mode_labels() {
        assert_eq!(OrpheusMode·Compose.label(), "Compose");
        assert_eq!(OrpheusMode·Mix.label(), "Mix");
        assert_eq!(OrpheusMode·Settings.label(), "Settings");
    }

    //@ rune: test
    rite test_main_modes_count() {
        ≔ modes = OrpheusMode·main_modes();
        assert_eq!(modes.len(), 7);
        // Settings is not included in main modes
        assert!(!modes.contains(&OrpheusMode·Settings));
    }

    //@ rune: test
    rite test_icon_paths_not_empty() {
        ∀ mode ∈ OrpheusMode·main_modes() {
            assert!(!mode.icon_path().is_empty());
        }
        assert!(!OrpheusMode·Settings.icon_path().is_empty());
    }
}
