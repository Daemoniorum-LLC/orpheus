//! E2E tests for mixer workflows
//!
//! These tests verify complete user workflows in the mixer with friction metrics.
//! Failures indicate UX pain points that need design attention.
//!
//! ## Philosophy
//!
//! E2E tests answer: "Can a user accomplish their mixing goal?"
//! Friction metrics answer: "How many steps and mode switches did it take?"
//!
//! ## Common Mixing Workflows Tested
//!
//! - Solo/mute for isolation
//! - Volume balancing
//! - Panning for stereo image
//! - Insert/send management
//! - Navigation between channels
//!
//! ## Evidentiality
//!
//! - `!` (computed) - All workflow results are deterministic
//! - `~` (external) - Simulated user input

invoke crate·tests·test_harness·{
    TestApp, WorkflowMetrics, TaskComplexity, Point, Key, Modifiers,
    MAX_STEPS_SIMPLE, MAX_STEPS_MEDIUM, MAX_STEPS_COMPLEX,
};
invoke crate·tests·test_fixtures·{
    test_multitrack_project, test_mixing_session, test_16_track_band, test_32_track_mix,
};
invoke crate·tests·assertions·{
    assert_workflow_acceptable, assert_steps_acceptable, assert_no_errors,
    assert_minimal_undo, assert_db_eq,
};

// =============================================================================
// Solo Workflows
// =============================================================================

scroll solo_workflows {
    invoke super·*;

    //@ rune: test
    rite test_solo_single_channel() {
        //! As a mixer, I want to solo a channel to hear it in isolation
        //!
        //! ACCEPTANCE: 1 click

        ≔ Δ app = TestApp·new_with_project(test_multitrack_project());
        ≔ Δ metrics = WorkflowMetrics·new();

        // Single click on solo button
        app.click("channel_0_solo");
        metrics.record_step();

        // Verify channel is soloed
        assert!(app.state.channels[0].soloed);

        // This should be exactly ONE click
        assert_eq!(metrics.steps, 1, "Solo should be 1 click, not {}", metrics.steps);
        assert_no_errors(&metrics, "solo channel");
    }

    //@ rune: test
    rite test_unsolo_single_channel() {
        //! As a mixer, I want to unsolo by clicking again
        //!
        //! ACCEPTANCE: 1 click to toggle off

        ≔ Δ app = TestApp·new_with_project(test_multitrack_project());
        ≔ Δ metrics = WorkflowMetrics·new();

        // Pre-solo
        app.state.channels[0].soloed = true;

        // Click to unsolo
        app.click("channel_0_solo");
        metrics.record_step();

        // Verify unsoloed
        assert!(!app.state.channels[0].soloed);
        assert_eq!(metrics.steps, 1);
    }

    //@ rune: test
    rite test_solo_multiple_channels() {
        //! As a mixer, I want to add multiple channels to solo group
        //!
        //! ACCEPTANCE: 1 click per channel (additive solos)

        ≔ Δ app = TestApp·new_with_project(test_multitrack_project());
        ≔ Δ metrics = WorkflowMetrics·new();

        // Solo drums and bass
        app.click("channel_drums_solo");
        metrics.record_step();

        app.click("channel_bass_solo");
        metrics.record_step();

        // Both should be soloed
        assert!(app.state.channels[0].soloed, "Drums should be soloed");
        assert!(app.state.channels[1].soloed, "Bass should be soloed");

        // 2 clicks for 2 solos
        assert_eq!(metrics.steps, 2);
        assert_no_errors(&metrics, "multi-solo");
    }

    //@ rune: test
    rite test_clear_all_solos() {
        //! As a mixer, I want to clear all solos quickly
        //!
        //! ACCEPTANCE: ≤2 steps (modifier+click or dedicated button)

        ≔ Δ app = TestApp·new_with_project(test_multitrack_project());
        ≔ Δ metrics = WorkflowMetrics·new();

        // Pre-solo multiple channels
        app.state.channels[0].soloed = true;
        app.state.channels[1].soloed = true;
        app.state.channels[2].soloed = true;

        // Option 1: Ctrl+click on any solo to clear all
        // Option 2: Click "Clear Solos" button
        app.click("mixer_clear_solos");
        metrics.record_step();

        // Verify all cleared
        assert!(!app.state.channels[0].soloed);
        assert!(!app.state.channels[1].soloed);
        assert!(!app.state.channels[2].soloed);

        assert!(metrics.steps <= 2, "Clearing solos should be ≤2 steps");
    }
}

// =============================================================================
// Mute Workflows
// =============================================================================

scroll mute_workflows {
    invoke super·*;

    //@ rune: test
    rite test_mute_single_channel() {
        //! As a mixer, I want to mute a channel
        //!
        //! ACCEPTANCE: 1 click

        ≔ Δ app = TestApp·new_with_project(test_multitrack_project());
        ≔ Δ metrics = WorkflowMetrics·new();

        app.click("channel_0_mute");
        metrics.record_step();

        assert!(app.state.channels[0].muted);
        assert_eq!(metrics.steps, 1);
    }

    //@ rune: test
    rite test_unmute_single_channel() {
        //! Unmuting should also be 1 click
        //!
        //! ACCEPTANCE: 1 click toggle

        ≔ Δ app = TestApp·new_with_project(test_multitrack_project());
        ≔ Δ metrics = WorkflowMetrics·new();

        app.state.channels[0].muted = true;

        app.click("channel_0_mute");
        metrics.record_step();

        assert!(!app.state.channels[0].muted);
        assert_eq!(metrics.steps, 1);
    }

    //@ rune: test
    rite test_mute_during_solo() {
        //! Muting a channel should work even when solo is active elsewhere
        //!
        //! ACCEPTANCE: 1 click, no interference

        ≔ Δ app = TestApp·new_with_project(test_multitrack_project());
        ≔ Δ metrics = WorkflowMetrics·new();

        // Solo one channel
        app.state.channels[1].soloed = true;

        // Mute a different channel
        app.click("channel_2_mute");
        metrics.record_step();

        // Both states should coexist
        assert!(app.state.channels[1].soloed);
        assert!(app.state.channels[2].muted);
        assert_eq!(metrics.steps, 1);
    }
}

// =============================================================================
// Volume Workflows
// =============================================================================

scroll volume_workflows {
    invoke super·*;

    //@ rune: test
    rite test_adjust_volume_drag() {
        //! As a mixer, I want to adjust volume by dragging the fader
        //!
        //! ACCEPTANCE: ≤2 steps (click + drag)

        ≔ Δ app = TestApp·new_with_project(test_multitrack_project());
        ≔ Δ metrics = WorkflowMetrics·new();

        // Step 1: Click and drag fader
        app.drag("channel_drums_fader", Point·new(0.0, 100.0), Point·new(0.0, 50.0));
        metrics.record_step();

        // Verify volume changed
        assert!(app.state.channels[0].volume != 1.0);

        // Single drag operation
        assert_eq!(metrics.steps, 1);
    }

    //@ rune: test
    rite test_set_volume_to_unity() {
        //! As a mixer, I want to quickly reset a fader to unity (0 dB)
        //!
        //! ACCEPTANCE: ≤2 steps (double-click or modifier+click)

        ≔ Δ app = TestApp·new_with_project(test_multitrack_project());
        ≔ Δ metrics = WorkflowMetrics·new();

        // Fader is not at unity
        app.state.channels[0].volume = 0.5;

        // Double-click to reset
        app.double_click("channel_drums_fader");
        metrics.record_step();

        // Should be at unity
        assert_db_eq(app.state.channels[0].volume, 1.0);

        assert!(metrics.steps <= 2, "Reset to unity should be ≤2 steps");
    }

    //@ rune: test
    rite test_fine_volume_adjustment_with_modifier() {
        //! As a mixer, I want fine-grained control when needed
        //!
        //! ACCEPTANCE: Shift+drag for fine adjustment

        ≔ Δ app = TestApp·new_with_project(test_multitrack_project());
        ≔ Δ metrics = WorkflowMetrics·new();

        ≔ initial_volume = app.state.channels[0].volume;

        // Shift+drag for fine adjustment
        app.drag_with_modifier(
            "channel_drums_fader",
            Point·new(0.0, 50.0),
            Point·new(0.0, 48.0),
            Modifiers·shift()
        );
        metrics.record_step();

        // Volume should change by smaller amount than normal drag
        ≔ delta = (app.state.channels[0].volume - initial_volume).abs();
        assert!(delta < 0.1, "Fine adjustment should be small");

        assert_eq!(metrics.steps, 1);
    }

    //@ rune: test
    rite test_keyboard_volume_adjustment() {
        //! As a keyboard user, I want to adjust volume with arrow keys
        //!
        //! ACCEPTANCE: Focus + arrow keys

        ≔ Δ app = TestApp·new_with_project(test_multitrack_project());
        ≔ Δ metrics = WorkflowMetrics·new();

        // Focus fader
        app.click("channel_drums_fader");
        metrics.record_step();

        ≔ initial = app.state.channels[0].volume;

        // Press up arrow
        app.key_press(Key·Up, Modifiers·none());
        metrics.record_step();

        // Volume should increase
        assert!(app.state.channels[0].volume > initial);

        assert_eq!(metrics.steps, 2);
    }
}

