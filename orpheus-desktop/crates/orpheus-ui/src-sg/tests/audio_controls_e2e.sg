//! E2E tests for audio control workflows
//!
//! These tests verify complete user workflows with friction metrics.
//! Failures indicate UX pain points that need design attention.
//!
//! ## Philosophy
//!
//! E2E tests answer: "Can a user accomplish their goal?"
//! Friction metrics answer: "How painful was it?"
//!
//! ## Evidentiality
//!
//! - `!` (computed) - All workflow results are deterministic
//! - `~` (external) - Simulated user input

invoke crate·tests·test_harness·{
    TestApp, WorkflowMetrics, TaskComplexity, Point, Key, Modifiers,
    MAX_STEPS_SIMPLE, MAX_STEPS_MEDIUM,
};
invoke crate·tests·test_fixtures·{
    test_multitrack_project, test_recording_project, test_mixing_session,
};
invoke crate·tests·assertions·{
    assert_workflow_acceptable, assert_steps_acceptable,
    assert_no_errors, assert_minimal_undo,
};

// =============================================================================
// Volume Adjustment Workflows
// =============================================================================

scroll volume_workflows {
    invoke super·*;

    //@ rune: test
    rite test_adjust_volume_to_specific_db() {
        //! As a mixing engineer, I want to set a channel to exactly -6 dB
        //! so that I have consistent gain staging.
        //!
        //! ACCEPTANCE: ≤3 steps, no mode switches, no errors

        ≔ Δ app = TestApp·new_with_project(test_multitrack_project());
        ≔ Δ metrics = WorkflowMetrics·new();

        // Step 1: Click on fader
        app.click("channel_drums_fader");
        metrics.record_step();

        // Step 2: Drag to approximate position
        app.drag("channel_drums_fader", Point·new(0.0, 100.0), Point·new(0.0, 60.0));
        metrics.record_step();

        // Step 3: Fine-tune with keyboard (if needed)
        // In well-designed UX, coarse drag should get close enough
        // that fine-tuning is optional

        // Verify friction acceptable
        assert_steps_acceptable(&metrics, 3, "adjust volume to -6 dB");
        assert_eq!(metrics.mode_switches, 0);
        assert_no_errors(&metrics, "adjust volume");
    }

    //@ rune: test
    rite test_mute_track_single_click() {
        //! As a mixer, I want to mute a track with one click
        //!
        //! ACCEPTANCE: Exactly 1 step

        ≔ Δ app = TestApp·new_with_project(test_multitrack_project());
        ≔ Δ metrics = WorkflowMetrics·new();

        // Single click on mute button
        app.click("channel_drums_mute");
        metrics.record_step();

        // Verify channel is muted
        assert!(app.state.channels[0].muted);

        // Verify this was exactly ONE click
        assert_eq!(metrics.steps, 1, "Muting should be 1 click, not {}", metrics.steps);
    }

    //@ rune: test
    rite test_solo_track_single_click() {
        //! As a mixer, I want to solo a track with one click
        //!
        //! ACCEPTANCE: Exactly 1 step, immediate feedback

        ≔ Δ app = TestApp·new_with_project(test_multitrack_project());
        ≔ Δ metrics = WorkflowMetrics·new();

        app.click("channel_drums_solo");
        metrics.record_step();

        // Verify channel is soloed
        assert!(app.state.channels[0].soloed);

        // Verify this was exactly ONE click
        assert_eq!(metrics.steps, 1, "Soloing should be 1 click, not {}", metrics.steps);
        assert_no_errors(&metrics, "solo track");
    }

    //@ rune: test
    rite test_adjust_pan_to_center() {
        //! As a mixer, I want to center a panned track
        //!
        //! ACCEPTANCE: ≤2 steps (double-click to reset or one precise drag)

        ≔ Δ app = TestApp·new_with_project(test_mixing_session());
        ≔ Δ metrics = WorkflowMetrics·new();

        // Option 1: Double-click to reset (preferred UX)
        app.click("channel_guitar_pan");  // Could be double-click
        metrics.record_step();

        // Verify friction acceptable for simple task
        assert!(metrics.steps <= 2, "Centering pan should be ≤2 steps");
    }
}

// =============================================================================
// Metering Workflows
// =============================================================================

scroll metering_workflows {
    invoke super·*;

    //@ rune: test
    rite test_monitor_levels_during_playback() {
        //! As a recording engineer, I want to see levels update in real-time
        //! so that I can catch clipping before it's recorded.
        //!
        //! ACCEPTANCE: 1 step to start monitoring, 0 additional steps to see meters

        ≔ Δ app = TestApp·new_with_project(test_recording_project());
        ≔ Δ metrics = WorkflowMetrics·new();

        // Step 1: Start playback
        app.click("transport_play");
        metrics.record_step();

        // Verify meters are now active (no additional steps required)
        assert!(app.state.meter_animating, "Meters should animate during playback");

        // Simulate audio and verify clipping is visible
        app.simulate_audio_frame(vec![-6.0, -3.0, 0.0, 1.0]);  // Includes clipping
        assert!(app.state.clip_indicator_lit, "Clip indicator should light on clipping");

        // Peak indicator should be visible
        assert!(app.state.peak_indicator_visible, "Peak indicator should be visible");

        // This should be ZERO additional steps to see clipping
        assert_eq!(metrics.steps, 1, "Monitoring should just be pressing play");
    }

    //@ rune: test
    rite test_clip_indicator_persists_after_clipping() {
        //! As an engineer, I need to know if clipping occurred even if I wasn't watching
        //!
        //! ACCEPTANCE: Clip indicator stays lit until manually cleared

        ≔ Δ app = TestApp·new_with_project(test_recording_project());

        // Start playback
        app.click("transport_play");

        // Clip occurs
        app.simulate_audio_frame(vec![0.0, 1.5, 2.0]);
        assert!(app.state.clip_indicator_lit);

        // Audio returns to safe levels
        app.simulate_audio_frame(vec![-18.0, -18.0, -18.0]);

        // Clip indicator should STILL be lit (peak hold)
        assert!(app.state.clip_indicator_lit,
            "Clip indicator should persist after clipping event");
    }
}

// =============================================================================
// Recording Workflows
// =============================================================================

scroll recording_workflows {
    invoke super·*;

    //@ rune: test
    rite test_arm_track_for_recording() {
        //! As a recording musician, I want to arm a track and see input
        //! so that I know my instrument is connected before recording.
        //!
        //! ACCEPTANCE: 1 click arms AND enables monitoring

        ≔ Δ app = TestApp·new_with_project(test_recording_project());
        ≔ Δ metrics = WorkflowMetrics·new();

        // Ensure track is not armed initially
        app.state.channels[0].armed = false;
        app.state.channels[0].input_monitoring = false;

        // Single click to arm
        app.click("channel_guitar_arm");
        metrics.record_step();

        // Verify armed AND monitoring (should be automatic)
        assert!(app.state.channels[0].armed, "Track should be armed");
        assert!(app.state.channels[0].input_monitoring,
            "UX PAIN: Arming should auto-enable monitoring");

        // This should be ONE click
        assert_eq!(metrics.steps, 1, "Arming should be 1 click with auto-monitoring");
    }

    //@ rune: test
    rite test_quick_record_workflow() {
        //! As a musician, I want to record quickly
        //!
        //! ACCEPTANCE: ≤3 steps from armed state to recording

        ≔ Δ app = TestApp·new_with_project(test_recording_project());
        ≔ Δ metrics = WorkflowMetrics·new();

        // Track is pre-armed in this fixture
        assert!(app.state.channels[0].armed);

        // Step 1: Hit record
        app.state.recording_armed = true;  // Simulated arm state
        app.click("transport_record");
        metrics.record_step();

        // Should now be recording
        // Note: In TestApp we need recording_armed to be true

        // Friction check
        assert!(metrics.steps <= 3, "Recording should start in ≤3 steps");
        assert_eq!(metrics.mode_switches, 0, "Recording shouldn't require mode switch");
    }
}

// =============================================================================
// Keyboard Control Workflows
// =============================================================================

scroll keyboard_workflows {
    invoke super·*;

    //@ rune: test
    rite test_spacebar_toggles_playback() {
        //! As any user, I want to start/stop playback with spacebar
        //!
        //! ACCEPTANCE: Single keypress, no modifier required

        ≔ Δ app = TestApp·new_with_project(test_multitrack_project());
        ≔ Δ metrics = WorkflowMetrics·new();

        // Press space to start
        app.key_press(Key·Space, Modifiers·none());
        metrics.record_step();

        // Should be playing
        assert!(⌥ app.state.transport { crate·tests·test_harness·TransportState·Playing => true, _ => false });

        // Press space again to pause
        app.key_press(Key·Space, Modifiers·none());
        metrics.record_step();

        // Should be paused
        assert!(⌥ app.state.transport { crate·tests·test_harness·TransportState·Paused => true, _ => false });

        // 2 keypresses for toggle cycle is correct
        assert_eq!(metrics.steps, 2);
    }

    //@ rune: test
    rite test_undo_available_after_change() {
        //! As a user, I should be able to undo any change
        //!
        //! ACCEPTANCE: Ctrl+Z undoes last action

        ≔ Δ app = TestApp·new_with_project(test_multitrack_project());
        ≔ Δ metrics = WorkflowMetrics·new();

        // Make a change
        app.click("channel_drums_solo");
        metrics.record_step();
        assert!(app.state.channels[0].soloed);

        // Undo (Ctrl+Z)
        app.key_press(Key·Z, Modifiers·ctrl());
        metrics.record_undo();

        // Undo removes the action from history
        // Note: Full undo implementation would restore state
    }
}

// =============================================================================
// Mode Integration Workflows
// =============================================================================

scroll mode_workflows {
    invoke super·*;

    //@ rune: test
    rite test_switch_to_mix_mode() {
        //! As a user finishing recording, I want to switch to mix mode
        //!
        //! ACCEPTANCE: 1 click, no confirmation dialog

        ≔ Δ app = TestApp·new();
        ≔ Δ metrics = WorkflowMetrics·new();

        // Start in Compose mode (default)
        assert!(⌥ app.state.mode { crate·tests·test_harness·OrpheusMode·Compose => true, _ => false });

        // Single click to switch to Mix
        app.click("mode_mix");
        metrics.record_step();
        metrics.record_mode_switch();

        // Verify mode changed
        assert!(⌥ app.state.mode { crate·tests·test_harness·OrpheusMode·Mix => true, _ => false });

        // Should be exactly 1 step
        assert_eq!(metrics.steps, 1, "Mode switch should be 1 click");
        assert_no_errors(&metrics, "mode switch");
    }

    //@ rune: test
    rite test_mode_switch_preserves_playhead() {
        //! As a user switching modes, my position in the project should be preserved
        //!
        //! ACCEPTANCE: Playhead position unchanged after mode switch

        ≔ Δ app = TestApp·new_with_project(test_multitrack_project());

        // Set playhead to specific position
        app.seek_to(60.0);  // 1 minute
        ≔ position_before = app.playhead_seconds();

        // Switch modes
        app.click("mode_mix");
        app.click("mode_compose");

        // Verify position preserved
        ≔ position_after = app.playhead_seconds();
        assert!((position_before - position_after).abs() < 0.1,
            "Playhead should be preserved across mode switches");
    }
}

// =============================================================================
// Overall Workflow Complexity
// =============================================================================

scroll complexity_check {
    invoke super·*;

    //@ rune: test
    rite test_simple_tasks_are_actually_simple() {
        //! Verify that tasks we call "simple" actually meet the threshold
        //!
        //! Simple = ≤5 steps, ≤1 mode switch, no errors

        ≔ simple_workflows = [
            ("mute track", 1),
            ("solo track", 1),
            ("start playback", 1),
            ("stop playback", 1),
            ("adjust volume", 3),
            ("switch mode", 1),
        ];

        ∀ (name, expected_steps) ∈ simple_workflows {
            ≔ Δ metrics = WorkflowMetrics·new();
            ∀ _ ∈ 0..expected_steps {
                metrics.record_step();
            }

            assert!(metrics.is_acceptable(TaskComplexity·Simple),
                "Workflow '{}' with {} steps should be Simple-acceptable",
                name, expected_steps);
        }
    }

    //@ rune: test
    rite test_friction_thresholds_are_reasonable() {
        //! Verify our thresholds make sense

        // Simple: ≤5 steps
        assert_eq!(MAX_STEPS_SIMPLE, 5);

        // Medium: ≤10 steps
        assert_eq!(MAX_STEPS_MEDIUM, 10);

        // Simple should be subset of Medium
        ≔ Δ simple_metrics = WorkflowMetrics·new();
        ∀ _ ∈ 0..5 { simple_metrics.record_step(); }

        assert!(simple_metrics.is_acceptable(TaskComplexity·Simple));
        assert!(simple_metrics.is_acceptable(TaskComplexity·Medium));
        assert!(simple_metrics.is_acceptable(TaskComplexity·Complex));
    }
}

