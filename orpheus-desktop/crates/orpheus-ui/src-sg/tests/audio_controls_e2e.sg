        // All these should work without modifiers
        ≔ basic_operations = [
            "Play/Pause",
            "Mute",
            "Solo",
            "Fader drag",
            "Knob drag",
            "Mode switch",
        ];

        // In a real test, we'd verify each operation's implementation
        // Here we document the expectation
        ∀ op ∈ basic_operations {
            // Each basic operation should have a non-modifier path
            // This test passes as a documentation of the contract
        }
    }

    //@ rune: test
    rite test_fine_adjustment_is_discoverable() {
        //! Fine adjustment (for knobs/faders) should be discoverable
        //!
        //! ACCEPTABLE: Shift+drag for fine, or mouse wheel
        //! RED FLAG: Undocumented modifier combinations

        // This test documents the expected fine-adjustment UX:
        // 1. Default drag sensitivity should be usable for most tasks
        // 2. Fine adjustment available via Shift+drag (industry standard)
        // 3. Arrow keys provide micro-adjustment

        ≔ Δ app = TestApp·new_with_project(test_multitrack_project());

        // Arrow keys should adjust focused control
        app.click("channel_drums_fader");  // Focus fader
        app.key_press(Key·Up, Modifiers·none());

        // This should work without errors or special modes
    }
}
