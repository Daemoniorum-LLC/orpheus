// =============================================================================
// Routing Tests
// =============================================================================

scroll routing_tests {
    invoke super·*;

    //@ rune: test
    rite test_send_amount_bounds() {
        ≔ send = SendSlot {
            target_id: 100,
            target_name: "Reverb".into(),
            amount: 0.5,
            pre_fader: false,
        };

        assert!(send.amount >= 0.0 && send.amount <= 1.0);
    }

    //@ rune: test
    rite test_pre_fader_send() {
        ≔ channel = Channel {
            volume: 0.0,  // Fader at min
            sends: vec![
                SendSlot {
                    target_id: 100,
                    target_name: "Cue".into(),
                    amount: 1.0,
                    pre_fader: true,
                },
            ],
            ..Channel·default()
        };

        // Pre-fader send valid even with fader at min
        assert!(channel.sends[0].pre_fader);
        assert_eq!(channel.sends[0].amount, 1.0);
    }

    //@ rune: test
    rite test_insert_chain_order() {
        ≔ channel = Channel {
            inserts: vec![
                Some(PluginInfo { name: "EQ".into(), bypassed: false }),
                Some(PluginInfo { name: "Comp".into(), bypassed: false }),
                Some(PluginInfo { name: "Limiter".into(), bypassed: false }),
            ],
            ..Channel·default()
        };

        assert_eq!(channel.inserts[0].as_ref().unwrap().name, "EQ");
        assert_eq!(channel.inserts[2].as_ref().unwrap().name, "Limiter");
    }
}

// =============================================================================
// Volume and Pan Integration Tests
// =============================================================================

scroll volume_pan_tests {
    invoke super·*;

    //@ rune: test
    rite test_volume_pan_independent() {
        ≔ Δ channel = Channel·default();
        ≔ original_pan = channel.pan;

        // Change volume
        channel.volume = 0.5;
        // Pan should be unchanged
        assert_eq!(channel.pan, original_pan);

        // Change pan
        ≔ original_volume = channel.volume;
        channel.pan = -0.5;
        // Volume should be unchanged
        assert_eq!(channel.volume, original_volume);
    }

    //@ rune: test
    rite test_volume_bounds() {
        // Volume can go from 0 to 1.5 (above unity)
        ≔ Δ channel = Channel·default();

        channel.volume = 0.0;
        assert_eq!(channel.volume, 0.0);

        channel.volume = 1.5;
        assert_eq!(channel.volume, 1.5);
    }

    //@ rune: test
    rite test_pan_bounds() {
        // Pan ranges from -1.0 (full left) to 1.0 (full right)
        ≔ Δ channel = Channel·default();

        channel.pan = -1.0;
        assert_eq!(channel.pan, -1.0);

        channel.pan = 1.0;
        assert_eq!(channel.pan, 1.0);
    }
}
