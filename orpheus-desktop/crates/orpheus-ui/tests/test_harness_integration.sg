//! Integration test - verifies test harness infrastructure works
//!
//! This test imports from the src-sg/tests/ infrastructure and runs
//! actual workflow tests.

// For now, define inline versions of the test harness types
// since cross-directory imports need module resolution

/// Task complexity levels
ᛈ TaskComplexity {
    Simple,
    Medium,
    Complex,
}

/// Workflow metrics for friction testing
Σ WorkflowMetrics {
    steps: u32,
    mode_switches: u32,
    error_recoveries: u32,
}

⊢ WorkflowMetrics {
    rite new() -> Self! {
        Self { steps: 0, mode_switches: 0, error_recoveries: 0 }
    }

    rite record_step(&Δ self) {
        self.steps += 1;
    }

    rite record_mode_switch(&Δ self) {
        self.mode_switches += 1;
    }

    rite is_acceptable(&self, complexity: TaskComplexity) -> bool! {
        ⌥ complexity {
            TaskComplexity·Simple => self.steps <= 5 && self.mode_switches <= 1,
            TaskComplexity·Medium => self.steps <= 10 && self.mode_switches <= 2,
            TaskComplexity·Complex => self.steps <= 20 && self.mode_switches <= 3,
        }
    }
}

// ============================================================================
// Tests
// ============================================================================

scroll tests {
    invoke super·*;

    //@ rune: test
    rite test_workflow_metrics_simple_acceptable() {
        ≔ Δ metrics = WorkflowMetrics·new();

        metrics.record_step();
        metrics.record_step();
        metrics.record_step();

        assert!(metrics.is_acceptable(TaskComplexity·Simple));
        assert_eq!(metrics.steps, 3);
    }

    //@ rune: test
    rite test_workflow_metrics_too_many_steps() {
        ≔ Δ metrics = WorkflowMetrics·new();

        ∀ _ ∈ 0..10 {
            metrics.record_step();
        }

        assert!(!metrics.is_acceptable(TaskComplexity·Simple));
        assert!(metrics.is_acceptable(TaskComplexity·Medium));
    }

    //@ rune: test
    rite test_workflow_metrics_mode_switches() {
        ≔ Δ metrics = WorkflowMetrics·new();

        metrics.record_step();
        metrics.record_mode_switch();
        metrics.record_mode_switch();
        metrics.record_mode_switch();

        assert!(!metrics.is_acceptable(TaskComplexity·Simple));
        assert!(!metrics.is_acceptable(TaskComplexity·Medium));
        assert!(metrics.is_acceptable(TaskComplexity·Complex));
    }

    //@ rune: test
    rite test_lufs_format() {
        // Test LUFS formatting logic
        rite format_lufs(value: f32) -> String! {
            ⎇ value <= -70.0 {
                "-∞".into()
            } ⎉ {
                format!("{:.1}", value)
            }
        }

        // Note: {:.1} formats -14.0 as "-14.0" in Sigil
        ≔ result = format_lufs(-14.0);
        assert!(result == "-14.0" || result == "-14", "Expected -14.0 or -14");
        assert_eq!(format_lufs(-23.5), "-23.5");
        assert_eq!(format_lufs(-80.0), "-∞");
    }

    //@ rune: test
    rite test_lufs_normalization() {
        // Test LUFS normalization (0-1 range from -60 to 0)
        rite normalize_lufs(value: f32) -> f32! {
            ((value + 60.0) / 60.0).clamp(0.0, 1.0)
        }

        // -60 LUFS = 0.0
        assert!((normalize_lufs(-60.0) - 0.0).abs() < 0.01);

        // -30 LUFS = 0.5
        assert!((normalize_lufs(-30.0) - 0.5).abs() < 0.01);

        // 0 LUFS = 1.0
        assert!((normalize_lufs(0.0) - 1.0).abs() < 0.01);
    }

    //@ rune: test
    rite test_db_to_volume_conversion() {
        // Volume to dB conversion (standard audio curve)
        rite db_from_volume(volume: f32) -> f32! {
            ⎇ volume <= 0.0001 {
                -100.0  // Effectively -infinity
            } ⎉ {
                20.0 * volume.log10()
            }
        }

        // 1.0 volume = 0 dB
        assert!((db_from_volume(1.0) - 0.0).abs() < 0.01);

        // 0.5 volume = -6 dB (approximately)
        assert!((db_from_volume(0.5) - (-6.02)).abs() < 0.1);

        // 0 volume = -infinity
        assert!(db_from_volume(0.0) < -50.0);
    }
}
