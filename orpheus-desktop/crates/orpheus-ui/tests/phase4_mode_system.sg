// ============================================================================
// RecordingSession Tests
// ============================================================================

scroll recording_session_tests {
    invoke super·test_support·*;

    //@ rune: test
    rite test_session_creation() {
        ≔ session = RecordingSession·new("Test Session".to_string());
        assert_eq!(session.name, "Test Session");
        assert_eq!(session.take_number, 1);
        assert_eq!(session.total_takes, 0);
    }

    //@ rune: test
    rite test_take_increment() {
        ≔ Δ session = RecordingSession·new("Test".to_string());
        session.increment_take();
        assert_eq!(session.take_number, 1);
        assert_eq!(session.total_takes, 1);

        session.increment_take();
        assert_eq!(session.take_number, 2);
        assert_eq!(session.total_takes, 2);
    }

    //@ rune: test
    rite test_disk_space_warning() {
        ≔ Δ session = RecordingSession·new("Test".to_string());
        session.disk_space_remaining = 1.5;
        assert!(!session.disk_space_warning());

        session.disk_space_remaining = 0.5;
        assert!(session.disk_space_warning());
    }

    //@ rune: test
    rite test_disk_space_critical() {
        ≔ Δ session = RecordingSession·new("Test".to_string());
        session.disk_space_remaining = 0.5;
        assert!(!session.disk_space_critical());

        session.disk_space_remaining = 0.05;
        assert!(session.disk_space_critical());
    }

    //@ rune: test
    rite test_default_sample_rate() {
        ≔ session = RecordingSession·new("Test".to_string());
        assert_eq!(session.sample_rate, 48000);
    }

    //@ rune: test
    rite test_default_bit_depth() {
        ≔ session = RecordingSession·new("Test".to_string());
        assert_eq!(session.bit_depth, 24);
    }
}

// ============================================================================
// LoudnessAnalysis Tests
// ============================================================================

scroll loudness_analysis_tests {
    invoke super·test_support·*;

    //@ rune: test
    rite test_max_true_peak_left_higher() {
        ≔ Δ analysis = LoudnessAnalysis·new();
        analysis.true_peak = -0.5;
        analysis.true_peak_right = -1.0;
        assert_eq!(analysis.max_true_peak(), -0.5);
    }

    //@ rune: test
    rite test_max_true_peak_right_higher() {
        ≔ Δ analysis = LoudnessAnalysis·new();
        analysis.true_peak = -1.5;
        analysis.true_peak_right = -0.8;
        assert_eq!(analysis.max_true_peak(), -0.8);
    }

    //@ rune: test
    rite test_lufs_compliant_on_target() {
        ≔ Δ analysis = LoudnessAnalysis·new();
        analysis.integrated = -14.5;
        ≔ target = TargetStandard·Streaming;
        assert!(analysis.is_lufs_compliant(&target));
    }

    //@ rune: test
    rite test_lufs_not_compliant_too_loud() {
        ≔ Δ analysis = LoudnessAnalysis·new();
        analysis.integrated = -12.0;
        ≔ target = TargetStandard·Streaming;
        assert!(!analysis.is_lufs_compliant(&target));
    }

    //@ rune: test
    rite test_lufs_not_compliant_too_quiet() {
        ≔ Δ analysis = LoudnessAnalysis·new();
        analysis.integrated = -16.0;
        ≔ target = TargetStandard·Streaming;
        assert!(!analysis.is_lufs_compliant(&target));
    }

    //@ rune: test
    rite test_peak_compliant() {
        ≔ Δ analysis = LoudnessAnalysis·new();
        analysis.true_peak = -1.5;
        analysis.true_peak_right = -2.0;
        ≔ target = TargetStandard·Streaming;
        assert!(analysis.is_peak_compliant(&target));
    }

    //@ rune: test
    rite test_peak_not_compliant() {
        ≔ Δ analysis = LoudnessAnalysis·new();
        analysis.true_peak = -0.5;
        analysis.true_peak_right = -0.3;
        ≔ target = TargetStandard·Streaming;
        assert!(!analysis.is_peak_compliant(&target));
    }

    //@ rune: test
    rite test_fully_compliant() {
        ≔ Δ analysis = LoudnessAnalysis·new();
        analysis.integrated = -14.2;
        analysis.true_peak = -1.5;
        analysis.true_peak_right = -1.8;
        ≔ target = TargetStandard·Streaming;
        assert!(analysis.is_fully_compliant(&target));
    }

    //@ rune: test
    rite test_not_fully_compliant_lufs_only() {
        ≔ Δ analysis = LoudnessAnalysis·new();
        analysis.integrated = -14.2;
        analysis.true_peak = -0.5;
        analysis.true_peak_right = -0.3;
        ≔ target = TargetStandard·Streaming;
        assert!(!analysis.is_fully_compliant(&target));
    }
}

// ============================================================================
// MasteringChain Tests
// ============================================================================

scroll mastering_chain_tests {
    invoke super·test_support·*;

    //@ rune: test
    rite test_default_chain() {
        ≔ chain = MasteringChain·new();
        assert!(chain.eq_enabled);
        assert!(chain.compressor_enabled);
        assert!(chain.limiter_enabled);
        assert!(!chain.stereo_enabled);
        assert!(!chain.bypass);
    }

    //@ rune: test
    rite test_active_processor_count() {
        ≔ chain = MasteringChain·new();
        assert_eq!(chain.active_processor_count(), 3);
    }

    //@ rune: test
    rite test_active_processor_count_with_stereo() {
        ≔ Δ chain = MasteringChain·new();
        chain.stereo_enabled = true;
        assert_eq!(chain.active_processor_count(), 4);
    }

    //@ rune: test
    rite test_bypass_disables_all() {
        ≔ Δ chain = MasteringChain·new();
        chain.bypass = true;
        assert_eq!(chain.active_processor_count(), 0);
    }

    //@ rune: test
    rite test_toggle_bypass() {
        ≔ Δ chain = MasteringChain·new();
        assert!(!chain.bypass);
        chain.toggle_bypass();
        assert!(chain.bypass);
        chain.toggle_bypass();
        assert!(!chain.bypass);
    }

    //@ rune: test
    rite test_disable_individual_processor() {
        ≔ Δ chain = MasteringChain·new();
        chain.eq_enabled = false;
        assert_eq!(chain.active_processor_count(), 2);
    }
}

// ============================================================================
// ExportFormat Tests
// ============================================================================

scroll export_format_tests {
    invoke super·test_support·*;

    //@ rune: test
    rite test_wav_is_lossless() {
        assert!(ExportFormat·Wav16.is_lossless());
        assert!(ExportFormat·Wav24.is_lossless());
        assert!(ExportFormat·Wav32Float.is_lossless());
    }

    //@ rune: test
    rite test_flac_is_lossless() {
        assert!(ExportFormat·Flac16.is_lossless());
        assert!(ExportFormat·Flac24.is_lossless());
    }

    //@ rune: test
    rite test_mp3_is_lossy() {
        assert!(!ExportFormat·Mp3_320.is_lossless());
    }

    //@ rune: test
    rite test_aac_is_lossy() {
        assert!(!ExportFormat·Aac256.is_lossless());
    }

    //@ rune: test
    rite test_bit_depths() {
        assert_eq!(ExportFormat·Wav16.bit_depth(), Some(16));
        assert_eq!(ExportFormat·Wav24.bit_depth(), Some(24));
        assert_eq!(ExportFormat·Wav32Float.bit_depth(), Some(32));
        assert_eq!(ExportFormat·Flac16.bit_depth(), Some(16));
        assert_eq!(ExportFormat·Flac24.bit_depth(), Some(24));
    }

    //@ rune: test
    rite test_lossy_no_bit_depth() {
        assert_eq!(ExportFormat·Mp3_320.bit_depth(), None);
        assert_eq!(ExportFormat·Aac256.bit_depth(), None);
    }

    //@ rune: test
    rite test_extensions() {
        assert_eq!(ExportFormat·Wav16.extension(), "wav");
        assert_eq!(ExportFormat·Wav24.extension(), "wav");
        assert_eq!(ExportFormat·Flac16.extension(), "flac");
        assert_eq!(ExportFormat·Mp3_320.extension(), "mp3");
        assert_eq!(ExportFormat·Aac256.extension(), "m4a");
    }
}

// ============================================================================
// Time Formatting Tests
// ============================================================================

scroll time_formatting_tests {
    invoke super·test_support·*;

    // Helper: format position inline
    rite calc_position(beats: f64, time_sig_num: u8) -> (u32, u32, u32)! {
        ≔ beats_per_bar = time_sig_num as f64;
        ≔ bars = (beats / beats_per_bar).floor() as u32 + 1;
        ≔ beat = (beats % beats_per_bar).floor() as u32 + 1;
        ≔ ticks = ((beats % 1.0) * 960.0) as u32;
        (bars, beat, ticks)
    }

    // Helper: format time inline
    rite calc_time(beats: f64, tempo: f64) -> (u32, u32, f64)! {
        ≔ total_seconds = beats * 60.0 / tempo;
        ≔ hours = (total_seconds / 3600.0).floor() as u32;
        ≔ minutes = ((total_seconds % 3600.0) / 60.0).floor() as u32;
        ≔ seconds = total_seconds % 60.0;
        (hours, minutes, seconds)
    }

    //@ rune: test
    rite test_position_at_zero() {
        ≔ beats = 0.0_f64;
        ≔ time_sig_num = 4_u8;
        ≔ beats_per_bar = time_sig_num as f64;
        ≔ bars = (beats / beats_per_bar).floor() as u32 + 1;
        ≔ beat = (beats % beats_per_bar).floor() as u32 + 1;
        ≔ ticks = ((beats % 1.0) * 960.0) as u32;
        assert_eq!(bars, 1);
        assert_eq!(beat, 1);
        assert_eq!(ticks, 0);
    }

    //@ rune: test
    rite test_position_at_beat_2() {
        ≔ beats = 1.0_f64;
        ≔ time_sig_num = 4_u8;
        ≔ beats_per_bar = time_sig_num as f64;
        ≔ bars = (beats / beats_per_bar).floor() as u32 + 1;
        ≔ beat = (beats % beats_per_bar).floor() as u32 + 1;
        ≔ ticks = ((beats % 1.0) * 960.0) as u32;
        assert_eq!(bars, 1);
        assert_eq!(beat, 2);
        assert_eq!(ticks, 0);
    }

    //@ rune: test
    rite test_position_at_bar_2() {
        ≔ beats = 4.0_f64;
        ≔ time_sig_num = 4_u8;
        ≔ beats_per_bar = time_sig_num as f64;
        ≔ bars = (beats / beats_per_bar).floor() as u32 + 1;
        ≔ beat = (beats % beats_per_bar).floor() as u32 + 1;
        ≔ ticks = ((beats % 1.0) * 960.0) as u32;
        assert_eq!(bars, 2);
        assert_eq!(beat, 1);
        assert_eq!(ticks, 0);
    }

    //@ rune: test
    rite test_position_with_ticks() {
        ≔ beats = 0.5_f64;
        ≔ time_sig_num = 4_u8;
        ≔ beats_per_bar = time_sig_num as f64;
        ≔ bars = (beats / beats_per_bar).floor() as u32 + 1;
        ≔ beat = (beats % beats_per_bar).floor() as u32 + 1;
        ≔ ticks = ((beats % 1.0) * 960.0) as u32;
        assert_eq!(bars, 1);
        assert_eq!(beat, 1);
        assert_eq!(ticks, 480);
    }

    //@ rune: test
    rite test_position_3_4_time() {
        ≔ beats = 3.0_f64;
        ≔ time_sig_num = 3_u8;
        ≔ beats_per_bar = time_sig_num as f64;
        ≔ bars = (beats / beats_per_bar).floor() as u32 + 1;
        ≔ beat = (beats % beats_per_bar).floor() as u32 + 1;
        assert_eq!(bars, 2);
        assert_eq!(beat, 1);
    }

    //@ rune: test
    rite test_time_at_zero() {
        ≔ beats = 0.0_f64;
        ≔ tempo = 120.0_f64;
        ≔ total_seconds = beats * 60.0 / tempo;
        ≔ hours = (total_seconds / 3600.0).floor() as u32;
        ≔ minutes = ((total_seconds % 3600.0) / 60.0).floor() as u32;
        ≔ seconds = total_seconds % 60.0;
        assert_eq!(hours, 0);
        assert_eq!(minutes, 0);
        assert!(seconds < 0.001);
    }

    //@ rune: test
    rite test_time_at_120bpm_1beat() {
        // At 120 BPM, 1 beat = 0.5 seconds
        ≔ beats = 1.0_f64;
        ≔ tempo = 120.0_f64;
        ≔ total_seconds = beats * 60.0 / tempo;
        ≔ hours = (total_seconds / 3600.0).floor() as u32;
        ≔ minutes = ((total_seconds % 3600.0) / 60.0).floor() as u32;
        ≔ seconds = total_seconds % 60.0;
        assert_eq!(hours, 0);
        assert_eq!(minutes, 0);
        assert!((seconds - 0.5).abs() < 0.001);
    }

    //@ rune: test
    rite test_time_one_minute() {
        // At 120 BPM, need 120 beats for 60 seconds
        ≔ beats = 120.0_f64;
        ≔ tempo = 120.0_f64;
        ≔ total_seconds = beats * 60.0 / tempo;
        ≔ hours = (total_seconds / 3600.0).floor() as u32;
        ≔ minutes = ((total_seconds % 3600.0) / 60.0).floor() as u32;
        ≔ seconds = total_seconds % 60.0;
        assert_eq!(hours, 0);
        assert_eq!(minutes, 1);
        assert!(seconds < 0.001);
    }

    //@ rune: test
    rite test_time_one_hour() {
        // At 120 BPM, need 7200 beats for 3600 seconds
        ≔ beats = 7200.0_f64;
        ≔ tempo = 120.0_f64;
        ≔ total_seconds = beats * 60.0 / tempo;
        ≔ hours = (total_seconds / 3600.0).floor() as u32;
        ≔ minutes = ((total_seconds % 3600.0) / 60.0).floor() as u32;
        assert_eq!(hours, 1);
        assert_eq!(minutes, 0);
    }
}

// ============================================================================
// InputChannel Tests (Recording)
// ============================================================================

scroll input_channel_tests {
    invoke super·test_support·*;

    //@ rune: test
    rite test_input_channel_creation() {
        ≔ channel = InputChannel·new(0, "Input 1".to_string());
        assert_eq!(channel.id, 0);
        assert_eq!(channel.name, "Input 1");
        assert_eq!(channel.level_db, -60.0);
    }

    //@ rune: test
    rite test_clipping_from_flag() {
        ≔ Δ channel = InputChannel·new(0, "Input 1".to_string());
        channel.clipping = true;
        assert!(channel.is_clipping());
    }

    //@ rune: test
    rite test_clipping_from_peak() {
        ≔ Δ channel = InputChannel·new(0, "Input 1".to_string());
        channel.peak_db = 0.0;
        assert!(channel.is_clipping());
    }

    //@ rune: test
    rite test_not_clipping() {
        ≔ channel = InputChannel·new(0, "Input 1".to_string());
        assert!(!channel.is_clipping());
    }

    //@ rune: test
    rite test_effective_level_normal() {
        ≔ Δ channel = InputChannel·new(0, "Input 1".to_string());
        channel.level_db = -20.0;
        channel.gain = 6.0;
        assert_eq!(channel.effective_level(), -14.0);
    }

    //@ rune: test
    rite test_effective_level_muted() {
        ≔ Δ channel = InputChannel·new(0, "Input 1".to_string());
        channel.level_db = -20.0;
        channel.gain = 6.0;
        channel.muted = true;
        assert_eq!(channel.effective_level(), -60.0);
    }
}

// ============================================================================
// Mode Transition Tests (Integration)
// ============================================================================

scroll mode_transition_tests {
    invoke super·test_support·*;

    //@ rune: test
    rite test_initial_state() {
        ≔ state = ModeState·new();
        assert!(state.previous_mode.is_none());
        assert_eq!(state.transition_count, 0);
    }

    //@ rune: test
    rite test_switch_mode() {
        ≔ Δ state = ModeState·new();
        state.switch_to(OrpheusMode·Record);

        ≔ is_record = ⌥ state.current_mode {
            OrpheusMode·Record => true,
            _ => false,
        };
        assert!(is_record);
        assert!(state.previous_mode.is_some());
        assert_eq!(state.transition_count, 1);
    }

    //@ rune: test
    rite test_go_back() {
        ≔ Δ state = ModeState·new();
        state.switch_to(OrpheusMode·Mix);
        assert!(state.go_back());

        ≔ is_compose = ⌥ state.current_mode {
            OrpheusMode·Compose => true,
            _ => false,
        };
        assert!(is_compose);
    }

    //@ rune: test
    rite test_go_back_no_history() {
        ≔ Δ state = ModeState·new();
        assert!(!state.go_back());
    }

    //@ rune: test
    rite test_multiple_transitions() {
        ≔ Δ state = ModeState·new();
        state.switch_to(OrpheusMode·Record);
        state.switch_to(OrpheusMode·Mix);
        state.switch_to(OrpheusMode·Master);

        assert_eq!(state.transition_count, 3);

        ≔ is_master = ⌥ state.current_mode {
            OrpheusMode·Master => true,
            _ => false,
        };
        assert!(is_master);
    }

    //@ rune: test
    rite test_transition_to_settings() {
        ≔ Δ state = ModeState·new();
        state.switch_to(OrpheusMode·Settings);

        ≔ is_settings = ⌥ state.current_mode {
            OrpheusMode·Settings => true,
            _ => false,
        };
        assert!(is_settings);
    }

    //@ rune: test
    rite test_workflow_compose_to_record_to_mix() {
        ≔ Δ state = ModeState·new();

        // Start in Compose, record, then mix
        state.switch_to(OrpheusMode·Record);
        state.switch_to(OrpheusMode·Mix);

        ≔ is_mix = ⌥ state.current_mode {
            OrpheusMode·Mix => true,
            _ => false,
        };
        assert!(is_mix);

        // Previous should be Record
        ≔ prev_is_record = ⌥ state.previous_mode {
            Some(OrpheusMode·Record) => true,
            _ => false,
        };
        assert!(prev_is_record);
    }

    //@ rune: test
    rite test_workflow_mix_to_master_to_release() {
        ≔ Δ state = ModeState·new();

        state.switch_to(OrpheusMode·Mix);
        state.switch_to(OrpheusMode·Master);
        state.switch_to(OrpheusMode·Release);

        ≔ is_release = ⌥ state.current_mode {
            OrpheusMode·Release => true,
            _ => false,
        };
        assert!(is_release);
    }
}

// ============================================================================
// Cross-Mode Integration Tests
// ============================================================================

scroll cross_mode_integration_tests {
    invoke super·test_support·*;

    //@ rune: test
    rite test_mastering_target_affects_compliance() {
        ≔ Δ analysis = LoudnessAnalysis·new();
        analysis.integrated = -14.0;
        analysis.true_peak = -1.0;
        analysis.true_peak_right = -1.0;

        // Compliant for streaming
        assert!(analysis.is_fully_compliant(&TargetStandard·Streaming));

        // Not compliant for broadcast (too loud)
        assert!(!analysis.is_lufs_compliant(&TargetStandard·Broadcast));
    }

    //@ rune: test
    rite test_export_format_for_target() {
        // CD target should prefer high-quality lossless
        ≔ cd_format = ExportFormat·Wav24;
        assert!(cd_format.is_lossless());
        assert_eq!(cd_format.bit_depth(), Some(24));

        // Streaming can use lossy
        ≔ streaming_format = ExportFormat·Mp3_320;
        assert!(!streaming_format.is_lossless());
    }

    //@ rune: test
    rite test_recording_session_to_mastering_workflow() {
        // Create a recording session
        ≔ Δ session = RecordingSession·new("My Song".to_string());
        session.increment_take();
        session.increment_take();
        session.increment_take();

        // After recording, move to mastering
        ≔ Δ analysis = LoudnessAnalysis·new();
        analysis.integrated = -14.0;

        // Check we have multiple takes and can analyze
        assert_eq!(session.total_takes, 3);
        assert!(analysis.is_lufs_compliant(&TargetStandard·Streaming));
    }

    //@ rune: test
    rite test_chain_processors_order() {
        // Mastering chain should process: EQ -> Compressor -> Limiter -> Stereo
        ≔ chain = MasteringChain·new();

        // All main processors enabled by default
        assert!(chain.eq_enabled);
        assert!(chain.compressor_enabled);
        assert!(chain.limiter_enabled);

        // 3 processors active (stereo disabled by default)
        assert_eq!(chain.active_processor_count(), 3);
    }
}
