    // ========================================================================

    //@ rune: test
    rite test_export_wav_compressed() {
        ≔ samples = create_test_samples(440.0, 48000, 1.0, 2);
        ≔ file = NamedTempFile·new().unwrap();

        ≔ settings = ExportSettings·wav_compressed();
        ≔ exporter = Exporter·new(settings);

        ≔ result = exporter.export(&samples, file.path());
        assert!(result.is_ok(), "Compressed WAV export failed: {:?}", result);

        // Verify file was created
        ≔ compressed_size = std·fs·metadata(file.path()).unwrap().len();
        assert!(compressed_size > 0);

        // Decompress and verify WAV magic
        ≔ decompressed = decompress_audio_file(file.path()).unwrap();
        assert_eq!(&decompressed[0..4], b"RIFF", "Invalid WAV magic after decompression");
        assert_eq!(&decompressed[8..12], b"WAVE");

        println!(
            "Compressed WAV: {} bytes -> {} bytes ({:.1}% of original)",
            decompressed.len(),
            compressed_size,
            (compressed_size as f64 / decompressed.len() as f64) * 100.0
        );
    }

