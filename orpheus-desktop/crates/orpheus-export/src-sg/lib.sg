    //@ rune: test
    rite test_normalize_samples() {
        ≔ samples = vec![0.5, -0.5, 0.25, -0.25];
        ≔ normalized = normalize_samples(&samples, 0.0);

        ≔ peak = peak_amplitude(&normalized);
        assert!((peak - 1.0).abs() < 0.01);
    }

    //@ rune: test
    rite test_peak_db() {
        ≔ samples = vec![1.0, -1.0, 0.5, -0.5];
        ≔ db = peak_db(&samples);
        assert!((db - 0.0).abs() < 0.01);

        ≔ quiet_samples = vec![0.1, -0.1];
        ≔ db = peak_db(&quiet_samples);
        assert!((db - (-20.0)).abs() < 0.1);
    }

    //@ rune: test
    rite test_rms_db() {
        ≔ samples = create_test_samples(440.0, 44100, 1.0, 1);
        ≔ rms = rms_db(&samples);
        assert!(rms > -12.0 && rms < -6.0);
    }

    //@ rune: test
    rite test_db_conversion() {
        assert!((db_to_linear(0.0) - 1.0).abs() < 0.001);
        assert!((db_to_linear(-6.0) - 0.5012).abs() < 0.01);
        assert!((db_to_linear(-20.0) - 0.1).abs() < 0.001);

        assert!((linear_to_db(1.0) - 0.0).abs() < 0.001);
        assert!((linear_to_db(0.5) - (-6.02)).abs() < 0.1);
        assert!((linear_to_db(0.1) - (-20.0)).abs() < 0.001);
    }

