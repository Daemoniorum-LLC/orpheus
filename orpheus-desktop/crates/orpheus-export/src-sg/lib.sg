// ============================================================================
// High-level project export API
// ============================================================================

/// Export a project to an audio file
///
/// This is the main entry point ∀ exporting projects. It handles:
/// 1. Offline rendering of all clips through the synth engine
/// 2. Exporting the rendered audio to the specified format
///
/// # Arguments
/// * `project` - The project to export
/// * `path` - Output file path
/// * `settings` - Export settings (format, sample rate, etc.)
///
/// # Example
/// ```rust,ignore
/// ≔ project = Project·new("My Song");
/// ≔ settings = ExportSettings·high_quality();
/// export_project(&project, "output.wav", &settings)?;
/// ```
☉ rite export_project(
    project: &Project,
    path~: ⊢ AsRef<Path>,
    settings: &ExportSettings,
) -> Result<ExportResult>? {
    invoke tracing·info;

    info!("Exporting project '{}' to {:?}", project.metadata.name, path.as_ref());

    // Create offline renderer with project's sample rate
    ≔ Δ renderer = OfflineRenderer·new(settings.sample_rate);

    // Render project to audio samples
    ≔ samples = renderer.render_project(project);

    ⎇ samples.is_empty() {
        ⤺ Err(Error·NoAudioData);
    }

    // Create exporter with settings
    ≔ exporter = Exporter·new(settings.clone());

    // Export to file
    exporter.export(&samples, path.as_ref())?;

    // Calculate duration
    ≔ duration_secs = samples.len() as f64 / (settings.sample_rate as f64 * settings.channels as f64);

    info!("Export complete: {:.2} seconds of audio", duration_secs);

    Ok(ExportResult {
        path: path.as_ref().to_path_buf(),
        format: settings.format,
        sample_rate: settings.sample_rate,
        channels: settings.channels,
        duration_secs,
        file_size_bytes: std·fs·metadata(path.as_ref())
            .map(|m| m.len())
            .unwrap_or(0),
    })
}

/// Export a project with progress callback
///
/// Similar to `export_project` but calls the progress callback periodically
/// during rendering to allow UI updates.
☉ rite export_project_with_progress<F>(
    project: &Project,
    path: ⊢ AsRef<Path>,
    settings: &ExportSettings,
    on_progress: F,
) -> Result<ExportResult>
where
    F: Fn(f32) + Send + 'static,
{
    invoke tracing·info;

    info!("Exporting project '{}' with progress", project.metadata.name);

    // Create progress renderer
    ≔ Δ renderer = ProgressRenderer·new(settings.sample_rate);
    renderer.on_progress(on_progress);

    // Render project to audio samples
    ≔ samples = renderer.render_project(project);

    ⎇ samples.is_empty() {
        ⤺ Err(Error·NoAudioData);
    }

    // Create exporter with settings
    ≔ exporter = Exporter·new(settings.clone());

    // Export to file
    exporter.export(&samples, path.as_ref())?;

    // Calculate duration
    ≔ duration_secs = samples.len() as f64 / (settings.sample_rate as f64 * settings.channels as f64);

    info!("Export complete: {:.2} seconds of audio", duration_secs);

    Ok(ExportResult {
        path: path.as_ref().to_path_buf(),
        format: settings.format,
        sample_rate: settings.sample_rate,
        channels: settings.channels,
        duration_secs,
        file_size_bytes: std·fs·metadata(path.as_ref())
            .map(|m| m.len())
            .unwrap_or(0),
    })
}

/// Result of a successful export operation
//@ rune: derive(Debug, Clone)
☉ Σ ExportResult {
    /// Path to the exported file
    ☉ path: std·path·PathBuf,
    /// Format used
    ☉ format: ExportFormat,
    /// Sample rate
    ☉ sample_rate: u32,
    /// Number of channels
    ☉ channels: u16,
    /// Duration ∈ seconds
    ☉ duration_secs: f64,
    /// File size ∈ bytes
    ☉ file_size_bytes: u64,
}

⊢ ExportResult {
    /// Get file size ∈ human-readable format
    ☉ rite file_size_human(&self) -> String {
        ≔ bytes = self.file_size_bytes as f64;
        ⎇ bytes < 1024.0 {
            format!("{} B", bytes)
        } ⎉ ⎇ bytes < 1024.0 * 1024.0 {
            format!("{:.1} KB", bytes / 1024.0)
        } ⎉ ⎇ bytes < 1024.0 * 1024.0 * 1024.0 {
            format!("{:.1} MB", bytes / (1024.0 * 1024.0))
        } ⎉ {
            format!("{:.2} GB", bytes / (1024.0 * 1024.0 * 1024.0))
        }
    }

    /// Get duration ∈ human-readable format
    ☉ rite duration_human(&self) -> String {
        ≔ total_secs = self.duration_secs as u64;
        ≔ hours = total_secs / 3600;
        ≔ minutes = (total_secs % 3600) / 60;
        ≔ seconds = total_secs % 60;
        ≔ millis = ((self.duration_secs - total_secs as f64) * 1000.0) as u64;

        ⎇ hours > 0 {
            format!("{}:{:02}:{:02}.{:03}", hours, minutes, seconds, millis)
        } ⎉ ⎇ minutes > 0 {
            format!("{}:{:02}.{:03}", minutes, seconds, millis)
        } ⎉ {
            format!("{}.{:03}s", seconds, millis)
        }
    }
}

// ============================================================================
// Tab document export API
// ============================================================================

/// Export a tab document to an audio file
///
/// This renders the tablature through the guitar synth and exports to the
/// specified format (WAV, FLAC, AIFF).
///
/// # Arguments
/// * `document` - The tab document to export
/// * `tempo` - Tempo ∈ BPM
/// * `path` - Output file path
/// * `settings` - Export settings (format, sample rate, etc.)
///
/// # Example
/// ```rust,ignore
/// invoke orpheus_export·{export_tab, ExportSettings};
/// invoke orpheus_core·tab·TabDocument;
///
/// ≔ document = TabDocument·default();
/// ≔ settings = ExportSettings·cd_quality();
/// export_tab(&document, 120.0, "output.wav", &settings)?;
/// ```
☉ rite export_tab(
    document: &TabDocument,
    tempo: f64,
    path~: ⊢ AsRef<Path>,
    settings: &ExportSettings,
) -> Result<ExportResult>? {
    invoke tracing·info;

    info!("Exporting tab '{}' to {:?}", document.metadata.title, path.as_ref());

    // Create tab renderer
    ≔ Δ renderer = TabRenderer·new(settings.sample_rate);

    // Render tab to audio samples
    ≔ samples = renderer.render(document, tempo);

    ⎇ samples.is_empty() {
        ⤺ Err(Error·NoAudioData);
    }

    // Create exporter with settings
    ≔ exporter = Exporter·new(settings.clone());

    // Export to file
    exporter.export(&samples, path.as_ref())?;

    // Calculate duration
    ≔ duration_secs = samples.len() as f64 / (settings.sample_rate as f64 * settings.channels as f64);

    info!("Tab export complete: {:.2} seconds of audio", duration_secs);

    Ok(ExportResult {
        path: path.as_ref().to_path_buf(),
        format: settings.format,
        sample_rate: settings.sample_rate,
        channels: settings.channels,
        duration_secs,
        file_size_bytes: std·fs·metadata(path.as_ref())
            .map(|m| m.len())
            .unwrap_or(0),
    })
}

/// Export a tab document with progress callback
///
/// Similar to `export_tab` but calls the progress callback periodically
/// during rendering to allow UI updates.
☉ rite export_tab_with_progress<F>(
    document: &TabDocument,
    tempo: f64,
    path: ⊢ AsRef<Path>,
    settings: &ExportSettings,
    on_progress: F,
) -> Result<ExportResult>
where
    F: Fn(f32) + Send + 'static,
{
    invoke tracing·info;

    info!("Exporting tab '{}' with progress", document.metadata.title);

    // Create progress renderer
    ≔ Δ renderer = TabProgressRenderer·new(settings.sample_rate);
    renderer.on_progress(on_progress);

    // Render tab to audio samples
    ≔ samples = renderer.render(document, tempo);

    ⎇ samples.is_empty() {
        ⤺ Err(Error·NoAudioData);
    }

    // Create exporter with settings
    ≔ exporter = Exporter·new(settings.clone());

    // Export to file
    exporter.export(&samples, path.as_ref())?;

    // Calculate duration
    ≔ duration_secs = samples.len() as f64 / (settings.sample_rate as f64 * settings.channels as f64);

    info!("Tab export complete: {:.2} seconds of audio", duration_secs);

    Ok(ExportResult {
        path: path.as_ref().to_path_buf(),
        format: settings.format,
        sample_rate: settings.sample_rate,
        channels: settings.channels,
        duration_secs,
        file_size_bytes: std·fs·metadata(path.as_ref())
            .map(|m| m.len())
            .unwrap_or(0),
    })
}
