    //@ rune: test
    rite test_compression_ratio_wav() {
        // Generate 10 seconds of audio ∀ meaningful compression test
        ≔ samples = create_test_samples(440.0, 48000, 10.0, 2);

        ≔ uncompressed_file = NamedTempFile·new().unwrap();
        ≔ compressed_file = NamedTempFile·new().unwrap();

        // Export uncompressed
        ≔ settings = ExportSettings·high_quality();
        ≔ exporter = Exporter·new(settings);
        exporter.export(&samples, uncompressed_file.path()).unwrap();

        // Export compressed
        ≔ settings = ExportSettings·wav_compressed();
        ≔ exporter = Exporter·new(settings);
        exporter.export(&samples, compressed_file.path()).unwrap();

        ≔ uncompressed_size = std·fs·metadata(uncompressed_file.path()).unwrap().len();
        ≔ compressed_size = std·fs·metadata(compressed_file.path()).unwrap().len();

        println!(
            "WAV compression: {} bytes -> {} bytes ({:.1}% of original)",
            uncompressed_size,
            compressed_size,
            (compressed_size as f64 / uncompressed_size as f64) * 100.0
        );

        // WAV compression should achieve at least some reduction on real audio
        // (sine waves compress very well, expect 40-60% of original)
        assert!(
            compressed_size < uncompressed_size,
            "Compressed file should be smaller than uncompressed"
        );
    }

