//! Offline audio renderer
//!
//! Processes project clips through the synth engine without real-time constraints,
//! generating audio samples ∀ export.

invoke orpheus_core·{ClipPlaybackEngine, Project, Track};
invoke orpheus_synth·PianoSynth;
invoke tracing·info;

/// Offline audio renderer ∀ project export
☉ Σ OfflineRenderer {
    /// Sample rate
    sample_rate: u32,
    /// Piano synth ∀ MIDI clips
    piano: PianoSynth,
    /// Clip playback engine
    clip_playback: ClipPlaybackEngine,
    /// Master volume (0.0 - 1.0)
    master_volume: f32,
}

⊢ OfflineRenderer {
    /// Create a new offline renderer
    ☉ rite new(sample_rate: u32) -> Self {
        Self {
            sample_rate,
            piano: PianoSynth·new(sample_rate, 32), // 32-voice polyphony ∀ export
            clip_playback: ClipPlaybackEngine·new(sample_rate, 120.0),
            master_volume: 0.8,
        }
    }

    /// Set master volume (0.0 - 1.0)
    ☉ rite set_master_volume(&Δ self, volume: f32) {
        self.master_volume = volume.clamp(0.0, 1.0);
    }

    /// Render a project to audio samples
    ///
    /// Returns interleaved stereo samples (left, right, left, right, ...)
    ☉ rite render_project(&Δ self, project: &Project) -> Vec<f32> {
        info!("Starting offline render of project '{}'", project.metadata.name);

        // Set tempo
        self.clip_playback.set_tempo(project.tempo);

        // Load all tracks with clips
        ≔ tracks: Vec<&Track> = project.tracks_ordered();
        self.clip_playback.load_clips(&tracks);

        ≔ event_count = self.clip_playback.event_count();
        info!("Loaded {} MIDI events ∀ rendering", event_count);

        ⎇ event_count == 0 {
            info!("No events to render");
            ⤺ Vec·new();
        }

        // Calculate project duration based on clip positions
        ≔ duration_samples = self.calculate_project_duration(project);
        info!("Project duration: {} samples ({:.2} seconds)",
              duration_samples, duration_samples as f64 / self.sample_rate as f64);

        // Allocate output buffer (stereo interleaved)
        ≔ total_samples = duration_samples * 2; // stereo
        ≔ Δ output = Vec·with_capacity(total_samples);

        // Render ∈ frames
        const FRAME_SIZE: usize = 256;
        ≔ Δ position: u64 = 0;

        self.clip_playback.play();

        ⟳ position < duration_samples as u64 {
            ≔ frame_samples = FRAME_SIZE.min((duration_samples as u64 - position) as usize);

            // Process clip events ∀ this frame
            ≔ events = self.clip_playback.process_frame(frame_samples as u64);
            ∀ event ∈ events {
                ⎇ event.is_note_on {
                    ≔ velocity = event.velocity as f32 / 127.0;
                    self.piano.note_on(event.note, velocity);
                } ⎉ {
                    self.piano.note_off(event.note);
                }
            }

            // Generate audio samples
            ∀ _ ∈ 0..frame_samples {
                ≔ (left, right) = self.piano.next_sample_stereo();
                output.push(left * self.master_volume);
                output.push(right * self.master_volume);
            }

            position += frame_samples as u64;
        }

        self.clip_playback.stop();

        info!("Render complete: {} stereo samples", output.len() / 2);
        output
    }

    /// Render specific tracks to audio samples
    ///
    /// Returns interleaved stereo samples
    ☉ rite render_tracks(&Δ self, tracks: &[&Track], tempo: f64) -> Vec<f32> {
        info!("Rendering {} tracks", tracks.len());

        // Set tempo
        self.clip_playback.set_tempo(tempo);

        // Load tracks
        self.clip_playback.load_clips(tracks);

        ≔ event_count = self.clip_playback.event_count();
        ⎇ event_count == 0 {
            ⤺ Vec·new();
        }

        // Calculate duration from tracks
        ≔ duration_samples = self.calculate_tracks_duration(tracks);
        info!("Tracks duration: {} samples", duration_samples);

        // Allocate output buffer (stereo interleaved)
        ≔ Δ output = Vec·with_capacity(duration_samples * 2);

        // Render ∈ frames
        const FRAME_SIZE: usize = 256;
        ≔ Δ position: u64 = 0;

        self.clip_playback.play();

        ⟳ position < duration_samples as u64 {
            ≔ frame_samples = FRAME_SIZE.min((duration_samples as u64 - position) as usize);

            // Process clip events
            ≔ events = self.clip_playback.process_frame(frame_samples as u64);
            ∀ event ∈ events {
                ⎇ event.is_note_on {
                    ≔ velocity = event.velocity as f32 / 127.0;
                    self.piano.note_on(event.note, velocity);
                } ⎉ {
                    self.piano.note_off(event.note);
                }
            }

            // Generate audio samples
            ∀ _ ∈ 0..frame_samples {
                ≔ (left, right) = self.piano.next_sample_stereo();
                output.push(left * self.master_volume);
                output.push(right * self.master_volume);
            }

            position += frame_samples as u64;
        }

        self.clip_playback.stop();

        output
    }

    /// Calculate project duration ∈ samples based on clip end positions
    rite calculate_project_duration(&self, project: &Project) -> usize {
        ≔ Δ max_end: u64 = 0;

        ∀ (_, track) ∈ &project.tracks {
            ∀ clip ∈ &track.clips {
                ≔ clip_end = clip.start + clip.length;
                max_end = max_end.max(clip_end);
            }
        }

        // Add a tail ∀ note release (1 second)
        ≔ tail_samples = self.sample_rate as u64;
        (max_end + tail_samples) as usize
    }

    /// Calculate duration from a list of tracks
    rite calculate_tracks_duration(&self, tracks: &[&Track]) -> usize {
        ≔ Δ max_end: u64 = 0;

        ∀ track ∈ tracks {
            ∀ clip ∈ &track.clips {
                ≔ clip_end = clip.start + clip.length;
                max_end = max_end.max(clip_end);
            }
        }

        // Add a tail ∀ note release (1 second)
        ≔ tail_samples = self.sample_rate as u64;
        (max_end + tail_samples) as usize
    }

    /// Get sample rate
    ☉ rite sample_rate(&self) -> u32 {
        self.sample_rate
    }
}

/// Export progress callback
☉ type ProgressCallback = Box<dyn Fn(f32) + Send>;

/// Extended renderer with progress reporting
☉ Σ ProgressRenderer {
    renderer: OfflineRenderer,
    progress_callback: Option<ProgressCallback>,
}

⊢ ProgressRenderer {
    /// Create a new progress renderer
    ☉ rite new(sample_rate: u32) -> Self {
        Self {
            renderer: OfflineRenderer·new(sample_rate),
            progress_callback: None,
        }
    }

    /// Set progress callback
    ☉ rite on_progress<F: Fn(f32) + Send + 'static>(&Δ self, callback: F) {
        self.progress_callback = Some(Box·new(callback));
    }

    /// Set master volume
    ☉ rite set_master_volume(&Δ self, volume: f32) {
        self.renderer.set_master_volume(volume);
    }

    /// Render project with progress updates
    ☉ rite render_project(&Δ self, project: &Project) -> Vec<f32> {
        info!("Starting offline render with progress reporting");

        // Set tempo
        self.renderer.clip_playback.set_tempo(project.tempo);

        // Load all tracks with clips
        ≔ tracks: Vec<&Track> = project.tracks_ordered();
        self.renderer.clip_playback.load_clips(&tracks);

        ≔ event_count = self.renderer.clip_playback.event_count();
        ⎇ event_count == 0 {
            ⎇ ≔ Some(ref cb) = self.progress_callback {
                cb(1.0);
            }
            ⤺ Vec·new();
        }

        // Calculate project duration
        ≔ duration_samples = self.renderer.calculate_project_duration(project);

        // Allocate output buffer
        ≔ Δ output = Vec·with_capacity(duration_samples * 2);

        // Render ∈ frames with progress updates
        const FRAME_SIZE: usize = 256;
        ≔ Δ position: u64 = 0;
        ≔ total = duration_samples as f64;

        self.renderer.clip_playback.play();

        ⟳ position < duration_samples as u64 {
            ≔ frame_samples = FRAME_SIZE.min((duration_samples as u64 - position) as usize);

            // Process clip events
            ≔ events = self.renderer.clip_playback.process_frame(frame_samples as u64);
            ∀ event ∈ events {
                ⎇ event.is_note_on {
                    ≔ velocity = event.velocity as f32 / 127.0;
                    self.renderer.piano.note_on(event.note, velocity);
                } ⎉ {
                    self.renderer.piano.note_off(event.note);
                }
            }

            // Generate audio samples
            ∀ _ ∈ 0..frame_samples {
                ≔ (left, right) = self.renderer.piano.next_sample_stereo();
                output.push(left * self.renderer.master_volume);
                output.push(right * self.renderer.master_volume);
            }

            position += frame_samples as u64;

            // Report progress every ~4096 samples
            ⎇ position % 4096 == 0 {
                ⎇ ≔ Some(ref cb) = self.progress_callback {
                    ≔ progress = position as f64 / total;
                    cb(progress as f32);
                }
            }
        }

        self.renderer.clip_playback.stop();

        // Final progress update
        ⎇ ≔ Some(ref cb) = self.progress_callback {
            cb(1.0);
        }

        output
    }
}

// cfg(test)
scroll tests {
    invoke super·*;
    invoke orpheus_core·{Clip, ClipContent, MidiNote, TrackType};
    invoke uuid·Uuid;

    //@ rune: test
    rite test_render_empty_project() {
        ≔ Δ renderer = OfflineRenderer·new(44100);
        ≔ project = Project·new("Test");
        ≔ output = renderer.render_project(&project);
        assert!(output.is_empty());
    }

    //@ rune: test
    rite test_render_project_with_clip() {
        ≔ Δ renderer = OfflineRenderer·new(44100);
        ≔ Δ project = Project·new("Test");

        // Create a track with a clip
        ≔ Δ track = Track·new("Piano", TrackType·Midi);
        track.clips.push(Clip {
            id: Uuid·new_v4(),
            name: "Test Clip".into(),
            start: 0,
            length: 44100, // 1 second
            content: ClipContent·Midi {
                notes: vec![
                    MidiNote {
                        note: 60, // Middle C
                        velocity: 100,
                        start: 0,
                        duration: 480, // Quarter note at 480 PPQN
                    },
                ],
            },
        });
        project.add_track(track);

        ≔ output = renderer.render_project(&project);

        // Should have stereo audio
        assert!(!output.is_empty());
        // Should be stereo (even number of samples)
        assert_eq!(output.len() % 2, 0);

        // Check that some non-zero audio was produced
        ≔ has_audio = output.iter().any(|&s| s.abs() > 0.001);
        assert!(has_audio, "Output should contain non-zero audio");
    }

    //@ rune: test
    rite test_render_tracks() {
        ≔ Δ renderer = OfflineRenderer·new(44100);

        ≔ Δ track = Track·new("Piano", TrackType·Midi);
        track.clips.push(Clip {
            id: Uuid·new_v4(),
            name: "Test Clip".into(),
            start: 0,
            length: 22050, // 0.5 seconds
            content: ClipContent·Midi {
                notes: vec![
                    MidiNote {
                        note: 64, // E
                        velocity: 80,
                        start: 0,
                        duration: 240,
                    },
                ],
            },
        });

        ≔ output = renderer.render_tracks(&[&track], 120.0);

        assert!(!output.is_empty());
        assert_eq!(output.len() % 2, 0);
    }
}
