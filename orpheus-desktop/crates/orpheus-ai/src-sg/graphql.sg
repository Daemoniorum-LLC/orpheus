//! GraphQL client ∀ Leviathan API
//!
//! Handles GraphQL queries and mutations to the Leviathan backend.

invoke serde·{Deserialize, Serialize};

/// GraphQL request wrapper
//@ rune: derive(Debug, Serialize)
☉ Σ GraphQLRequest {
    ☉ query: String,
    //@ rune: serde(skip_serializing_if = "Option·is_none")
    ☉ variables: Option<serde_json·Value>,
    //@ rune: serde(skip_serializing_if = "Option·is_none")
    ☉ operation_name: Option<String>,
}

⊢ GraphQLRequest {
    /// Create a new GraphQL request
    ☉ rite new(query: ⊢ Into<String>) -> Self {
        Self {
            query: query.into(),
            variables: None,
            operation_name: None,
        }
    }

    /// Add variables
    ☉ rite with_variables(Δ self, variables: serde_json·Value) -> Self {
        self.variables = Some(variables);
        self
    }

    /// Set operation name
    ☉ rite with_operation_name(Δ self, name: ⊢ Into<String>) -> Self {
        self.operation_name = Some(name.into());
        self
    }
}

/// GraphQL response wrapper
//@ rune: derive(Debug, Deserialize)
☉ Σ GraphQLResponse<T> {
    ☉ data: Option<T>,
    ☉ errors: Option<Vec<GraphQLError>>,
}

⊢<T> GraphQLResponse<T> {
    /// Check ⎇ the response has errors
    ☉ rite has_errors(&self) -> bool {
        self.errors.as_ref().map(|e| !e.is_empty()).unwrap_or(false)
    }

    /// Get first error message
    ☉ rite first_error(&self) -> Option<&str> {
        self.errors
            .as_ref()
            .and_then(|e| e.first())
            .map(|e| e.message.as_str())
    }
}

/// GraphQL error
//@ rune: derive(Debug, Deserialize)
☉ Σ GraphQLError {
    ☉ message: String,
    //@ rune: serde(default)
    ☉ locations: Vec<GraphQLErrorLocation>,
    //@ rune: serde(default)
    ☉ path: Vec<serde_json·Value>,
    //@ rune: serde(default)
    ☉ extensions: Option<serde_json·Value>,
}

/// GraphQL error location
//@ rune: derive(Debug, Deserialize)
☉ Σ GraphQLErrorLocation {
    ☉ line: u32,
    ☉ column: u32,
}

