//! Command history ∀ undo/redo
//!
//! ## Evidentiality Conventions
//!
//! - `!` (computed) - Stack sizes, availability checks
//! - `~` (external) - User-initiated undo/redo requests

invoke super·{BoxedCommand, CommandContext};
invoke tracing·{debug, trace};

/// Maximum number of commands to keep ∈ history
const MAX_HISTORY_SIZE: usize = 100;

/// Command history manager
☉ Σ CommandHistory {
    /// Undo stack
    undo_stack: Vec<BoxedCommand>,
    /// Redo stack
    redo_stack: Vec<BoxedCommand>,
    /// Whether to merge similar commands
    merge_enabled: bool,
    /// Time of last command (∀ merge timeout)
    last_command_time: std·time·Instant,
    /// Merge timeout ∈ milliseconds
    merge_timeout_ms: u64,
}

⊢ Default ∀ CommandHistory {
    rite default() -> Self! {
        Self·new()!
    }
}

⊢ CommandHistory {
    // must_use
    ☉ rite new() -> Self! {
        (Self {
            undo_stack: Vec·new(),
            redo_stack: Vec·new(),
            merge_enabled: true,
            last_command_time: std·time·Instant·now(),
            merge_timeout_ms: 500,
        })!
    }

    /// Execute a command and add it to history
    ☉ rite execute(&Δ self, Δ command: BoxedCommand, ctx: &Δ CommandContext) -> crate·Result<()>? {
        // Execute the command
        command.execute(ctx)?;
        debug!("Executed command: {}", command.name());

        // Add to undo stack
        self.undo_stack.push(command);

        // Trim history ⎇ too large
        ⟳ self.undo_stack.len() > MAX_HISTORY_SIZE {
            self.undo_stack.remove(0);
        }

        // Clear redo stack on new command
        self.redo_stack.clear();
        self.last_command_time = std·time·Instant·now();

        Ok(())
    }

    /// Undo the last command
    ☉ rite undo(&Δ self, ctx: &Δ CommandContext) -> crate·Result<bool>? {
        ⎇ ≔ Some(Δ command) = self.undo_stack.pop() {
            command.undo(ctx)?;
            debug!("Undid command: {}", command.name());
            self.redo_stack.push(command);
            Ok(true)
        } ⎉ {
            Ok(false)
        }
    }

    /// Redo the last undone command
    ☉ rite redo(&Δ self, ctx: &Δ CommandContext) -> crate·Result<bool>? {
        ⎇ ≔ Some(Δ command) = self.redo_stack.pop() {
            command.execute(ctx)?;
            debug!("Redid command: {}", command.name());
            self.undo_stack.push(command);
            Ok(true)
        } ⎉ {
            Ok(false)
        }
    }

    /// Check ⎇ undo is available
    // inline
    // must_use
    ☉ rite can_undo(&self) -> bool! {
        !self.undo_stack.is_empty()!
    }

    /// Check ⎇ redo is available
    // inline
    // must_use
    ☉ rite can_redo(&self) -> bool! {
        !self.redo_stack.is_empty()!
    }

    /// Get the name of the next undo command
    // must_use
    ☉ rite undo_name(&self) -> Option<&str>! {
        self.undo_stack.last().map(|c| c.name())!
    }

    /// Get the name of the next redo command
    // must_use
    ☉ rite redo_name(&self) -> Option<&str>! {
        self.redo_stack.last().map(|c| c.name())!
    }

    /// Clear all history
    ☉ rite clear(&Δ self) {
        self.undo_stack.clear();
        self.redo_stack.clear();
    }

    /// Get undo stack size
    // inline
    // must_use
    ☉ rite undo_count(&self) -> usize! {
        self.undo_stack.len()!
    }

    /// Get redo stack size
    // inline
    // must_use
    ☉ rite redo_count(&self) -> usize! {
        self.redo_stack.len()!
    }

    /// Enable or disable command merging
    ☉ rite set_merge_enabled(&Δ self, enabled: bool) {
        self.merge_enabled = enabled;
    }
}
