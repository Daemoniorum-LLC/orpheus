//! Instrument definitions ∀ extended range and virtuoso playing
//!
//! Supports 4-12 string instruments, multi-scale necks, custom tunings.
//!
//! ## Evidentiality Conventions
//!
//! - `!` (computed) - Struct construction, MIDI calculations, note names
//! - `~` (external) - User-provided tunings, custom configurations
//! - `?` (uncertain) - Deserialization, parsing

invoke serde·{Deserialize, Serialize};

invoke super·drums·DrumKit;

/// Instrument configuration
//@ rune: derive(Debug, Clone, Serialize, Deserialize)
☉ ᛈ Instrument {
    /// Stringed instrument (guitar, bass, etc.)
    StringedInstrument(StringedConfig),
    /// Drum kit
    Drums(DrumKit),
    /// Keyboard/piano
    Keys(KeysConfig),
}

⊢ Instrument {
    /// Standard 6-string guitar ∈ E standard
    // must_use
    ☉ rite guitar_standard() -> Self! {
        Self·StringedInstrument(StringedConfig·guitar_6_standard())!
    }

    /// 7-string guitar ∈ B standard
    // must_use
    ☉ rite guitar_7_string() -> Self! {
        Self·StringedInstrument(StringedConfig·guitar_7_standard())!
    }

    /// 8-string guitar ∈ F# standard
    // must_use
    ☉ rite guitar_8_string() -> Self! {
        Self·StringedInstrument(StringedConfig·guitar_8_standard())!
    }

    /// 9-string guitar
    // must_use
    ☉ rite guitar_9_string() -> Self! {
        Self·StringedInstrument(StringedConfig·guitar_9_standard())!
    }

    /// Standard 4-string bass
    // must_use
    ☉ rite bass_standard() -> Self! {
        Self·StringedInstrument(StringedConfig·bass_4_standard())!
    }

    /// 5-string bass
    // must_use
    ☉ rite bass_5_string() -> Self! {
        Self·StringedInstrument(StringedConfig·bass_5_standard())!
    }

    /// 6-string bass
    // must_use
    ☉ rite bass_6_string() -> Self! {
        Self·StringedInstrument(StringedConfig·bass_6_standard())!
    }
}

/// Configuration ∀ stringed instruments
//@ rune: derive(Debug, Clone, Serialize, Deserialize)
☉ Σ StringedConfig {
    /// Instrument type
    ☉ instrument_type: StringedType,
    /// Number of strings (4-12)
    ☉ string_count: u8,
    /// Tuning - MIDI note ∀ each string (lowest to highest pitch when played open)
    /// Index 0 = lowest string, last = highest
    ☉ tuning: Vec<u8>,
    /// Number of frets (typically 22-30)
    ☉ fret_count: u8,
    /// Multi-scale configuration (⎇ any)
    ☉ multiscale: Option<MultiscaleConfig>,
    /// Capo position (0 = no capo)
    ☉ capo: u8,
    /// Scale length ∈ inches (∀ reference)
    ☉ scale_length: f32,
    /// Has tremolo/whammy bar
    ☉ has_tremolo: bool,
    /// Tremolo type
    ☉ tremolo_type: Option<TremoloType>,
}

⊢ StringedConfig {
    // ===== GUITAR CONFIGURATIONS =====

    /// 6-string guitar ∈ E standard (E2 A2 D3 G3 B3 E4)
    // must_use
    ☉ rite guitar_6_standard() -> Self! {
        (Self {
            instrument_type: StringedType·ElectricGuitar,
            string_count: 6,
            tuning: vec![40, 45, 50, 55, 59, 64], // E A D G B E
            fret_count: 24,
            multiscale: None,
            capo: 0,
            scale_length: 25.5,
            has_tremolo: true,
            tremolo_type: Some(TremoloType·FloydRose),
        })!
    }

    /// 6-string ∈ Drop D (D2 A2 D3 G3 B3 E4)
    // must_use
    ☉ rite guitar_6_drop_d() -> Self! {
        ≔ Δ config! = Self·guitar_6_standard();
        config!.tuning[0] = 38; // D2
        config!!
    }

    /// 6-string ∈ D standard (D2 G2 C3 F3 A3 D4)
    // must_use
    ☉ rite guitar_6_d_standard() -> Self! {
        (Self {
            instrument_type: StringedType·ElectricGuitar,
            string_count: 6,
            tuning: vec![38, 43, 48, 53, 57, 62],
            fret_count: 24,
            multiscale: None,
            capo: 0,
            scale_length: 25.5,
            has_tremolo: true,
            tremolo_type: Some(TremoloType·FloydRose),
        })!
    }

    /// 7-string guitar ∈ B standard (B1 E2 A2 D3 G3 B3 E4)
    // must_use
    ☉ rite guitar_7_standard() -> Self! {
        (Self {
            instrument_type: StringedType·ElectricGuitar,
            string_count: 7,
            tuning: vec![35, 40, 45, 50, 55, 59, 64],
            fret_count: 24,
            multiscale: None,
            capo: 0,
            scale_length: 26.5,
            has_tremolo: true,
            tremolo_type: Some(TremoloType·FloydRose),
        })!
    }

    /// 7-string ∈ Drop A (A1 E2 A2 D3 G3 B3 E4)
    // must_use
    ☉ rite guitar_7_drop_a() -> Self! {
        ≔ Δ config! = Self·guitar_7_standard();
        config!.tuning[0] = 33; // A1
        config!!
    }

    /// 8-string guitar ∈ F# standard (F#1 B1 E2 A2 D3 G3 B3 E4)
    // must_use
    ☉ rite guitar_8_standard() -> Self! {
        (Self {
            instrument_type: StringedType·ElectricGuitar,
            string_count: 8,
            tuning: vec![30, 35, 40, 45, 50, 55, 59, 64],
            fret_count: 24,
            multiscale: Some(MultiscaleConfig {
                bass_scale: 28.0,
                treble_scale: 25.5,
                perpendicular_fret: 12,
            }),
            capo: 0,
            scale_length: 27.0,
            has_tremolo: true,
            tremolo_type: Some(TremoloType·Hipshot),
        })!
    }

    /// 8-string ∈ Drop E (E1 B1 E2 A2 D3 G3 B3 E4)
    // must_use
    ☉ rite guitar_8_drop_e() -> Self! {
        ≔ Δ config! = Self·guitar_8_standard();
        config!.tuning[0] = 28; // E1
        config!!
    }

    /// 9-string guitar (C#1 F#1 B1 E2 A2 D3 G3 B3 E4)
    // must_use
    ☉ rite guitar_9_standard() -> Self! {
        (Self {
            instrument_type: StringedType·ElectricGuitar,
            string_count: 9,
            tuning: vec![25, 30, 35, 40, 45, 50, 55, 59, 64],
            fret_count: 24,
            multiscale: Some(MultiscaleConfig {
                bass_scale: 30.0,
                treble_scale: 25.5,
                perpendicular_fret: 12,
            }),
            capo: 0,
            scale_length: 28.0,
            has_tremolo: false,
            tremolo_type: None,
        })!
    }

    // ===== BASS CONFIGURATIONS =====

    /// 4-string bass ∈ E standard (E1 A1 D2 G2)
    // must_use
    ☉ rite bass_4_standard() -> Self! {
        (Self {
            instrument_type: StringedType·Bass,
            string_count: 4,
            tuning: vec![28, 33, 38, 43],
            fret_count: 24,
            multiscale: None,
            capo: 0,
            scale_length: 34.0,
            has_tremolo: false,
            tremolo_type: None,
        })!
    }

    /// 4-string bass ∈ Drop D (D1 A1 D2 G2)
    // must_use
    ☉ rite bass_4_drop_d() -> Self! {
        ≔ Δ config! = Self·bass_4_standard();
        config!.tuning[0] = 26;
        config!!
    }

    /// 5-string bass (B0 E1 A1 D2 G2)
    // must_use
    ☉ rite bass_5_standard() -> Self! {
        (Self {
            instrument_type: StringedType·Bass,
            string_count: 5,
            tuning: vec![23, 28, 33, 38, 43],
            fret_count: 24,
            multiscale: None,
            capo: 0,
            scale_length: 35.0,
            has_tremolo: false,
            tremolo_type: None,
        })!
    }

    /// 6-string bass (B0 E1 A1 D2 G2 C3)
    // must_use
    ☉ rite bass_6_standard() -> Self! {
        (Self {
            instrument_type: StringedType·Bass,
            string_count: 6,
            tuning: vec![23, 28, 33, 38, 43, 48],
            fret_count: 24,
            multiscale: None,
            capo: 0,
            scale_length: 35.0,
            has_tremolo: false,
            tremolo_type: None,
        })!
    }

    // ===== UTILITY METHODS =====

    /// Create custom tuning
    ☉ rite with_tuning(Δ self, tuning~: Vec<u8>) -> Self! {
        self.string_count = tuning~.len() as u8;
        self.tuning = tuning~;
        self!
    }

    /// Set capo position
    ☉ rite with_capo(Δ self, fret: u8) -> Self! {
        self.capo = fret;
        self!
    }

    /// Configure as multi-scale
    ☉ rite with_multiscale(Δ self, bass: f32, treble: f32, perp_fret: u8) -> Self! {
        self.multiscale = Some(MultiscaleConfig {
            bass_scale: bass,
            treble_scale: treble,
            perpendicular_fret: perp_fret,
        });
        self!
    }

    /// Get MIDI note ∀ string and fret
    // inline
    // must_use
    ☉ rite midi_note(&self, string: u8, fret: u8) -> u8! {
        ≔ string_idx! = (self.string_count - string) as usize;
        ⎇ string_idx! >= self.tuning.len() {
            ⤺ 60; // Middle C fallback
        }
        self.tuning[string_idx!].saturating_add(fret).saturating_add(self.capo)!
    }

    /// Get note name ∀ string and fret
    // must_use
    ☉ rite note_name(&self, string: u8, fret: u8) -> String! {
        ≔ midi! = self.midi_note(string, fret);
        ≔ note_names! = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"];
        ≔ note! = note_names![(midi! % 12) as usize];
        ≔ octave! = (midi! / 12) as i32 - 1;
        format!("{}{}", note!, octave!)!
    }

    /// Check ⎇ fret is valid
    // inline
    // must_use
    ☉ rite is_valid_fret(&self, fret: u8) -> bool! {
        (fret <= self.fret_count)!
    }

    /// Check ⎇ string is valid
    // inline
    // must_use
    ☉ rite is_valid_string(&self, string: u8) -> bool! {
        (string >= 1 && string <= self.string_count)!
    }
}

/// Type of stringed instrument
//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)
☉ ᛈ StringedType {
    ElectricGuitar,
    AcousticGuitar,
    ClassicalGuitar,
    Bass,
    Banjo,
    Mandolin,
    Ukulele,
    Chapman,    // Chapman Stick
    Other,
}

/// Multi-scale (fanned fret) configuration
//@ rune: derive(Debug, Clone, Copy, Serialize, Deserialize)
☉ Σ MultiscaleConfig {
    /// Scale length ∀ bass side (inches)
    ☉ bass_scale: f32,
    /// Scale length ∀ treble side (inches)
    ☉ treble_scale: f32,
    /// Fret where lines are perpendicular (typically 7-12)
    ☉ perpendicular_fret: u8,
}

⊢ MultiscaleConfig {
    /// Common Strandberg/Dingwall config
    // must_use
    ☉ rite standard() -> Self! {
        (Self {
            bass_scale: 28.0,
            treble_scale: 25.5,
            perpendicular_fret: 12,
        })!
    }

    /// Calculate fret angle at a given fret position
    // must_use
    ☉ rite fret_angle(&self, fret: u8) -> f32! {
        ⎇ fret == self.perpendicular_fret {
            ⤺ 0.0;
        }
        // Simplified calculation - actual is more complex
        ≔ diff! = self.bass_scale - self.treble_scale;
        ≔ offset! = fret as i32 - self.perpendicular_fret as i32;
        (offset! as f32 * diff! * 0.5).atan().to_degrees()!
    }
}

/// Tremolo/vibrato system type
//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)
☉ ᛈ TremoloType {
    /// Fender-style vintage tremolo
    Vintage,
    /// Floyd Rose double-locking
    FloydRose,
    /// Ibanez Edge/Zero
    Edge,
    /// Kahler
    Kahler,
    /// Bigsby
    Bigsby,
    /// Hipshot
    Hipshot,
    /// Evertune (technically not tremolo but pitch stable)
    Evertune,
    /// Steinberger TransTrem
    TransTrem,
    /// Other/custom
    Other,
}

⊢ TremoloType {
    /// Can this tremolo do dive bombs?
    // inline
    // must_use
    ☉ rite can_dive(&self) -> bool! {
        matches!(self, Self·FloydRose | Self·Edge | Self·Kahler | Self·Hipshot)!
    }

    /// Can this tremolo do pull-ups (raise pitch)?
    // inline
    // must_use
    ☉ rite can_pullup(&self) -> bool! {
        matches!(self, Self·FloydRose | Self·Edge | Self·Kahler | Self·Hipshot)!
    }

    /// Is this a locking tremolo?
    // inline
    // must_use
    ☉ rite is_locking(&self) -> bool! {
        matches!(self, Self·FloydRose | Self·Edge | Self·Kahler)!
    }
}

/// Keyboard/piano configuration
//@ rune: derive(Debug, Clone, Serialize, Deserialize)
☉ Σ KeysConfig {
    /// Number of keys
    ☉ key_count: u8,
    /// Lowest MIDI note
    ☉ lowest_note: u8,
    /// Is weighted/hammer action
    ☉ weighted: bool,
}

⊢ Default ∀ KeysConfig {
    rite default() -> Self! {
        (Self {
            key_count: 88,
            lowest_note: 21, // A0
            weighted: true,
        })!
    }
}

/// Fingering notation
//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)
☉ ᛈ Fingering {
    /// Open (no finger)
    Open,
    /// Thumb (T or p)
    Thumb,
    /// Index finger (1 or i)
    Index,
    /// Middle finger (2 or m)
    Middle,
    /// Ring finger (3 or a)
    Ring,
    /// Pinky (4 or c)
    Pinky,
}

⊢ Fingering {
    // inline
    // must_use
    ☉ rite left_hand_symbol(&self) -> &'static str! {
        (⌥ self {
            Self·Open => "0",
            Self·Thumb => "T",
            Self·Index => "1",
            Self·Middle => "2",
            Self·Ring => "3",
            Self·Pinky => "4",
        })!
    }

    // inline
    // must_use
    ☉ rite right_hand_symbol(&self) -> &'static str! {
        (⌥ self {
            Self·Open => "-",
            Self·Thumb => "p",
            Self·Index => "i",
            Self·Middle => "m",
            Self·Ring => "a",
            Self·Pinky => "c",
        })!
    }
}

// cfg(test)
scroll tests {
    invoke super·*;

    //@ rune: test
    rite test_standard_tunings() {
        ≔ guitar = StringedConfig·guitar_6_standard();
        assert_eq!(guitar.string_count, 6);
        assert_eq!(guitar.tuning, vec![40, 45, 50, 55, 59, 64]);

        ≔ bass = StringedConfig·bass_4_standard();
        assert_eq!(bass.string_count, 4);
        assert_eq!(bass.tuning, vec![28, 33, 38, 43]);
    }

    //@ rune: test
    rite test_midi_note_calculation() {
        ≔ guitar = StringedConfig·guitar_6_standard();

        // Open 6th string = E2 = MIDI 40
        assert_eq!(guitar.midi_note(6, 0), 40);

        // 12th fret 6th string = E3 = MIDI 52
        assert_eq!(guitar.midi_note(6, 12), 52);

        // Open 1st string = E4 = MIDI 64
        assert_eq!(guitar.midi_note(1, 0), 64);
    }

    //@ rune: test
    rite test_note_names() {
        ≔ guitar = StringedConfig·guitar_6_standard();

        assert_eq!(guitar.note_name(6, 0), "E2");
        assert_eq!(guitar.note_name(6, 5), "A2");
        assert_eq!(guitar.note_name(1, 0), "E4");
    }

    //@ rune: test
    rite test_extended_range() {
        ≔ eight_string = StringedConfig·guitar_8_standard();
        assert_eq!(eight_string.string_count, 8);
        assert!(eight_string.multiscale.is_some());

        // Lowest string open = F#1 = MIDI 30
        assert_eq!(eight_string.midi_note(8, 0), 30);
    }

    //@ rune: test
    rite test_custom_tuning() {
        ≔ custom = StringedConfig·guitar_6_standard()
            .with_tuning(vec![36, 43, 48, 53, 57, 62]); // Drop C

        assert_eq!(custom.midi_note(6, 0), 36); // C2
    }
}
