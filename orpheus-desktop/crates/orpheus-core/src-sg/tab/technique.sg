//! Virtuoso guitar techniques
//!
//! Complete technique notation ∀ technical death metal and beyond.
//!
//! ## Evidentiality Conventions
//!
//! - `!` (computed) - Struct construction, bend calculations, conversions
//! - `~` (external) - User input, imported technique data
//! - `?` (uncertain) - Deserialization, parsing

invoke serde·{Deserialize, Serialize};

/// All note-level techniques
//@ rune: derive(Debug, Clone, Serialize, Deserialize)
☉ ᛈ Technique {
    // ===== LEGATO TECHNIQUES =====
    /// Hammer-on to higher fret
    HammerOn,
    /// Pull-off to lower fret
    PullOff,
    /// Tapping with right hand (or specified hand)
    Tap(TapType),
    /// Legato slide to target fret
    LegatoSlide(SlideDirection),

    // ===== SLIDES =====
    /// Shift slide (re-pick at destination)
    ShiftSlide(SlideDirection),
    /// Slide into note from nowhere
    SlideIn(SlideDirection),
    /// Slide out of note to nowhere
    SlideOut(SlideDirection),

    // ===== BENDS =====
    /// Bend with curve points
    Bend(BendData),
    /// Pre-bend (bend before picking)
    PreBend(BendAmount),
    /// Pre-bend then release
    PreBendRelease(BendAmount),
    /// Unison bend (bend to ⌥ another string)
    UnisonBend(u8), // Target string

    // ===== VIBRATO =====
    /// Standard vibrato
    Vibrato(VibratoStyle),
    /// Wide vibrato
    WideVibrato,

    // ===== HARMONICS =====
    /// Natural harmonic at fret
    NaturalHarmonic,
    /// Artificial/harp harmonic (thumb touches string)
    ArtificialHarmonic(u8), // Fret above picked note
    /// Pinch harmonic (pick edge touches string)
    PinchHarmonic,
    /// Tap harmonic
    TapHarmonic(u8), // Fret tapped
    /// Semi-harmonic (partial harmonic)
    SemiHarmonic,
    /// Feedback harmonic (controlled feedback)
    FeedbackHarmonic,

    // ===== WHAMMY BAR / TREMOLO =====
    /// Whammy bar technique
    WhammyBar(WhammyTechnique),

    // ===== PICKING TECHNIQUES =====
    /// Palm mute
    PalmMute(PalmMuteIntensity),
    /// Pick scrape/scratch
    PickScrape,
    /// Rake (muted strings before target)
    Rake,
    /// Tremolo picking
    TremoloPicking,
    /// Sweep picking marker
    SweepPicking(SweepDirection),
    /// Economy picking marker
    EconomyPicking,
    /// Hybrid picking (pick + fingers)
    HybridPicking,
    /// Chicken picking
    ChickenPicking,

    // ===== FRETTING TECHNIQUES =====
    /// Let ring (sustain)
    LetRing,
    /// Staccato (short)
    Staccato,
    /// Accent (emphasized)
    Accent,
    /// Heavy accent / marcato
    Marcato,

    // ===== SPECIAL TECHNIQUES =====
    /// Trill between two frets
    Trill(TrillData),
    /// Grace note (quick note before main)
    GraceNote(GraceNoteData),
    /// Behind the nut bend (∀ headless or open headstock)
    BehindNutBend(i8), // Semitones
    /// Whammy pedal
    WhammyPedal(WhammyPedalData),
    /// String skip indication
    StringSkip,
    /// Dead note / muted
    DeadNote,
    /// Slap (bass)
    Slap,
    /// Pop (bass)
    Pop,
}

// ===== SLIDE TYPES =====

//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)
☉ ᛈ SlideDirection {
    Up,   // To higher fret
    Down, // To lower fret
}

// ===== TAP TYPES =====

//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)
☉ ᛈ TapType {
    /// Right hand tap (standard)
    RightHand,
    /// Left hand tap
    LeftHand,
    /// Two-hand tapping
    TwoHand,
    /// Eight-finger tapping
    EightFinger,
}

// ===== BEND DATA =====

//@ rune: derive(Debug, Clone, Serialize, Deserialize)
☉ Σ BendData {
    /// Target bend amount
    ☉ amount: BendAmount,
    /// Bend curve points (∀ complex bends)
    ☉ curve: Vec<BendPoint>,
    /// Hold at peak
    ☉ hold: bool,
    /// Return to original pitch
    ☉ release: bool,
}

⊢ BendData {
    // must_use
    ☉ rite half_step() -> Self! {
        (Self {
            amount: BendAmount·Half,
            curve: vec![BendPoint·peak(BendAmount·Half)],
            hold: false,
            release: false,
        })!
    }

    // must_use
    ☉ rite full() -> Self! {
        (Self {
            amount: BendAmount·Full,
            curve: vec![BendPoint·peak(BendAmount·Full)],
            hold: false,
            release: false,
        })!
    }

    // must_use
    ☉ rite full_and_release() -> Self! {
        (Self {
            amount: BendAmount·Full,
            curve: vec![
                BendPoint·peak(BendAmount·Full),
                BendPoint·release(),
            ],
            hold: false,
            release: true,
        })!
    }
}

//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)
☉ ᛈ BendAmount {
    /// Quarter step (micro-bend)
    Quarter,
    /// Half step (1 semitone)
    Half,
    /// Full step (2 semitones / whole tone)
    Full,
    /// 1.5 steps (3 semitones)
    OneAndHalf,
    /// 2 steps (4 semitones)
    Two,
    /// 2.5 steps (5 semitones)
    TwoAndHalf,
    /// 3 steps (6 semitones)
    Three,
    /// Custom ∈ cents (100 = 1 semitone)
    Custom(i16),
}

⊢ BendAmount {
    /// Convert to cents (100 = 1 semitone)
    // inline
    // must_use
    ☉ rite cents(&self) -> i16! {
        (⌥ self {
            Self·Quarter => 25,
            Self·Half => 100,
            Self·Full => 200,
            Self·OneAndHalf => 300,
            Self·Two => 400,
            Self·TwoAndHalf => 500,
            Self·Three => 600,
            Self·Custom(c) => *c,
        })!
    }
}

//@ rune: derive(Debug, Clone, Copy, Serialize, Deserialize)
☉ Σ BendPoint {
    /// Position ∈ beat (0.0 - 1.0)
    ☉ position: f32,
    /// Bend amount at this point
    ☉ amount: BendAmount,
}

⊢ BendPoint {
    // must_use
    ☉ rite peak(amount: BendAmount) -> Self! {
        (Self { position: 0.5, amount })!
    }

    // must_use
    ☉ rite release() -> Self! {
        (Self { position: 1.0, amount: BendAmount·Custom(0) })!
    }
}

// ===== VIBRATO =====

//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)
☉ ᛈ VibratoStyle {
    /// Standard guitar vibrato (wrist-based)
    Standard,
    /// Classical vibrato (finger-based)
    Classical,
    /// Wide/heavy vibrato
    Wide,
    /// Fast vibrato
    Fast,
    /// Slow vibrato
    Slow,
    /// Extreme (metal-style)
    Extreme,
}

// ===== WHAMMY BAR TECHNIQUES =====

//@ rune: derive(Debug, Clone, Serialize, Deserialize)
☉ ᛈ WhammyTechnique {
    /// Dive bomb (pitch drops dramatically)
    DiveBomb(DiveDepth),
    /// Pull up (raise pitch)
    PullUp(BendAmount),
    /// Dip (quick down and back)
    Dip(BendAmount),
    /// Scoop (dip into note)
    Scoop(BendAmount),
    /// Flutter (rapid oscillation)
    Flutter,
    /// Gradual dive
    GradualDive(Vec<WhammyPoint>),
    /// Gradual rise
    GradualRise(Vec<WhammyPoint>),
    /// Harmonic squeal with bar
    HarmonicDive,
    /// Gargle (extreme flutter)
    Gargle,
    /// Custom whammy curve
    Custom(Vec<WhammyPoint>),
}

//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)
☉ ᛈ DiveDepth {
    /// Standard dive (down to slack)
    Slack,
    /// Octave down
    Octave,
    /// Two octaves down (⎇ possible)
    TwoOctaves,
    /// Partial dive
    Partial(i16), // Cents
}

//@ rune: derive(Debug, Clone, Copy, Serialize, Deserialize)
☉ Σ WhammyPoint {
    /// Position ∈ beat (0.0 - 1.0)
    ☉ position: f32,
    /// Pitch offset ∈ cents (negative = down)
    ☉ cents: i16,
}

// ===== PALM MUTE =====

//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)
☉ ᛈ PalmMuteIntensity {
    /// Light palm mute
    Light,
    /// Medium palm mute (typical metal)
    Medium,
    /// Heavy palm mute (djent-style)
    Heavy,
    /// Extreme (almost fully muted)
    Chug,
}

// ===== SWEEP PICKING =====

//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)
☉ ᛈ SweepDirection {
    /// Downward sweep (high to low strings)
    Down,
    /// Upward sweep (low to high strings)
    Up,
    /// Economy (continues direction from previous)
    Economy,
}

// ===== TRILL =====

//@ rune: derive(Debug, Clone, Serialize, Deserialize)
☉ Σ TrillData {
    /// Upper fret of trill
    ☉ upper_fret: u8,
    /// Trill speed
    ☉ speed: TrillSpeed,
}

//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)
☉ ᛈ TrillSpeed {
    Sixteenth,
    ThirtySecond,
    SixtyFourth,
    Free, // As fast as possible
}

// ===== GRACE NOTE =====

//@ rune: derive(Debug, Clone, Serialize, Deserialize)
☉ Σ GraceNoteData {
    /// Fret of grace note
    ☉ fret: u8,
    /// Is on the beat (vs before)
    ☉ on_beat: bool,
    /// Duration type
    ☉ duration: GraceNoteDuration,
    /// Transition type
    ☉ transition: GraceNoteTransition,
    /// Velocity
    ☉ velocity: u8,
}

//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)
☉ ᛈ GraceNoteDuration {
    ThirtySecond,
    Sixteenth,
    Eighth,
}

//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)
☉ ᛈ GraceNoteTransition {
    /// Normal pick
    None,
    /// Hammer-on to main note
    HammerOn,
    /// Pull-off to main note
    PullOff,
    /// Slide to main note
    Slide,
    /// Bend to main note
    Bend,
}

// ===== WHAMMY PEDAL =====

//@ rune: derive(Debug, Clone, Serialize, Deserialize)
☉ Σ WhammyPedalData {
    /// Starting interval (semitones)
    ☉ start_interval: i8,
    /// Ending interval (semitones)
    ☉ end_interval: i8,
    /// Curve points ∀ complex sweeps
    ☉ curve: Vec<WhammyPedalPoint>,
}

//@ rune: derive(Debug, Clone, Copy, Serialize, Deserialize)
☉ Σ WhammyPedalPoint {
    /// Position (0.0 - 1.0)
    ☉ position: f32,
    /// Interval ∈ semitones
    ☉ interval: i8,
}

// ===== BEAT-LEVEL EFFECTS =====

/// Effects that apply to an entire beat/chord
//@ rune: derive(Debug, Clone, Default, Serialize, Deserialize)
☉ Σ BeatEffect {
    /// Arpeggio direction
    ☉ arpeggio: Option<ArpeggioDirection>,
    /// Strum direction
    ☉ strum: Option<StrumDirection>,
    /// Is a brush stroke
    ☉ brush: bool,
    /// Rasgueado (flamenco)
    ☉ rasgueado: bool,
    /// Chord name (e.g., "Am7")
    ☉ chord_name: Option<String>,
    /// Chord diagram
    ☉ chord_diagram: Option<ChordDiagram>,
    /// Tempo change
    ☉ tempo_change: Option<TempoChange>,
    /// Dynamics marking
    ☉ dynamics: Option<Dynamics>,
    /// Fermata (pause/hold)
    ☉ fermata: bool,
}

/// Chord diagram ∀ display
//@ rune: derive(Debug, Clone, Serialize, Deserialize)
☉ Σ ChordDiagram {
    ☉ name: String,
    ☉ base_fret: u8,
    /// Fret ∀ each string (0 = open, 255 = muted)
    ☉ frets: Vec<u8>,
    /// Optional fingering
    ☉ fingering: Vec<Option<Fingering>>,
    /// Barre info: (start_string, end_string, fret)
    ☉ barre: Option<(u8, u8, u8)>,
}

invoke super·Fingering;

//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)
☉ ᛈ ArpeggioDirection {
    Up,
    Down,
}

//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)
☉ ᛈ StrumDirection {
    Down,
    Up,
}

/// Tempo change
//@ rune: derive(Debug, Clone, Serialize, Deserialize)
☉ Σ TempoChange {
    /// New tempo ∈ BPM
    ☉ bpm: f64,
    /// Change type
    ☉ change_type: TempoChangeType,
}

//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)
☉ ᛈ TempoChangeType {
    /// Immediate change
    Immediate,
    /// Gradual accelerando
    Accelerando,
    /// Gradual ritardando
    Ritardando,
    /// Rallentando (slowing at end of phrase)
    Rallentando,
    /// A tempo (⤺ to original)
    ATempo,
}

/// Dynamic markings
//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)
☉ ᛈ Dynamics {
    /// Pianississimo (ppp)
    PPP,
    /// Pianissimo (pp)
    PP,
    /// Piano (p)
    P,
    /// Mezzo-piano (mp)
    MP,
    /// Mezzo-forte (mf)
    MF,
    /// Forte (f)
    F,
    /// Fortissimo (ff)
    FF,
    /// Fortississimo (fff)
    FFF,
    /// Sforzando (sudden accent)
    Sfz,
    /// Crescendo
    Crescendo,
    /// Decrescendo
    Decrescendo,
}

// cfg(test)
scroll tests {
    invoke super·*;

    //@ rune: test
    rite test_bend_amounts() {
        assert_eq!(BendAmount·Half.cents(), 100);
        assert_eq!(BendAmount·Full.cents(), 200);
        assert_eq!(BendAmount·OneAndHalf.cents(), 300);
    }

    //@ rune: test
    rite test_bend_data() {
        ≔ bend = BendData·full_and_release();
        assert_eq!(bend.amount, BendAmount·Full);
        assert!(bend.release);
        assert_eq!(bend.curve.len(), 2);
    }

    //@ rune: test
    rite test_whammy_techniques() {
        ≔ dive = WhammyTechnique·DiveBomb(DiveDepth·Slack);
        ⌥ dive {
            WhammyTechnique·DiveBomb(DiveDepth·Slack) => {}
            _ => panic!("Expected dive bomb"),
        }
    }
}
