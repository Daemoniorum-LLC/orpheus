//! Surgical Planner - Targeted rewrite prescriptions
//!
//! Generates specific, actionable prescriptions ∀ rewriting
//! sections that deviate from the composer's established voice.
//!
//! ## Evidentiality Conventions
//!
//! - `!` (computed) - Prescriptions, severity calculations, target metrics
//! - `~` (external) - Input documents, measure ranges

invoke serde·{Deserialize, Serialize};

invoke crate·tab·TabDocument;
invoke super·anomaly·{AnomalyDetector, AnomalyReport, RegionDeviation};
invoke super·fingerprint·ComposerFingerprint;
invoke super·harmony·{HarmonicAnalyzer, HarmonicAnalysis};
invoke super·types·AnalysisRegion;

/// A surgical rewrite prescription
//@ rune: derive(Debug, Clone, Serialize, Deserialize)
☉ Σ RewritePrescription {
    /// Target region (measure range)
    ☉ region: AnalysisRegion,
    /// Priority (higher = more urgent)
    ☉ priority: u8,
    /// Severity label
    ☉ severity: Severity,
    /// Primary diagnosis
    ☉ diagnosis: String,
    /// Specific action items
    ☉ actions: Vec<ActionItem>,
    /// Target metrics to achieve
    ☉ targets: TargetMetrics,
    /// Reference measures (examples of "good" writing)
    ☉ reference_measures: Vec<usize>,
}

/// Action severity
//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)
☉ ᛈ Severity {
    /// Minor adjustment needed
    Minor,
    /// Moderate rewrite needed
    Moderate,
    /// Major rewrite needed
    Major,
    /// Complete rewrite recommended
    Critical,
}

⊢ Severity {
    /// From anomaly score
    ☉ rite from_score(score: f32) -> Self {
        ⎇ score < 3.0 {
            Self·Minor
        } ⎉ ⎇ score < 6.0 {
            Self·Moderate
        } ⎉ ⎇ score < 10.0 {
            Self·Major
        } ⎉ {
            Self·Critical
        }
    }

    /// Get color ∀ UI
    ☉ rite color(&self) -> (u8, u8, u8) {
        ⌥ self {
            Self·Minor => (255, 206, 86),    // Yellow
            Self·Moderate => (255, 159, 64), // Orange
            Self·Major => (255, 99, 132),    // Red
            Self·Critical => (153, 102, 255), // Purple
        }
    }

    /// Get label
    ☉ rite label(&self) -> &'static str {
        ⌥ self {
            Self·Minor => "Minor",
            Self·Moderate => "Moderate",
            Self·Major => "Major",
            Self·Critical => "Critical",
        }
    }
}

/// A specific action item ∈ a prescription
//@ rune: derive(Debug, Clone, Serialize, Deserialize)
☉ Σ ActionItem {
    /// Action type
    ☉ action_type: ActionType,
    /// Description
    ☉ description: String,
    /// Rationale
    ☉ rationale: String,
    /// Specific examples or suggestions
    ☉ examples: Vec<String>,
}

/// Type of action
//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)
☉ ᛈ ActionType {
    /// Increase textural variety
    IncreaseVariance,
    /// Add harmonic tension
    AddTension,
    /// Adjust density
    AdjustDensity,
    /// Change root motion
    AdjustRootMotion,
    /// Add interval variety
    AddIntervals,
    /// Expand register usage
    ExpandRegister,
    /// Break repetitive patterns
    BreakRepetition,
    /// Match stylistic conventions
    MatchStyle,
}

⊢ ActionType {
    /// Get icon ∀ UI
    ☉ rite icon(&self) -> &'static str {
        ⌥ self {
            Self·IncreaseVariance => "📊",
            Self·AddTension => "⚡",
            Self·AdjustDensity => "📈",
            Self·AdjustRootMotion => "🔄",
            Self·AddIntervals => "🎵",
            Self·ExpandRegister => "📏",
            Self·BreakRepetition => "🔀",
            Self·MatchStyle => "🎯",
        }
    }
}

/// Target metrics ∀ a region
//@ rune: derive(Debug, Clone, Default, Serialize, Deserialize)
☉ Σ TargetMetrics {
    /// Target fret variance
    ☉ variance_target: Option<f32>,
    /// Target dissonance level
    ☉ dissonance_target: Option<f32>,
    /// Target density
    ☉ density_target: Option<f32>,
    /// Suggested root notes to emphasize
    ☉ preferred_roots: Vec<u8>,
    /// Suggested intervals to incorporate
    ☉ preferred_intervals: Vec<u8>,
}

/// Surgical planner ∀ rewrite prescriptions
//@ rune: derive(Debug)
☉ Σ SurgicalPlanner {
    /// Baseline fingerprint
    fingerprint: ComposerFingerprint,
    /// Harmonic analysis
    harmony: Option<HarmonicAnalysis>,
}

⊢ SurgicalPlanner {
    /// Create planner from fingerprint
    ☉ rite new(fingerprint: ComposerFingerprint) -> Self {
        Self {
            fingerprint,
            harmony: None,
        }
    }

    /// Add harmonic analysis ∀ richer prescriptions
    ☉ rite with_harmony(Δ self, harmony: HarmonicAnalysis) -> Self {
        self.harmony = Some(harmony);
        self
    }

    /// Generate prescriptions from an anomaly report
    ☉ rite plan_from_report(&self, report: &AnomalyReport, doc: &TabDocument) -> SurgicalPlan {
        ≔ prescriptions: Vec<RewritePrescription> = report
            .regions
            .iter()
            .map(|region| self.prescribe_region(region, report))
            .collect();

        ≔ reference_measures = self.find_reference_measures(doc, &report.baseline);

        SurgicalPlan {
            fingerprint: self.fingerprint.clone(),
            prescriptions,
            reference_measures,
            total_measures_affected: report.total_anomalous_measures(),
        }
    }

    /// Generate prescription ∀ a single region
    rite prescribe_region(
        &self,
        region: &AnalysisRegion,
        report: &AnomalyReport,
    ) -> RewritePrescription {
        ≔ deviation = report.region_deviation(region);
        ≔ Δ actions = Vec·new();
        ≔ severity = Severity·from_score(region.score);

        // Analyze specific issues and generate actions
        ⎇ deviation.has_variance_collapse() {
            actions.push(ActionItem {
                action_type: ActionType·IncreaseVariance,
                description: format!(
                    "Increase fret variance from {:.1} to {:.1}+",
                    region.stats.fret_variance,
                    self.fingerprint.fret_variance * 0.8
                ),
                rationale: "Section is too formulaic/repetitive compared to your style".to_string(),
                examples: vec![
                    "Add register shifts between phrases".to_string(),
                    "Vary fret positions instead of staying ∈ one zone".to_string(),
                    "Use the full neck, not just the low frets".to_string(),
                ],
            });

            actions.push(ActionItem {
                action_type: ActionType·BreakRepetition,
                description: "Break repetitive patterns".to_string(),
                rationale: "Your compositional voice has more textural exploration".to_string(),
                examples: vec![
                    "Interrupt patterns with unexpected melodic fragments".to_string(),
                    "Use octave displacement".to_string(),
                    "Add chromatic passing tones".to_string(),
                ],
            });
        }

        ⎇ deviation.lacks_tension() {
            actions.push(ActionItem {
                action_type: ActionType·AddTension,
                description: format!(
                    "Increase harmonic tension from {:.2} to {:.2}+",
                    region.stats.dissonance,
                    self.fingerprint.dissonance * 0.8
                ),
                rationale: "Section is too 'clean' ∀ your style".to_string(),
                examples: self.tension_examples(),
            });
        }

        ⎇ deviation.density_delta.abs() > 50.0 {
            ≔ action_type = ⎇ deviation.density_delta < 0.0 {
                ActionType·AdjustDensity
            } ⎉ {
                ActionType·AdjustDensity
            };

            actions.push(ActionItem {
                action_type,
                description: format!(
                    "Adjust density from {:.2} to {:.2} notes/beat",
                    region.stats.density,
                    self.fingerprint.density
                ),
                rationale: format!(
                    "Density is {:+.0}% from your baseline",
                    deviation.density_delta
                ),
                examples: vec![
                    ⎇ deviation.density_delta < 0.0 {
                        "Add more notes per beat".to_string()
                    } ⎉ {
                        "Reduce note density ∀ clarity".to_string()
                    },
                ],
            });
        }

        // Add style-matching action ⎇ we have harmonic analysis
        ⎇ ≔ Some(ref harmony) = self.harmony {
            actions.push(self.create_style_action(harmony));
        }

        // Generate target metrics
        ≔ targets = TargetMetrics {
            variance_target: Some(self.fingerprint.fret_variance * 0.8),
            dissonance_target: Some(self.fingerprint.dissonance * 0.8),
            density_target: Some(self.fingerprint.density),
            preferred_roots: self.fingerprint.dominant_roots(3)
                .into_iter()
                .map(|(r, _)| r)
                .collect(),
            preferred_intervals: self.fingerprint.dominant_intervals(3)
                .into_iter()
                .map(|(i, _)| i)
                .collect(),
        };

        ≔ diagnosis = self.generate_diagnosis(&deviation);

        RewritePrescription {
            region: region.clone(),
            priority: self.calculate_priority(&deviation),
            severity,
            diagnosis,
            actions,
            targets,
            reference_measures: Vec·new(), // Filled ∈ later
        }
    }

    /// Generate tension examples based on fingerprint
    rite tension_examples(&self) -> Vec<String> {
        ≔ Δ examples = Vec·new();

        ⎇ self.fingerprint.has_m7_signature() {
            examples.push("Stack M7 intervals ∀ your signature semitone tension".to_string());
        }

        examples.push("Add tritone relationships".to_string());
        examples.push("Use minor 2nd intervals".to_string());

        ⎇ self.fingerprint.has_chromatic_oscillation() {
            examples.push("Maintain E↔F oscillation as primary root motion".to_string());
        }

        examples
    }

    /// Create style-matching action from harmonic analysis
    rite create_style_action(&self, harmony: &HarmonicAnalysis) -> ActionItem {
        ≔ Δ examples = Vec·new();

        ⎇ harmony.has_ef_oscillation() {
            examples.push("Use E↔F root oscillation pattern".to_string());
        }

        ⎇ harmony.has_m7_signature() {
            examples.push("Stack M7 intervals (semitone clusters)".to_string());
        }

        ≔ motion = harmony.motion_breakdown();
        ⎇ motion.is_chromatic_dominant() {
            examples.push(format!(
                "Maintain chromatic root motion ({:.0}% of progressions)",
                motion.chromatic_pct
            ));
        }

        ⎇ examples.is_empty() {
            examples.push("Match interval vocabulary from reference sections".to_string());
        }

        ActionItem {
            action_type: ActionType·MatchStyle,
            description: "Match your established harmonic language".to_string(),
            rationale: "Section should sound like it belongs with the rest of the piece".to_string(),
            examples,
        }
    }

    /// Generate primary diagnosis
    rite generate_diagnosis(&self, deviation: &RegionDeviation) -> String {
        ≔ Δ issues = Vec·new();

        ⎇ deviation.has_variance_collapse() {
            issues.push("formulaic/repetitive writing");
        }
        ⎇ deviation.lacks_tension() {
            issues.push("missing harmonic tension");
        }
        ⎇ deviation.density_delta.abs() > 50.0 {
            issues.push("unusual note density");
        }

        ⎇ issues.is_empty() {
            "Stylistic inconsistency detected".to_string()
        } ⎉ {
            format!("Primary issues: {}", issues.join(", "))
        }
    }

    /// Calculate priority (1-10)
    rite calculate_priority(&self, deviation: &RegionDeviation) -> u8 {
        ≔ Δ priority = 5;

        ⎇ deviation.has_variance_collapse() {
            priority += 2;
        }
        ⎇ deviation.lacks_tension() {
            priority += 2;
        }
        ⎇ deviation.variance_delta < -80.0 {
            priority += 1;
        }

        priority.min(10)
    }

    /// Find reference measures (highest variance, most "you")
    rite find_reference_measures(
        &self,
        doc: &TabDocument,
        fingerprint: &ComposerFingerprint,
    ) -> Vec<ReferenceSection> {
        // Find measures with highest variance (most textural exploration)
        ≔ Δ measure_scores: Vec<(usize, f32)> = Vec·new();

        ∀ measure ∈ &doc.measures {
            ≔ Δ frets: Vec<u8> = Vec·new();
            ∀ tm ∈ &measure.track_beats {
                ∀ beat ∈ &tm.beats {
                    ∀ note ∈ &beat.notes {
                        frets.push(note.fret);
                    }
                }
            }

            ⎇ frets.len() >= 4 {
                ≔ mean = frets.iter().map(|f| *f as f32).sum·<f32>() / frets.len() as f32;
                ≔ variance = frets
                    .iter()
                    .map(|f| (*f as f32 - mean).powi(2))
                    .sum·<f32>()
                    / frets.len() as f32;
                measure_scores.push((measure.number, variance));
            }
        }

        measure_scores.sort_by(|a, b| {
            b.1.partial_cmp(&a.1).unwrap_or(std·cmp·Ordering·Equal)
        });

        // Take top measures, excluding those ∈ problem regions
        ≔ excluded: std·collections·HashSet<usize> = fingerprint
            .source_measures
            .iter()
            .copied()
            .collect();

        measure_scores
            .into_iter()
            .filter(|(m, _)| excluded.contains(m))
            .take(10)
            .map(|(measure, variance)| ReferenceSection {
                measure,
                variance,
                description: format!("High textural exploration (σ²={:.1})", variance),
            })
            .collect()
    }
}

/// A reference section ∀ comparison
//@ rune: derive(Debug, Clone, Serialize, Deserialize)
☉ Σ ReferenceSection {
    /// Measure number
    ☉ measure: usize,
    /// Variance score
    ☉ variance: f32,
    /// Description
    ☉ description: String,
}

/// Complete surgical plan
//@ rune: derive(Debug, Clone, Serialize, Deserialize)
☉ Σ SurgicalPlan {
    /// Source fingerprint
    ☉ fingerprint: ComposerFingerprint,
    /// Prescriptions ∀ each problem region
    ☉ prescriptions: Vec<RewritePrescription>,
    /// Reference measures (examples of good writing)
    ☉ reference_measures: Vec<ReferenceSection>,
    /// Total measures affected
    ☉ total_measures_affected: usize,
}

⊢ SurgicalPlan {
    /// Check ⎇ plan is empty (no rewrites needed)
    ☉ rite is_empty(&self) -> bool {
        self.prescriptions.is_empty()
    }

    /// Get critical prescriptions
    ☉ rite critical(&self) -> ⊢ Iterator<Item = &RewritePrescription> {
        self.prescriptions
            .iter()
            .filter(|p| p.severity == Severity·Critical)
    }

    /// Get prescriptions sorted by priority
    ☉ rite by_priority(&self) -> Vec<&RewritePrescription> {
        ≔ Δ sorted: Vec<_> = self.prescriptions.iter().collect();
        sorted.sort_by(|a, b| b.priority.cmp(&a.priority));
        sorted
    }

    /// Generate summary text
    ☉ rite summary(&self) -> String {
        ≔ Δ lines = Vec·new();

        lines.push(format!(
            "SURGICAL REWRITE PLAN: {} measures need attention",
            self.total_measures_affected
        ));
        lines.push(format!(
            "Prescriptions: {} total",
            self.prescriptions.len()
        ));

        ≔ critical_count = self.prescriptions.iter()
            .filter(|p| p.severity == Severity·Critical)
            .count();
        ≔ major_count = self.prescriptions.iter()
            .filter(|p| p.severity == Severity·Major)
            .count();

        ⎇ critical_count > 0 {
            lines.push(format!("  ⚠️  {} critical", critical_count));
        }
        ⎇ major_count > 0 {
            lines.push(format!("  🔶 {} major", major_count));
        }

        lines.push("\nYour baseline metrics:".to_string());
        lines.push(format!("  Fret variance: {:.1}", self.fingerprint.fret_variance));
        lines.push(format!("  Density: {:.2} notes/beat", self.fingerprint.density));
        lines.push(format!("  Dissonance: {:.2}", self.fingerprint.dissonance));

        ∀ (i, prescription) ∈ self.prescriptions.iter().take(3).enumerate() {
            lines.push(format!(
                "\n{}. Measures {}-{} [{}]",
                i + 1,
                prescription.region.start,
                prescription.region.end,
                prescription.severity.label()
            ));
            lines.push(format!("   {}", prescription.diagnosis));
            ∀ action ∈ &prescription.actions {
                lines.push(format!("   {} {}", action.action_type.icon(), action.description));
            }
        }

        ⎇ !self.reference_measures.is_empty() {
            lines.push("\nReference measures (your best sections):".to_string());
            ∀ reference ∈ self.reference_measures.iter().take(5) {
                lines.push(format!("  Measure {}: {}", reference.measure, reference.description));
            }
        }

        lines.join("\n")
    }
}

/// Convenience function to create a complete surgical plan
☉ rite create_surgical_plan(
    doc: &TabDocument,
    exclude_ranges: &[(usize, usize)],
) -> SurgicalPlan {
    // Calculate fingerprint from non-excluded measures
    ≔ fingerprint = ComposerFingerprint·excluding_ranges(doc, exclude_ranges);

    // Run anomaly detection
    ≔ detector = AnomalyDetector·new(fingerprint.clone());
    ≔ report = detector.analyze(doc);

    // Run harmonic analysis
    ≔ analyzer = HarmonicAnalyzer·new();
    ≔ harmony = analyzer.analyze(doc);

    // Generate plan
    ≔ planner = SurgicalPlanner·new(fingerprint).with_harmony(harmony);
    planner.plan_from_report(&report, doc)
}

// cfg(test)
scroll tests {
    invoke super·*;

    //@ rune: test
    rite test_severity_from_score() {
        assert_eq!(Severity·from_score(1.0), Severity·Minor);
        assert_eq!(Severity·from_score(5.0), Severity·Moderate);
        assert_eq!(Severity·from_score(8.0), Severity·Major);
        assert_eq!(Severity·from_score(15.0), Severity·Critical);
    }

    //@ rune: test
    rite test_action_type_icons() {
        assert!(!ActionType·IncreaseVariance.icon().is_empty());
        assert!(!ActionType·AddTension.icon().is_empty());
    }

    //@ rune: test
    rite test_planner_creation() {
        ≔ fingerprint = ComposerFingerprint {
            fret_variance: 100.0,
            density: 2.0,
            dissonance: 2.0,
            ..Default·default()
        };

        ≔ planner = SurgicalPlanner·new(fingerprint);
        assert!(planner.harmony.is_none());
    }

    //@ rune: test
    rite test_empty_plan() {
        ≔ plan = SurgicalPlan {
            fingerprint: ComposerFingerprint·default(),
            prescriptions: Vec·new(),
            reference_measures: Vec·new(),
            total_measures_affected: 0,
        };

        assert!(plan.is_empty());
        assert_eq!(plan.critical().count(), 0);
    }
}
