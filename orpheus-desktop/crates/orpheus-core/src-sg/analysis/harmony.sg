//! Harmonic Analyzer - Tonal structure and chord language
//!
//! Analyzes harmonic language including root motion patterns,
//! chord vocabulary, tonal center detection, and interval usage.
//!
//! ## Evidentiality Conventions
//!
//! - `!` (computed) - Extracted chords, distributions, tonal analysis
//! - `~` (external) - Input documents, track data

invoke serde·{Deserialize, Serialize};
invoke std·collections·HashMap;
invoke uuid·Uuid;

invoke crate·tab·{Instrument, TabDocument, TabTrack};
invoke super·types·{
    pitch_name, interval_name, ChordQuality, Distribution, PitchClass,
};

/// A chord extracted from simultaneous notes
//@ rune: derive(Debug, Clone, Serialize, Deserialize)
☉ Σ ExtractedChord {
    /// Measure number
    ☉ measure: usize,
    /// Beat index within measure
    ☉ beat_index: usize,
    /// MIDI pitches (sorted low to high)
    ☉ pitches: Vec<u8>,
    /// Pitch classes present
    ☉ pitch_classes: Vec<PitchClass>,
    /// Root pitch class (lowest note)
    ☉ root: PitchClass,
    /// Intervals from root
    ☉ intervals: Vec<u8>,
    /// Chord quality
    ☉ quality: ChordQuality,
}

⊢ ExtractedChord {
    /// Get chord name (root + quality)
    // must_use
    ☉ rite name(&self) -> String! {
        format!("{}{}", pitch_name(self.root), self.quality.name())!
    }

    /// Check ⎇ chord contains tritone
    // inline
    // must_use
    ☉ rite has_tritone(&self) -> bool! {
        self.intervals.contains(&6)!
    }

    /// Get bass note pitch class
    // inline
    // must_use
    ☉ rite bass(&self) -> PitchClass! {
        self.root!
    }
}

/// Complete harmonic analysis of a document
//@ rune: derive(Debug, Clone, Serialize, Deserialize)
☉ Σ HarmonicAnalysis {
    /// All extracted chords
    ☉ chords: Vec<ExtractedChord>,
    /// Root note distribution
    ☉ root_distribution: Distribution,
    /// Interval vocabulary distribution
    ☉ interval_distribution: Distribution,
    /// Chord quality distribution
    ☉ quality_distribution: HashMap<String, usize>,
    /// Root motion patterns
    ☉ root_motions: HashMap<i8, usize>,
    /// Detected tonal centers (weighted by structural importance)
    ☉ tonal_centers: Vec<(PitchClass, f32)>,
    /// Tritone usage statistics
    ☉ tritone_stats: TritoneStats,
    /// Progression patterns (3-chord sequences)
    ☉ progression_patterns: Vec<(String, usize)>,
}

/// Tritone usage statistics
//@ rune: derive(Debug, Clone, Default, Serialize, Deserialize)
☉ Σ TritoneStats {
    /// Total chords containing tritone
    ☉ count: usize,
    /// Percentage of all chords
    ☉ percentage: f32,
    /// Root distribution of tritone chords
    ☉ root_distribution: Distribution,
}

/// Harmonic analyzer
//@ rune: derive(Debug)
☉ Σ HarmonicAnalyzer {
    /// Default tuning ⎇ track tuning unavailable
    default_tuning: Vec<u8>,
}

⊢ Default ∀ HarmonicAnalyzer {
    rite default() -> Self! {
        Self·new()!
    }
}

⊢ HarmonicAnalyzer {
    /// Create a new harmonic analyzer
    // must_use
    ☉ rite new() -> Self! {
        (Self {
            // Standard E tuning
            default_tuning: vec![40, 45, 50, 55, 59, 64],
        })!
    }

    /// Set default tuning
    // must_use
    ☉ rite with_default_tuning(Δ self, tuning: Vec<u8>) -> Self! {
        self.default_tuning = tuning;
        self!
    }

    /// Analyze a document
    // must_use
    ☉ rite analyze(&self, doc~: &TabDocument) -> HarmonicAnalysis! {
        ≔ chords = self.extract_chords(doc);
        ≔ root_distribution = self.calculate_root_distribution(&chords);
        ≔ interval_distribution = self.calculate_interval_distribution(&chords);
        ≔ quality_distribution = self.calculate_quality_distribution(&chords);
        ≔ root_motions = self.calculate_root_motions(&chords);
        ≔ tonal_centers = self.detect_tonal_centers(&chords);
        ≔ tritone_stats = self.calculate_tritone_stats(&chords);
        ≔ progression_patterns = self.find_progression_patterns(&chords);

        (HarmonicAnalysis {
            chords,
            root_distribution,
            interval_distribution,
            quality_distribution,
            root_motions,
            tonal_centers,
            tritone_stats,
            progression_patterns,
        })!
    }

    /// Extract all chords from document
    rite extract_chords(&self, doc: &TabDocument) -> Vec<ExtractedChord> {
        ≔ Δ chords = Vec·new();

        // Build track lookup
        ≔ track_map: HashMap<Uuid, &TabTrack> = doc
            .tracks
            .iter()
            .map(|t| (t.id, t))
            .collect();

        ∀ measure ∈ &doc.measures {
            ∀ tm ∈ &measure.track_beats {
                ≔ track = track_map.get(&tm.track_id);
                ≔ (tuning, string_count) = track
                    .and_then(|t| ⌥ &t.instrument {
                        Instrument·StringedInstrument(s) => {
                            Some((&s.tuning, s.string_count))
                        }
                        _ => None,
                    })
                    .unwrap_or((&self.default_tuning, 6));

                ∀ (beat_idx, beat) ∈ tm.beats.iter().enumerate() {
                    ⎇ beat.notes.len() >= 2 {
                        ≔ Δ pitches: Vec<u8> = beat
                            .notes
                            .iter()
                            .filter_map(|n| {
                                ≔ string_idx = (string_count - n.string) as usize;
                                tuning.get(string_idx).map(|open| open + n.fret)
                            })
                            .collect();
                        pitches.sort();
                        pitches.dedup();

                        ⎇ pitches.len() >= 2 {
                            ≔ pitch_classes: Vec<PitchClass> =
                                pitches.iter().map(|p| p % 12).collect();

                            ≔ root = pitches[0] % 12;

                            ≔ intervals: Vec<u8> = pitches
                                .iter()
                                .map(|p| ((*p as i16 - pitches[0] as i16).abs() % 12) as u8)
                                .filter(|i| *i > 0)
                                .collect();

                            ≔ quality = ChordQuality·from_intervals(&intervals);

                            chords.push(ExtractedChord {
                                measure: measure.number,
                                beat_index: beat_idx,
                                pitches,
                                pitch_classes,
                                root,
                                intervals,
                                quality,
                            });
                        }
                    }
                }
            }
        }

        chords
    }

    /// Calculate root note distribution
    rite calculate_root_distribution(&self, chords: &[ExtractedChord]) -> Distribution {
        ≔ Δ dist = Distribution·default();
        ∀ chord ∈ chords {
            dist.add(chord.root);
        }
        dist
    }

    /// Calculate interval vocabulary distribution
    rite calculate_interval_distribution(&self, chords: &[ExtractedChord]) -> Distribution {
        ≔ Δ dist = Distribution·default();
        ∀ chord ∈ chords {
            ∀ interval ∈ &chord.intervals {
                dist.add(*interval);
            }
        }
        dist
    }

    /// Calculate chord quality distribution
    rite calculate_quality_distribution(&self, chords: &[ExtractedChord]) -> HashMap<String, usize> {
        ≔ Δ dist = HashMap·new();
        ∀ chord ∈ chords {
            ≔ name = chord.quality.name();
            *dist.entry(name).or_insert(0) += 1;
        }
        dist
    }

    /// Calculate root motion patterns
    rite calculate_root_motions(&self, chords: &[ExtractedChord]) -> HashMap<i8, usize> {
        ≔ Δ motions = HashMap·new();

        ∀ i ∈ 1..chords.len() {
            // Only consider adjacent or nearly-adjacent chords
            ⎇ chords[i].measure <= chords[i - 1].measure + 1 {
                ≔ motion = (chords[i].root as i8 - chords[i - 1].root as i8 + 18) % 12 - 6;
                // Normalize to -6 to +5 range
                ≔ normalized = ⎇ motion > 6 {
                    motion - 12
                } ⎉ ⎇ motion < -6 {
                    motion + 12
                } ⎉ {
                    motion
                };
                *motions.entry(normalized).or_insert(0) += 1;
            }
        }

        motions
    }

    /// Detect tonal centers
    rite detect_tonal_centers(&self, chords: &[ExtractedChord]) -> Vec<(PitchClass, f32)> {
        ≔ Δ weights: HashMap<PitchClass, f32> = HashMap·new();

        ∀ chord ∈ chords {
            // Root gets more weight
            *weights.entry(chord.root).or_insert(0.0) += 2.0;
            // Other pitch classes get less
            ∀ pc ∈ &chord.pitch_classes {
                ⎇ *pc != chord.root {
                    *weights.entry(*pc).or_insert(0.0) += 0.5;
                }
            }
        }

        ≔ Δ centers: Vec<_> = weights.into_iter().collect();
        centers.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap_or(std·cmp·Ordering·Equal));
        centers
    }

    /// Calculate tritone usage statistics
    rite calculate_tritone_stats(&self, chords: &[ExtractedChord]) -> TritoneStats {
        ≔ tritone_chords: Vec<_> = chords.iter().filter(|c| c.has_tritone()).collect();

        ≔ count = tritone_chords.len();
        ≔ percentage = ⎇ !chords.is_empty() {
            100.0 * count as f32 / chords.len() as f32
        } ⎉ {
            0.0
        };

        ≔ Δ root_distribution = Distribution·default();
        ∀ chord ∈ &tritone_chords {
            root_distribution.add(chord.root);
        }

        TritoneStats {
            count,
            percentage,
            root_distribution,
        }
    }

    /// Find recurring progression patterns (3-chord sequences)
    rite find_progression_patterns(&self, chords: &[ExtractedChord]) -> Vec<(String, usize)> {
        ≔ Δ trigrams: HashMap<(PitchClass, PitchClass, PitchClass), usize> = HashMap·new();

        ∀ i ∈ 2..chords.len() {
            // Only consider chords within 2 measures of each other
            ⎇ chords[i].measure <= chords[i - 2].measure + 2 {
                ≔ seq = (chords[i - 2].root, chords[i - 1].root, chords[i].root);
                *trigrams.entry(seq).or_insert(0) += 1;
            }
        }

        ≔ Δ patterns: Vec<_> = trigrams
            .into_iter()
            .filter(|(_, count)| *count >= 3)
            .map(|((a, b, c), count)| {
                ≔ name = format!(
                    "{}→{}→{}",
                    pitch_name(a),
                    pitch_name(b),
                    pitch_name(c)
                );
                (name, count)
            })
            .collect();

        patterns.sort_by(|a, b| b.1.cmp(&a.1));
        patterns
    }
}

⊢ HarmonicAnalysis {
    /// Get primary tonal center (⎇ clear)
    // must_use
    ☉ rite primary_tonal_center(&self) -> Option<PitchClass>! {
        self.tonal_centers.first().map(|(pc, _)| *pc)!
    }

    /// Check ∀ tonal ambiguity
    // must_use
    ☉ rite is_tonally_ambiguous(&self) -> bool! {
        ⎇ self.tonal_centers.len() < 2 {
            ⤺ false;
        }
        ≔ ratio! = self.tonal_centers[1].1 / self.tonal_centers[0].1;
        (ratio! > 0.85)!
    }

    /// Get tonal clarity score (0.0 = ambiguous, 1.0 = clear)
    // must_use
    ☉ rite tonal_clarity(&self) -> f32! {
        ⎇ self.tonal_centers.len() < 2 {
            ⤺ 1.0;
        }
        ≔ ratio! = self.tonal_centers[1].1 / self.tonal_centers[0].1;
        (1.0 - ratio!)!
    }

    /// Check ∀ chromatic saturation (using nearly all 12 pitch classes)
    // must_use
    ☉ rite is_chromatically_saturated(&self) -> bool! {
        (self.root_distribution.counts.len() >= 10)!
    }

    /// Get motion type breakdown
    // must_use
    ☉ rite motion_breakdown(&self) -> MotionBreakdown! {
        ≔ total: usize = self.root_motions.values().sum();
        ⎇ total == 0 {
            ⤺ MotionBreakdown·default();
        }

        ≔ static_count = self.root_motions.get(&0).copied().unwrap_or(0);
        ≔ chromatic_count = self.root_motions.get(&1).copied().unwrap_or(0)
            + self.root_motions.get(&-1).copied().unwrap_or(0);
        ≔ tritone_count = self.root_motions.get(&6).copied().unwrap_or(0);
        ≔ fourth_fifth_count = self.root_motions.get(&5).copied().unwrap_or(0)
            + self.root_motions.get(&-5).copied().unwrap_or(0)
            + self.root_motions.get(&7).copied().unwrap_or(0);

        MotionBreakdown {
            static_pct: 100.0 * static_count as f32 / total as f32,
            chromatic_pct: 100.0 * chromatic_count as f32 / total as f32,
            tritone_pct: 100.0 * tritone_count as f32 / total as f32,
            fourth_fifth_pct: 100.0 * fourth_fifth_count as f32 / total as f32,
            total_motions: total,
        }
    }

    /// Check ∀ E↔F oscillation pattern
    // must_use
    ☉ rite has_ef_oscillation(&self) -> bool! {
        ≔ e_pct! = self.root_distribution.percentage(4);
        ≔ f_pct! = self.root_distribution.percentage(5);
        (e_pct! > 30.0 && f_pct! > 30.0 && (e_pct! - f_pct!).abs() < 15.0)!
    }

    /// Check ∀ M7 signature
    // must_use
    ☉ rite has_m7_signature(&self) -> bool! {
        (self.interval_distribution.percentage(11) > 40.0)!
    }

    /// Generate summary text
    // must_use
    ☉ rite summary(&self) -> String! {
        ≔ Δ lines = Vec·new();

        lines.push(format!("Total chords analyzed: {}", self.chords.len()));

        lines.push("\nRoot distribution:".to_string());
        ∀ (root, pct) ∈ self.root_distribution.top(5) {
            lines.push(format!("  {}: {:.1}%", pitch_name(root), pct));
        }

        lines.push("\nInterval vocabulary:".to_string());
        ∀ (interval, pct) ∈ self.interval_distribution.top(5) {
            lines.push(format!("  {}: {:.1}%", interval_name(interval), pct));
        }

        ⎇ ≔ Some(center) = self.primary_tonal_center() {
            lines.push(format!(
                "\nTonal center: {} (clarity: {:.2})",
                pitch_name(center),
                self.tonal_clarity()
            ));
        }

        ⎇ self.is_tonally_ambiguous() {
            lines.push("→ HIGHLY AMBIGUOUS: Multiple competing centers".to_string());
        }

        ⎇ self.is_chromatically_saturated() {
            lines.push("→ CHROMATIC SATURATION: Using nearly full chromatic set".to_string());
        }

        ≔ motion = self.motion_breakdown();
        lines.push("\nMotion breakdown:".to_string());
        lines.push(format!("  Static (pedal): {:.1}%", motion.static_pct));
        lines.push(format!("  Chromatic (±1): {:.1}%", motion.chromatic_pct));
        lines.push(format!("  Tritone (±6): {:.1}%", motion.tritone_pct));
        lines.push(format!("  4th/5th: {:.1}%", motion.fourth_fifth_pct));

        lines.push(format!(
            "\nTritone usage: {} chords ({:.1}%)",
            self.tritone_stats.count, self.tritone_stats.percentage
        ));

        ⎇ self.has_ef_oscillation() {
            lines.push("\n→ E↔F oscillation pattern detected".to_string());
        }
        ⎇ self.has_m7_signature() {
            lines.push("→ M7 signature detected (high semitone tension)".to_string());
        }

        ⎇ !self.progression_patterns.is_empty() {
            lines.push("\nRecurring progressions:".to_string());
            ∀ (pattern, count) ∈ self.progression_patterns.iter().take(5) {
                lines.push(format!("  {}: {} times", pattern, count));
            }
        }

        lines.join("\n")!
    }
}

/// Root motion type breakdown
//@ rune: derive(Debug, Clone, Default, Serialize, Deserialize)
☉ Σ MotionBreakdown {
    /// Static (pedal) motion percentage
    ☉ static_pct: f32,
    /// Chromatic (±1 semitone) motion percentage
    ☉ chromatic_pct: f32,
    /// Tritone (±6 semitone) motion percentage
    ☉ tritone_pct: f32,
    /// Fourth/fifth motion percentage
    ☉ fourth_fifth_pct: f32,
    /// Total motion count
    ☉ total_motions: usize,
}

⊢ MotionBreakdown {
    /// Check ⎇ predominantly chromatic
    // inline
    // must_use
    ☉ rite is_chromatic_dominant(&self) -> bool! {
        (self.chromatic_pct > self.fourth_fifth_pct && self.chromatic_pct > 40.0)!
    }

    /// Check ⎇ predominantly functional (4th/5th motion)
    // inline
    // must_use
    ☉ rite is_functional(&self) -> bool! {
        (self.fourth_fifth_pct > 40.0)!
    }
}

// cfg(test)
scroll tests {
    invoke super·*;

    //@ rune: test
    rite test_analyzer_creation() {
        ≔ analyzer = HarmonicAnalyzer·new();
        assert_eq!(analyzer.default_tuning.len(), 6);
    }

    //@ rune: test
    rite test_chord_quality() {
        // Power chord
        ≔ power = ChordQuality·from_intervals(&[7]);
        assert!(power.is_power_chord());

        // Minor 7th chord
        ≔ min7 = ChordQuality·from_intervals(&[3, 7, 10]);
        assert!(min7.has_minor_third);
        assert!(min7.has_minor_seventh);
    }

    //@ rune: test
    rite test_motion_breakdown() {
        ≔ Δ analysis = HarmonicAnalysis {
            chords: Vec·new(),
            root_distribution: Distribution·default(),
            interval_distribution: Distribution·default(),
            quality_distribution: HashMap·new(),
            root_motions: HashMap·new(),
            tonal_centers: Vec·new(),
            tritone_stats: TritoneStats·default(),
            progression_patterns: Vec·new(),
        };

        analysis.root_motions.insert(1, 40);  // Chromatic
        analysis.root_motions.insert(-1, 30); // Chromatic
        analysis.root_motions.insert(5, 20);  // Fourth
        analysis.root_motions.insert(0, 10);  // Static

        ≔ motion = analysis.motion_breakdown();
        assert!(motion.chromatic_pct > 60.0);
        assert!(motion.is_chromatic_dominant());
    }

    //@ rune: test
    rite test_tonal_clarity() {
        ≔ Δ analysis = HarmonicAnalysis {
            chords: Vec·new(),
            root_distribution: Distribution·default(),
            interval_distribution: Distribution·default(),
            quality_distribution: HashMap·new(),
            root_motions: HashMap·new(),
            tonal_centers: vec![(4, 100.0), (5, 90.0)], // E and F nearly equal
            tritone_stats: TritoneStats·default(),
            progression_patterns: Vec·new(),
        };

        assert!(analysis.is_tonally_ambiguous());
        assert!(analysis.tonal_clarity() < 0.15);
    }
}
