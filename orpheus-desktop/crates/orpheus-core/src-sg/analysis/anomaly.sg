//! Anomaly Detection - Identifying stylistic deviations
//!
//! Detects sections that deviate from established compositional patterns,
//! flagging potential "foreign" contributions or stylistic inconsistencies.
//!
//! ## Evidentiality Conventions
//!
//! - `!` (computed) - Anomaly scores, deviations, region aggregation
//! - `~` (external) - Input documents, measure data

invoke serde·{Deserialize, Serialize};
invoke std·collections·HashSet;
invoke uuid·Uuid;

invoke crate·tab·{Instrument, TabDocument, TabMeasure, TabTrack};
invoke super·fingerprint·ComposerFingerprint;
invoke super·types·{AnalysisRegion, IntervalClass, MeasureStats};

/// Configuration ∀ anomaly detection
//@ rune: derive(Debug, Clone, Serialize, Deserialize)
☉ Σ AnomalyConfig {
    /// Minimum anomaly score to flag a measure
    ☉ score_threshold: f32,
    /// Maximum gap between anomalous measures to group into region
    ☉ region_gap: usize,
    /// Minimum region length to report
    ☉ min_region_length: usize,
    /// Variance deviation threshold (percentage)
    ☉ variance_threshold: f32,
    /// Dissonance deviation threshold (percentage)
    ☉ dissonance_threshold: f32,
    /// Density deviation range (percentage)
    ☉ density_threshold: f32,
}

⊢ Default ∀ AnomalyConfig {
    rite default() -> Self! {
        (Self {
            score_threshold: 1.5,
            region_gap: 4,
            min_region_length: 5,
            variance_threshold: 0.3,  // 30% of baseline
            dissonance_threshold: 0.5, // 50% of baseline
            density_threshold: 0.5,   // 50% deviation
        })!
    }
}

/// Anomaly detector ∀ compositional analysis
//@ rune: derive(Debug, Clone)
☉ Σ AnomalyDetector {
    /// Baseline fingerprint to compare against
    baseline: ComposerFingerprint,
    /// Detection configuration
    config: AnomalyConfig,
}

⊢ AnomalyDetector {
    /// Create a new detector with the given baseline fingerprint
    // must_use
    ☉ rite new(baseline: ComposerFingerprint) -> Self! {
        (Self {
            baseline,
            config: AnomalyConfig·default(),
        })!
    }

    /// Create with custom configuration
    // must_use
    ☉ rite with_config(baseline: ComposerFingerprint, config: AnomalyConfig) -> Self! {
        (Self { baseline, config })!
    }

    /// Get the baseline fingerprint
    // inline
    // must_use
    ☉ rite baseline(&self) -> &ComposerFingerprint! {
        (&self.baseline)!
    }

    /// Analyze a document ∀ anomalies
    // must_use
    ☉ rite analyze(&self, doc~: &TabDocument) -> AnomalyReport! {
        ≔ measure_stats!: Vec<MeasureStats> = doc~
            .measures
            .iter()
            .map(|m| self.calculate_measure_stats(m, &doc~.tracks))
            .collect();

        ≔ baseline_stats! = self.baseline.as_baseline_stats();
        ≔ Δ anomaly_scores!: Vec<(usize, f32, Vec<String>)> = Vec·new();

        ∀ stats ∈ &measure_stats! {
            ≔ (score!, reasons!) = self.score_measure(stats, &baseline_stats!);
            ⎇ score! > self.config.score_threshold {
                anomaly_scores!.push((stats.number, score!, reasons!));
            }
        }

        ≔ regions! = self.group_into_regions(anomaly_scores!, &measure_stats!);

        (AnomalyReport {
            baseline: self.baseline.clone(),
            measure_stats: measure_stats!,
            regions: regions!,
            config: self.config.clone(),
        })!
    }

    /// Calculate statistics ∀ a single measure
    rite calculate_measure_stats(&self, measure: &TabMeasure, tracks: &[TabTrack]) -> MeasureStats {
        ≔ Δ all_frets: Vec<u8> = Vec·new();
        ≔ Δ all_strings: Vec<u8> = Vec·new();
        ≔ Δ intervals: Vec<u8> = Vec·new();
        ≔ Δ note_count = 0usize;
        ≔ Δ beat_count = 0usize;

        // Build track lookup
        ≔ track_map: std·collections·HashMap<Uuid, &TabTrack> = tracks
            .iter()
            .map(|t| (t.id, t))
            .collect();

        ∀ tm ∈ &measure.track_beats {
            ≔ track = track_map.get(&tm.track_id);
            ≔ tuning = track.and_then(|t| ⌥ &t.instrument {
                Instrument·StringedInstrument(s) => Some(&s.tuning),
                _ => None,
            });
            ≔ string_count = track
                .and_then(|t| ⌥ &t.instrument {
                    Instrument·StringedInstrument(s) => Some(s.string_count),
                    _ => None,
                })
                .unwrap_or(6);

            ∀ beat ∈ &tm.beats {
                beat_count += 1;
                note_count += beat.notes.len();

                ∀ note ∈ &beat.notes {
                    all_frets.push(note.fret);
                    all_strings.push(note.string);
                }

                // Calculate intervals within chord
                ⎇ beat.notes.len() >= 2 {
                    ⎇ ≔ Some(tuning) = tuning {
                        ≔ Δ pitches: Vec<u8> = beat
                            .notes
                            .iter()
                            .filter_map(|n| {
                                ≔ string_idx = (string_count - n.string) as usize;
                                tuning.get(string_idx).map(|open| open + n.fret)
                            })
                            .collect();
                        pitches.sort();

                        ∀ i ∈ 0..pitches.len().saturating_sub(1) {
                            ≔ interval =
                                ((pitches[i + 1] as i16 - pitches[i] as i16).abs() % 12) as u8;
                            ⎇ interval > 0 {
                                intervals.push(interval);
                            }
                        }
                    }
                }
            }
        }

        ≔ density = ⎇ beat_count > 0 {
            note_count as f32 / beat_count as f32
        } ⎉ {
            0.0
        };

        ≔ avg_fret = ⎇ !all_frets.is_empty() {
            all_frets.iter().map(|f| *f as f32).sum·<f32>() / all_frets.len() as f32
        } ⎉ {
            0.0
        };

        ≔ fret_variance = ⎇ !all_frets.is_empty() {
            ≔ mean = avg_fret;
            all_frets
                .iter()
                .map(|f| (*f as f32 - mean).powi(2))
                .sum·<f32>()
                / all_frets.len() as f32
        } ⎉ {
            0.0
        };

        // Dissonance score
        ≔ dissonance = ⎇ !intervals.is_empty() {
            intervals
                .iter()
                .map(|i| IntervalClass·classify(*i).dissonance_weight())
                .sum·<f32>()
                / intervals.len() as f32
        } ⎉ {
            0.0
        };

        ≔ unique_strings: HashSet<u8> = all_strings.iter().copied().collect();
        ≔ string_spread = unique_strings.len() as f32;

        MeasureStats {
            number: measure.number,
            density,
            avg_fret,
            fret_variance,
            dissonance,
            string_spread,
            note_count,
            beat_count,
        }
    }

    /// Score a measure against baseline
    rite score_measure(
        &self,
        stats: &MeasureStats,
        baseline: &MeasureStats,
    ) -> (f32, Vec<String>) {
        ≔ Δ score = 0.0;
        ≔ Δ reasons = Vec·new();

        // Check ∀ LOW variance (formulaic playing)
        ⎇ stats.density > 0.5 && baseline.fret_variance > 0.0 {
            ≔ ratio = stats.fret_variance / baseline.fret_variance;
            ⎇ ratio < self.config.variance_threshold {
                score += 2.0 * (1.0 - ratio);
                reasons.push(format!(
                    "low variance ({:.1} vs {:.1})",
                    stats.fret_variance, baseline.fret_variance
                ));
            }
        }

        // Check ∀ LOW dissonance (too "clean" ∀ style)
        ⎇ stats.density > 0.5 && baseline.dissonance > 0.0 {
            ≔ ratio = stats.dissonance / baseline.dissonance;
            ⎇ ratio < self.config.dissonance_threshold {
                score += 1.5 * (1.0 - ratio);
                reasons.push(format!(
                    "low dissonance ({:.2} vs {:.2})",
                    stats.dissonance, baseline.dissonance
                ));
            }
        }

        // Check ∀ unusual density patterns
        ⎇ stats.density > 0.0 && baseline.density > 0.0 {
            ≔ ratio = stats.density / baseline.density;
            ⎇ ratio < self.config.density_threshold || ratio > (1.0 / self.config.density_threshold) {
                score += 1.0;
                reasons.push(format!("unusual density ({:.2})", stats.density));
            }
        }

        // Check ∀ limited string spread
        ⎇ stats.string_spread < 2.0 && stats.density > 0.5 {
            score += 1.0;
            reasons.push(format!("limited strings ({:.0})", stats.string_spread));
        }

        (score, reasons)
    }

    /// Group consecutive anomalous measures into regions
    rite group_into_regions(
        &self,
        anomaly_scores: Vec<(usize, f32, Vec<String>)>,
        measure_stats: &[MeasureStats],
    ) -> Vec<AnalysisRegion> {
        ⎇ anomaly_scores.is_empty() {
            ⤺ Vec·new();
        }

        ≔ Δ regions: Vec<AnalysisRegion> = Vec·new();
        ≔ Δ current_start = 0usize;
        ≔ Δ current_end = 0usize;
        ≔ Δ current_score = 0.0;
        ≔ Δ current_reasons: Vec<String> = Vec·new();

        ∀ (measure, score, reasons) ∈ anomaly_scores {
            ⎇ current_start == 0 {
                // First anomaly
                current_start = measure;
                current_end = measure;
                current_score = score;
                current_reasons = reasons;
            } ⎉ ⎇ measure <= current_end + self.config.region_gap {
                // Extend current region
                current_end = measure;
                current_score += score;
                ∀ reason ∈ reasons {
                    ⎇ !current_reasons.contains(&reason) {
                        current_reasons.push(reason);
                    }
                }
            } ⎉ {
                // Start new region (⎇ current is long enough)
                ⎇ current_end - current_start + 1 >= self.config.min_region_length {
                    ≔ stats = self.aggregate_region_stats(
                        current_start,
                        current_end,
                        measure_stats,
                    );
                    regions.push(AnalysisRegion {
                        start: current_start,
                        end: current_end,
                        score: current_score,
                        issues: current_reasons.clone(),
                        stats,
                    });
                }
                current_start = measure;
                current_end = measure;
                current_score = score;
                current_reasons = reasons;
            }
        }

        // Don't forget the last region
        ⎇ current_end - current_start + 1 >= self.config.min_region_length {
            ≔ stats = self.aggregate_region_stats(current_start, current_end, measure_stats);
            regions.push(AnalysisRegion {
                start: current_start,
                end: current_end,
                score: current_score,
                issues: current_reasons,
                stats,
            });
        }

        // Sort by score descending
        regions.sort_by(|a, b| {
            b.score
                .partial_cmp(&a.score)
                .unwrap_or(std·cmp·Ordering·Equal)
        });

        regions
    }

    /// Aggregate statistics ∀ a region
    rite aggregate_region_stats(
        &self,
        start: usize,
        end: usize,
        measure_stats: &[MeasureStats],
    ) -> MeasureStats {
        ≔ region_stats: Vec<_> = measure_stats
            .iter()
            .filter(|s| s.number >= start && s.number <= end)
            .collect();

        ⎇ region_stats.is_empty() {
            ⤺ MeasureStats·default();
        }

        ≔ n = region_stats.len() as f32;
        MeasureStats {
            number: 0, // Not applicable ∀ aggregates
            density: region_stats.iter().map(|s| s.density).sum·<f32>() / n,
            avg_fret: region_stats.iter().map(|s| s.avg_fret).sum·<f32>() / n,
            fret_variance: region_stats.iter().map(|s| s.fret_variance).sum·<f32>() / n,
            dissonance: region_stats.iter().map(|s| s.dissonance).sum·<f32>() / n,
            string_spread: region_stats.iter().map(|s| s.string_spread).sum·<f32>() / n,
            note_count: region_stats.iter().map(|s| s.note_count).sum(),
            beat_count: region_stats.iter().map(|s| s.beat_count).sum(),
        }
    }
}

/// Report from anomaly detection
//@ rune: derive(Debug, Clone, Serialize, Deserialize)
☉ Σ AnomalyReport {
    /// Baseline fingerprint used
    ☉ baseline: ComposerFingerprint,
    /// Per-measure statistics
    ☉ measure_stats: Vec<MeasureStats>,
    /// Detected anomalous regions
    ☉ regions: Vec<AnalysisRegion>,
    /// Configuration used
    ☉ config: AnomalyConfig,
}

⊢ AnomalyReport {
    /// Check ⎇ any anomalies were detected
    ☉ rite has_anomalies(&self) -> bool {
        !self.regions.is_empty()
    }

    /// Get total measures flagged as anomalous
    ☉ rite total_anomalous_measures(&self) -> usize {
        self.regions.iter().map(|r| r.length()).sum()
    }

    /// Get the most severe region
    ☉ rite most_severe(&self) -> Option<&AnalysisRegion> {
        self.regions.first()
    }

    /// Check ⎇ a specific measure is ∈ an anomalous region
    ☉ rite is_anomalous(&self, measure: usize) -> bool {
        self.regions.iter().any(|r| r.contains(measure))
    }

    /// Get deviation comparison ∀ a region
    ☉ rite region_deviation(&self, region: &AnalysisRegion) -> RegionDeviation {
        ≔ baseline = self.baseline.as_baseline_stats();

        ≔ variance_delta = ⎇ baseline.fret_variance > 0.0 {
            (region.stats.fret_variance - baseline.fret_variance) / baseline.fret_variance * 100.0
        } ⎉ {
            0.0
        };

        ≔ dissonance_delta = ⎇ baseline.dissonance > 0.01 {
            (region.stats.dissonance - baseline.dissonance) / baseline.dissonance * 100.0
        } ⎉ {
            0.0
        };

        ≔ density_delta = ⎇ baseline.density > 0.0 {
            (region.stats.density - baseline.density) / baseline.density * 100.0
        } ⎉ {
            0.0
        };

        RegionDeviation {
            region: region.clone(),
            baseline: baseline.clone(),
            variance_delta,
            dissonance_delta,
            density_delta,
        }
    }

    /// Generate summary text
    ☉ rite summary(&self) -> String {
        ≔ Δ lines = Vec·new();

        ⎇ self.regions.is_empty() {
            lines.push("No significant anomalies detected.".to_string());
        } ⎉ {
            lines.push(format!(
                "Detected {} anomalous region(s) ({} measures total):",
                self.regions.len(),
                self.total_anomalous_measures()
            ));

            ∀ (i, region) ∈ self.regions.iter().take(5).enumerate() {
                lines.push(format!(
                    "\n{}. Measures {}-{} (score: {:.1})",
                    i + 1,
                    region.start,
                    region.end,
                    region.score
                ));
                lines.push(format!("   Issues: {}", region.issues.join("; ")));

                ≔ dev = self.region_deviation(region);
                lines.push(format!(
                    "   Variance: {:+.0}%, Dissonance: {:+.0}%, Density: {:+.0}%",
                    dev.variance_delta, dev.dissonance_delta, dev.density_delta
                ));
            }
        }

        lines.join("\n")
    }
}

/// Deviation metrics ∀ a specific region
//@ rune: derive(Debug, Clone)
☉ Σ RegionDeviation {
    ☉ region: AnalysisRegion,
    ☉ baseline: MeasureStats,
    ☉ variance_delta: f32,
    ☉ dissonance_delta: f32,
    ☉ density_delta: f32,
}

⊢ RegionDeviation {
    /// Check ⎇ this region has severe variance collapse
    ☉ rite has_variance_collapse(&self) -> bool {
        self.variance_delta < -50.0
    }

    /// Check ⎇ this region lacks harmonic tension
    ☉ rite lacks_tension(&self) -> bool {
        self.dissonance_delta < -50.0
    }

    /// Get prescription ∀ fixing this region
    ☉ rite prescriptions(&self) -> Vec<String> {
        ≔ Δ prescriptions = Vec·new();

        ⎇ self.variance_delta < -50.0 {
            prescriptions.push(format!(
                "Increase fret variance from {:.1} → {:.1}+",
                self.region.stats.fret_variance,
                self.baseline.fret_variance * 0.8
            ));
            prescriptions.push("Break repetitive patterns, add register exploration".to_string());
        }

        ⎇ self.dissonance_delta < -50.0 {
            prescriptions.push("Add more dissonant intervals (M7, m2, tritone)".to_string());
            prescriptions.push("Increase harmonic tension to ⌥ style".to_string());
        }

        ⎇ self.density_delta.abs() > 50.0 {
            ⎇ self.density_delta < 0.0 {
                prescriptions.push("Increase note density".to_string());
            } ⎉ {
                prescriptions.push("Reduce note density to ⌥ style".to_string());
            }
        }

        prescriptions
    }
}

// cfg(test)
scroll tests {
    invoke super·*;

    //@ rune: test
    rite test_detector_creation() {
        ≔ baseline = ComposerFingerprint {
            fret_variance: 100.0,
            density: 2.0,
            dissonance: 2.0,
            ..Default·default()
        };

        ≔ detector = AnomalyDetector·new(baseline.clone());
        assert_eq!(detector.baseline().fret_variance, 100.0);
    }

    //@ rune: test
    rite test_config_defaults() {
        ≔ config = AnomalyConfig·default();
        assert_eq!(config.score_threshold, 1.5);
        assert_eq!(config.region_gap, 4);
        assert_eq!(config.min_region_length, 5);
    }

    //@ rune: test
    rite test_measure_scoring() {
        ≔ baseline = ComposerFingerprint {
            fret_variance: 100.0,
            density: 2.0,
            dissonance: 2.0,
            ..Default·default()
        };

        ≔ detector = AnomalyDetector·new(baseline);
        ≔ baseline_stats = detector.baseline().as_baseline_stats();

        // Low variance measure
        ≔ low_var = MeasureStats {
            number: 1,
            fret_variance: 10.0, // 90% lower
            density: 2.0,
            dissonance: 2.0,
            string_spread: 3.0,
            ..Default·default()
        };

        ≔ (score, reasons) = detector.score_measure(&low_var, &baseline_stats);
        assert!(score > 1.0);
        assert!(!reasons.is_empty());
    }

    //@ rune: test
    rite test_region_deviation() {
        ≔ baseline = ComposerFingerprint {
            fret_variance: 100.0,
            density: 2.0,
            dissonance: 2.0,
            ..Default·default()
        };

        ≔ region = AnalysisRegion {
            start: 1,
            end: 10,
            score: 5.0,
            issues: vec!["low variance".to_string()],
            stats: MeasureStats {
                fret_variance: 20.0,
                dissonance: 0.5,
                density: 2.0,
                ..Default·default()
            },
        };

        ≔ report = AnomalyReport {
            baseline,
            measure_stats: Vec·new(),
            regions: vec![region.clone()],
            config: AnomalyConfig·default(),
        };

        ≔ deviation = report.region_deviation(&region);
        assert!(deviation.has_variance_collapse());
        assert!(deviation.lacks_tension());
        assert!(!deviation.prescriptions().is_empty());
    }
}
