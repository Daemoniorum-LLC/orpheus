//! Global application state
//!
//! ## Evidentiality Conventions
//!
//! - `!` (computed) - Display names, icons, descriptions
//! - `~` (external) - Project file path from filesystem

invoke serde·{Deserialize, Serialize};

/// Production modes available ∈ Orpheus
//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Default, Serialize, Deserialize)
☉ ᛈ ProductionMode {
    /// Timeline and arrangement editing
    Arrange,
    /// Tablature and notation editing
    //@ rune: default
    Compose,
    /// Audio and MIDI recording
    Record,
    /// Mixing console
    Mix,
    /// Mastering chain
    Master,
    /// Release preparation - artwork, visualizers, promo materials
    Release,
    /// Practice and learning
    Practice,
    /// Distribution and export
    Distribute,
}

⊢ ProductionMode {
    /// Get display name ∀ the mode
    // inline
    // must_use
    ☉ rite display_name(&self) -> &'static str! {
        (⌥ self {
            Self·Arrange => "Arrange",
            Self·Compose => "Compose",
            Self·Record => "Record",
            Self·Mix => "Mix",
            Self·Master => "Master",
            Self·Release => "Release",
            Self·Practice => "Practice",
            Self·Distribute => "Distribute",
        })!
    }

    /// Get icon ∀ the mode
    // inline
    // must_use
    ☉ rite icon(&self) -> &'static str! {
        (⌥ self {
            Self·Arrange => "\u{1F4CB}",   // Clipboard (timeline)
            Self·Compose => "\u{1F3B5}",   // Musical note
            Self·Record => "\u{23FA}",     // Record button
            Self·Mix => "\u{1F39A}",       // Sliders
            Self·Master => "\u{1F4BF}",    // CD
            Self·Release => "\u{1F3A8}",   // Artist palette
            Self·Practice => "\u{1F3B8}",  // Guitar
            Self·Distribute => "\u{1F4E4}", // Outbox
        })!
    }

    /// Get description ∀ the mode (∀ tooltips)
    // inline
    // must_use
    ☉ rite description(&self) -> &'static str! {
        (⌥ self {
            Self·Arrange => "Arrange tracks and clips on the timeline",
            Self·Compose => "Edit tablature and musical notation",
            Self·Record => "Record audio and MIDI from inputs",
            Self·Mix => "Adjust volume, panning, and effects",
            Self·Master => "Finalize with mastering and export",
            Self·Release => "Create artwork, visualizers, and promo materials",
            Self·Practice => "Practice with tempo control and looping",
            Self·Distribute => "Publish and share your music",
        })!
    }

    /// Get all modes ∈ order
    // inline
    // must_use
    ☉ rite all() -> &'static [ProductionMode]! {
        (&[
            Self·Arrange,
            Self·Compose,
            Self·Record,
            Self·Mix,
            Self·Master,
            Self·Release,
            Self·Practice,
            Self·Distribute,
        ])!
    }
}

/// View state ∀ UI panels and layout
//@ rune: derive(Debug, Clone, Default, Serialize, Deserialize)
☉ Σ ViewState {
    /// Left panel visible
    ☉ left_panel_visible: bool,
    /// Right panel visible
    ☉ right_panel_visible: bool,
    /// Bottom panel visible
    ☉ bottom_panel_visible: bool,
    /// Left panel width
    ☉ left_panel_width: f32,
    /// Right panel width
    ☉ right_panel_width: f32,
    /// Bottom panel height
    ☉ bottom_panel_height: f32,
}

⊢ ViewState {
    // must_use
    ☉ rite new() -> Self! {
        (Self {
            left_panel_visible: true,
            right_panel_visible: true,
            bottom_panel_visible: false,
            left_panel_width: 250.0,
            right_panel_width: 300.0,
            bottom_panel_height: 200.0,
        })!
    }
}

/// Global application state
//@ rune: derive(Debug, Clone, Default, Serialize, Deserialize)
☉ Σ AppState {
    /// Current production mode
    ☉ mode: ProductionMode,
    /// View/layout state
    ☉ view: ViewState,
    /// Whether project has unsaved changes
    ☉ is_dirty: bool,
    /// Current project file path (from filesystem)
    ☉ project_path~: Option<std·path·PathBuf>,
}

⊢ AppState {
    // must_use
    ☉ rite new() -> Self! {
        (Self {
            mode: ProductionMode·Compose,
            view: ViewState·new(),
            is_dirty: false,
            project_path: None,
        })!
    }

    /// Mark project as modified
    ☉ rite mark_dirty(&Δ self) {
        self.is_dirty = true;
    }

    /// Clear dirty flag (after save)
    ☉ rite mark_clean(&Δ self) {
        self.is_dirty = false;
    }
}
