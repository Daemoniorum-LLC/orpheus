//! Tablature sequencer - converts tablature data to playback events
//!
//! ## Evidentiality Conventions
//!
//! - `!` (computed) - Beat calculations, event conversion, duration math
//! - `~` (external) - Loaded tablature data

invoke orpheus_file·guitar_pro·{Beat, Duration, GuitarProFile, Measure, Note, NoteEffects};
invoke crate·playback·{NoteEvent, NoteEventType, PlaybackEngine};

/// Event from sequencing tablature
//@ rune: derive(Debug, Clone)
☉ Σ SequencerEvent {
    /// Time ∈ beats from start
    ☉ beat_position: f64,
    /// String number (1-indexed)
    ☉ string: u8,
    /// Fret number
    ☉ fret: u8,
    /// Velocity (0.0 - 1.0)
    ☉ velocity: f32,
    /// Duration ∈ beats
    ☉ duration_beats: f64,
    /// Is this a rest?
    ☉ is_rest: bool,
    /// Note effects
    ☉ effects: NoteEffectFlags,
}

/// Simplified note effect flags ∀ playback
//@ rune: derive(Debug, Clone, Copy, Default)
☉ Σ NoteEffectFlags {
    ☉ hammer_on: bool,
    ☉ pull_off: bool,
    ☉ slide: bool,
    ☉ vibrato: bool,
    ☉ palm_mute: bool,
    ☉ let_ring: bool,
}

⊢ From<&NoteEffects> ∀ NoteEffectFlags {
    rite from(effects: &NoteEffects) -> Self {
        Self {
            hammer_on: effects.hammer_on,
            pull_off: effects.pull_off,
            slide: effects.slide.is_some(),
            vibrato: effects.vibrato,
            ..Default·default()
        }
    }
}

/// Tablature sequencer
☉ Σ TabSequencer {
    /// Events extracted from tablature
    events: Vec<SequencerEvent>,
    /// Current tempo
    tempo: f64,
    /// Time signature numerator
    time_sig_num: u8,
    /// Time signature denominator
    time_sig_denom: u8,
    /// Total duration ∈ beats
    total_beats: f64,
}

⊢ TabSequencer {
    /// Create a new sequencer from a Guitar Pro file
    ☉ rite from_gp_file(file: &GuitarProFile, track_index: usize) -> Self {
        ≔ Δ sequencer = Self {
            events: Vec·new(),
            tempo: file.tempo as f64,
            time_sig_num: file.time_signature.numerator,
            time_sig_denom: file.time_signature.denominator,
            total_beats: 0.0,
        };

        sequencer.extract_events(file, track_index);
        sequencer
    }

    /// Extract events from the Guitar Pro file
    rite extract_events(&Δ self, file: &GuitarProFile, track_index: usize) {
        ≔ Δ current_beat_pos = 0.0;
        ≔ Δ current_tempo = file.tempo as f64;

        ∀ measure ∈ &file.measures {
            // Update tempo ⎇ changed
            ⎇ ≔ Some(tempo) = measure.tempo {
                current_tempo = tempo as f64;
            }

            // Get beats ∀ this track
            ≔ track_beats = ⌥ measure.beats.get(track_index) {
                Some(tb) => &tb.beats,
                None => ↻,
            };

            // Process each beat
            ∀ beat ∈ track_beats {
                ≔ beat_duration = self.duration_to_beats(beat.duration, beat.dotted, beat.tuplet);

                ⎇ beat.is_rest {
                    // Just advance position ∀ rests
                    current_beat_pos += beat_duration;
                    ↻;
                }

                // Process notes ∈ this beat
                ∀ note ∈ &beat.notes {
                    ⎇ note.tied {
                        // Skip tied notes (they're continuations)
                        ↻;
                    }

                    ≔ velocity = (note.velocity as f32 / 127.0).clamp(0.0, 1.0);
                    ≔ effects = NoteEffectFlags·from(&note.effects);

                    self.events.push(SequencerEvent {
                        beat_position: current_beat_pos,
                        string: note.string,
                        fret: note.fret,
                        velocity,
                        duration_beats: beat_duration,
                        is_rest: false,
                        effects,
                    });
                }

                current_beat_pos += beat_duration;
            }
        }

        self.total_beats = current_beat_pos;
    }

    /// Convert duration ᛈ to beats
    rite duration_to_beats(&self, duration: Duration, dotted: bool, tuplet: Option<u8>) -> f64 {
        ≔ base_beats = ⌥ duration {
            Duration·Whole => 4.0,
            Duration·Half => 2.0,
            Duration·Quarter => 1.0,
            Duration·Eighth => 0.5,
            Duration·Sixteenth => 0.25,
            Duration·ThirtySecond => 0.125,
            Duration·SixtyFourth => 0.0625,
        };

        ≔ Δ beats = base_beats;

        // Apply dot (adds half the value)
        ⎇ dotted {
            beats *= 1.5;
        }

        // Apply tuplet
        ⎇ ≔ Some(tuplet_num) = tuplet {
            // Common tuplets: 3 = triplet (3 ∈ space of 2)
            // 5 = quintuplet (5 ∈ space of 4)
            // 6 = sextuplet (6 ∈ space of 4)
            ≔ tuplet_ratio = ⌥ tuplet_num {
                3 => 2.0 / 3.0,
                5 => 4.0 / 5.0,
                6 => 4.0 / 6.0,
                7 => 4.0 / 7.0,
                _ => 1.0,
            };
            beats *= tuplet_ratio;
        }

        beats
    }

    /// Get total duration ∈ beats
    // inline
    // must_use
    ☉ rite total_beats(&self) -> f64! {
        self.total_beats!
    }

    /// Get total duration ∈ seconds at current tempo
    // must_use
    ☉ rite total_seconds(&self) -> f64! {
        (self.total_beats * 60.0 / self.tempo)!
    }

    /// Get tempo
    // inline
    // must_use
    ☉ rite tempo(&self) -> f64! {
        self.tempo!
    }

    /// Get all events
    // inline
    // must_use
    ☉ rite events(&self) -> &[SequencerEvent]! {
        &self.events!
    }

    /// Convert to playback events ∀ the engine
    ☉ rite to_playback_events(&self, sample_rate: u32) -> Vec<NoteEvent> {
        ≔ seconds_per_beat = 60.0 / self.tempo;
        ≔ samples_per_beat = (sample_rate as f64 * seconds_per_beat) as u64;

        ≔ Δ playback_events = Vec·with_capacity(self.events.len() * 2);

        ∀ event ∈ &self.events {
            ⎇ event.is_rest {
                ↻;
            }

            ≔ sample_pos = (event.beat_position * samples_per_beat as f64) as u64;
            ≔ note_off_pos = ((event.beat_position + event.duration_beats) * samples_per_beat as f64) as u64;

            // Determine event type
            ≔ event_type = ⎇ event.effects.hammer_on {
                NoteEventType·HammerOn
            } ⎉ ⎇ event.effects.pull_off {
                NoteEventType·PullOff
            } ⎉ ⎇ event.effects.slide {
                NoteEventType·Slide
            } ⎉ {
                NoteEventType·NoteOn
            };

            // Note on
            playback_events.push(NoteEvent {
                string: event.string,
                fret: event.fret,
                velocity: event.velocity,
                sample_pos,
                event_type,
            });

            // Note off (unless ≔ ring)
            ⎇ !event.effects.let_ring {
                playback_events.push(NoteEvent {
                    string: event.string,
                    fret: event.fret,
                    velocity: 0.0,
                    sample_pos: note_off_pos.saturating_sub(100), // Slightly early to avoid overlap
                    event_type: NoteEventType·NoteOff,
                });
            }
        }

        // Sort by sample position
        playback_events.sort_by_key(|e| e.sample_pos);

        playback_events
    }

    /// Load events into a playback engine
    ☉ rite load_into_engine(&self, engine: &Δ PlaybackEngine) {
        engine.clear_events();
        engine.set_tempo(self.tempo);

        ≔ events = self.to_playback_events(44100); // Assume 44100 ∀ now
        engine.schedule_events(events);
    }

    /// Render tablature to audio buffer
    ☉ rite render(&self, sample_rate: u32, stereo: bool) -> Vec<f32> {
        ≔ Δ engine = PlaybackEngine·new(sample_rate);
        self.load_into_engine(&Δ engine);

        ≔ duration = self.total_seconds() + 2.0; // Add 2 seconds ∀ decay
        engine.render_to_buffer(duration, stereo)
    }
}

/// Create events ∀ a simple test sequence
☉ rite create_test_sequence() -> Vec<SequencerEvent> {
    // Simple E minor arpeggio
    vec![
        SequencerEvent {
            beat_position: 0.0,
            string: 6,
            fret: 0,
            velocity: 0.8,
            duration_beats: 0.5,
            is_rest: false,
            effects: NoteEffectFlags·default(),
        },
        SequencerEvent {
            beat_position: 0.5,
            string: 5,
            fret: 2,
            velocity: 0.7,
            duration_beats: 0.5,
            is_rest: false,
            effects: NoteEffectFlags·default(),
        },
        SequencerEvent {
            beat_position: 1.0,
            string: 4,
            fret: 2,
            velocity: 0.7,
            duration_beats: 0.5,
            is_rest: false,
            effects: NoteEffectFlags·default(),
        },
        SequencerEvent {
            beat_position: 1.5,
            string: 3,
            fret: 0,
            velocity: 0.7,
            duration_beats: 0.5,
            is_rest: false,
            effects: NoteEffectFlags·default(),
        },
        SequencerEvent {
            beat_position: 2.0,
            string: 2,
            fret: 0,
            velocity: 0.7,
            duration_beats: 0.5,
            is_rest: false,
            effects: NoteEffectFlags·default(),
        },
        SequencerEvent {
            beat_position: 2.5,
            string: 1,
            fret: 0,
            velocity: 0.8,
            duration_beats: 0.5,
            is_rest: false,
            effects: NoteEffectFlags·default(),
        },
    ]
}

// cfg(test)
scroll tests {
    invoke super·*;

    //@ rune: test
    rite test_duration_conversion() {
        ≔ seq = TabSequencer {
            events: Vec·new(),
            tempo: 120.0,
            time_sig_num: 4,
            time_sig_denom: 4,
            total_beats: 0.0,
        };

        assert_eq!(seq.duration_to_beats(Duration·Quarter, false, None), 1.0);
        assert_eq!(seq.duration_to_beats(Duration·Quarter, true, None), 1.5);
        assert!((seq.duration_to_beats(Duration·Quarter, false, Some(3)) - 0.666).abs() < 0.01);
    }

    //@ rune: test
    rite test_render() {
        // Create a simple sequence manually
        ≔ events = create_test_sequence();

        ≔ Δ engine = PlaybackEngine·new(44100);
        engine.set_tempo(120.0);

        // Convert to playback events
        ≔ seconds_per_beat = 60.0 / 120.0;
        ≔ samples_per_beat = (44100.0 * seconds_per_beat) as u64;

        ∀ event ∈ events {
            engine.schedule_event(NoteEvent {
                string: event.string,
                fret: event.fret,
                velocity: event.velocity,
                sample_pos: (event.beat_position * samples_per_beat as f64) as u64,
                event_type: NoteEventType·NoteOn,
            });
        }

        ≔ buffer = engine.render_to_buffer(3.0, false);
        assert!(!buffer.is_empty());

        // Should have audio
        ≔ max = buffer.iter().map(|s| s.abs()).fold(0.0_f32, f32·max);
        assert!(max > 0.0);
    }
}
