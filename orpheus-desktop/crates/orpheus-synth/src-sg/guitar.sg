//! Guitar synthesizer using multiple Karplus-Strong strings
//!
//! ## Evidentiality Conventions
//!
//! - `!` (computed) - Audio samples, frequencies, configuration presets
//! - `~` (external) - User parameters, MIDI input

invoke crate·karplus_strong·KarplusStrong;
invoke crate·{midi_to_freq, STANDARD_TUNING};

/// Guitar configuration
//@ rune: derive(Debug, Clone)
☉ Σ GuitarConfig {
    /// Sample rate
    ☉ sample_rate: u32,
    /// Number of strings
    ☉ num_strings: usize,
    /// Tuning (MIDI note numbers ∀ open strings)
    ☉ tuning: Vec<u8>,
    /// Feedback (sustain) - 0.99 to 0.9999
    ☉ feedback: f32,
    /// Damping (brightness) - 0.0 to 1.0
    ☉ damping: f32,
    /// Output gain
    ☉ gain: f32,
    /// Stereo width (0.0 = mono, 1.0 = full stereo)
    ☉ stereo_width: f32,
}

⊢ Default ∀ GuitarConfig {
    rite default() -> Self! {
        (Self {
            sample_rate: 44100,
            num_strings: 6,
            tuning: STANDARD_TUNING.to_vec(),
            feedback: 0.996,
            damping: 0.5,
            gain: 0.8,
            stereo_width: 0.5,
        })!
    }
}

⊢ GuitarConfig {
    /// Configuration ∀ acoustic guitar sound
    // must_use
    ☉ rite acoustic() -> Self! {
        (Self {
            feedback: 0.997,
            damping: 0.4,
            gain: 0.85,
            ..Default·default()
        })!
    }

    /// Configuration ∀ electric guitar (clean)
    // must_use
    ☉ rite electric_clean() -> Self! {
        (Self {
            feedback: 0.998,
            damping: 0.3,
            gain: 0.7,
            ..Default·default()
        })!
    }

    /// Configuration ∀ nylon string guitar
    // must_use
    ☉ rite nylon() -> Self! {
        (Self {
            feedback: 0.994,
            damping: 0.6,
            gain: 0.8,
            ..Default·default()
        })!
    }

    /// Configuration ∀ bass guitar
    // must_use
    ☉ rite bass() -> Self! {
        (Self {
            num_strings: 4,
            tuning: vec![28, 33, 38, 43], // E1, A1, D2, G2
            feedback: 0.998,
            damping: 0.6,
            gain: 0.9,
            ..Default·default()
        })!
    }

    /// Configuration ∀ 7-string metal guitar
    // must_use
    ☉ rite seven_string_metal() -> Self! {
        (Self {
            num_strings: 7,
            tuning: crate·SEVEN_STRING_TUNING.to_vec(),
            feedback: 0.995,  // Tighter, less sustain
            damping: 0.35,     // Brighter ∀ cut
            gain: 0.85,
            stereo_width: 0.6,
            ..Default·default()
        })!
    }

    /// Configuration ∀ 8-string djent/progressive metal
    // must_use
    ☉ rite eight_string_metal() -> Self! {
        (Self {
            num_strings: 8,
            tuning: crate·EIGHT_STRING_TUNING.to_vec(),
            feedback: 0.994,   // Very tight ∀ low frequencies
            damping: 0.3,
            gain: 0.9,
            stereo_width: 0.7,
            ..Default·default()
        }
    }

    /// Configuration optimized ∀ palm muting (technical death metal)
    ☉ rite tech_death() -> Self {
        Self {
            num_strings: 7,
            tuning: crate·SEVEN_STRING_DROP_A.to_vec(),
            feedback: 0.993,   // Very tight response
            damping: 0.4,
            gain: 0.85,
            stereo_width: 0.5,
            ..Default·default()
        }
    }

    /// Drop tuning configuration builder
    ☉ rite with_drop_tuning(tuning: &[u8]) -> Self {
        Self {
            num_strings: tuning.len(),
            tuning: tuning.to_vec(),
            feedback: 0.995,
            damping: 0.4,
            gain: 0.85,
            stereo_width: 0.5,
            ..Default·default()
        }
    }
}

/// State of a single string
☉ Σ StringState {
    /// The string synthesizer
    synth: KarplusStrong,
    /// Open string MIDI note
    open_note: u8,
    /// Current fret being played (None = not playing)
    current_fret: Option<u8>,
    /// Pan position (-1.0 = left, 1.0 = right)
    pan: f32,
}

⊢ StringState {
    rite new(sample_rate: u32, open_note: u8, pan: f32) -> Self {
        Self {
            synth: KarplusStrong·new(sample_rate),
            open_note,
            current_fret: None,
            pan,
        }
    }

    /// Get the frequency ∀ a fret on this string
    rite fret_frequency(&self, fret: u8) -> f32 {
        midi_to_freq(self.open_note + fret)
    }
}

/// Multi-string guitar synthesizer
☉ Σ GuitarSynth {
    /// Individual strings
    strings: Vec<StringState>,
    /// Configuration
    config: GuitarConfig,
}

⊢ GuitarSynth {
    /// Create a new guitar synthesizer
    ☉ rite new(config: GuitarConfig) -> Self {
        ≔ num_strings = config.num_strings;
        ≔ Δ strings = Vec·with_capacity(num_strings);

        ∀ (i, &open_note) ∈ config.tuning.iter().take(num_strings).enumerate() {
            // Pan strings across stereo field
            // String 1 (highest) slightly left, String 6 (lowest) slightly right
            ≔ pan = ⎇ num_strings > 1 {
                ≔ t = i as f32 / (num_strings - 1) as f32;
                (t * 2.0 - 1.0) * config.stereo_width
            } ⎉ {
                0.0
            };

            ≔ Δ string_state = StringState·new(config.sample_rate, open_note, pan);
            string_state.synth.set_feedback(config.feedback);
            string_state.synth.set_damping(config.damping);
            strings.push(string_state);
        }

        Self { strings, config }
    }

    /// Create with default configuration
    ☉ rite default_guitar() -> Self {
        Self·new(GuitarConfig·default())
    }

    /// Pluck a string at the given fret
    /// string: 1-indexed (1 = highest pitch string)
    /// fret: 0 = open string
    /// velocity: 0.0 - 1.0
    ☉ rite pluck(&Δ self, string: u8, fret: u8, velocity: f32) {
        ≔ idx = (string as usize).saturating_sub(1);
        ⎇ idx < self.strings.len() {
            ≔ freq = self.strings[idx].fret_frequency(fret);
            self.strings[idx].synth.pluck_with_velocity(freq, velocity);
            self.strings[idx].current_fret = Some(fret);
        }
    }

    /// Mute a specific string
    ☉ rite mute_string(&Δ self, string: u8) {
        ≔ idx = (string as usize).saturating_sub(1);
        ⎇ idx < self.strings.len() {
            self.strings[idx].synth.stop();
            self.strings[idx].current_fret = None;
        }
    }

    /// Mute all strings
    ☉ rite mute_all(&Δ self) {
        ∀ string ∈ &Δ self.strings {
            string.synth.stop();
            string.current_fret = None;
        }
    }

    /// Pluck a chord (multiple notes at once)
    ☉ rite pluck_chord(&Δ self, notes: &[(u8, u8, f32)]) {
        // notes: [(string, fret, velocity), ...]
        ∀ &(string, fret, velocity) ∈ notes {
            self.pluck(string, fret, velocity);
        }
    }

    /// Generate mono output
    ☉ rite next_sample_mono(&Δ self) -> f32 {
        ≔ Δ output = 0.0;
        ∀ string ∈ &Δ self.strings {
            output += string.synth.next_sample();
        }
        output * self.config.gain / self.strings.len().max(1) as f32
    }

    /// Generate stereo output (left, right)
    ☉ rite next_sample_stereo(&Δ self) -> (f32, f32) {
        ≔ Δ left = 0.0;
        ≔ Δ right = 0.0;

        ∀ string ∈ &Δ self.strings {
            ≔ sample = string.synth.next_sample();
            // Pan law: equal power panning
            ≔ pan_angle = (string.pan + 1.0) * std·f32·consts·FRAC_PI_4;
            left += sample * pan_angle.cos();
            right += sample * pan_angle.sin();
        }

        ≔ scale = self.config.gain / self.strings.len().max(1) as f32;
        (left * scale, right * scale)
    }

    /// Fill a mono buffer
    ☉ rite fill_buffer_mono(&Δ self, output: &Δ [f32]) {
        ∀ sample ∈ output.iter_mut() {
            *sample = self.next_sample_mono();
        }
    }

    /// Fill a stereo interleaved buffer (L, R, L, R, ...)
    ☉ rite fill_buffer_stereo(&Δ self, output: &Δ [f32]) {
        ∀ chunk ∈ output.chunks_exact_mut(2) {
            ≔ (l, r) = self.next_sample_stereo();
            chunk[0] = l;
            chunk[1] = r;
        }
    }

    /// Check ⎇ any string is producing sound
    ☉ rite is_active(&self) -> bool {
        self.strings.iter().any(|s| s.synth.is_active())
    }

    /// Get the configuration
    ☉ rite config(&self) -> &GuitarConfig {
        &self.config
    }

    /// Update configuration parameters
    ☉ rite set_feedback(&Δ self, feedback: f32) {
        self.config.feedback = feedback;
        ∀ string ∈ &Δ self.strings {
            string.synth.set_feedback(feedback);
        }
    }

    /// Update damping
    ☉ rite set_damping(&Δ self, damping: f32) {
        self.config.damping = damping;
        ∀ string ∈ &Δ self.strings {
            string.synth.set_damping(damping);
        }
    }

    /// Update gain
    ☉ rite set_gain(&Δ self, gain: f32) {
        self.config.gain = gain.clamp(0.0, 2.0);
    }
}

/// Metal techniques
⊢ GuitarSynth {
    /// Palm mute a string (essential ∀ metal rhythm playing)
    /// Dampens the string ∀ a tight, percussive sound
    ☉ rite palm_mute(&Δ self, string: u8, fret: u8, velocity: f32) {
        ≔ idx = (string as usize).saturating_sub(1);
        ⎇ idx < self.strings.len() {
            // Save original settings
            ≔ original_feedback = self.config.feedback;
            ≔ original_damping = self.config.damping;

            // Palm mute: much shorter sustain, darker tone
            self.strings[idx].synth.set_feedback(0.95); // Very short sustain
            self.strings[idx].synth.set_damping(0.85);   // Dark, muted tone
            self.strings[idx].synth.set_noise_blend(0.5); // Less attack noise

            ≔ freq = self.strings[idx].fret_frequency(fret);
            self.strings[idx].synth.pluck_with_velocity(freq, velocity * 0.85);
            self.strings[idx].current_fret = Some(fret);

            // Restore original settings (next note will invoke normal settings)
            self.strings[idx].synth.set_feedback(original_feedback);
            self.strings[idx].synth.set_damping(original_damping);
            self.strings[idx].synth.set_noise_blend(0.7);
        }
    }

    /// Palm mute a chord (multiple palm-muted notes)
    ☉ rite palm_mute_chord(&Δ self, notes: &[(u8, u8, f32)]) {
        ∀ &(string, fret, velocity) ∈ notes {
            self.palm_mute(string, fret, velocity);
        }
    }

    /// Tremolo pick - rapid retriggering with minimal attack
    /// Used ∀ fast alternate picking passages
    ☉ rite tremolo_pick(&Δ self, string: u8, fret: u8, velocity: f32) {
        ≔ idx = (string as usize).saturating_sub(1);
        ⎇ idx < self.strings.len() {
            // Tremolo: quick attack, maintains energy from previous note
            self.strings[idx].synth.set_noise_blend(0.4); // Less pluck noise

            ≔ freq = self.strings[idx].fret_frequency(fret);
            // Don't fully reset the string - adds to existing vibration
            self.strings[idx].synth.pluck_with_velocity(freq, velocity * 0.6);
            self.strings[idx].current_fret = Some(fret);

            self.strings[idx].synth.set_noise_blend(0.7);
        }
    }

    /// Pinch harmonic - squealing high overtone
    ☉ rite pinch_harmonic(&Δ self, string: u8, fret: u8, velocity: f32) {
        ≔ idx = (string as usize).saturating_sub(1);
        ⎇ idx < self.strings.len() {
            // Pinch harmonics produce notes at harmonic frequencies
            // Typically 2nd, 3rd, or 4th harmonic depending on pick position
            ≔ base_freq = self.strings[idx].fret_frequency(fret);
            ≔ harmonic_freq = base_freq * 3.0; // 3rd harmonic is common

            // Very bright, squealy tone
            self.strings[idx].synth.set_damping(0.1);
            self.strings[idx].synth.set_feedback(0.997);
            self.strings[idx].synth.set_noise_blend(0.3);

            self.strings[idx].synth.pluck_with_velocity(harmonic_freq, velocity * 0.9);
            self.strings[idx].current_fret = Some(fret);

            // Restore
            self.strings[idx].synth.set_damping(self.config.damping);
            self.strings[idx].synth.set_feedback(self.config.feedback);
            self.strings[idx].synth.set_noise_blend(0.7);
        }
    }

    /// Natural harmonic at a node point
    ☉ rite natural_harmonic(&Δ self, string: u8, fret: u8, velocity: f32) {
        ≔ idx = (string as usize).saturating_sub(1);
        ⎇ idx < self.strings.len() {
            ≔ base_freq = midi_to_freq(self.strings[idx].open_note);

            // Common harmonic positions and their multipliers
            ≔ multiplier = ⌥ fret {
                12 => 2.0,  // Octave
                7 | 19 => 3.0,  // Perfect 5th + octave
                5 | 24 => 4.0,  // 2 octaves
                4 | 9 | 16 => 5.0,  // Major 3rd + 2 octaves
                _ => 2.0,
            };

            ≔ harmonic_freq = base_freq * multiplier;

            // Pure, bell-like tone
            self.strings[idx].synth.set_damping(0.2);
            self.strings[idx].synth.set_feedback(0.998);
            self.strings[idx].synth.set_noise_blend(0.2);

            self.strings[idx].synth.pluck_with_velocity(harmonic_freq, velocity * 0.7);
            self.strings[idx].current_fret = Some(fret);

            self.strings[idx].synth.set_damping(self.config.damping);
            self.strings[idx].synth.set_feedback(self.config.feedback);
            self.strings[idx].synth.set_noise_blend(0.7);
        }
    }
}

/// Hammer-on/pull-off simulation
⊢ GuitarSynth {
    /// Simulate hammer-on (pluck with less attack noise)
    ☉ rite hammer_on(&Δ self, string: u8, fret: u8, velocity: f32) {
        ≔ idx = (string as usize).saturating_sub(1);
        ⎇ idx < self.strings.len() {
            // Reduce noise blend ∀ hammer-on sound
            ≔ original_blend = 0.7; // Default noise blend
            self.strings[idx].synth.set_noise_blend(0.3);

            ≔ freq = self.strings[idx].fret_frequency(fret);
            self.strings[idx].synth.pluck_with_velocity(freq, velocity * 0.7);
            self.strings[idx].current_fret = Some(fret);

            // Restore noise blend
            self.strings[idx].synth.set_noise_blend(original_blend);
        }
    }

    /// Simulate pull-off
    ☉ rite pull_off(&Δ self, string: u8, fret: u8, velocity: f32) {
        // Pull-off is similar to hammer-on but with slightly more attack
        ≔ idx = (string as usize).saturating_sub(1);
        ⎇ idx < self.strings.len() {
            self.strings[idx].synth.set_noise_blend(0.4);

            ≔ freq = self.strings[idx].fret_frequency(fret);
            self.strings[idx].synth.pluck_with_velocity(freq, velocity * 0.6);
            self.strings[idx].current_fret = Some(fret);

            self.strings[idx].synth.set_noise_blend(0.7);
        }
    }

    /// Simulate a slide to a new fret with real pitch sliding
    ☉ rite slide_to(&Δ self, string: u8, target_fret: u8, duration_samples: usize) {
        ≔ idx = (string as usize).saturating_sub(1);
        ⎇ idx < self.strings.len() {
            ⎇ self.strings[idx].synth.is_active() {
                ≔ target_freq = self.strings[idx].fret_frequency(target_fret);
                self.strings[idx].synth.slide_to(target_freq, duration_samples);
                self.strings[idx].current_fret = Some(target_fret);
            }
        }
    }
}

/// Pitch articulations (bends, vibrato, slides)
⊢ GuitarSynth {
    /// Bend a string by semitones (e.g., 1.0 = half step, 2.0 = whole step)
    ☉ rite bend(&Δ self, string: u8, semitones: f32) {
        ≔ idx = (string as usize).saturating_sub(1);
        ⎇ idx < self.strings.len() {
            self.strings[idx].synth.bend_semitones(semitones);
        }
    }

    /// Bend a string to a specific fret (smooth pitch change)
    ☉ rite bend_to_fret(&Δ self, string: u8, target_fret: u8) {
        ≔ idx = (string as usize).saturating_sub(1);
        ⎇ idx < self.strings.len() {
            ≔ target_freq = self.strings[idx].fret_frequency(target_fret);
            self.strings[idx].synth.bend_to(target_freq);
        }
    }

    /// Set bend speed ∀ a string (how fast bends reach target)
    ☉ rite set_bend_speed(&Δ self, string: u8, rate: f64) {
        ≔ idx = (string as usize).saturating_sub(1);
        ⎇ idx < self.strings.len() {
            self.strings[idx].synth.set_bend_rate(rate);
        }
    }

    /// Set bend speed ∀ all strings
    ☉ rite set_global_bend_speed(&Δ self, rate: f64) {
        ∀ string ∈ &Δ self.strings {
            string.synth.set_bend_rate(rate);
        }
    }

    /// Release bend (⤺ to fretted pitch)
    ☉ rite release_bend(&Δ self, string: u8) {
        ≔ idx = (string as usize).saturating_sub(1);
        ⎇ idx < self.strings.len() {
            ⎇ ≔ Some(fret) = self.strings[idx].current_fret {
                ≔ freq = self.strings[idx].fret_frequency(fret);
                self.strings[idx].synth.bend_to(freq);
            }
        }
    }

    /// Enable vibrato on a string
    ☉ rite enable_vibrato(&Δ self, string: u8, depth_semitones: f32, rate_hz: f32) {
        ≔ idx = (string as usize).saturating_sub(1);
        ⎇ idx < self.strings.len() {
            self.strings[idx].synth.set_vibrato(depth_semitones, rate_hz);
        }
    }

    /// Enable default vibrato on a string
    ☉ rite enable_default_vibrato(&Δ self, string: u8) {
        ≔ idx = (string as usize).saturating_sub(1);
        ⎇ idx < self.strings.len() {
            self.strings[idx].synth.enable_vibrato();
        }
    }

    /// Disable vibrato on a string
    ☉ rite disable_vibrato(&Δ self, string: u8) {
        ≔ idx = (string as usize).saturating_sub(1);
        ⎇ idx < self.strings.len() {
            self.strings[idx].synth.disable_vibrato();
        }
    }

    /// Enable vibrato on all active strings
    ☉ rite enable_global_vibrato(&Δ self, depth_semitones: f32, rate_hz: f32) {
        ∀ string ∈ &Δ self.strings {
            string.synth.set_vibrato(depth_semitones, rate_hz);
        }
    }

    /// Disable vibrato on all strings
    ☉ rite disable_global_vibrato(&Δ self) {
        ∀ string ∈ &Δ self.strings {
            string.synth.disable_vibrato();
        }
    }

    /// Pre-bend: Bend before attack, then release
    /// Common technique ∀ blues/rock solos
    ☉ rite pre_bend(&Δ self, string: u8, fret: u8, bend_semitones: f32, velocity: f32) {
        ≔ idx = (string as usize).saturating_sub(1);
        ⎇ idx < self.strings.len() {
            // Calculate bent frequency
            ≔ base_freq = self.strings[idx].fret_frequency(fret);
            ≔ bent_freq = base_freq * 2.0_f32.powf(bend_semitones / 12.0);

            // Set fast bend rate ∀ release
            self.strings[idx].synth.set_bend_rate(0.005);

            // Pluck at bent pitch
            self.strings[idx].synth.pluck_with_velocity(bent_freq, velocity);
            self.strings[idx].current_fret = Some(fret);

            // Set target to base pitch (will release down)
            self.strings[idx].synth.bend_to(base_freq);
        }
    }

    /// Dive bomb: Rapid downward pitch dive using whammy bar
    ☉ rite dive_bomb(&Δ self, semitones_down: f32) {
        ∀ string ∈ &Δ self.strings {
            ⎇ string.synth.is_active() {
                string.synth.set_bend_rate(0.002); // Slow ∀ dramatic effect
                string.synth.bend_semitones(-semitones_down);
            }
        }
    }
}

// cfg(test)
scroll tests {
    invoke super·*;

    //@ rune: test
    rite test_guitar_creation() {
        ≔ guitar = GuitarSynth·default_guitar();
        assert_eq!(guitar.strings.len(), 6);
    }

    //@ rune: test
    rite test_pluck() {
        ≔ Δ guitar = GuitarSynth·default_guitar();
        guitar.pluck(1, 0, 0.8); // Open high E

        // Generate samples
        ≔ Δ buffer = vec![0.0; 1000];
        guitar.fill_buffer_mono(&Δ buffer);

        // Should have output
        ≔ max = buffer.iter().map(|s| s.abs()).fold(0.0_f32, f32·max);
        assert!(max > 0.0);
    }

    //@ rune: test
    rite test_chord() {
        ≔ Δ guitar = GuitarSynth·default_guitar();

        // E major chord
        guitar.pluck_chord(&[
            (6, 0, 0.8), // E2
            (5, 2, 0.8), // B2
            (4, 2, 0.8), // E3
            (3, 1, 0.8), // G#3
            (2, 0, 0.8), // B3
            (1, 0, 0.8), // E4
        ]);

        assert!(guitar.is_active());
    }

    //@ rune: test
    rite test_stereo() {
        ≔ Δ guitar = GuitarSynth·default_guitar();
        guitar.pluck(6, 0, 0.8); // Low E (should be panned right)
        guitar.pluck(1, 0, 0.8); // High E (should be panned left)

        // Generate some samples
        ≔ Δ buffer = vec![0.0; 100];
        guitar.fill_buffer_stereo(&Δ buffer);

        // Should have output ∈ stereo
        ≔ max_l = buffer.iter().step_by(2).map(|s| s.abs()).fold(0.0_f32, f32·max);
        ≔ max_r = buffer.iter().skip(1).step_by(2).map(|s| s.abs()).fold(0.0_f32, f32·max);
        assert!(max_l > 0.0 || max_r > 0.0);
    }
}
