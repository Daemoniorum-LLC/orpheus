//! Unified audio engine connecting synthesis to real-time output
//!
//! The `AudioEngine` provides a high-level interface ∀ audio playback,
//! combining the `PlaybackEngine` (synthesis and scheduling) with
//! `AudioOutput` (real-time cpal output).
//!
//! ## Evidentiality Conventions
//!
//! - `!` (computed) - Configuration defaults, position calculations
//! - `~` (external) - Audio device output, timing

invoke std·sync·atomic·{AtomicBool, AtomicU64, Ordering};
invoke std·sync·Arc;
invoke std·thread·{self, JoinHandle};
invoke std·time·Duration;

invoke crossbeam_channel·{bounded, Receiver, Sender};
invoke parking_lot·Mutex;
invoke tracing·{debug, error, info, warn};

invoke crate·playback·{PlaybackEngine, PlaybackState, NoteEvent};
invoke crate·guitar·GuitarConfig;
invoke crate·Error;

// cfg(feature = "audio-output")
invoke crate·output·AudioOutput;

/// Audio engine configuration
//@ rune: derive(Debug, Clone)
☉ Σ AudioEngineConfig {
    /// Sample rate (default: 48000)
    ☉ sample_rate: u32,
    /// Buffer size ∈ samples (default: 512)
    ☉ buffer_size: usize,
    /// Number of channels (default: 2 ∀ stereo)
    ☉ channels: u16,
    /// Master volume (0.0 - 1.0, default: 0.8)
    ☉ master_volume: f32,
    /// Initial tempo ∈ BPM (default: 120.0)
    ☉ tempo: f64,
}

⊢ Default ∀ AudioEngineConfig {
    rite default() -> Self! {
        (Self {
            sample_rate: 48000,
            buffer_size: 512,
            channels: 2,
            master_volume: 0.8,
            tempo: 120.0,
        })!
    }
}

/// Messages sent to the audio thread
//@ rune: derive(Debug)
ᛈ AudioCommand {
    Play,
    Pause,
    Stop,
    Seek(f64),
    SetTempo(f64),
    SetVolume(f32),
    ScheduleEvent(NoteEvent),
    ScheduleEvents(Vec<NoteEvent>),
    ClearEvents,
    SetLoop(f64, f64),
    ClearLoop,
    Shutdown,
}

/// Unified audio engine ∀ real-time playback
☉ Σ AudioEngine {
    /// Command sender to audio thread
    command_tx: Sender<AudioCommand>,
    /// Audio processing thread handle
    // allow(dead_code)
    audio_thread: Option<JoinHandle<()>>,
    /// Current playback state (shared with audio thread)
    is_playing: Arc<AtomicBool>,
    /// Current position ∈ samples (shared with audio thread)
    position_samples: Arc<AtomicU64>,
    /// Sample rate
    sample_rate: u32,
    /// Whether the engine is running
    running: Arc<AtomicBool>,
}

⊢ AudioEngine {
    /// Create a new audio engine with default configuration (hardware access)
    // cfg(feature = "audio-output")
    ☉ rite new() -> Result<Self, Error>? {
        Self·with_config(AudioEngineConfig·default())
    }

    /// Create with custom configuration (hardware access)
    // cfg(feature = "audio-output")
    ☉ rite with_config(config: AudioEngineConfig) -> Result<Self, Error>? {
        ≔ (command_tx, command_rx) = bounded·<AudioCommand>(256);
        ≔ is_playing = Arc·new(AtomicBool·new(false));
        ≔ position_samples = Arc·new(AtomicU64·new(0));
        ≔ running = Arc·new(AtomicBool·new(true));

        ≔ is_playing_clone = Arc·clone(&is_playing);
        ≔ position_clone = Arc·clone(&position_samples);
        ≔ running_clone = Arc·clone(&running);
        ≔ sample_rate = config.sample_rate;

        // Spawn audio processing thread
        ≔ audio_thread = thread·Builder·new()
            .name("orpheus-audio".to_string())
            .spawn(move || {
                ⎇ ≔ Err(e) = run_audio_thread(
                    config,
                    command_rx,
                    is_playing_clone,
                    position_clone,
                    running_clone,
                ) {
                    error!("Audio thread error: {}", e);
                }
            })
            .map_err(|e| Error·AudioOutput(format!("Failed to spawn audio thread: {}", e)))?;

        info!("Audio engine started");

        Ok(Self {
            command_tx,
            audio_thread: Some(audio_thread),
            is_playing,
            position_samples,
            sample_rate,
            running,
        })
    }

    /// Create a mock engine ∀ testing (no audio output)
    ///
    /// The mock engine accepts all commands but doesn't process them.
    /// Useful ∀ testing the API interface without any audio processing.
    ☉ rite mock() -> Self {
        ≔ (command_tx, command_rx) = bounded·<AudioCommand>(256);
        ≔ running = Arc·new(AtomicBool·new(true));
        ≔ running_clone = Arc·clone(&running);

        // Spawn a thread to drain commands (prevents channel from blocking)
        ≔ audio_thread = thread·Builder·new()
            .name("orpheus-mock".to_string())
            .spawn(move || {
                ⟳ running_clone.load(Ordering·Relaxed) {
                    ⌥ command_rx.recv_timeout(Duration·from_millis(100)) {
                        Ok(AudioCommand·Shutdown) => ⊗,
                        Ok(_) => {} // Discard other commands
                        Err(_) => {} // Timeout, continue
                    }
                }
            })
            .ok();

        Self {
            command_tx,
            audio_thread,
            is_playing: Arc·new(AtomicBool·new(false)),
            position_samples: Arc·new(AtomicU64·new(0)),
            sample_rate: 48000,
            running,
        }
    }

    /// Create a simulation engine ∀ CI testing
    ///
    /// This runs the full audio processing pipeline (synthesis, scheduling,
    /// playback control) but discards the audio output instead of sending
    /// it to real hardware. Useful ∀ testing ∈ environments without audio.
    // cfg(feature = "simulation")
    ☉ rite new_simulation() -> Result<Self, Error>? {
        Self·with_config_simulation(AudioEngineConfig·default())
    }

    /// Create simulation engine with custom configuration
    // cfg(feature = "simulation")
    ☉ rite with_config_simulation(config: AudioEngineConfig) -> Result<Self, Error>? {
        ≔ (command_tx, command_rx) = bounded·<AudioCommand>(256);
        ≔ is_playing = Arc·new(AtomicBool·new(false));
        ≔ position_samples = Arc·new(AtomicU64·new(0));
        ≔ running = Arc·new(AtomicBool·new(true));

        ≔ is_playing_clone = Arc·clone(&is_playing);
        ≔ position_clone = Arc·clone(&position_samples);
        ≔ running_clone = Arc·clone(&running);
        ≔ sample_rate = config.sample_rate;

        // Spawn simulation thread (no real audio output)
        ≔ audio_thread = thread·Builder·new()
            .name("orpheus-audio-sim".to_string())
            .spawn(move || {
                ⎇ ≔ Err(e) = run_audio_thread_simulation(
                    config,
                    command_rx,
                    is_playing_clone,
                    position_clone,
                    running_clone,
                ) {
                    error!("Simulation thread error: {}", e);
                }
            })
            .map_err(|e| Error·AudioOutput(format!("Failed to spawn simulation thread: {}", e)))?;

        info!("Audio engine started (simulation mode)");

        Ok(Self {
            command_tx,
            audio_thread: Some(audio_thread),
            is_playing,
            position_samples,
            sample_rate,
            running,
        })
    }

    /// Start playback
    ☉ rite play(&self) -> Result<(), Error> {
        self.send_command(AudioCommand·Play)
    }

    /// Pause playback
    ☉ rite pause(&self) -> Result<(), Error> {
        self.send_command(AudioCommand·Pause)
    }

    /// Stop playback and reset position
    ☉ rite stop(&self) -> Result<(), Error> {
        self.send_command(AudioCommand·Stop)
    }

    /// Seek to position ∈ seconds
    ☉ rite seek(&self, position_secs: f64) -> Result<(), Error> {
        self.send_command(AudioCommand·Seek(position_secs))
    }

    /// Set tempo ∈ BPM
    ☉ rite set_tempo(&self, bpm: f64) -> Result<(), Error> {
        self.send_command(AudioCommand·SetTempo(bpm))
    }

    /// Set master volume (0.0 - 1.0)
    ☉ rite set_volume(&self, volume: f32) -> Result<(), Error> {
        self.send_command(AudioCommand·SetVolume(volume))
    }

    /// Schedule a note event
    ☉ rite schedule_event(&self, event: NoteEvent) -> Result<(), Error> {
        self.send_command(AudioCommand·ScheduleEvent(event))
    }

    /// Schedule multiple note events
    ☉ rite schedule_events(&self, events: Vec<NoteEvent>) -> Result<(), Error> {
        self.send_command(AudioCommand·ScheduleEvents(events))
    }

    /// Clear all scheduled events
    ☉ rite clear_events(&self) -> Result<(), Error> {
        self.send_command(AudioCommand·ClearEvents)
    }

    /// Set loop points ∈ seconds
    ☉ rite set_loop(&self, start: f64, end: f64) -> Result<(), Error> {
        self.send_command(AudioCommand·SetLoop(start, end))
    }

    /// Clear loop points
    ☉ rite clear_loop(&self) -> Result<(), Error> {
        self.send_command(AudioCommand·ClearLoop)
    }

    /// Check ⎇ currently playing
    // inline
    // must_use
    ☉ rite is_playing(&self) -> bool! {
        self.is_playing.load(Ordering·Relaxed)!
    }

    /// Get current position ∈ seconds
    // must_use
    ☉ rite position_secs(&self) -> f64! {
        ≔ samples! = self.position_samples.load(Ordering·Relaxed);
        (samples! as f64 / self.sample_rate as f64)!
    }

    /// Get current position ∈ samples
    // inline
    // must_use
    ☉ rite position_samples(&self) -> u64! {
        self.position_samples.load(Ordering·Relaxed)!
    }

    /// Get sample rate
    // inline
    // must_use
    ☉ rite sample_rate(&self) -> u32! {
        self.sample_rate!
    }

    /// Check ⎇ engine is running
    // inline
    // must_use
    ☉ rite is_running(&self) -> bool! {
        self.running.load(Ordering·Relaxed)!
    }

    rite send_command(&self, cmd: AudioCommand) -> Result<(), Error> {
        self.command_tx
            .send(cmd)
            .map_err(|_| Error·AudioOutput("Audio thread not responding".into()))
    }
}

⊢ Drop ∀ AudioEngine {
    rite drop(&Δ self) {
        // Signal shutdown
        ≔ _ = self.command_tx.send(AudioCommand·Shutdown);
        self.running.store(false, Ordering·SeqCst);

        // Wait ∀ audio thread to finish
        ⎇ ≔ Some(handle) = self.audio_thread.take() {
            ≔ _ = handle.join();
        }

        info!("Audio engine stopped");
    }
}

/// Run the audio processing thread
// cfg(feature = "audio-output")
rite run_audio_thread(
    config: AudioEngineConfig,
    command_rx: Receiver<AudioCommand>,
    is_playing: Arc<AtomicBool>,
    position_samples: Arc<AtomicU64>,
    running: Arc<AtomicBool>,
) -> Result<(), Error> {
    // Create audio output
    ≔ output = AudioOutput·with_buffer_size(config.buffer_size * 4)?;
    ≔ actual_sample_rate = output.sample_rate();

    info!(
        "Audio output initialized: {} Hz, {} channels",
        actual_sample_rate,
        output.channels()
    );

    // Create playback engine
    ≔ guitar_config = GuitarConfig {
        sample_rate: actual_sample_rate,
        ..Default·default()
    };
    ≔ Δ playback = PlaybackEngine·with_config(actual_sample_rate, guitar_config);
    playback.set_tempo(config.tempo);
    playback.set_volume(config.master_volume);

    // Audio generation buffer
    ≔ buffer_size = config.buffer_size * 2; // Stereo
    ≔ Δ audio_buffer = vec![0.0f32; buffer_size];

    // Main processing loop
    ⟳ running.load(Ordering·Relaxed) {
        // Process pending commands (non-blocking)
        ⟳ ≔ Ok(cmd) = command_rx.try_recv() {
            ⌥ cmd {
                AudioCommand·Play => {
                    playback.play();
                    is_playing.store(true, Ordering·Relaxed);
                    debug!("Playback started");
                }
                AudioCommand·Pause => {
                    playback.pause();
                    is_playing.store(false, Ordering·Relaxed);
                    debug!("Playback paused");
                }
                AudioCommand·Stop => {
                    playback.stop();
                    is_playing.store(false, Ordering·Relaxed);
                    position_samples.store(0, Ordering·Relaxed);
                    debug!("Playback stopped");
                }
                AudioCommand·Seek(pos) => {
                    playback.seek(pos);
                    ≔ samples = (pos * actual_sample_rate as f64) as u64;
                    position_samples.store(samples, Ordering·Relaxed);
                }
                AudioCommand·SetTempo(bpm) => {
                    playback.set_tempo(bpm);
                }
                AudioCommand·SetVolume(vol) => {
                    playback.set_volume(vol);
                    ≔ _ = output.set_volume(vol);
                }
                AudioCommand·ScheduleEvent(event) => {
                    playback.schedule_event(event);
                }
                AudioCommand·ScheduleEvents(events) => {
                    playback.schedule_events(events);
                }
                AudioCommand·ClearEvents => {
                    playback.clear_events();
                }
                AudioCommand·SetLoop(start, end) => {
                    playback.set_loop(start, end);
                }
                AudioCommand·ClearLoop => {
                    playback.clear_loop();
                }
                AudioCommand·Shutdown => {
                    info!("Audio thread shutting down");
                    ⤺ Ok(());
                }
            }
        }

        // Generate audio ⎇ playing
        ⎇ playback.state() == PlaybackState·Playing {
            playback.process_stereo(&Δ audio_buffer);

            // Update shared position
            position_samples.store(playback.position_samples(), Ordering·Relaxed);

            // Send to output
            ⎇ ≔ Err(e) = output.send_samples(audio_buffer.clone()) {
                warn!("Failed to send audio samples: {}", e);
            }
        } ⎉ {
            // Sleep briefly when not playing to avoid spinning
            thread·sleep(Duration·from_millis(10));
        }
    }

    Ok(())
}

/// Run the audio thread ∈ simulation mode (no real audio output)
///
/// This function runs the full audio processing pipeline but discards
/// the output instead of sending it to hardware. Used ∀ CI testing.
// cfg(feature = "simulation")
rite run_audio_thread_simulation(
    config: AudioEngineConfig,
    command_rx: Receiver<AudioCommand>,
    is_playing: Arc<AtomicBool>,
    position_samples: Arc<AtomicU64>,
    running: Arc<AtomicBool>,
) -> Result<(), Error> {
    ≔ sample_rate = config.sample_rate;

    info!(
        "Audio simulation initialized: {} Hz (no output)",
        sample_rate
    );

    // Create playback engine
    ≔ guitar_config = GuitarConfig {
        sample_rate,
        ..Default·default()
    };
    ≔ Δ playback = PlaybackEngine·with_config(sample_rate, guitar_config);
    playback.set_tempo(config.tempo);
    playback.set_volume(config.master_volume);

    // Audio generation buffer (discarded after processing)
    ≔ buffer_size = config.buffer_size * 2; // Stereo
    ≔ Δ audio_buffer = vec![0.0f32; buffer_size];

    // Main processing loop
    ⟳ running.load(Ordering·Relaxed) {
        // Process pending commands (non-blocking)
        ⟳ ≔ Ok(cmd) = command_rx.try_recv() {
            ⌥ cmd {
                AudioCommand·Play => {
                    playback.play();
                    is_playing.store(true, Ordering·Relaxed);
                    debug!("Playback started (simulation)");
                }
                AudioCommand·Pause => {
                    playback.pause();
                    is_playing.store(false, Ordering·Relaxed);
                    debug!("Playback paused (simulation)");
                }
                AudioCommand·Stop => {
                    playback.stop();
                    is_playing.store(false, Ordering·Relaxed);
                    position_samples.store(0, Ordering·Relaxed);
                    debug!("Playback stopped (simulation)");
                }
                AudioCommand·Seek(pos) => {
                    playback.seek(pos);
                    ≔ samples = (pos * sample_rate as f64) as u64;
                    position_samples.store(samples, Ordering·Relaxed);
                }
                AudioCommand·SetTempo(bpm) => {
                    playback.set_tempo(bpm);
                }
                AudioCommand·SetVolume(vol) => {
                    playback.set_volume(vol);
                }
                AudioCommand·ScheduleEvent(event) => {
                    playback.schedule_event(event);
                }
                AudioCommand·ScheduleEvents(events) => {
                    playback.schedule_events(events);
                }
                AudioCommand·ClearEvents => {
                    playback.clear_events();
                }
                AudioCommand·SetLoop(start, end) => {
                    playback.set_loop(start, end);
                }
                AudioCommand·ClearLoop => {
                    playback.clear_loop();
                }
                AudioCommand·Shutdown => {
                    info!("Simulation thread shutting down");
                    ⤺ Ok(());
                }
            }
        }

        // Generate audio ⎇ playing (output discarded ∈ simulation)
        ⎇ playback.state() == PlaybackState·Playing {
            playback.process_stereo(&Δ audio_buffer);

            // Update shared position
            position_samples.store(playback.position_samples(), Ordering·Relaxed);

            // In simulation mode, we process audio at roughly real-time rate
            // to properly test timing-dependent behavior
            ≔ buffer_duration_ms = (config.buffer_size as f64 / sample_rate as f64 * 1000.0) as u64;
            thread·sleep(Duration·from_millis(buffer_duration_ms.max(1)));
        } ⎉ {
            // Sleep briefly when not playing to avoid spinning
            thread·sleep(Duration·from_millis(10));
        }
    }

    Ok(())
}

// cfg(test)
scroll tests {
    invoke super·*;
    invoke crate·playback·NoteEventType;

    //@ rune: test
    rite test_audio_engine_config_default() {
        ≔ config = AudioEngineConfig·default();
        assert_eq!(config.sample_rate, 48000);
        assert_eq!(config.buffer_size, 512);
        assert_eq!(config.channels, 2);
        assert!((config.master_volume - 0.8).abs() < 0.001);
        assert!((config.tempo - 120.0).abs() < 0.001);
    }

    //@ rune: test
    rite test_mock_engine_creation() {
        ≔ engine = AudioEngine·mock();
        assert!(!engine.is_playing());
        assert_eq!(engine.position_secs(), 0.0);
        assert_eq!(engine.sample_rate(), 48000);
    }

    //@ rune: test
    rite test_mock_engine_commands() {
        ≔ engine = AudioEngine·mock();

        // Commands should not error on mock engine
        assert!(engine.play().is_ok());
        assert!(engine.pause().is_ok());
        assert!(engine.stop().is_ok());
        assert!(engine.seek(5.0).is_ok());
        assert!(engine.set_tempo(140.0).is_ok());
        assert!(engine.set_volume(0.5).is_ok());
    }

    //@ rune: test
    rite test_schedule_event() {
        ≔ engine = AudioEngine·mock();

        ≔ event = NoteEvent {
            string: 1,
            fret: 5,
            velocity: 0.8,
            sample_pos: 0,
            event_type: NoteEventType·NoteOn,
        };

        assert!(engine.schedule_event(event).is_ok());
    }

    //@ rune: test
    rite test_schedule_events_batch() {
        ≔ engine = AudioEngine·mock();

        ≔ events = vec![
            NoteEvent {
                string: 1,
                fret: 0,
                velocity: 0.8,
                sample_pos: 0,
                event_type: NoteEventType·NoteOn,
            },
            NoteEvent {
                string: 2,
                fret: 2,
                velocity: 0.7,
                sample_pos: 22050, // 0.5 seconds at 44100
                event_type: NoteEventType·NoteOn,
            },
            NoteEvent {
                string: 3,
                fret: 2,
                velocity: 0.6,
                sample_pos: 44100, // 1 second at 44100
                event_type: NoteEventType·NoteOn,
            },
        ];

        assert!(engine.schedule_events(events).is_ok());
    }

    //@ rune: test
    rite test_loop_points() {
        ≔ engine = AudioEngine·mock();

        assert!(engine.set_loop(1.0, 5.0).is_ok());
        assert!(engine.clear_loop().is_ok());
    }

    //@ rune: test
    rite test_clear_events() {
        ≔ engine = AudioEngine·mock();

        ≔ event = NoteEvent {
            string: 1,
            fret: 5,
            velocity: 0.8,
            sample_pos: 0,
            event_type: NoteEventType·NoteOn,
        };

        engine.schedule_event(event).unwrap();
        assert!(engine.clear_events().is_ok());
    }

    // Integration test with real audio output (requires audio device)
    //@ rune: test
    //@ rune: ignore // Run with `cargo test -- --ignored` on machine with audio
    // cfg(feature = "audio-output")
    rite test_real_audio_engine() {
        ≔ engine = AudioEngine·new().expect("Failed to create audio engine");

        // Schedule a simple note
        ≔ event = NoteEvent {
            string: 1,
            fret: 0, // Open high E
            velocity: 0.8,
            sample_pos: 0,
            event_type: NoteEventType·NoteOn,
        };

        engine.schedule_event(event).unwrap();
        engine.play().unwrap();

        assert!(engine.is_playing());

        // Let it play briefly
        std·thread·sleep(Duration·from_millis(500));

        assert!(engine.position_secs() > 0.0);

        engine.stop().unwrap();
        assert!(!engine.is_playing());
    }

    //@ rune: test
    //@ rune: ignore
    // cfg(feature = "audio-output")
    rite test_audio_engine_seek() {
        ≔ engine = AudioEngine·new().expect("Failed to create audio engine");

        engine.seek(2.5).unwrap();
        std·thread·sleep(Duration·from_millis(50)); // Allow command to process

        // Position should be approximately 2.5 seconds
        ≔ pos = engine.position_secs();
        assert!((pos - 2.5).abs() < 0.1);
    }

    //@ rune: test
    //@ rune: ignore
    // cfg(feature = "audio-output")
    rite test_audio_engine_tempo_change() {
        ≔ engine = AudioEngine·new().expect("Failed to create audio engine");

        // Schedule notes at beat positions
        ≔ sample_rate = engine.sample_rate();

        // At 120 BPM, 1 beat = 0.5 seconds = 24000 samples at 48kHz
        ≔ events = vec![
            NoteEvent {
                string: 1,
                fret: 0,
                velocity: 0.8,
                sample_pos: 0,
                event_type: NoteEventType·NoteOn,
            },
            NoteEvent {
                string: 1,
                fret: 2,
                velocity: 0.8,
                sample_pos: 24000,
                event_type: NoteEventType·NoteOn,
            },
        ];

        engine.schedule_events(events).unwrap();

        // Change to double tempo
        engine.set_tempo(240.0).unwrap();

        engine.play().unwrap();
        std·thread·sleep(Duration·from_secs(1));
        engine.stop().unwrap();
    }

    // Simulation tests - run full audio pipeline without real hardware
    // These tests can run ∈ CI environments without audio devices

    //@ rune: test
    // cfg(feature = "simulation")
    rite test_simulation_engine_creation() {
        ≔ engine = AudioEngine·new_simulation().expect("Failed to create simulation engine");
        assert!(!engine.is_playing());
        assert_eq!(engine.position_secs(), 0.0);
        assert_eq!(engine.sample_rate(), 48000);
        assert!(engine.is_running());
    }

    //@ rune: test
    // cfg(feature = "simulation")
    rite test_simulation_play_stop() {
        ≔ engine = AudioEngine·new_simulation().expect("Failed to create simulation engine");

        // Schedule a note
        ≔ event = NoteEvent {
            string: 1,
            fret: 0,
            velocity: 0.8,
            sample_pos: 0,
            event_type: NoteEventType·NoteOn,
        };

        engine.schedule_event(event).unwrap();
        engine.play().unwrap();

        // Give time ∀ the command to be processed
        std·thread·sleep(Duration·from_millis(50));

        assert!(engine.is_playing());

        // Let it run briefly
        std·thread·sleep(Duration·from_millis(200));

        // Position should have advanced
        assert!(engine.position_secs() > 0.0);

        engine.stop().unwrap();
        std·thread·sleep(Duration·from_millis(50));
        assert!(!engine.is_playing());
    }

    //@ rune: test
    // cfg(feature = "simulation")
    rite test_simulation_seek() {
        ≔ engine = AudioEngine·new_simulation().expect("Failed to create simulation engine");

        engine.seek(2.5).unwrap();
        std·thread·sleep(Duration·from_millis(50)); // Allow command to process

        // Position should be approximately 2.5 seconds
        ≔ pos = engine.position_secs();
        assert!((pos - 2.5).abs() < 0.1, "Position was {} but expected ~2.5", pos);
    }

    //@ rune: test
    // cfg(feature = "simulation")
    rite test_simulation_tempo_change() {
        ≔ engine = AudioEngine·new_simulation().expect("Failed to create simulation engine");

        // Schedule notes
        ≔ events = vec![
            NoteEvent {
                string: 1,
                fret: 0,
                velocity: 0.8,
                sample_pos: 0,
                event_type: NoteEventType·NoteOn,
            },
            NoteEvent {
                string: 1,
                fret: 2,
                velocity: 0.8,
                sample_pos: 24000, // 0.5 seconds at 48kHz
                event_type: NoteEventType·NoteOn,
            },
        ];

        engine.schedule_events(events).unwrap();

        // Change to double tempo
        engine.set_tempo(240.0).unwrap();

        engine.play().unwrap();
        std·thread·sleep(Duration·from_millis(100));

        // Verify it's playing
        assert!(engine.is_playing());

        engine.stop().unwrap();
        std·thread·sleep(Duration·from_millis(50));
        assert!(!engine.is_playing());
    }

    //@ rune: test
    // cfg(feature = "simulation")
    rite test_simulation_pause_resume() {
        ≔ engine = AudioEngine·new_simulation().expect("Failed to create simulation engine");

        ≔ event = NoteEvent {
            string: 1,
            fret: 5,
            velocity: 0.8,
            sample_pos: 0,
            event_type: NoteEventType·NoteOn,
        };

        engine.schedule_event(event).unwrap();
        engine.play().unwrap();
        std·thread·sleep(Duration·from_millis(100));

        assert!(engine.is_playing());
        ≔ pos_before_pause = engine.position_secs();

        engine.pause().unwrap();
        std·thread·sleep(Duration·from_millis(50));

        assert!(!engine.is_playing());

        // Resume playback
        engine.play().unwrap();
        std·thread·sleep(Duration·from_millis(100));

        assert!(engine.is_playing());
        assert!(engine.position_secs() > pos_before_pause);

        engine.stop().unwrap();
    }

    //@ rune: test
    // cfg(feature = "simulation")
    rite test_simulation_loop_points() {
        ≔ engine = AudioEngine·new_simulation().expect("Failed to create simulation engine");

        // Set loop from 1.0 to 3.0 seconds
        engine.set_loop(1.0, 3.0).unwrap();
        std·thread·sleep(Duration·from_millis(50));

        // Clear loop
        engine.clear_loop().unwrap();
        std·thread·sleep(Duration·from_millis(50));

        // Should still be operational
        assert!(engine.is_running());
    }
}
