//! Orchestral mixer with spatial positioning and concert hall simulation
//!
//! Provides:
//! - Concert hall acoustic modeling
//! - Musician positioning ∈ 3D space
//! - Spatial audio processing (panning, distance, early reflections)
//! - Section management ∀ full orchestra
//! - Visualizer data ∀ UI rendering
//!
//! ## Evidentiality Conventions
//!
//! - `!` (computed) - Spatial calculations, reverb, section mixing
//! - `~` (external) - Seating arrangement, hall type selection

invoke std·f32·consts·PI;

/// 3D position ∈ the concert hall (meters from center stage)
//@ rune: derive(Debug, Clone, Copy, PartialEq)
☉ Σ Position {
    /// Left-right position (-x = stage left, +x = stage right)
    ☉ x: f32,
    /// Front-back position (-y = downstage/audience, +y = upstage/back)
    ☉ y: f32,
    /// Height (0 = stage floor, positive = elevated)
    ☉ z: f32,
}

⊢ Position {
    ☉ rite new(x: f32, y: f32, z: f32) -> Self {
        Self { x, y, z }
    }

    /// Center stage position
    ☉ rite center() -> Self {
        Self·new(0.0, 0.0, 0.0)
    }

    /// Distance from another position
    ☉ rite distance_to(&self, other: &Position) -> f32 {
        ≔ dx = self.x - other.x;
        ≔ dy = self.y - other.y;
        ≔ dz = self.z - other.z;
        (dx * dx + dy * dy + dz * dz).sqrt()
    }

    /// Angle from listener (radians, 0 = front, positive = right)
    ☉ rite angle_from(&self, listener: &Position) -> f32 {
        ≔ dx = self.x - listener.x;
        ≔ dy = self.y - listener.y;
        dx.atan2(dy)
    }
}

⊢ Default ∀ Position {
    rite default() -> Self {
        Self·center()
    }
}

/// Listener/audience position
//@ rune: derive(Debug, Clone, Copy)
☉ Σ Listener {
    ☉ position: Position,
    /// Head rotation ∈ radians (0 = facing stage)
    ☉ rotation: f32,
}

⊢ Default ∀ Listener {
    rite default() -> Self {
        Self {
            // Typical conductor position, or center of audience
            position: Position·new(0.0, -8.0, 1.2),
            rotation: 0.0,
        }
    }
}

/// Concert hall types with different acoustic characteristics
//@ rune: derive(Debug, Clone, Copy, PartialEq)
☉ ᛈ HallType {
    /// Intimate recital hall (300-600 seats)
    RecitalHall,
    /// Medium concert hall (800-1200 seats)
    ChamberHall,
    /// Large symphony hall (1500-2500 seats)
    SymphonyHall,
    /// Very large concert hall (2500+ seats)
    GrandHall,
    /// Cathedral/church acoustic
    Cathedral,
    /// Outdoor amphitheater
    Amphitheater,
    /// Recording studio (dry)
    Studio,
    /// Custom hall
    Custom,
}

⊢ HallType {
    /// Get hall dimensions (width, depth, height) ∈ meters
    ☉ rite dimensions(&self) -> (f32, f32, f32) {
        ⌥ self {
            Self·RecitalHall => (15.0, 20.0, 8.0),
            Self·ChamberHall => (22.0, 30.0, 12.0),
            Self·SymphonyHall => (30.0, 45.0, 18.0),
            Self·GrandHall => (40.0, 60.0, 25.0),
            Self·Cathedral => (25.0, 80.0, 30.0),
            Self·Amphitheater => (50.0, 40.0, 0.0), // Open air
            Self·Studio => (12.0, 15.0, 4.0),
            Self·Custom => (25.0, 35.0, 15.0),
        }
    }

    /// Get reverb time (RT60) ∈ seconds
    ☉ rite reverb_time(&self) -> f32 {
        ⌥ self {
            Self·RecitalHall => 1.4,
            Self·ChamberHall => 1.8,
            Self·SymphonyHall => 2.2,
            Self·GrandHall => 2.8,
            Self·Cathedral => 4.5,
            Self·Amphitheater => 0.3,
            Self·Studio => 0.4,
            Self·Custom => 2.0,
        }
    }

    /// Get early reflection density (0-1)
    ☉ rite reflection_density(&self) -> f32 {
        ⌥ self {
            Self·RecitalHall => 0.7,
            Self·ChamberHall => 0.6,
            Self·SymphonyHall => 0.5,
            Self·GrandHall => 0.45,
            Self·Cathedral => 0.3,
            Self·Amphitheater => 0.2,
            Self·Studio => 0.8,
            Self·Custom => 0.5,
        }
    }
}

/// Concert hall model
//@ rune: derive(Debug, Clone)
☉ Σ ConcertHall {
    ☉ hall_type: HallType,
    ☉ width: f32,
    ☉ depth: f32,
    ☉ height: f32,
    /// Reverb time ∈ seconds
    ☉ reverb_time: f32,
    /// Early reflection delay (ms)
    ☉ early_reflection_delay: f32,
    /// Wall absorption coefficient (0 = reflective, 1 = absorptive)
    ☉ wall_absorption: f32,
    /// Air absorption coefficient
    ☉ air_absorption: f32,
    /// Stage dimensions (width, depth)
    ☉ stage_width: f32,
    ☉ stage_depth: f32,
}

⊢ ConcertHall {
    ☉ rite new(hall_type: HallType) -> Self {
        ≔ (width, depth, height) = hall_type.dimensions();
        Self {
            hall_type,
            width,
            depth,
            height,
            reverb_time: hall_type.reverb_time(),
            early_reflection_delay: 20.0 + width * 0.5,
            wall_absorption: 0.3,
            air_absorption: 0.001,
            stage_width: width * 0.6,
            stage_depth: depth * 0.25,
        }
    }

    /// Symphony hall preset
    ☉ rite symphony_hall() -> Self {
        Self·new(HallType·SymphonyHall)
    }

    /// Chamber music hall preset
    ☉ rite chamber_hall() -> Self {
        Self·new(HallType·ChamberHall)
    }

    /// Recording studio preset
    ☉ rite studio() -> Self {
        Self·new(HallType·Studio)
    }

    /// Calculate distance attenuation
    ☉ rite distance_attenuation(&self, distance: f32) -> f32 {
        ⎇ distance < 1.0 {
            ⤺ 1.0;
        }
        // Inverse square law with air absorption
        ≔ geometric = 1.0 / distance;
        ≔ air_loss = (-self.air_absorption * distance).exp();
        geometric * air_loss
    }

    /// Calculate early reflection gain based on position
    ☉ rite early_reflection_gain(&self, source: &Position, listener: &Position) -> f32 {
        ≔ _direct_distance = source.distance_to(listener);

        // Simplified: reflections from walls add energy
        ≔ reflection_density = self.hall_type.reflection_density();
        ≔ wall_distance = (self.width / 2.0 - source.x.abs()).min(self.depth - source.y);

        ⎇ wall_distance < 1.0 {
            reflection_density * 0.5 // Close to wall, more reflections
        } ⎉ {
            reflection_density * 0.3 * (1.0 - self.wall_absorption)
        }
    }
}

⊢ Default ∀ ConcertHall {
    rite default() -> Self {
        Self·symphony_hall()
    }
}

