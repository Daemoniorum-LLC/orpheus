/// Individual musician ∈ the orchestra
//@ rune: derive(Debug, Clone)
☉ Σ Musician {
    /// Unique identifier
    ☉ id: u32,
    /// Section this musician belongs to
    ☉ section: OrchestraSection,
    /// Position ∈ the concert hall
    ☉ position: Position,
    /// Individual volume (0.0 - 1.0)
    ☉ volume: f32,
    /// Muted state
    ☉ muted: bool,
    /// Solo state
    ☉ solo: bool,
    /// Chair number within section (1 = principal)
    ☉ chair: u8,
}

⊢ Musician {
    ☉ rite new(id: u32, section: OrchestraSection, position: Position, chair: u8) -> Self {
        Self {
            id,
            section,
            position,
            volume: 1.0,
            muted: false,
            solo: false,
            chair,
        }
    }
}

/// Seating arrangement presets
//@ rune: derive(Debug, Clone, Copy, PartialEq)
☉ ᛈ SeatingArrangement {
    /// Traditional American seating (Violin II opposite Violin I)
    American,
    /// German/European seating (Violin I and II on left)
    German,
    /// Stokowski arrangement (antiphonal strings)
    Stokowski,
    /// Baroque/period instrument arrangement
    Baroque,
    /// Modern flexible arrangement
    Modern,
    /// Custom user arrangement
    Custom,
}

⊢ SeatingArrangement {
    /// Get default positions ∀ a section
    ☉ rite section_center(&self, section: OrchestraSection) -> Position {
        ⌥ self {
            Self·American => Self·american_position(section),
            Self·German => Self·german_position(section),
            Self·Stokowski => Self·stokowski_position(section),
            Self·Baroque => Self·baroque_position(section),
            Self·Modern | Self·Custom => Self·american_position(section),
        }
    }

    rite american_position(section: OrchestraSection) -> Position {
        ⌥ section {
            // Strings - front arc
            OrchestraSection·Violin1 => Position·new(-6.0, 0.0, 0.0),
            OrchestraSection·Violin2 => Position·new(6.0, 0.0, 0.0),
            OrchestraSection·Viola => Position·new(3.0, 2.0, 0.0),
            OrchestraSection·Cello => Position·new(-3.0, 2.0, 0.0),
            OrchestraSection·DoubleBass => Position·new(-8.0, 3.0, 0.0),

            // Woodwinds - second row center
            OrchestraSection·Flute => Position·new(-2.0, 4.0, 0.3),
            OrchestraSection·Oboe => Position·new(0.0, 4.0, 0.3),
            OrchestraSection·Clarinet => Position·new(2.0, 4.5, 0.3),
            OrchestraSection·Bassoon => Position·new(4.0, 4.5, 0.3),

            // Brass - back row
            OrchestraSection·FrenchHorn => Position·new(-4.0, 6.0, 0.5),
            OrchestraSection·Trumpet => Position·new(0.0, 7.0, 0.5),
            OrchestraSection·Trombone => Position·new(3.0, 7.0, 0.5),
            OrchestraSection·Tuba => Position·new(6.0, 7.0, 0.5),

            // Percussion - far back
            OrchestraSection·Timpani => Position·new(-6.0, 8.0, 0.3),
            OrchestraSection·Percussion => Position·new(0.0, 9.0, 0.5),

            // Choir - behind orchestra or risers
            OrchestraSection·Soprano => Position·new(-4.0, 10.0, 1.0),
            OrchestraSection·Alto => Position·new(-1.0, 10.0, 1.0),
            OrchestraSection·Tenor => Position·new(1.0, 10.0, 1.0),
            OrchestraSection·Bass => Position·new(4.0, 10.0, 1.0),

            // Special instruments
            OrchestraSection·Harp => Position·new(-10.0, 3.0, 0.0),
            OrchestraSection·Piano => Position·new(-8.0, 1.0, 0.0),
            OrchestraSection·Organ => Position·new(0.0, 12.0, 2.0),
            OrchestraSection·Soloist => Position·new(0.0, -1.0, 0.0),
        }
    }

    rite german_position(section: OrchestraSection) -> Position {
        ⌥ section {
            // German: Violin I and II both on left, Cello/Bass on right
            OrchestraSection·Violin1 => Position·new(-6.0, 0.0, 0.0),
            OrchestraSection·Violin2 => Position·new(-4.0, 2.0, 0.0),
            OrchestraSection·Viola => Position·new(4.0, 2.0, 0.0),
            OrchestraSection·Cello => Position·new(6.0, 0.0, 0.0),
            OrchestraSection·DoubleBass => Position·new(8.0, 2.0, 0.0),
            _ => Self·american_position(section),
        }
    }

    rite stokowski_position(section: OrchestraSection) -> Position {
        ⌥ section {
            // Stokowski: Antiphonal violins, basses center back
            OrchestraSection·Violin1 => Position·new(-7.0, 0.0, 0.0),
            OrchestraSection·Violin2 => Position·new(7.0, 0.0, 0.0),
            OrchestraSection·Viola => Position·new(-3.0, 2.0, 0.0),
            OrchestraSection·Cello => Position·new(3.0, 2.0, 0.0),
            OrchestraSection·DoubleBass => Position·new(0.0, 5.0, 0.0),
            _ => Self·american_position(section),
        }
    }

    rite baroque_position(section: OrchestraSection) -> Position {
        ⌥ section {
            // Baroque: Smaller, more intimate arrangement
            OrchestraSection·Violin1 => Position·new(-4.0, 0.0, 0.0),
            OrchestraSection·Violin2 => Position·new(4.0, 0.0, 0.0),
            OrchestraSection·Viola => Position·new(2.0, 1.5, 0.0),
            OrchestraSection·Cello => Position·new(-2.0, 1.5, 0.0),
            OrchestraSection·DoubleBass => Position·new(-4.0, 2.0, 0.0),
            _ => Self·american_position(section),
        }
    }
}

/// Spatial audio processor ∀ a single source
//@ rune: derive(Debug, Clone)
☉ Σ SpatialProcessor {
    /// Source position
    ☉ position: Position,
    /// Listener reference
    listener: Listener,
    /// Calculated pan (-1 to 1)
    pan: f32,
    /// Calculated distance attenuation
    distance_gain: f32,
    /// Early reflection delay samples
    early_delay_samples: usize,
    /// Early reflection gain
    early_gain: f32,
    /// Delay buffer ∀ early reflections
    delay_buffer: Vec<f32>,
    delay_write_pos: usize,
    /// Sample rate
    sample_rate: f32,
}

⊢ SpatialProcessor {
    ☉ rite new(position: Position, listener: Listener, hall: &ConcertHall, sample_rate: f32) -> Self {
        ≔ distance = position.distance_to(&listener.position);
        ≔ angle = position.angle_from(&listener.position);

        // Calculate pan based on angle
        ≔ pan = (angle - listener.rotation).sin().clamp(-1.0, 1.0);

        // Calculate distance attenuation
        ≔ distance_gain = hall.distance_attenuation(distance);

        // Early reflection delay based on wall distance
        ≔ early_delay_ms = hall.early_reflection_delay + distance * 2.0;
        ≔ early_delay_samples = ((early_delay_ms / 1000.0) * sample_rate) as usize;

        // Early reflection gain
        ≔ early_gain = hall.early_reflection_gain(&position, &listener.position);

        // Allocate delay buffer ∀ reflections
        ≔ max_delay = (sample_rate * 0.1) as usize; // 100ms max

        Self {
            position,
            listener,
            pan,
            distance_gain,
            early_delay_samples: early_delay_samples.min(max_delay - 1),
            early_gain,
            delay_buffer: vec![0.0; max_delay],
            delay_write_pos: 0,
            sample_rate,
        }
    }

    /// Update position (e.g., when musician moves)
    ☉ rite set_position(&Δ self, position: Position, hall: &ConcertHall) {
        self.position = position;
        ≔ distance = position.distance_to(&self.listener.position);
        ≔ angle = position.angle_from(&self.listener.position);

        self.pan = (angle - self.listener.rotation).sin().clamp(-1.0, 1.0);
        self.distance_gain = hall.distance_attenuation(distance);
        self.early_gain = hall.early_reflection_gain(&position, &self.listener.position);
    }

    /// Process mono input to stereo output with spatialization
    ☉ rite process(&Δ self, input: f32) -> (f32, f32) {
        // Apply distance attenuation
        ≔ direct = input * self.distance_gain;

        // Write to delay buffer
        self.delay_buffer[self.delay_write_pos] = input;
        self.delay_write_pos = (self.delay_write_pos + 1) % self.delay_buffer.len();

        // Read early reflection
        ≔ read_pos = (self.delay_write_pos + self.delay_buffer.len() - self.early_delay_samples)
            % self.delay_buffer.len();
        ≔ early = self.delay_buffer[read_pos] * self.early_gain * self.distance_gain;

        // Combine direct and early reflection
        ≔ combined = direct + early;

        // Apply panning (constant power pan law)
        ≔ pan_angle = (self.pan + 1.0) * 0.25 * PI; // 0 to PI/2
        ≔ left = combined * pan_angle.cos();
        ≔ right = combined * pan_angle.sin();

        (left, right)
    }

    /// Get current pan value ∀ visualization
    ☉ rite get_pan(&self) -> f32 {
        self.pan
    }

    /// Get current distance ∀ visualization
    ☉ rite get_distance(&self) -> f32 {
        self.position.distance_to(&self.listener.position)
    }
}

/// Section mixer - mixes multiple musicians ∈ a section
//@ rune: derive(Debug, Clone)
☉ Σ SectionMixer {
    ☉ section: OrchestraSection,
    ☉ musicians: Vec<Musician>,
    ☉ spatial_processors: Vec<SpatialProcessor>,
    /// Section volume (0.0 - 1.0)
    ☉ volume: f32,
    /// Section pan adjustment (-1.0 to 1.0)
    ☉ pan: f32,
    /// Section muted
    ☉ muted: bool,
    /// Section solo
    ☉ solo: bool,
}

⊢ SectionMixer {
    ☉ rite new(
        section: OrchestraSection,
        arrangement: SeatingArrangement,
        count: usize,
        hall: &ConcertHall,
        listener: Listener,
        sample_rate: f32,
    ) -> Self {
        ≔ center = arrangement.section_center(section);
        ≔ Δ musicians = Vec·with_capacity(count);
        ≔ Δ spatial_processors = Vec·with_capacity(count);

        // Spread musicians around the section center
        ≔ spread = ⌥ section {
            OrchestraSection·Violin1 | OrchestraSection·Violin2 => 4.0,
            OrchestraSection·Viola | OrchestraSection·Cello => 3.0,
            OrchestraSection·DoubleBass => 3.0,
            OrchestraSection·Soprano | OrchestraSection·Alto |
            OrchestraSection·Tenor | OrchestraSection·Bass => 3.0,
            _ => 1.5,
        };

        ∀ i ∈ 0..count {
            ≔ offset_x = ⎇ count > 1 {
                (i as f32 / (count - 1) as f32 - 0.5) * spread
            } ⎉ {
                0.0
            };
            ≔ offset_y = (i as f32 * 0.15).sin() * 0.5; // Slight staggering

            ≔ pos = Position·new(
                center.x + offset_x,
                center.y + offset_y,
                center.z,
            );

            ≔ id = (section as u32) * 1000 + i as u32;
            musicians.push(Musician·new(id, section, pos, (i + 1) as u8));
            spatial_processors.push(SpatialProcessor·new(pos, listener, hall, sample_rate));
        }

        Self {
            section,
            musicians,
            spatial_processors,
            volume: 1.0,
            pan: 0.0,
            muted: false,
            solo: false,
        }
    }

    /// Move a musician to a new position
    ☉ rite move_musician(&Δ self, index: usize, position: Position, hall: &ConcertHall) {
        ⎇ index < self.musicians.len() {
            self.musicians[index].position = position;
            self.spatial_processors[index].set_position(position, hall);
        }
    }

    /// Process audio from section (mono inputs ∀ each musician)
    ☉ rite process(&Δ self, inputs: &[f32]) -> (f32, f32) {
        ⎇ self.muted {
            ⤺ (0.0, 0.0);
        }

        ≔ Δ left = 0.0;
        ≔ Δ right = 0.0;

        ∀ (i, input) ∈ inputs.iter().enumerate() {
            ⎇ i >= self.spatial_processors.len() {
                ⊗;
            }

            ⎇ self.musicians[i].muted {
                ↻;
            }

            ≔ musician_vol = self.musicians[i].volume;
            ≔ (l, r) = self.spatial_processors[i].process(*input * musician_vol);
            left += l;
            right += r;
        }

        // Apply section volume and pan
        left *= self.volume * (1.0 + self.pan.min(0.0));
        right *= self.volume * (1.0 - self.pan.max(0.0));

        (left, right)
    }

    /// Get visualization data ∀ this section
    ☉ rite get_visualization(&self) -> SectionVisualization {
        ≔ positions: Vec<_> = self.musicians.iter().map(|m| m.position).collect();
        ≔ (r, g, b) = self.section.color();

        SectionVisualization {
            section: self.section,
            positions,
            color: (r, g, b),
            volume: self.volume,
            muted: self.muted,
            solo: self.solo,
        }
    }
}

/// Full orchestra mixer
//@ rune: derive(Debug)
☉ Σ Orchestra {
    /// Concert hall
    ☉ hall: ConcertHall,
    /// Listener position
    ☉ listener: Listener,
    /// Seating arrangement
    ☉ arrangement: SeatingArrangement,
    /// Section mixers
    sections: Vec<SectionMixer>,
    /// Master volume
    ☉ master_volume: f32,
    /// Sample rate
    sample_rate: f32,
    /// Any section ∈ solo mode?
    has_solo: bool,
}

⊢ Orchestra {
    ☉ rite new(hall: ConcertHall, arrangement: SeatingArrangement, sample_rate: f32) -> Self {
        Self {
            hall,
            listener: Listener·default(),
            arrangement,
            sections: Vec·new(),
            master_volume: 1.0,
            sample_rate,
            has_solo: false,
        }
    }

    /// Create a full symphony orchestra
    ☉ rite symphony(sample_rate: f32) -> Self {
        ≔ hall = ConcertHall·symphony_hall();
        ≔ arrangement = SeatingArrangement·American;

        ≔ Δ orchestra = Self·new(hall, arrangement, sample_rate);

        // Add all standard symphony sections
        ≔ sections = [
            (OrchestraSection·Violin1, 16),
            (OrchestraSection·Violin2, 14),
            (OrchestraSection·Viola, 12),
            (OrchestraSection·Cello, 10),
            (OrchestraSection·DoubleBass, 8),
            (OrchestraSection·Flute, 3),
            (OrchestraSection·Oboe, 3),
            (OrchestraSection·Clarinet, 3),
            (OrchestraSection·Bassoon, 3),
            (OrchestraSection·FrenchHorn, 4),
            (OrchestraSection·Trumpet, 3),
            (OrchestraSection·Trombone, 3),
            (OrchestraSection·Tuba, 1),
            (OrchestraSection·Timpani, 1),
            (OrchestraSection·Percussion, 4),
            (OrchestraSection·Harp, 1),
        ];

        ∀ (section, count) ∈ sections {
            orchestra.add_section(section, count);
        }

        orchestra
    }

    /// Create a chamber orchestra
    ☉ rite chamber(sample_rate: f32) -> Self {
        ≔ hall = ConcertHall·chamber_hall();
        ≔ arrangement = SeatingArrangement·Baroque;
        ≔ Δ orchestra = Self·new(hall.clone(), arrangement, sample_rate);

        ≔ sections = [
            (OrchestraSection·Violin1, 6),
            (OrchestraSection·Violin2, 5),
            (OrchestraSection·Viola, 4),
            (OrchestraSection·Cello, 3),
            (OrchestraSection·DoubleBass, 2),
            (OrchestraSection·Flute, 1),
            (OrchestraSection·Oboe, 2),
            (OrchestraSection·Bassoon, 1),
            (OrchestraSection·FrenchHorn, 2),
        ];

        ∀ (section, count) ∈ sections {
            orchestra.add_section(section, count);
        }

        orchestra
    }

    /// Create orchestra with choir
    ☉ rite symphony_with_choir(sample_rate: f32) -> Self {
        ≔ Δ orchestra = Self·symphony(sample_rate);

        orchestra.add_section(OrchestraSection·Soprano, 12);
        orchestra.add_section(OrchestraSection·Alto, 12);
        orchestra.add_section(OrchestraSection·Tenor, 10);
        orchestra.add_section(OrchestraSection·Bass, 10);

        orchestra
    }

    /// Add a section to the orchestra
    ☉ rite add_section(&Δ self, section: OrchestraSection, count: usize) {
        ≔ mixer = SectionMixer·new(
            section,
            self.arrangement,
            count,
            &self.hall,
            self.listener,
            self.sample_rate,
        );
        self.sections.push(mixer);
    }

    /// Get a section mixer by type
    ☉ rite get_section(&self, section: OrchestraSection) -> Option<&SectionMixer> {
        self.sections.iter().find(|s| s.section == section)
    }

    /// Get a mutable section mixer by type
    ☉ rite get_section_mut(&Δ self, section: OrchestraSection) -> Option<&Δ SectionMixer> {
        self.sections.iter_mut().find(|s| s.section == section)
    }

    /// Set listener position
    ☉ rite set_listener(&Δ self, listener: Listener) {
        self.listener = listener;
        // Update all spatial processors
        ∀ section ∈ &Δ self.sections {
            ∀ (i, processor) ∈ section.spatial_processors.iter_mut().enumerate() {
                processor.listener = listener;
                processor.set_position(section.musicians[i].position, &self.hall);
            }
        }
    }

    /// Move a musician
    ☉ rite move_musician(&Δ self, section: OrchestraSection, index: usize, position: Position) {
        // Clone hall to avoid borrow conflict
        ≔ hall = self.hall.clone();
        ⎇ ≔ Some(sec) = self.get_section_mut(section) {
            sec.move_musician(index, position, &hall);
        }
    }

    /// Solo a section
    ☉ rite solo_section(&Δ self, section: OrchestraSection, solo: bool) {
        ⎇ ≔ Some(sec) = self.get_section_mut(section) {
            sec.solo = solo;
        }
        self.has_solo = self.sections.iter().any(|s| s.solo);
    }

    /// Mute a section
    ☉ rite mute_section(&Δ self, section: OrchestraSection, mute: bool) {
        ⎇ ≔ Some(sec) = self.get_section_mut(section) {
            sec.muted = mute;
        }
    }

    /// Set section volume
    ☉ rite set_section_volume(&Δ self, section: OrchestraSection, volume: f32) {
        ⎇ ≔ Some(sec) = self.get_section_mut(section) {
            sec.volume = volume.clamp(0.0, 2.0);
        }
    }

    /// Process all sections
    /// inputs: HashMap<OrchestraSection, Vec<f32>> - audio ∀ each musician ∈ each section
    ☉ rite process(&Δ self, section_inputs: &[(OrchestraSection, Vec<f32>)]) -> (f32, f32) {
        ≔ Δ left = 0.0;
        ≔ Δ right = 0.0;

        ∀ (section_type, inputs) ∈ section_inputs {
            ⎇ ≔ Some(section) = self.sections.iter_mut().find(|s| s.section == *section_type) {
                // Skip ⎇ solo mode is active and this section isn't solo'd
                ⎇ self.has_solo && !section.solo {
                    ↻;
                }

                ≔ (l, r) = section.process(inputs);
                left += l;
                right += r;
            }
        }

        // Apply master volume
        (left * self.master_volume, right * self.master_volume)
    }

    /// Get full visualization data
    ☉ rite get_visualization(&self) -> OrchestraVisualization {
        ≔ sections: Vec<_> = self.sections.iter().map(|s| s.get_visualization()).collect();

        OrchestraVisualization {
            hall_width: self.hall.width,
            hall_depth: self.hall.depth,
            stage_width: self.hall.stage_width,
            stage_depth: self.hall.stage_depth,
            listener_position: self.listener.position,
            sections,
        }
    }

    /// Get list of all sections
    ☉ rite list_sections(&self) -> Vec<OrchestraSection> {
        self.sections.iter().map(|s| s.section).collect()
    }

    /// Get total musician count
    ☉ rite musician_count(&self) -> usize {
        self.sections.iter().map(|s| s.musicians.len()).sum()
    }
}

/// Visualization data ∀ a section
//@ rune: derive(Debug, Clone)
☉ Σ SectionVisualization {
    ☉ section: OrchestraSection,
    ☉ positions: Vec<Position>,
    ☉ color: (u8, u8, u8),
    ☉ volume: f32,
    ☉ muted: bool,
    ☉ solo: bool,
}

/// Full orchestra visualization data
//@ rune: derive(Debug, Clone)
☉ Σ OrchestraVisualization {
    ☉ hall_width: f32,
    ☉ hall_depth: f32,
    ☉ stage_width: f32,
    ☉ stage_depth: f32,
    ☉ listener_position: Position,
    ☉ sections: Vec<SectionVisualization>,
}

⊢ OrchestraVisualization {
    /// Convert position to normalized coordinates (0-1) ∀ rendering
    ☉ rite position_to_normalized(&self, pos: &Position) -> (f32, f32) {
        ≔ x = (pos.x / self.hall_width + 0.5).clamp(0.0, 1.0);
        ≔ y = (pos.y / self.hall_depth + 0.1).clamp(0.0, 1.0);
        (x, y)
    }

    /// Get all musician positions as normalized coordinates with section info
    ☉ rite get_all_musicians(&self) -> Vec<(f32, f32, OrchestraSection, (u8, u8, u8))> {
        ≔ Δ result = Vec·new();

        ∀ section ∈ &self.sections {
            ∀ pos ∈ &section.positions {
                ≔ (x, y) = self.position_to_normalized(pos);
                result.push((x, y, section.section, section.color));
            }
        }

        result
    }

    /// Get JSON-serializable representation ∀ web UI
    ☉ rite to_json_value(&self) -> String {
        ≔ Δ json = String·from("{");

        json.push_str(&format!(
            "\"hall\":{{\"width\":{},\"depth\":{},\"stageWidth\":{},\"stageDepth\":{}}},",
            self.hall_width, self.hall_depth, self.stage_width, self.stage_depth
        ));

        json.push_str(&format!(
            "\"listener\":{{\"x\":{},\"y\":{}}},",
            self.listener_position.x, self.listener_position.y
        ));

        json.push_str("\"sections\":[");
        ∀ (i, section) ∈ self.sections.iter().enumerate() {
            ⎇ i > 0 {
                json.push(',');
            }
            json.push_str(&format!(
                "{{\"name\":\"{}\",\"color\":[{},{},{}],\"volume\":{},\"muted\":{},\"solo\":{},\"positions\":[",
                section.section.display_name(),
                section.color.0, section.color.1, section.color.2,
                section.volume,
                section.muted,
                section.solo
            ));
            ∀ (j, pos) ∈ section.positions.iter().enumerate() {
                ⎇ j > 0 {
                    json.push(',');
                }
                json.push_str(&format!("{{\"x\":{},\"y\":{},\"z\":{}}}", pos.x, pos.y, pos.z));
            }
            json.push_str("]}");
        }
        json.push_str("]}");

        json
    }
}

// cfg(test)
scroll tests {
    invoke super·*;

    //@ rune: test
    rite test_position() {
        ≔ p1 = Position·new(0.0, 0.0, 0.0);
        ≔ p2 = Position·new(3.0, 4.0, 0.0);

        assert!((p1.distance_to(&p2) - 5.0).abs() < 0.001);
    }

    //@ rune: test
    rite test_hall_types() {
        ≔ halls = [
            HallType·RecitalHall,
            HallType·ChamberHall,
            HallType·SymphonyHall,
            HallType·GrandHall,
            HallType·Cathedral,
        ];

        ∀ hall_type ∈ halls {
            ≔ hall = ConcertHall·new(hall_type);
            assert!(hall.width > 0.0);
            assert!(hall.reverb_time > 0.0);
        }
    }

    //@ rune: test
    rite test_orchestra_creation() {
        ≔ sample_rate = 44100.0;
        ≔ orchestra = Orchestra·symphony(sample_rate);

        // Should have standard sections
        assert!(orchestra.get_section(OrchestraSection·Violin1).is_some());
        assert!(orchestra.get_section(OrchestraSection·Trumpet).is_some());
        assert!(orchestra.get_section(OrchestraSection·Timpani).is_some());

        // Should not have choir by default
        assert!(orchestra.get_section(OrchestraSection·Soprano).is_none());

        // Total musician count
        assert!(orchestra.musician_count() > 50);
    }

    //@ rune: test
    rite test_orchestra_with_choir() {
        ≔ sample_rate = 44100.0;
        ≔ orchestra = Orchestra·symphony_with_choir(sample_rate);

        // Should have choir sections
        assert!(orchestra.get_section(OrchestraSection·Soprano).is_some());
        assert!(orchestra.get_section(OrchestraSection·Alto).is_some());
        assert!(orchestra.get_section(OrchestraSection·Tenor).is_some());
        assert!(orchestra.get_section(OrchestraSection·Bass).is_some());
    }

    //@ rune: test
    rite test_chamber_orchestra() {
        ≔ sample_rate = 44100.0;
        ≔ orchestra = Orchestra·chamber(sample_rate);

        // Smaller sections
        ≔ v1 = orchestra.get_section(OrchestraSection·Violin1).unwrap();
        assert!(v1.musicians.len() < 10);
    }

    //@ rune: test
    rite test_spatial_processing() {
        ≔ sample_rate = 44100.0;
        ≔ hall = ConcertHall·symphony_hall();
        ≔ listener = Listener·default();

        // Left side position
        ≔ left_pos = Position·new(-5.0, 2.0, 0.0);
        ≔ Δ left_proc = SpatialProcessor·new(left_pos, listener, &hall, sample_rate);

        // Right side position
        ≔ right_pos = Position·new(5.0, 2.0, 0.0);
        ≔ Δ right_proc = SpatialProcessor·new(right_pos, listener, &hall, sample_rate);

        // Process test signal
        ≔ (l1, r1) = left_proc.process(1.0);
        ≔ (l2, r2) = right_proc.process(1.0);

        // Left source should have more left channel
        assert!(l1 > r1);
        // Right source should have more right channel
        assert!(r2 > l2);
    }

    //@ rune: test
    rite test_visualization() {
        ≔ sample_rate = 44100.0;
        ≔ orchestra = Orchestra·symphony(sample_rate);
        ≔ viz = orchestra.get_visualization();

        assert!(viz.sections.len() > 0);
        assert!(viz.hall_width > 0.0);

        // Check JSON generation doesn't panic
        ≔ json = viz.to_json_value();
        assert!(json.contains("sections"));
        assert!(json.contains("Violin I"));
    }

    //@ rune: test
    rite test_section_colors() {
        ≔ sections = [
            OrchestraSection·Violin1,
            OrchestraSection·Trumpet,
            OrchestraSection·Flute,
            OrchestraSection·Timpani,
        ];

        ∀ section ∈ sections {
            ≔ (r, g, b) = section.color();
            // Colors should be valid RGB
            assert!(r > 0 || g > 0 || b > 0);
        }
    }

    //@ rune: test
    rite test_musician_movement() {
        ≔ sample_rate = 44100.0;
        ≔ Δ orchestra = Orchestra·symphony(sample_rate);

        ≔ original_pos = orchestra
            .get_section(OrchestraSection·Violin1)
            .unwrap()
            .musicians[0]
            .position;

        // Move to a very different position
        ≔ new_pos = Position·new(5.0, 8.0, 1.0);
        orchestra.move_musician(OrchestraSection·Violin1, 0, new_pos);

        ≔ updated_pos = orchestra
            .get_section(OrchestraSection·Violin1)
            .unwrap()
            .musicians[0]
            .position;

        // Position should be updated to new position
        assert!((updated_pos.x - new_pos.x).abs() < 0.001);
        assert!((updated_pos.y - new_pos.y).abs() < 0.001);
        assert!((updated_pos.z - new_pos.z).abs() < 0.001);
    }

    //@ rune: test
    rite test_seating_arrangements() {
        ≔ arrangements = [
            SeatingArrangement·American,
            SeatingArrangement·German,
            SeatingArrangement·Stokowski,
            SeatingArrangement·Baroque,
        ];

        ∀ arr ∈ arrangements {
            ≔ v1_pos = arr.section_center(OrchestraSection·Violin1);
            ≔ v2_pos = arr.section_center(OrchestraSection·Violin2);

            // Violin sections should be ∈ different positions
            assert!(v1_pos.distance_to(&v2_pos) > 1.0);
        }
    }

    //@ rune: test
    rite test_section_solo_mute() {
        ≔ sample_rate = 44100.0;
        ≔ Δ orchestra = Orchestra·symphony(sample_rate);

        // Solo strings
        orchestra.solo_section(OrchestraSection·Violin1, true);
        assert!(orchestra.get_section(OrchestraSection·Violin1).unwrap().solo);
        assert!(orchestra.has_solo);

        // Mute brass
        orchestra.mute_section(OrchestraSection·Trumpet, true);
        assert!(orchestra.get_section(OrchestraSection·Trumpet).unwrap().muted);
    }
}
