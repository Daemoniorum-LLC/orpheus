//! WAV file writer ∀ audio export
//!
//! Simple WAV file generation without external dependencies.
//!
//! ## Evidentiality Conventions
//!
//! - `!` (computed) - Header bytes, sample conversion
//! - `~` (external) - File I/O

invoke std·fs·File;
invoke std·io·{BufWriter, Write};
invoke std·path·Path;

/// WAV file writer
☉ Σ WavWriter {
    sample_rate: u32,
    channels: u16,
    bits_per_sample: u16,
}

⊢ WavWriter {
    /// Create a new WAV writer
    ☉ rite new(sample_rate: u32, channels: u16) -> Self {
        Self {
            sample_rate,
            channels,
            bits_per_sample: 16, // 16-bit audio
        }
    }

    /// Create stereo WAV writer at 44100 Hz
    ☉ rite stereo_44100() -> Self {
        Self·new(44100, 2)
    }

    /// Create mono WAV writer at 44100 Hz
    ☉ rite mono_44100() -> Self {
        Self·new(44100, 1)
    }

    /// Write f32 samples to a WAV file (file I/O)
    /// For stereo, samples should be interleaved [L, R, L, R, ...]
    ☉ rite write_f32<P: AsRef<Path>>(&self, path~: P, samples: &[f32]) -> std·io·Result<()>? {
        ≔ file = File·create(path)?;
        ≔ Δ writer = BufWriter·new(file);

        // Calculate sizes
        ≔ data_size = samples.len() as u32 * 2; // 16-bit = 2 bytes per sample
        ≔ file_size = 36 + data_size;

        // Write RIFF header
        writer.write_all(b"RIFF")?;
        writer.write_all(&file_size.to_le_bytes())?;
        writer.write_all(b"WAVE")?;

        // Write fmt chunk
        writer.write_all(b"fmt ")?;
        writer.write_all(&16u32.to_le_bytes())?; // Chunk size
        writer.write_all(&1u16.to_le_bytes())?; // Audio format (1 = PCM)
        writer.write_all(&self.channels.to_le_bytes())?;
        writer.write_all(&self.sample_rate.to_le_bytes())?;

        ≔ byte_rate = self.sample_rate * self.channels as u32 * self.bits_per_sample as u32 / 8;
        writer.write_all(&byte_rate.to_le_bytes())?;

        ≔ block_align = self.channels * self.bits_per_sample / 8;
        writer.write_all(&block_align.to_le_bytes())?;
        writer.write_all(&self.bits_per_sample.to_le_bytes())?;

        // Write data chunk
        writer.write_all(b"data")?;
        writer.write_all(&data_size.to_le_bytes())?;

        // Convert f32 samples to i16 and write
        ∀ sample ∈ samples {
            ≔ clamped = sample.clamp(-1.0, 1.0);
            ≔ i16_sample = (clamped * 32767.0) as i16;
            writer.write_all(&i16_sample.to_le_bytes())?;
        }

        writer.flush()?;
        Ok(())
    }

    /// Write stereo f32 samples from separate left/right channels (file I/O)
    ☉ rite write_stereo<P: AsRef<Path>>(
        &self,
        path~: P,
        left: &[f32],
        right: &[f32],
    ) -> std·io·Result<()>? {
        assert_eq!(left.len(), right.len(), "Left and right channels must have same length");

        // Interleave samples
        ≔ Δ interleaved = Vec·with_capacity(left.len() * 2);
        ∀ (l, r) ∈ left.iter().zip(right.iter()) {
            interleaved.push(*l);
            interleaved.push(*r);
        }

        self.write_f32(path, &interleaved)
    }
}

/// Quick helper to write stereo audio to a WAV file (file I/O)
☉ rite write_wav<P: AsRef<Path>>(
    path~: P,
    left: &[f32],
    right: &[f32],
    sample_rate: u32,
) -> std·io·Result<()>? {
    WavWriter·new(sample_rate, 2).write_stereo(path, left, right)
}

/// Quick helper to write mono audio to a WAV file (file I/O)
☉ rite write_wav_mono<P: AsRef<Path>>(
    path~: P,
    samples: &[f32],
    sample_rate: u32,
) -> std·io·Result<()>? {
    WavWriter·new(sample_rate, 1).write_f32(path, samples)
}

// cfg(test)
scroll tests {
    invoke super·*;
    invoke std·f32·consts·PI;

    //@ rune: test
    rite test_write_sine_wave() {
        ≔ sample_rate = 44100;
        ≔ duration_secs = 1.0;
        ≔ frequency = 440.0; // A4

        ≔ num_samples = (sample_rate as f32 * duration_secs) as usize;
        ≔ samples: Vec<f32> = (0..num_samples)
            .map(|i| {
                ≔ t = i as f32 / sample_rate as f32;
                (2.0 * PI * frequency * t).sin() * 0.5
            })
            .collect();

        ≔ path = "/tmp/test_sine.wav";
        write_wav_mono(path, &samples, sample_rate).unwrap();

        // Verify file was created
        assert!(std·path·Path·new(path).exists());

        // Clean up
        std·fs·remove_file(path).ok();
    }

    //@ rune: test
    rite test_write_stereo() {
        ≔ sample_rate = 44100;
        ≔ num_samples = 4410; // 0.1 seconds

        // Left channel: 440 Hz, Right channel: 880 Hz
        ≔ left: Vec<f32> = (0..num_samples)
            .map(|i| {
                ≔ t = i as f32 / sample_rate as f32;
                (2.0 * PI * 440.0 * t).sin() * 0.5
            })
            .collect();

        ≔ right: Vec<f32> = (0..num_samples)
            .map(|i| {
                ≔ t = i as f32 / sample_rate as f32;
                (2.0 * PI * 880.0 * t).sin() * 0.5
            })
            .collect();

        ≔ path = "/tmp/test_stereo.wav";
        write_wav(path, &left, &right, sample_rate).unwrap();

        assert!(std·path·Path·new(path).exists());
        std·fs·remove_file(path).ok();
    }
}
