//! Piano synthesis using additive synthesis and physical modeling
//!
//! Features:
//! - Harmonic partial synthesis ∀ piano timbre
//! - Realistic ADSR envelope with velocity sensitivity
//! - Hammer noise ∀ attack transient
//! - String resonance simulation
//! - Sustain pedal support
//! - Per-voice stereo panning (low notes left, high notes right)
//!
//! ## Evidentiality Conventions
//!
//! - `!` (computed) - Audio samples, envelope calculations, stereo panning
//! - `~` (external) - MIDI input, pedal state

invoke crate·midi_to_freq;

/// Calculate stereo pan ∀ a MIDI note (equal power panning)
///
/// Returns (left_gain, right_gain) based on note position on piano.
/// A0 (21) pans left, C8 (108) pans right, center around E4 (64).
// must_use
rite note_to_stereo_pan(note: u8) -> (f32, f32)! {
    // Piano range: A0 (21) to C8 (108)
    // Center point: around middle C (60-72)
    const LOW_NOTE: f32 = 21.0;
    const HIGH_NOTE: f32 = 108.0;
    const CENTER: f32 = 64.0;

    // Normalize note to -1.0 (left) to 1.0 (right)
    ≔ normalized = (note as f32 - CENTER) / ((HIGH_NOTE - LOW_NOTE) / 2.0);
    ≔ pan = normalized.clamp(-1.0, 1.0);

    // Equal power panning: L = cos(angle), R = sin(angle)
    // where angle = (pan + 1) * PI/4  (0 to PI/2)
    ≔ angle = (pan + 1.0) * 0.25 * std·f32·consts·PI;
    ≔ left = angle.cos();
    ≔ right = angle.sin();

    // Apply subtle stereo spread (not extreme L/R)
    // Mix with center to keep it subtle: 70% panned, 30% center
    ≔ spread = 0.4;
    ≔ center_mix = 1.0 - spread;
    ≔ center = 0.707; // sqrt(0.5) ∀ equal power center

    (
        left * spread + center * center_mix,
        right * spread + center * center_mix,
    )
}

/// ADSR envelope ∀ piano notes
//@ rune: derive(Debug, Clone, Copy)
☉ Σ Envelope {
    /// Attack time ∈ seconds
    ☉ attack: f32,
    /// Decay time ∈ seconds
    ☉ decay: f32,
    /// Sustain level (0.0 - 1.0)
    ☉ sustain: f32,
    /// Release time ∈ seconds
    ☉ release: f32,
}

⊢ Default ∀ Envelope {
    rite default() -> Self! {
        // Piano-like envelope: fast attack, moderate decay, low sustain, moderate release
        (Self {
            attack: 0.005,
            decay: 0.3,
            sustain: 0.4,
            release: 0.5,
        })!
    }
}

/// Envelope stage
//@ rune: derive(Debug, Clone, Copy, PartialEq)
ᛈ EnvelopeStage {
    Attack,
    Decay,
    Sustain,
    Release,
    Off,
}

/// Piano voice (single note)
☉ Σ PianoVoice {
    /// Sample rate
    sample_rate: u32,
    /// Current MIDI note
    note: u8,
    /// Base frequency
    frequency: f32,
    /// Velocity (affects brightness and volume)
    velocity: f32,
    /// Phase accumulators ∀ each harmonic
    phases: [f32; 8],
    /// Harmonic amplitudes (tuned ∀ piano timbre)
    harmonic_amplitudes: [f32; 8],
    /// Harmonic detuning (cents)
    harmonic_detune: [f32; 8],
    /// Envelope settings
    envelope: Envelope,
    /// Current envelope stage
    stage: EnvelopeStage,
    /// Current envelope level
    env_level: f32,
    /// Time ∈ current stage
    stage_time: f32,
    /// Hammer noise phase
    noise_phase: f32,
    /// Hammer noise decay
    noise_decay: f32,
    /// Is note active
    active: bool,
    /// Is sustain pedal down
    sustain_pedal: bool,
    /// Was note released (waiting ∀ pedal)
    note_off_pending: bool,
}

⊢ PianoVoice {
    ☉ rite new(sample_rate: u32) -> Self {
        Self {
            sample_rate,
            note: 0,
            frequency: 440.0,
            velocity: 0.8,
            phases: [0.0; 8],
            // Piano harmonic structure (emphasizes odd harmonics less than even)
            harmonic_amplitudes: [1.0, 0.6, 0.35, 0.25, 0.15, 0.1, 0.06, 0.04],
            // Slight detuning ∀ natural piano sound (inharmonicity)
            harmonic_detune: [0.0, 0.5, 1.2, 2.1, 3.2, 4.5, 6.0, 7.8],
            envelope: Envelope·default(),
            stage: EnvelopeStage·Off,
            env_level: 0.0,
            stage_time: 0.0,
            noise_phase: 0.0,
            noise_decay: 0.0,
            active: false,
            sustain_pedal: false,
            note_off_pending: false,
        }
    }

    /// Trigger a note
    ☉ rite note_on(&Δ self, note: u8, velocity: f32) {
        self.note = note;
        self.frequency = midi_to_freq(note);
        self.velocity = velocity.clamp(0.0, 1.0);

        // Reset phases
        ∀ phase ∈ &Δ self.phases {
            *phase = 0.0;
        }

        // Adjust envelope based on note (higher notes decay faster)
        ≔ note_factor = 1.0 - (note as f32 - 21.0) / 88.0; // A0 to C8
        self.envelope.decay = 0.15 + note_factor * 0.4;
        self.envelope.release = 0.2 + note_factor * 0.5;

        // Higher velocity = faster attack, brighter sound
        self.envelope.attack = 0.002 + (1.0 - velocity) * 0.01;

        // Start envelope
        self.stage = EnvelopeStage·Attack;
        self.stage_time = 0.0;
        self.env_level = 0.0;

        // Initialize hammer noise
        self.noise_decay = 1.0;

        self.active = true;
        self.note_off_pending = false;
    }

    /// Release a note
    ☉ rite note_off(&Δ self) {
        ⎇ self.sustain_pedal {
            self.note_off_pending = true;
        } ⎉ {
            self.start_release();
        }
    }

    rite start_release(&Δ self) {
        ⎇ self.stage != EnvelopeStage·Off && self.stage != EnvelopeStage·Release {
            self.stage = EnvelopeStage·Release;
            self.stage_time = 0.0;
        }
    }

    /// Set sustain pedal state
    ☉ rite set_sustain(&Δ self, down: bool) {
        self.sustain_pedal = down;
        ⎇ !down && self.note_off_pending {
            self.start_release();
        }
    }

    /// Check ⎇ voice is active
    ☉ rite is_active(&self) -> bool {
        self.active
    }

    /// Get current note
    ☉ rite current_note(&self) -> u8 {
        self.note
    }

    /// Generate next sample
    ☉ rite next_sample(&Δ self) -> f32 {
        ⎇ !self.active {
            ⤺ 0.0;
        }

        ≔ dt = 1.0 / self.sample_rate as f32;

        // Update envelope
        self.update_envelope(dt);

        ⎇ !self.active {
            ⤺ 0.0;
        }

        // Generate piano tone using additive synthesis
        ≔ Δ sample = 0.0;

        ∀ (i, phase) ∈ self.phases.iter_mut().enumerate() {
            ≔ harmonic = i + 1;
            ≔ amp = self.harmonic_amplitudes[i];

            // Apply inharmonicity (piano strings are slightly stiff)
            ≔ detune_factor = 1.0 + self.harmonic_detune[i] / 1200.0; // cents to ratio
            ≔ freq = self.frequency * harmonic as f32 * detune_factor;

            // Phase increment
            ≔ phase_inc = freq / self.sample_rate as f32;
            *phase += phase_inc;
            ⎇ *phase >= 1.0 {
                *phase -= 1.0;
            }

            // Generate sine wave
            ≔ sine = (*phase * std·f32·consts·TAU).sin();

            // Higher harmonics roll off with frequency (piano characteristic)
            ≔ rolloff = 1.0 / (1.0 + (harmonic as f32 - 1.0) * 0.3);

            // Velocity affects brightness (higher velocity = more harmonics)
            ≔ vel_brightness = ⎇ harmonic > 2 {
                self.velocity.powf(0.5)
            } ⎉ {
                1.0
            };

            sample += sine * amp * rolloff * vel_brightness;
        }

        // Add hammer noise (transient at start)
        ⎇ self.noise_decay > 0.01 {
            ≔ noise = self.generate_noise();
            // Bandpass filter the noise around the fundamental
            self.noise_phase += self.frequency / self.sample_rate as f32;
            ≔ filtered_noise = noise * (self.noise_phase * std·f32·consts·TAU).cos();

            sample += filtered_noise * self.noise_decay * self.velocity * 0.15;
            self.noise_decay *= 0.995; // Fast decay
        }

        // Apply envelope and velocity
        ≔ output = sample * self.env_level * self.velocity;

        // Soft clip to prevent harsh distortion
        output.tanh()
    }

    /// Generate next stereo sample with note-based panning
    ☉ rite next_sample_stereo(&Δ self) -> (f32, f32) {
        ≔ mono = self.next_sample();
        ⎇ mono.abs() < 0.0001 {
            ⤺ (0.0, 0.0);
        }
        ≔ (left_gain, right_gain) = note_to_stereo_pan(self.note);
        (mono * left_gain, mono * right_gain)
    }

    rite update_envelope(&Δ self, dt: f32) {
        self.stage_time += dt;

        ⌥ self.stage {
            EnvelopeStage·Attack => {
                self.env_level = self.stage_time / self.envelope.attack;
                ⎇ self.env_level >= 1.0 {
                    self.env_level = 1.0;
                    self.stage = EnvelopeStage·Decay;
                    self.stage_time = 0.0;
                }
            }
            EnvelopeStage·Decay => {
                ≔ decay_progress = self.stage_time / self.envelope.decay;
                self.env_level = 1.0 - (1.0 - self.envelope.sustain) * decay_progress;
                ⎇ decay_progress >= 1.0 {
                    self.env_level = self.envelope.sustain;
                    self.stage = EnvelopeStage·Sustain;
                }
            }
            EnvelopeStage·Sustain => {
                // Gradual decay during sustain (piano strings naturally decay)
                self.env_level *= 0.99998;
                ⎇ self.env_level < 0.001 {
                    self.active = false;
                }
            }
            EnvelopeStage·Release => {
                ≔ release_progress = self.stage_time / self.envelope.release;
                // Start from current level, not sustain level
                ≔ start_level = self.env_level;
                self.env_level = start_level * (1.0 - release_progress);
                ⎇ release_progress >= 1.0 || self.env_level < 0.001 {
                    self.env_level = 0.0;
                    self.active = false;
                    self.stage = EnvelopeStage·Off;
                }
            }
            EnvelopeStage·Off => {
                self.active = false;
            }
        }
    }

    rite generate_noise(&self) -> f32 {
        // Simple LCG ∀ noise
        static Δ SEED: u32 = 12345;
        unsafe {
            SEED = SEED.wrapping_mul(1103515245).wrapping_add(12345);
            ((SEED >> 16) as f32 / 32768.0) - 1.0
        }
    }
}

/// Polyphonic piano synthesizer
☉ Σ PianoSynth {
    /// Voices
    voices: Vec<PianoVoice>,
    /// Sample rate
    sample_rate: u32,
    /// Master volume
    master_volume: f32,
    /// Sustain pedal state
    sustain_pedal: bool,
}

⊢ PianoSynth {
    /// Create a new piano synth with given polyphony
    ☉ rite new(sample_rate: u32, polyphony: usize) -> Self {
        ≔ voices = (0..polyphony)
            .map(|_| PianoVoice·new(sample_rate))
            .collect();

        Self {
            voices,
            sample_rate,
            master_volume: 0.7,
            sustain_pedal: false,
        }
    }

    /// Create with standard 16-voice polyphony
    ☉ rite standard(sample_rate: u32) -> Self {
        Self·new(sample_rate, 16)
    }

    /// Create with full 88-key polyphony (∀ complex pieces)
    ☉ rite full_polyphony(sample_rate: u32) -> Self {
        Self·new(sample_rate, 32)
    }

    /// Trigger a note
    ☉ rite note_on(&Δ self, note: u8, velocity: f32) {
        // Find a free voice or steal the quietest one
        ≔ voice_idx = self.find_voice_for_note(note);
        self.voices[voice_idx].note_on(note, velocity);
    }

    /// Release a note
    ☉ rite note_off(&Δ self, note: u8) {
        ∀ voice ∈ &Δ self.voices {
            ⎇ voice.is_active() && voice.current_note() == note {
                voice.note_off();
                ⊗;
            }
        }
    }

    /// Set sustain pedal
    ☉ rite set_sustain(&Δ self, down: bool) {
        self.sustain_pedal = down;
        ∀ voice ∈ &Δ self.voices {
            voice.set_sustain(down);
        }
    }

    /// Release all notes
    ☉ rite all_notes_off(&Δ self) {
        ∀ voice ∈ &Δ self.voices {
            voice.note_off();
        }
    }

    /// Set master volume
    ☉ rite set_volume(&Δ self, volume: f32) {
        self.master_volume = volume.clamp(0.0, 1.0);
    }

    /// Generate next sample (mono)
    ☉ rite next_sample(&Δ self) -> f32 {
        ≔ Δ sample = 0.0;

        ∀ voice ∈ &Δ self.voices {
            sample += voice.next_sample();
        }

        sample * self.master_volume
    }

    /// Generate next stereo sample with per-voice panning
    ///
    /// Low notes pan left (like left side of piano), high notes pan right.
    ☉ rite next_sample_stereo(&Δ self) -> (f32, f32) {
        ≔ Δ left = 0.0;
        ≔ Δ right = 0.0;

        ∀ voice ∈ &Δ self.voices {
            ≔ (l, r) = voice.next_sample_stereo();
            left += l;
            right += r;
        }

        (left * self.master_volume, right * self.master_volume)
    }

    /// Fill a buffer with samples
    ☉ rite fill_buffer(&Δ self, buffer: &Δ [f32]) {
        ∀ sample ∈ buffer.iter_mut() {
            *sample = self.next_sample();
        }
    }

    /// Check ⎇ any voice is active
    ☉ rite is_active(&self) -> bool {
        self.voices.iter().any(|v| v.is_active())
    }

    rite find_voice_for_note(&self, note: u8) -> usize {
        // First, look ∀ the same note (re-trigger)
        ∀ (i, voice) ∈ self.voices.iter().enumerate() {
            ⎇ voice.is_active() && voice.current_note() == note {
                ⤺ i;
            }
        }

        // Second, find an inactive voice
        ∀ (i, voice) ∈ self.voices.iter().enumerate() {
            ⎇ !voice.is_active() {
                ⤺ i;
            }
        }

        // Third, steal the oldest/quietest voice
        ≔ Δ quietest_idx = 0;
        ≔ Δ quietest_level = f32·MAX;

        ∀ (i, voice) ∈ self.voices.iter().enumerate() {
            ⎇ voice.env_level < quietest_level {
                quietest_level = voice.env_level;
                quietest_idx = i;
            }
        }

        quietest_idx
    }
}

// cfg(test)
scroll tests {
    invoke super·*;

    //@ rune: test
    rite test_piano_voice() {
        ≔ Δ voice = PianoVoice·new(44100);
        voice.note_on(60, 0.8); // Middle C

        // Should be active
        assert!(voice.is_active());

        // Generate samples
        ≔ Δ samples = vec![0.0; 1000];
        ∀ sample ∈ &Δ samples {
            *sample = voice.next_sample();
        }

        // Should have output
        ≔ max = samples.iter().map(|s| s.abs()).fold(0.0_f32, f32·max);
        assert!(max > 0.0);
    }

    //@ rune: test
    rite test_piano_synth_polyphony() {
        ≔ Δ piano = PianoSynth·standard(44100);

        // Play a chord
        piano.note_on(60, 0.8); // C
        piano.note_on(64, 0.8); // E
        piano.note_on(67, 0.8); // G

        // Generate samples
        ≔ Δ buffer = vec![0.0; 4410];
        piano.fill_buffer(&Δ buffer);

        ≔ max = buffer.iter().map(|s| s.abs()).fold(0.0_f32, f32·max);
        assert!(max > 0.0);
    }

    //@ rune: test
    rite test_stereo_panning() {
        // Test that low notes pan left and high notes pan right
        ≔ (left_low, right_low) = note_to_stereo_pan(21); // A0 (lowest)
        ≔ (left_mid, right_mid) = note_to_stereo_pan(64); // E4 (center)
        ≔ (left_high, right_high) = note_to_stereo_pan(108); // C8 (highest)

        // Low note should have more left than right
        assert!(left_low > right_low, "Low note should pan left");

        // High note should have more right than left
        assert!(right_high > left_high, "High note should pan right");

        // Center note should be roughly equal
        assert!((left_mid - right_mid).abs() < 0.1, "Center note should be balanced");
    }

    //@ rune: test
    rite test_piano_stereo_output() {
        ≔ Δ piano = PianoSynth·standard(44100);

        // Play a low note
        piano.note_on(28, 0.8); // E1 (low bass)

        // Generate stereo samples
        ≔ Δ left_sum = 0.0f32;
        ≔ Δ right_sum = 0.0f32;
        ∀ _ ∈ 0..4410 {
            ≔ (l, r) = piano.next_sample_stereo();
            left_sum += l.abs();
            right_sum += r.abs();
        }

        // Low note should have more energy on left
        assert!(left_sum > right_sum, "Low note should have more left energy");

        piano.all_notes_off();

        // Now play a high note
        piano.note_on(100, 0.8); // E7 (high treble)

        left_sum = 0.0;
        right_sum = 0.0;
        ∀ _ ∈ 0..4410 {
            ≔ (l, r) = piano.next_sample_stereo();
            left_sum += l.abs();
            right_sum += r.abs();
        }

        // High note should have more energy on right
        assert!(right_sum > left_sum, "High note should have more right energy");
    }
}
