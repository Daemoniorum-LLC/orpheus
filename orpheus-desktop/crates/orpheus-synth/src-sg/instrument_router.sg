/// Drum kit wrapper
Σ DrumKitWrapper {
    machine: DrumMachine,
    volume: f32,
}

⊢ DrumKitWrapper {
    rite new(sample_rate: u32) -> Self {
        Self {
            machine: DrumMachine·new(sample_rate, 16),
            volume: 1.0,
        }
    }
}

⊢ Synthesizer ∀ DrumKitWrapper {
    rite note_on(&Δ self, note: u8, velocity: f32) {
        // Map MIDI drum notes to drum types
        ≔ drum = ⌥ note {
            35 | 36 => DrumType·Kick,
            38 | 40 => DrumType·Snare,
            42 | 44 => DrumType·ClosedHiHat,
            46 => DrumType·OpenHiHat,
            41 | 43 => DrumType·FloorTom,
            45 | 47 => DrumType·MidTom,
            48 | 50 => DrumType·HighTom,
            49 | 57 => DrumType·Crash,
            51 | 59 => DrumType·Ride,
            _ => DrumType·Snare,
        };

        self.machine.trigger(drum, velocity);
    }

    rite note_off(&Δ self, _note: u8) {}

    rite process(&Δ self, num_samples: usize) -> (Vec<f32>, Vec<f32>) {
        ≔ Δ left = Vec·with_capacity(num_samples);
        ≔ Δ right = Vec·with_capacity(num_samples);

        ∀ _ ∈ 0..num_samples {
            ≔ sample = self.machine.next_sample() * self.volume;
            // Mono drum output
            left.push(sample);
            right.push(sample);
        }

        (left, right)
    }

    rite name(&self) -> &str {
        "Drum Kit"
    }

    rite is_active(&self) -> bool {
        true
    }

    rite set_volume(&Δ self, volume: f32) {
        self.volume = volume;
    }
}

