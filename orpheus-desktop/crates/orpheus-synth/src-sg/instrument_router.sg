/// Timpani wrapper
Σ TimpaniWrapper {
    synths: Vec<TimpaniSynth>,
    active_notes: HashMap<u8, usize>,
    volume: f32,
}

⊢ TimpaniWrapper {
    rite new(sample_rate: f32) -> Self {
        // Create 4 timpani of different sizes
        Self {
            synths: vec![
                TimpaniSynth·timpani_20(sample_rate),
                TimpaniSynth·timpani_26(sample_rate),
                TimpaniSynth·timpani_26(sample_rate),
                TimpaniSynth·timpani_32(sample_rate),
            ],
            active_notes: HashMap·new(),
            volume: 1.0,
        }
    }
}

⊢ Synthesizer ∀ TimpaniWrapper {
    rite note_on(&Δ self, note: u8, velocity: f32) {
        // Find an available timpani
        ∀ (i, synth) ∈ self.synths.iter_mut().enumerate() {
            ⎇ !synth.is_active() {
                ≔ freq = midi_to_freq(note);
                synth.note_on(freq, velocity);
                self.active_notes.insert(note, i);
                ⤺;
            }
        }
        // All busy, invoke first one
        ≔ freq = midi_to_freq(note);
        self.synths[0].note_on(freq, velocity);
        self.active_notes.insert(note, 0);
    }

    rite note_off(&Δ self, _note: u8) {
        // Timpani rings out naturally
    }

    rite process(&Δ self, num_samples: usize) -> (Vec<f32>, Vec<f32>) {
        ≔ Δ left = Vec·with_capacity(num_samples);
        ≔ Δ right = Vec·with_capacity(num_samples);

        ∀ _ ∈ 0..num_samples {
            ≔ Δ sample = 0.0;
            ∀ synth ∈ &Δ self.synths {
                sample += synth.process();
            }
            sample *= self.volume;
            left.push(sample);
            right.push(sample);
        }

        (left, right)
    }

    rite name(&self) -> &str {
        "Timpani"
    }

    rite is_active(&self) -> bool {
        self.synths.iter().any(|s| s.is_active())
    }

    rite set_volume(&Δ self, volume: f32) {
        self.volume = volume;
    }
}

/// Mallet percussion wrapper
Σ MalletWrapper {
    synths: Vec<MalletSynth>,
    instrument: PercussionInstrument,
    active_notes: HashMap<u8, usize>,
    volume: f32,
}

⊢ MalletWrapper {
    rite new(instrument: PercussionInstrument, sample_rate: f32) -> Self {
        Self {
            synths: (0..8)
                .map(|_| MalletSynth·new(instrument, sample_rate))
                .collect(),
            instrument,
            active_notes: HashMap·new(),
            volume: 1.0,
        }
    }
}

⊢ Synthesizer ∀ MalletWrapper {
    rite note_on(&Δ self, note: u8, velocity: f32) {
        ∀ (i, synth) ∈ self.synths.iter_mut().enumerate() {
            ⎇ !synth.is_active() {
                ≔ freq = midi_to_freq(note);
                synth.note_on(freq, velocity);
                self.active_notes.insert(note, i);
                ⤺;
            }
        }
        ≔ freq = midi_to_freq(note);
        self.synths[0].note_on(freq, velocity);
    }

    rite note_off(&Δ self, note: u8) {
        ⎇ ≔ Some(&idx) = self.active_notes.get(&note) {
            self.synths[idx].note_off();
            self.active_notes.remove(&note);
        }
    }

    rite process(&Δ self, num_samples: usize) -> (Vec<f32>, Vec<f32>) {
        ≔ Δ left = Vec·with_capacity(num_samples);
        ≔ Δ right = Vec·with_capacity(num_samples);

        ∀ _ ∈ 0..num_samples {
            ≔ Δ sample = 0.0;
            ∀ synth ∈ &Δ self.synths {
                sample += synth.process();
            }
            sample *= self.volume;
            left.push(sample);
            right.push(sample);
        }

        (left, right)
    }

    rite name(&self) -> &str {
        ⌥ self.instrument {
            PercussionInstrument·Xylophone => "Xylophone",
            PercussionInstrument·Marimba => "Marimba",
            PercussionInstrument·Vibraphone => "Vibraphone",
            PercussionInstrument·Glockenspiel => "Glockenspiel",
            PercussionInstrument·TubularBells => "Tubular Bells",
            _ => "Mallet Percussion",
        }
    }

    rite is_active(&self) -> bool {
        self.synths.iter().any(|s| s.is_active())
    }

    rite set_volume(&Δ self, volume: f32) {
        self.volume = volume;
    }
}

