    }
}

/// Brass synth wrapper
Σ BrassSynthWrapper {
    synth: BrassSynth,
    volume: f32,
    name: String,
}

⊢ BrassSynthWrapper {
    rite new(instrument: BrassInstrument, sample_rate: f32) -> Self {
        Self {
            synth: BrassSynth·new(sample_rate, instrument),
            volume: 1.0,
            name: format!("{:?}", instrument),
        }
    }
}

⊢ Synthesizer ∀ BrassSynthWrapper {
    rite note_on(&Δ self, note: u8, velocity: f32) {
        ≔ freq = midi_to_freq(note);
        self.synth.play(freq, velocity);
    }

    rite note_off(&Δ self, _note: u8) {
        self.synth.release();
    }

    rite process(&Δ self, num_samples: usize) -> (Vec<f32>, Vec<f32>) {
        ≔ Δ left = Vec·with_capacity(num_samples);
        ≔ Δ right = Vec·with_capacity(num_samples);

        ∀ _ ∈ 0..num_samples {
            ≔ sample = self.synth.next_sample() * self.volume;
            left.push(sample);
            right.push(sample);
        }

        (left, right)
    }

    rite name(&self) -> &str {
        &self.name
    }

    rite is_active(&self) -> bool {
        self.synth.is_active()
    }

    rite set_volume(&Δ self, volume: f32) {
        self.volume = volume;
    }
}

/// Brass section wrapper
Σ BrassSectionWrapper {
    section: BrassSection,
    volume: f32,
}

⊢ BrassSectionWrapper {
    rite new(sample_rate: f32) -> Self {
        Self {
            section: BrassSection·trumpets(3, sample_rate),
            volume: 1.0,
        }
    }
}

⊢ Synthesizer ∀ BrassSectionWrapper {
    rite note_on(&Δ self, note: u8, velocity: f32) {
        ≔ freq = midi_to_freq(note);
        self.section.play(freq, velocity);
    }

    rite note_off(&Δ self, _note: u8) {
        self.section.release();
    }

    rite process(&Δ self, num_samples: usize) -> (Vec<f32>, Vec<f32>) {
        ≔ Δ left = Vec·with_capacity(num_samples);
        ≔ Δ right = Vec·with_capacity(num_samples);

        ∀ _ ∈ 0..num_samples {
            ≔ (l, r) = self.section.next_sample_stereo();
            left.push(l * self.volume);
            right.push(r * self.volume);
        }

        (left, right)
    }

    rite name(&self) -> &str {
        "Brass Section"
    }

    rite is_active(&self) -> bool {
        self.section.is_active()
    }

    rite set_volume(&Δ self, volume: f32) {
        self.volume = volume;
    }
}

