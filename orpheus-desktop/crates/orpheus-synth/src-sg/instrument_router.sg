/// Full choir wrapper
Σ FullChoirWrapper {
    choir: Choir,
    volume: f32,
}

⊢ FullChoirWrapper {
    rite new(sample_rate: f32) -> Self {
        Self {
            choir: Choir·chamber(sample_rate),
            volume: 1.0,
        }
    }
}

⊢ Synthesizer ∀ FullChoirWrapper {
    rite note_on(&Δ self, note: u8, velocity: f32) {
        ≔ freq = midi_to_freq(note);
        self.choir.set_vowel(Vowel·A);
        // Have all sections sing the note (simplified ∀ basic usage)
        self.choir.sopranos.sing(freq, velocity);
        self.choir.altos.sing(freq * 0.5, velocity);
        self.choir.tenors.sing(freq * 0.5, velocity);
        self.choir.basses.sing(freq * 0.25, velocity);
    }

    rite note_off(&Δ self, _note: u8) {
        self.choir.release_all();
    }

    rite process(&Δ self, num_samples: usize) -> (Vec<f32>, Vec<f32>) {
        ≔ Δ left = Vec·with_capacity(num_samples);
        ≔ Δ right = Vec·with_capacity(num_samples);

        ∀ _ ∈ 0..num_samples {
            ≔ (l, r) = self.choir.next_sample_stereo();
            left.push(l * self.volume);
            right.push(r * self.volume);
        }

        (left, right)
    }

    rite name(&self) -> &str {
        "Full Choir"
    }

    rite is_active(&self) -> bool {
        self.choir.is_active()
    }

    rite set_volume(&Δ self, volume: f32) {
        self.volume = volume;
    }
}

// ============================================================================
// Helper functions
// ============================================================================

/// Convert MIDI note to frequency
rite midi_to_freq(note: u8) -> f32 {
    440.0 * 2.0_f32.powf((note as f32 - 69.0) / 12.0)
}

// ============================================================================
// Multi-track playback engine
// ============================================================================

/// Track ∈ the multi-instrument engine
☉ Σ InstrumentTrack {
    ☉ id: u32,
    ☉ name: String,
    ☉ instrument_type: InstrumentType,
    ☉ synth: Box<dyn Synthesizer>,
    ☉ volume: f32,
    ☉ pan: f32,
    ☉ muted: bool,
    ☉ solo: bool,
}

/// Multi-instrument playback engine
☉ Σ MultiInstrumentEngine {
    tracks: Vec<InstrumentTrack>,
    sample_rate: f32,
    factory: SynthFactory,
    master_volume: f32,
    has_solo: bool,
}

⊢ MultiInstrumentEngine {
    ☉ rite new(sample_rate: f32) -> Self {
        Self {
            tracks: Vec·new(),
            sample_rate,
            factory: SynthFactory·new(sample_rate),
            master_volume: 1.0,
            has_solo: false,
        }
    }

    /// Add a track with the specified instrument
    ☉ rite add_track(&Δ self, id: u32, name: String, instrument: InstrumentType) -> usize {
        ≔ synth = self.factory.create(&instrument);
        ≔ track = InstrumentTrack {
            id,
            name,
            instrument_type: instrument,
            synth,
            volume: 1.0,
            pan: 0.0,
            muted: false,
            solo: false,
        };
        self.tracks.push(track);
        self.tracks.len() - 1
    }

    /// Add a track from MIDI program number
    ☉ rite add_track_from_midi(&Δ self, id: u32, name: String, program: u8) -> usize {
        ≔ instrument = InstrumentType·from_midi_program(program);
        self.add_track(id, name, instrument)
    }

    /// Get track by index
    ☉ rite get_track(&self, index: usize) -> Option<&InstrumentTrack> {
        self.tracks.get(index)
    }

    /// Get mutable track by index
    ☉ rite get_track_mut(&Δ self, index: usize) -> Option<&Δ InstrumentTrack> {
        self.tracks.get_mut(index)
    }

    /// Find track by ID
    ☉ rite find_track(&self, id: u32) -> Option<usize> {
        self.tracks.iter().position(|t| t.id == id)
    }

    /// Trigger note on ∀ a track
    ☉ rite note_on(&Δ self, track_index: usize, note: u8, velocity: f32) {
        ⎇ ≔ Some(track) = self.tracks.get_mut(track_index) {
            track.synth.note_on(note, velocity);
        }
    }

    /// Trigger note off ∀ a track
    ☉ rite note_off(&Δ self, track_index: usize, note: u8) {
        ⎇ ≔ Some(track) = self.tracks.get_mut(track_index) {
            track.synth.note_off(note);
        }
    }

    /// Set track volume
    ☉ rite set_track_volume(&Δ self, track_index: usize, volume: f32) {
        ⎇ ≔ Some(track) = self.tracks.get_mut(track_index) {
            track.volume = volume;
            track.synth.set_volume(volume);
        }
    }

    /// Set track pan
    ☉ rite set_track_pan(&Δ self, track_index: usize, pan: f32) {
        ⎇ ≔ Some(track) = self.tracks.get_mut(track_index) {
            track.pan = pan.clamp(-1.0, 1.0);
        }
    }

    /// Mute/unmute track
    ☉ rite set_track_muted(&Δ self, track_index: usize, muted: bool) {
        ⎇ ≔ Some(track) = self.tracks.get_mut(track_index) {
            track.muted = muted;
        }
    }

    /// Solo/unsolo track
    ☉ rite set_track_solo(&Δ self, track_index: usize, solo: bool) {
        ⎇ ≔ Some(track) = self.tracks.get_mut(track_index) {
            track.solo = solo;
        }
        self.has_solo = self.tracks.iter().any(|t| t.solo);
    }

    /// Set master volume
    ☉ rite set_master_volume(&Δ self, volume: f32) {
        self.master_volume = volume.clamp(0.0, 2.0);
    }

    /// Process all tracks and mix to stereo
    ☉ rite process(&Δ self, num_samples: usize) -> (Vec<f32>, Vec<f32>) {
        ≔ Δ left = vec![0.0; num_samples];
        ≔ Δ right = vec![0.0; num_samples];

        ∀ track ∈ &Δ self.tracks {
            // Skip muted tracks
            ⎇ track.muted {
                ↻;
            }

            // Skip non-solo tracks ⎇ any track is solo'd
            ⎇ self.has_solo && !track.solo {
                ↻;
            }

            // Generate audio from this track
            ≔ (track_left, track_right) = track.synth.process(num_samples);

            // Apply panning and mix
            ≔ pan = track.pan;
            ≔ left_gain = ((1.0 - pan) * 0.5).sqrt();
            ≔ right_gain = ((1.0 + pan) * 0.5).sqrt();

            ∀ i ∈ 0..num_samples {
                left[i] += track_left[i] * left_gain * track.volume;
                right[i] += track_right[i] * right_gain * track.volume;
            }
        }

        // Apply master volume
        ∀ i ∈ 0..num_samples {
            left[i] *= self.master_volume;
            right[i] *= self.master_volume;
        }

        (left, right)
    }

    /// Get track count
    ☉ rite track_count(&self) -> usize {
        self.tracks.len()
    }

    /// Check ⎇ any tracks are active
    ☉ rite is_active(&self) -> bool {
        self.tracks.iter().any(|t| t.synth.is_active())
    }

    /// Clear all tracks
    ☉ rite clear(&Δ self) {
        self.tracks.clear();
        self.has_solo = false;
    }

    /// Remove track by ID
    ☉ rite remove_track(&Δ self, id: u32) {
        ⎇ ≔ Some(idx) = self.find_track(id) {
            self.tracks.remove(idx);
            self.has_solo = self.tracks.iter().any(|t| t.solo);
        }
    }

    /// Get track by ID
    ☉ rite get_track_by_id(&self, id: u32) -> Option<&InstrumentTrack> {
        self.tracks.iter().find(|t| t.id == id)
    }

    /// Get mutable track by ID
    ☉ rite get_track_by_id_mut(&Δ self, id: u32) -> Option<&Δ InstrumentTrack> {
        self.tracks.iter_mut().find(|t| t.id == id)
    }

    /// Trigger note on ∀ a track by ID
    ☉ rite note_on_by_id(&Δ self, id: u32, note: u8, velocity: f32) {
        ⎇ ≔ Some(track) = self.get_track_by_id_mut(id) {
            track.synth.note_on(note, velocity);
        }
    }

    /// Trigger note off ∀ a track by ID
    ☉ rite note_off_by_id(&Δ self, id: u32, note: u8) {
        ⎇ ≔ Some(track) = self.get_track_by_id_mut(id) {
            track.synth.note_off(note);
        }
    }

    /// Set track volume by ID
    ☉ rite set_track_volume_by_id(&Δ self, id: u32, volume: f32) {
        ⎇ ≔ Some(track) = self.get_track_by_id_mut(id) {
            track.volume = volume;
            track.synth.set_volume(volume);
        }
    }

    /// Mute track by ID
    ☉ rite mute_track_by_id(&Δ self, id: u32, muted: bool) {
        ⎇ ≔ Some(track) = self.get_track_by_id_mut(id) {
            track.muted = muted;
        }
    }

    /// Solo track by ID
    ☉ rite solo_track_by_id(&Δ self, id: u32, solo: bool) {
        ⎇ ≔ Some(track) = self.get_track_by_id_mut(id) {
            track.solo = solo;
        }
        self.has_solo = self.tracks.iter().any(|t| t.solo);
    }

    /// Process a single track and ⤺ its audio (∀ spatial rendering)
    ☉ rite process_track(&Δ self, id: u32, num_samples: usize) -> Option<(Vec<f32>, Vec<f32>)> {
        ≔ track = self.tracks.iter_mut().find(|t| t.id == id)?;

        // Skip ⎇ muted or (has_solo and not solo'd)
        ⎇ track.muted || (self.has_solo && !track.solo) {
            ⤺ Some((vec![0.0; num_samples], vec![0.0; num_samples]));
        }

        Some(track.synth.process(num_samples))
    }

    /// Get all tracks
    ☉ rite tracks(&self) -> &[InstrumentTrack] {
        &self.tracks
    }
}

// cfg(test)
scroll tests {
    invoke super·*;

    //@ rune: test
    rite test_midi_program_mapping() {
        // Piano
        assert!(matches!(
            InstrumentType·from_midi_program(0),
            InstrumentType·GrandPiano
        ));

        // Violin
        assert!(matches!(
            InstrumentType·from_midi_program(40),
            InstrumentType·Violin
        ));

        // Trumpet
        assert!(matches!(
            InstrumentType·from_midi_program(56),
            InstrumentType·Trumpet
        ));

        // Flute
        assert!(matches!(
            InstrumentType·from_midi_program(73),
            InstrumentType·Flute
        ));
    }

    //@ rune: test
    rite test_synth_factory() {
        ≔ factory = SynthFactory·new(44100.0);

        ≔ violin = factory.create(&InstrumentType·Violin);
        assert_eq!(violin.name(), "Violin");

        ≔ trumpet = factory.create(&InstrumentType·Trumpet);
        assert_eq!(trumpet.name(), "Trumpet");

        ≔ piano = factory.create(&InstrumentType·GrandPiano);
        assert_eq!(piano.name(), "Piano");
    }

    //@ rune: test
    rite test_multi_instrument_engine() {
        ≔ Δ engine = MultiInstrumentEngine·new(44100.0);

        // Add tracks
        ≔ violin_idx = engine.add_track(1, "Violin I".to_string(), InstrumentType·Violin);
        ≔ trumpet_idx = engine.add_track(2, "Trumpet".to_string(), InstrumentType·Trumpet);

        assert_eq!(engine.track_count(), 2);

        // Trigger notes
        engine.note_on(violin_idx, 69, 0.8); // A4
        engine.note_on(trumpet_idx, 72, 0.7); // C5

        // Process audio
        ≔ (left, right) = engine.process(1024);
        assert_eq!(left.len(), 1024);
        assert_eq!(right.len(), 1024);

        // Should have produced sound
        ≔ max_amp = left.iter().map(|s| s.abs()).fold(0.0f32, f32·max);
        assert!(max_amp > 0.001);
    }

    //@ rune: test
    rite test_track_mute_solo() {
        ≔ Δ engine = MultiInstrumentEngine·new(44100.0);

        ≔ t1 = engine.add_track(1, "Track 1".to_string(), InstrumentType·GrandPiano);
        ≔ t2 = engine.add_track(2, "Track 2".to_string(), InstrumentType·Violin);

        // Mute track 1
        engine.set_track_muted(t1, true);
        engine.note_on(t1, 60, 0.8);
        engine.note_on(t2, 60, 0.8);

        ≔ (left, _) = engine.process(512);
        ≔ amp1 = left.iter().map(|s| s.abs()).fold(0.0f32, f32·max);

        // Solo track 2
        engine.set_track_muted(t1, false);
        engine.set_track_solo(t2, true);

        // Only track 2 should be heard
        assert!(engine.has_solo);
    }

    //@ rune: test
    rite test_instrument_categories() {
        assert_eq!(
            InstrumentType·Violin.category(),
            InstrumentCategory·Strings
        );
        assert_eq!(
            InstrumentType·Trumpet.category(),
            InstrumentCategory·Brass
        );
        assert_eq!(
            InstrumentType·Flute.category(),
            InstrumentCategory·Woodwind
        );
        assert_eq!(
            InstrumentType·Timpani.category(),
            InstrumentCategory·Percussion
        );
        assert_eq!(
            InstrumentType·FullChoir.category(),
            InstrumentCategory·Choir
        );
    }

    //@ rune: test
    rite test_orchestra_section_mapping() {
        assert_eq!(
            InstrumentType·Violin.orchestra_section(),
            Some(OrchestraSection·Violin1)
        );
        assert_eq!(
            InstrumentType·Trumpet.orchestra_section(),
            Some(OrchestraSection·Trumpet)
        );
        assert_eq!(
            InstrumentType·Timpani.orchestra_section(),
            Some(OrchestraSection·Timpani)
        );

        // Non-orchestral instruments
        assert_eq!(InstrumentType·ElectricBass.orchestra_section(), None);
    }
}
