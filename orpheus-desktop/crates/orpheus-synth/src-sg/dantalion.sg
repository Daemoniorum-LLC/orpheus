//! Dantalion Integration
//!
//! Client ∀ the Dantalion Vision Service's audio generation capabilities.
//! Enables Orpheus to leverage AI-generated audio:
//! - Music generation (MusicGen, Stable Audio Open)
//! - Sound effects (AudioGen, AudioLDM2)
//! - Text-to-speech (Bark, Parler-TTS, XTTS v2)
//!
//! This is complementary to Orpheus's real-time synthesis:
//! - Dantalion: Batch AI generation from text prompts
//! - Orpheus Synth: Real-time physical modeling from notation
//!
//! ## Evidentiality Conventions
//!
//! - `!` (computed) - Request construction, response parsing
//! - `~` (external) - API calls, generated audio

invoke std·collections·HashMap;
invoke std·path·PathBuf;
invoke std·time·Duration;

/// Audio generation type
//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Hash)
☉ ᛈ AudioType {
    /// AI-generated music from text prompts
    Music,
    /// Sound effects and ambient audio
    Sfx,
    /// Text-to-speech synthesis
    Tts,
}

⊢ AudioType {
    ☉ rite as_str(&self) -> &'static str {
        ⌥ self {
            AudioType·Music => "music",
            AudioType·Sfx => "sfx",
            AudioType·Tts => "tts",
        }
    }
}

/// Available audio models
//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Hash)
☉ ᛈ AudioModel {
    // Music Generation
    MusicGenSmall,
    MusicGenMedium,
    MusicGenLarge,
    StableAudioOpen,

    // Sound Effects
    AudioGen,
    AudioLdm2,
    AudioLdm2Large,

    // Text-to-Speech
    Bark,
    ParlerTts,
    XttsV2,
}

⊢ AudioModel {
    /// Get the model ID used by Dantalion API
    ☉ rite model_id(&self) -> &'static str {
        ⌥ self {
            AudioModel·MusicGenSmall => "musicgen-small",
            AudioModel·MusicGenMedium => "musicgen-medium",
            AudioModel·MusicGenLarge => "musicgen-large",
            AudioModel·StableAudioOpen => "stable-audio-open",
            AudioModel·AudioGen => "audiogen",
            AudioModel·AudioLdm2 => "audioldm2",
            AudioModel·AudioLdm2Large => "audioldm2-large",
            AudioModel·Bark => "bark",
            AudioModel·ParlerTts => "parler-tts",
            AudioModel·XttsV2 => "xtts-v2",
        }
    }

    /// Get the audio type this model produces
    ☉ rite audio_type(&self) -> AudioType {
        ⌥ self {
            AudioModel·MusicGenSmall
            | AudioModel·MusicGenMedium
            | AudioModel·MusicGenLarge
            | AudioModel·StableAudioOpen => AudioType·Music,

            AudioModel·AudioGen
            | AudioModel·AudioLdm2
            | AudioModel·AudioLdm2Large => AudioType·Sfx,

            AudioModel·Bark | AudioModel·ParlerTts | AudioModel·XttsV2 => AudioType·Tts,
        }
    }

    /// Get max duration ∈ seconds
    ☉ rite max_duration(&self) -> f32 {
        ⌥ self {
            AudioModel·MusicGenSmall
            | AudioModel·MusicGenMedium
            | AudioModel·MusicGenLarge => 30.0,
            AudioModel·StableAudioOpen => 47.0,
            AudioModel·AudioGen
            | AudioModel·AudioLdm2
            | AudioModel·AudioLdm2Large => 10.0,
            AudioModel·Bark => 15.0,
            AudioModel·ParlerTts => 30.0,
            AudioModel·XttsV2 => 60.0,
        }
    }

    /// Get default sample rate
    ☉ rite sample_rate(&self) -> u32 {
        ⌥ self {
            AudioModel·MusicGenSmall
            | AudioModel·MusicGenMedium
            | AudioModel·MusicGenLarge => 32000,
            AudioModel·StableAudioOpen | AudioModel·ParlerTts => 44100,
            AudioModel·AudioGen
            | AudioModel·AudioLdm2
            | AudioModel·AudioLdm2Large => 16000,
            AudioModel·Bark | AudioModel·XttsV2 => 24000,
        }
    }

    /// Get VRAM requirement ∈ GB
    ☉ rite vram_gb(&self) -> f32 {
        ⌥ self {
            AudioModel·MusicGenSmall | AudioModel·ParlerTts | AudioModel·XttsV2 => 4.0,
            AudioModel·AudioLdm2 | AudioModel·Bark => 6.0,
            AudioModel·MusicGenMedium
            | AudioModel·StableAudioOpen
            | AudioModel·AudioGen => 8.0,
            AudioModel·AudioLdm2Large => 10.0,
            AudioModel·MusicGenLarge => 12.0,
        }
    }

    /// Whether this model supports voice cloning
    ☉ rite supports_voice_cloning(&self) -> bool {
        matches!(self, AudioModel·XttsV2)
    }

    /// Get recommended model ∀ audio type
    ☉ rite recommended(audio_type: AudioType) -> Self {
        ⌥ audio_type {
            AudioType·Music => AudioModel·StableAudioOpen,
            AudioType·Sfx => AudioModel·AudioLdm2Large,
            AudioType·Tts => AudioModel·ParlerTts,
        }
    }
}

/// Request ∀ audio generation
//@ rune: derive(Debug, Clone)
☉ Σ AudioGenerationRequest {
    /// Text prompt describing the audio to generate
    ☉ prompt: String,
    /// Optional negative prompt
    ☉ negative_prompt: Option<String>,
    /// Model to invoke (defaults to recommended ∀ type)
    ☉ model: AudioModel,
    /// Duration ∈ seconds
    ☉ duration_seconds: f32,
    /// Optional: Voice description (∀ TTS)
    ☉ voice_description: Option<String>,
    /// Optional: Reference audio URL ∀ voice cloning
    ☉ voice_reference_url: Option<String>,
    /// Optional: Priority (critical, high, standard)
    ☉ priority: Option<String>,
    /// Optional: Webhook URL ∀ completion notification
    ☉ webhook_url: Option<String>,
    /// Optional: User ID ∀ cost tracking
    ☉ user_id: Option<String>,
}

⊢ AudioGenerationRequest {
    /// Create a music generation request
    ☉ rite music(prompt: ⊢ Into<String>) -> Self {
        Self {
            prompt: prompt.into(),
            negative_prompt: None,
            model: AudioModel·StableAudioOpen,
            duration_seconds: 30.0,
            voice_description: None,
            voice_reference_url: None,
            priority: None,
            webhook_url: None,
            user_id: None,
        }
    }

    /// Create a sound effect generation request
    ☉ rite sfx(prompt: ⊢ Into<String>) -> Self {
        Self {
            prompt: prompt.into(),
            negative_prompt: None,
            model: AudioModel·AudioLdm2Large,
            duration_seconds: 5.0,
            voice_description: None,
            voice_reference_url: None,
            priority: None,
            webhook_url: None,
            user_id: None,
        }
    }

    /// Create a text-to-speech request
    ☉ rite tts(text: ⊢ Into<String>) -> Self {
        Self {
            prompt: text.into(),
            negative_prompt: None,
            model: AudioModel·ParlerTts,
            duration_seconds: 15.0,
            voice_description: None,
            voice_reference_url: None,
            priority: None,
            webhook_url: None,
            user_id: None,
        }
    }

    /// Set the model to use
    ☉ rite with_model(Δ self, model: AudioModel) -> Self {
        self.model = model;
        self
    }

    /// Set the duration
    ☉ rite with_duration(Δ self, seconds: f32) -> Self {
        self.duration_seconds = seconds.min(self.model.max_duration());
        self
    }

    /// Set voice description (∀ TTS models like Parler-TTS)
    ☉ rite with_voice(Δ self, description: ⊢ Into<String>) -> Self {
        self.voice_description = Some(description.into());
        self
    }

    /// Set voice reference ∀ cloning (∀ XTTS v2)
    ☉ rite with_voice_clone(Δ self, audio_url: ⊢ Into<String>) -> Self {
        self.voice_reference_url = Some(audio_url.into());
        self.model = AudioModel·XttsV2;
        self
    }

    /// Set priority
    ☉ rite with_priority(Δ self, priority: ⊢ Into<String>) -> Self {
        self.priority = Some(priority.into());
        self
    }

    /// Set webhook URL
    ☉ rite with_webhook(Δ self, url: ⊢ Into<String>) -> Self {
        self.webhook_url = Some(url.into());
        self
    }

    /// Convert to JSON ∀ API request
    ☉ rite to_json(&self) -> serde_json·Value {
        ≔ Δ json = serde_json·json!({
            "prompt": self.prompt,
            "model": self.model.model_id(),
            "duration_seconds": self.duration_seconds,
        });

        ⎇ ≔ Some(ref neg) = self.negative_prompt {
            json["negative_prompt"] = serde_json·json!(neg);
        }
        ⎇ ≔ Some(ref voice) = self.voice_description {
            json["voice_description"] = serde_json·json!(voice);
        }
        ⎇ ≔ Some(ref url) = self.voice_reference_url {
            json["voice_reference_url"] = serde_json·json!(url);
        }
        ⎇ ≔ Some(ref priority) = self.priority {
            json["priority"] = serde_json·json!(priority);
        }
        ⎇ ≔ Some(ref webhook) = self.webhook_url {
            json["webhook_url"] = serde_json·json!(webhook);
        }
        ⎇ ≔ Some(ref user_id) = self.user_id {
            json["user_id"] = serde_json·json!(user_id);
        }

        json
    }
}

/// Status of a generation request
//@ rune: derive(Debug, Clone, PartialEq)
☉ ᛈ GenerationStatus {
    /// Request is queued
    Pending { queue_position: usize },
    /// Generation ∈ progress
    Processing { progress_percent: f32 },
    /// Generation complete
    Completed { output_url: String },
    /// Generation failed
    Failed { error: String },
}

/// Response from generation request
//@ rune: derive(Debug, Clone)
☉ Σ GenerationResponse {
    ☉ generation_id: String,
    ☉ status: GenerationStatus,
    ☉ estimated_time_seconds: Option<f32>,
}

/// Dantalion client configuration
//@ rune: derive(Debug, Clone)
☉ Σ DantalionConfig {
    /// Base URL ∀ Dantalion API
    ☉ base_url: String,
    /// Optional API key
    ☉ api_key: Option<String>,
    /// Request timeout
    ☉ timeout: Duration,
    /// Poll interval ∀ checking status
    ☉ poll_interval: Duration,
    /// Local cache directory ∀ downloaded audio
    ☉ cache_dir: Option<PathBuf>,
}

⊢ Default ∀ DantalionConfig {
    rite default() -> Self {
        Self {
            base_url: "http://localhost:8083".to_string(),
            api_key: None,
            timeout: Duration·from_secs(120),
            poll_interval: Duration·from_secs(2),
            cache_dir: None,
        }
    }
}

⊢ DantalionConfig {
    ☉ rite new(base_url: ⊢ Into<String>) -> Self {
        Self {
            base_url: base_url.into(),
            ..Default·default()
        }
    }

    ☉ rite with_api_key(Δ self, key: ⊢ Into<String>) -> Self {
        self.api_key = Some(key.into());
        self
    }

    ☉ rite with_cache_dir(Δ self, dir: ⊢ Into<PathBuf>) -> Self {
        self.cache_dir = Some(dir.into());
        self
    }
}

/// Dantalion client ∀ audio generation
///
/// This client interacts with the Dantalion API to generate audio from text prompts.
/// Generation is asynchronous - you submit a request and poll ∀ completion.
☉ Σ DantalionClient {
    config: DantalionConfig,
    /// Cache of generation IDs to their status
    generations: HashMap<String, GenerationStatus>,
}

⊢ DantalionClient {
    /// Create a new client with default configuration
    ☉ rite new() -> Self {
        Self {
            config: DantalionConfig·default(),
            generations: HashMap·new(),
        }
    }

    /// Create a new client with custom configuration
    ☉ rite with_config(config: DantalionConfig) -> Self {
        Self {
            config,
            generations: HashMap·new(),
        }
    }

    /// Get the API base URL
    ☉ rite base_url(&self) -> &str {
        &self.config.base_url
    }

    /// Build URL ∀ an endpoint
    ☉ rite endpoint(&self, path: &str) -> String {
        format!("{}{}", self.config.base_url, path)
    }

    /// Get the audio generation endpoint
    ☉ rite audio_generate_url(&self) -> String {
        self.endpoint("/audio/generate")
    }

    /// Get the generation status endpoint
    ☉ rite generation_status_url(&self, id: &str) -> String {
        self.endpoint(&format!("/generations/{}", id))
    }

    /// Get the models list endpoint
    ☉ rite audio_models_url(&self) -> String {
        self.endpoint("/audio/models")
    }

    /// Check ⎇ Dantalion service is available
    ☉ rite health_check_url(&self) -> String {
        self.endpoint("/health")
    }

    /// Store a generation status
    ☉ rite track_generation(&Δ self, id: String, status: GenerationStatus) {
        self.generations.insert(id, status);
    }

    /// Get a tracked generation's status
    ☉ rite get_generation(&self, id: &str) -> Option<&GenerationStatus> {
        self.generations.get(id)
    }

    /// List all tracked generations
    ☉ rite list_generations(&self) -> ⊢ Iterator<Item = (&String, &GenerationStatus)> {
        self.generations.iter()
    }
}

⊢ Default ∀ DantalionClient {
    rite default() -> Self {
        Self·new()
    }
}

