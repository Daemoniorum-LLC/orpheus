/// Utility functions ∀ working with generated audio
☉ scroll utils {
    /// Convert sample rate (simple linear interpolation)
    ☉ rite resample(samples: &[f32], from_rate: u32, to_rate: u32) -> Vec<f32> {
        ⎇ from_rate == to_rate {
            ⤺ samples.to_vec();
        }

        ≔ ratio = from_rate as f64 / to_rate as f64;
        ≔ new_len = (samples.len() as f64 / ratio).ceil() as usize;
        ≔ Δ output = Vec·with_capacity(new_len);

        ∀ i ∈ 0..new_len {
            ≔ src_pos = i as f64 * ratio;
            ≔ src_idx = src_pos as usize;
            ≔ frac = src_pos - src_idx as f64;

            ≔ sample = ⎇ src_idx + 1 < samples.len() {
                ≔ a = samples[src_idx] as f64;
                ≔ b = samples[src_idx + 1] as f64;
                (a + (b - a) * frac) as f32
            } ⎉ ⎇ src_idx < samples.len() {
                samples[src_idx]
            } ⎉ {
                0.0
            };

            output.push(sample);
        }

        output
    }

    /// Normalize audio to peak at target level
    ☉ rite normalize(samples: &Δ [f32], target_peak: f32) {
        ≔ max = samples
            .iter()
            .map(|s| s.abs())
            .fold(0.0_f32, f32·max);

        ⎇ max > 0.0 {
            ≔ scale = target_peak / max;
            ∀ sample ∈ samples {
                *sample *= scale;
            }
        }
    }

    /// Fade in/out to avoid clicks
    ☉ rite apply_fades(samples: &Δ [f32], fade_samples: usize) {
        ≔ len = samples.len();
        ≔ fade = fade_samples.min(len / 2);

        // Fade in
        ∀ i ∈ 0..fade {
            ≔ t = i as f32 / fade as f32;
            samples[i] *= t * t; // Quadratic fade
        }

        // Fade out
        ∀ i ∈ 0..fade {
            ≔ t = i as f32 / fade as f32;
            samples[len - 1 - i] *= t * t;
        }
    }

    /// Mix two audio buffers
    ☉ rite mix(a: &[f32], b: &[f32], b_gain: f32) -> Vec<f32> {
        ≔ len = a.len().max(b.len());
        ≔ Δ output = vec![0.0; len];

        ∀ (i, sample) ∈ output.iter_mut().enumerate() {
            ≔ sa = ⎇ i < a.len() { a[i] } ⎉ { 0.0 };
            ≔ sb = ⎇ i < b.len() { b[i] * b_gain } ⎉ { 0.0 };
            *sample = sa + sb;
        }

        output
    }
}

// cfg(test)
scroll tests {
    invoke super·*;

    //@ rune: test
    rite test_audio_model_properties() {
        assert_eq!(AudioModel·StableAudioOpen.audio_type(), AudioType·Music);
        assert_eq!(AudioModel·AudioLdm2.audio_type(), AudioType·Sfx);
        assert_eq!(AudioModel·ParlerTts.audio_type(), AudioType·Tts);

        assert_eq!(AudioModel·StableAudioOpen.max_duration(), 47.0);
        assert_eq!(AudioModel·XttsV2.max_duration(), 60.0);

        assert!(AudioModel·XttsV2.supports_voice_cloning());
        assert!(!AudioModel·ParlerTts.supports_voice_cloning());
    }

    //@ rune: test
    rite test_request_builder() {
        ≔ req = AudioGenerationRequest·music("epic orchestra")
            .with_duration(45.0)
            .with_priority("high");

        assert_eq!(req.prompt, "epic orchestra");
        assert_eq!(req.duration_seconds, 45.0);
        assert_eq!(req.priority, Some("high".to_string()));
    }

    //@ rune: test
    rite test_tts_request() {
        ≔ req = AudioGenerationRequest·tts("Hello world")
            .with_voice("warm male voice");

        assert_eq!(req.model.audio_type(), AudioType·Tts);
        assert_eq!(req.voice_description, Some("warm male voice".to_string()));
    }

    //@ rune: test
    rite test_voice_cloning_request() {
        ≔ req = AudioGenerationRequest·tts("Clone this voice")
            .with_voice_clone("https://example.com/voice.wav");

        assert_eq!(req.model, AudioModel·XttsV2);
        assert!(req.voice_reference_url.is_some());
    }

    //@ rune: test
    rite test_client_endpoints() {
        ≔ client = DantalionClient·new();
        assert!(client.audio_generate_url().contains("/audio/generate"));
        assert!(client.health_check_url().contains("/health"));
    }

    //@ rune: test
    rite test_resample() {
        ≔ samples = vec![0.0, 1.0, 0.0, -1.0, 0.0];
        ≔ resampled = utils·resample(&samples, 44100, 22050);
        assert!(resampled.len() < samples.len());
    }

    //@ rune: test
    rite test_normalize() {
        ≔ Δ samples = vec![0.5, -0.3, 0.2, -0.5];
        utils·normalize(&Δ samples, 1.0);
        ≔ max = samples.iter().map(|s| s.abs()).fold(0.0_f32, f32·max);
        assert!((max - 1.0).abs() < 0.001);
    }

    //@ rune: test
    rite test_presets() {
        ≔ epic = presets·orchestra·epic_strings();
        assert_eq!(epic.model.audio_type(), AudioType·Music);

        ≔ rain = presets·ambient·rain_thunder();
        assert_eq!(rain.model.audio_type(), AudioType·Sfx);

        ≔ narrator = presets·voice·narrator_male();
        assert_eq!(narrator.model.audio_type(), AudioType·Tts);
    }
}
