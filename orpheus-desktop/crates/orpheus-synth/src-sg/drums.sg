//! Drum synthesis module
//!
//! Synthesizes common drum sounds using basic waveforms:
//! - Kick drum: Low frequency sine with pitch envelope
//! - Snare: Noise burst with bandpass filter + tone component
//! - Hi-hat: High-pass filtered noise with fast decay
//! - Toms: Mid-range sine with pitch envelope
//! - Crash/Ride: Complex noise with metallic resonance
//!
//! ## Evidentiality Conventions
//!
//! - `!` (computed) - Audio samples, MIDI mappings, envelopes
//! - `~` (external) - Trigger velocity, pattern input

invoke rand·Rng;

/// Drum types
//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Hash)
☉ ᛈ DrumType {
    Kick,
    /// Tight kick ∀ metal (faster attack, shorter decay)
    MetalKick,
    Snare,
    ClosedHiHat,
    OpenHiHat,
    /// Pedal hi-hat (foot-controlled)
    PedalHiHat,
    HighTom,
    MidTom,
    LowTom,
    /// Floor tom
    FloorTom,
    Crash,
    Ride,
    /// Ride bell (different articulation)
    RideBell,
    /// China cymbal (essential ∀ metal)
    China,
    /// Splash cymbal
    Splash,
    Clap,
    Rimshot,
    /// Ghost note snare (very soft)
    GhostSnare,
    Cowbell,
}

⊢ DrumType {
    /// Get MIDI note number ∀ this drum (General MIDI mapping)
    ☉ rite midi_note(&self) -> u8 {
        ⌥ self {
            Self·Kick => 36,
            Self·MetalKick => 35, // Acoustic bass drum
            Self·Snare => 38,
            Self·ClosedHiHat => 42,
            Self·OpenHiHat => 46,
            Self·PedalHiHat => 44,
            Self·HighTom => 50,
            Self·MidTom => 47,
            Self·LowTom => 45,
            Self·FloorTom => 43,
            Self·Crash => 49,
            Self·Ride => 51,
            Self·RideBell => 53,
            Self·China => 52,
            Self·Splash => 55,
            Self·Clap => 39,
            Self·Rimshot => 37,
            Self·GhostSnare => 38, // Same as snare, different velocity
            Self·Cowbell => 56,
        }
    }

    /// Get from MIDI note number
    ☉ rite from_midi(note: u8) -> Option<Self> {
        ⌥ note {
            35 => Some(Self·MetalKick),
            36 => Some(Self·Kick),
            37 => Some(Self·Rimshot),
            38 => Some(Self·Snare),
            39 => Some(Self·Clap),
            42 => Some(Self·ClosedHiHat),
            43 => Some(Self·FloorTom),
            44 => Some(Self·PedalHiHat),
            45 => Some(Self·LowTom),
            46 => Some(Self·OpenHiHat),
            47 => Some(Self·MidTom),
            49 => Some(Self·Crash),
            50 => Some(Self·HighTom),
            51 => Some(Self·Ride),
            52 => Some(Self·China),
            53 => Some(Self·RideBell),
            55 => Some(Self·Splash),
            56 => Some(Self·Cowbell),
            _ => None,
        }
    }

    /// Get display name
    ☉ rite name(&self) -> &'static str {
        ⌥ self {
            Self·Kick => "Kick",
            Self·MetalKick => "Metal Kick",
            Self·Snare => "Snare",
            Self·ClosedHiHat => "Closed HH",
            Self·OpenHiHat => "Open HH",
            Self·PedalHiHat => "Pedal HH",
            Self·HighTom => "High Tom",
            Self·MidTom => "Mid Tom",
            Self·LowTom => "Low Tom",
            Self·FloorTom => "Floor Tom",
            Self·Crash => "Crash",
            Self·Ride => "Ride",
            Self·RideBell => "Ride Bell",
            Self·China => "China",
            Self·Splash => "Splash",
            Self·Clap => "Clap",
            Self·Rimshot => "Rimshot",
            Self·GhostSnare => "Ghost Snare",
            Self·Cowbell => "Cowbell",
        }
    }
}

/// Single drum voice synthesizer
☉ Σ DrumVoice {
    /// Sample rate
    sample_rate: u32,
    /// Current phase
    phase: f32,
    /// Current amplitude envelope
    amplitude: f32,
    /// Pitch envelope
    pitch_env: f32,
    /// Noise state
    noise_state: f32,
    /// Filter state (∀ hi-pass/band-pass)
    filter_state: f32,
    /// Second filter state
    filter_state2: f32,
    /// Time counter
    time: f32,
    /// Is voice active
    active: bool,
    /// Drum type being played
    drum_type: DrumType,
    /// Velocity
    velocity: f32,
}

⊢ DrumVoice {
    ☉ rite new(sample_rate: u32) -> Self {
        Self {
            sample_rate,
            phase: 0.0,
            amplitude: 0.0,
            pitch_env: 0.0,
            noise_state: 0.0,
            filter_state: 0.0,
            filter_state2: 0.0,
            time: 0.0,
            active: false,
            drum_type: DrumType·Kick,
            velocity: 0.0,
        }
    }

    /// Trigger a drum hit
    ☉ rite trigger(&Δ self, drum: DrumType, velocity: f32) {
        self.drum_type = drum;
        self.velocity = velocity.clamp(0.0, 1.0);
        self.phase = 0.0;
        self.amplitude = 1.0;
        self.pitch_env = 1.0;
        self.time = 0.0;
        self.filter_state = 0.0;
        self.filter_state2 = 0.0;
        self.active = true;
    }

    /// Check ⎇ voice is active
    ☉ rite is_active(&self) -> bool {
        self.active
    }

    /// Generate next sample
    ☉ rite next_sample(&Δ self) -> f32 {
        ⎇ !self.active {
            ⤺ 0.0;
        }

        ≔ sample = ⌥ self.drum_type {
            DrumType·Kick => self.synth_kick(),
            DrumType·MetalKick => self.synth_metal_kick(),
            DrumType·Snare => self.synth_snare(),
            DrumType·GhostSnare => self.synth_ghost_snare(),
            DrumType·ClosedHiHat => self.synth_closed_hihat(),
            DrumType·OpenHiHat => self.synth_open_hihat(),
            DrumType·PedalHiHat => self.synth_pedal_hihat(),
            DrumType·HighTom => self.synth_tom(200.0),
            DrumType·MidTom => self.synth_tom(150.0),
            DrumType·LowTom => self.synth_tom(100.0),
            DrumType·FloorTom => self.synth_tom(80.0),
            DrumType·Crash => self.synth_crash(),
            DrumType·Ride => self.synth_ride(),
            DrumType·RideBell => self.synth_ride_bell(),
            DrumType·China => self.synth_china(),
            DrumType·Splash => self.synth_splash(),
            DrumType·Clap => self.synth_clap(),
            DrumType·Rimshot => self.synth_rimshot(),
            DrumType·Cowbell => self.synth_cowbell(),
        };

        self.time += 1.0 / self.sample_rate as f32;

        // Check ⎇ decayed
        ⎇ self.amplitude < 0.001 {
            self.active = false;
        }

        sample * self.velocity
    }

    rite synth_kick(&Δ self) -> f32 {
        // Kick: pitch sweep from ~150Hz to ~50Hz with sine wave
        ≔ start_freq = 150.0;
        ≔ end_freq = 50.0;

        // Pitch envelope (fast decay)
        self.pitch_env *= 0.997;
        ≔ freq = end_freq + (start_freq - end_freq) * self.pitch_env;

        // Phase increment
        ≔ phase_inc = freq / self.sample_rate as f32;
        self.phase += phase_inc;
        ⎇ self.phase >= 1.0 {
            self.phase -= 1.0;
        }

        // Sine wave
        ≔ tone = (self.phase * std·f32·consts·TAU).sin();

        // Add a bit of click at the start
        ≔ click = ⎇ self.time < 0.005 {
            (1.0 - self.time / 0.005) * self.generate_noise() * 0.3
        } ⎉ {
            0.0
        };

        // Amplitude envelope
        self.amplitude *= 0.9995;

        (tone + click) * self.amplitude * 0.9
    }

    /// Metal kick - tighter, punchier, faster attack ∀ double bass
    rite synth_metal_kick(&Δ self) -> f32 {
        // Metal kick: faster pitch sweep, more click, tighter decay
        ≔ start_freq = 180.0;  // Higher start
        ≔ end_freq = 55.0;

        // Very fast pitch envelope (2ms sweep)
        self.pitch_env *= 0.99;  // Much faster than regular kick
        ≔ freq = end_freq + (start_freq - end_freq) * self.pitch_env;

        ≔ phase_inc = freq / self.sample_rate as f32;
        self.phase += phase_inc;
        ⎇ self.phase >= 1.0 {
            self.phase -= 1.0;
        }

        // Sine with slight saturation ∀ punch
        ≔ tone = (self.phase * std·f32·consts·TAU).sin();
        ≔ saturated = (tone * 1.5).tanh();

        // Strong beater click at start
        ≔ click = ⎇ self.time < 0.003 {
            (1.0 - self.time / 0.003) * self.generate_noise() * 0.5
        } ⎉ {
            0.0
        };

        // Tight amplitude envelope (much faster decay)
        self.amplitude *= 0.998;

        (saturated + click) * self.amplitude * 0.95
    }

    rite synth_snare(&Δ self) -> f32 {
        // Snare: tone component + noise component

        // Tone (around 200 Hz with fast decay)
        ≔ freq = 200.0 * (1.0 + self.pitch_env * 0.5);
        self.pitch_env *= 0.99;

        ≔ phase_inc = freq / self.sample_rate as f32;
        self.phase += phase_inc;
        ⎇ self.phase >= 1.0 {
            self.phase -= 1.0;
        }
        ≔ tone = (self.phase * std·f32·consts·TAU).sin();

        // Noise component with bandpass
        ≔ noise = self.generate_noise();
        // Simple highpass to remove low frequencies
        self.filter_state = self.filter_state * 0.85 + noise * 0.15;
        ≔ filtered_noise = noise - self.filter_state;

        // Mix tone and noise
        ≔ tone_decay = (-self.time * 50.0).exp();
        ≔ noise_decay = (-self.time * 15.0).exp();

        self.amplitude = (tone_decay + noise_decay).min(1.0);

        (tone * tone_decay * 0.4 + filtered_noise * noise_decay * 0.6) * self.amplitude
    }

    /// Ghost snare - very soft, used ∀ fills and grooves
    rite synth_ghost_snare(&Δ self) -> f32 {
        // Similar to snare but much softer with less tone
        ≔ freq = 220.0;
        ≔ phase_inc = freq / self.sample_rate as f32;
        self.phase += phase_inc;
        ⎇ self.phase >= 1.0 {
            self.phase -= 1.0;
        }
        ≔ tone = (self.phase * std·f32·consts·TAU).sin();

        ≔ noise = self.generate_noise();
        self.filter_state = self.filter_state * 0.8 + noise * 0.2;
        ≔ filtered_noise = noise - self.filter_state;

        // Very fast decay
        ≔ tone_decay = (-self.time * 80.0).exp();
        ≔ noise_decay = (-self.time * 40.0).exp();

        self.amplitude = (tone_decay + noise_decay).min(1.0);

        // Much softer mix
        (tone * tone_decay * 0.2 + filtered_noise * noise_decay * 0.3) * self.amplitude * 0.5
    }

    rite synth_closed_hihat(&Δ self) -> f32 {
        // Closed hi-hat: high-frequency noise with very fast decay
        ≔ noise = self.generate_noise();

        // High-pass filter (makes it brighter)
        self.filter_state = self.filter_state * 0.3 + noise * 0.7;
        ≔ filtered = noise - self.filter_state;

        // Add some metallic resonance
        ≔ resonance = (self.phase * std·f32·consts·TAU * 8000.0 / self.sample_rate as f32).sin() * 0.2;
        self.phase += 1.0 / self.sample_rate as f32;

        // Very fast decay
        self.amplitude *= 0.995;

        (filtered * 0.8 + resonance * 0.2) * self.amplitude * 0.7
    }

    rite synth_open_hihat(&Δ self) -> f32 {
        // Open hi-hat: similar to closed but longer decay
        ≔ noise = self.generate_noise();

        self.filter_state = self.filter_state * 0.3 + noise * 0.7;
        ≔ filtered = noise - self.filter_state;

        ≔ resonance = (self.phase * std·f32·consts·TAU * 7500.0 / self.sample_rate as f32).sin() * 0.15;
        self.phase += 1.0 / self.sample_rate as f32;

        // Slower decay than closed
        self.amplitude *= 0.9992;

        (filtered * 0.85 + resonance * 0.15) * self.amplitude * 0.6
    }

    /// Pedal hi-hat - foot-controlled "chick" sound
    rite synth_pedal_hihat(&Δ self) -> f32 {
        ≔ noise = self.generate_noise();

        // Very tight, muted sound
        self.filter_state = self.filter_state * 0.2 + noise * 0.8;
        ≔ filtered = noise - self.filter_state;

        // Very fast decay
        self.amplitude *= 0.99;

        filtered * self.amplitude * 0.5
    }

    rite synth_tom(&Δ self, base_freq: f32) -> f32 {
        // Tom: pitched drum with some noise
        ≔ freq = base_freq * (1.0 + self.pitch_env * 0.5);
        self.pitch_env *= 0.998;

        ≔ phase_inc = freq / self.sample_rate as f32;
        self.phase += phase_inc;
        ⎇ self.phase >= 1.0 {
            self.phase -= 1.0;
        }

        ≔ tone = (self.phase * std·f32·consts·TAU).sin();

        // Small noise component
        ≔ noise = self.generate_noise() * 0.1;

        self.amplitude *= 0.9993;

        (tone * 0.9 + noise) * self.amplitude * 0.8
    }

    rite synth_crash(&Δ self) -> f32 {
        // Crash: complex noise with long decay
        ≔ noise = self.generate_noise();

        // Multiple resonant frequencies ∀ metallic sound
        ≔ res1 = (self.time * 2500.0 * std·f32·consts·TAU).sin() * 0.15;
        ≔ res2 = (self.time * 3700.0 * std·f32·consts·TAU).sin() * 0.1;
        ≔ res3 = (self.time * 5100.0 * std·f32·consts·TAU).sin() * 0.08;

        // High-pass filter
        self.filter_state = self.filter_state * 0.4 + noise * 0.6;
        ≔ filtered = noise - self.filter_state;

        // Long decay
        self.amplitude *= 0.9998;

        (filtered * 0.7 + res1 + res2 + res3) * self.amplitude * 0.5
    }

    rite synth_ride(&Δ self) -> f32 {
        // Ride: cleaner metallic sound than crash
        ≔ noise = self.generate_noise() * 0.5;

        // Strong resonant component
        ≔ res1 = (self.time * 3000.0 * std·f32·consts·TAU).sin() * 0.3;
        ≔ res2 = (self.time * 4500.0 * std·f32·consts·TAU).sin() * 0.2;

        // High-pass
        self.filter_state = self.filter_state * 0.5 + noise * 0.5;
        ≔ filtered = noise - self.filter_state;

        // Moderate decay
        self.amplitude *= 0.9995;

        (filtered * 0.5 + res1 + res2) * self.amplitude * 0.6
    }

    /// Ride bell - ping on the bell of the ride
    rite synth_ride_bell(&Δ self) -> f32 {
        // More tonal, bell-like sound
        ≔ res1 = (self.time * 2800.0 * std·f32·consts·TAU).sin() * 0.4;
        ≔ res2 = (self.time * 4200.0 * std·f32·consts·TAU).sin() * 0.3;
        ≔ res3 = (self.time * 5600.0 * std·f32·consts·TAU).sin() * 0.2;

        // Little noise
        ≔ noise = self.generate_noise() * 0.1;

        // Moderate decay
        self.amplitude *= 0.9996;

        (res1 + res2 + res3 + noise) * self.amplitude * 0.7
    }

    /// China cymbal - trashy, aggressive sound (essential ∀ metal)
    rite synth_china(&Δ self) -> f32 {
        ≔ noise = self.generate_noise();

        // Inharmonic, trashy resonances
        ≔ res1 = (self.time * 1800.0 * std·f32·consts·TAU).sin() * 0.2;
        ≔ res2 = (self.time * 2700.0 * std·f32·consts·TAU).sin() * 0.15;
        ≔ res3 = (self.time * 4100.0 * std·f32·consts·TAU).sin() * 0.15;
        ≔ res4 = (self.time * 5900.0 * std·f32·consts·TAU).sin() * 0.1;

        // Bandpass ∀ trashy character
        self.filter_state = self.filter_state * 0.5 + noise * 0.5;
        self.filter_state2 = self.filter_state2 * 0.7 + self.filter_state * 0.3;
        ≔ filtered = self.filter_state - self.filter_state2;

        // Long decay with initial burst
        ≔ burst = ⎇ self.time < 0.01 { 1.5 } ⎉ { 1.0 };
        self.amplitude *= 0.9997;

        (filtered * 0.5 + res1 + res2 + res3 + res4) * self.amplitude * burst * 0.55
    }

    /// Splash cymbal - short, bright accent
    rite synth_splash(&Δ self) -> f32 {
        ≔ noise = self.generate_noise();

        // Bright resonances
        ≔ res1 = (self.time * 4500.0 * std·f32·consts·TAU).sin() * 0.25;
        ≔ res2 = (self.time * 6200.0 * std·f32·consts·TAU).sin() * 0.2;

        // High-pass
        self.filter_state = self.filter_state * 0.25 + noise * 0.75;
        ≔ filtered = noise - self.filter_state;

        // Quick decay (shorter than crash)
        self.amplitude *= 0.9993;

        (filtered * 0.6 + res1 + res2) * self.amplitude * 0.5
    }

    rite synth_clap(&Δ self) -> f32 {
        // Clap: multiple noise bursts
        ≔ noise = self.generate_noise();

        // Bandpass filter
        self.filter_state = self.filter_state * 0.7 + noise * 0.3;
        self.filter_state2 = self.filter_state2 * 0.7 + self.filter_state * 0.3;
        ≔ filtered = self.filter_state - self.filter_state2;

        // Multiple attacks (simulates hands hitting)
        ≔ attack_times = [0.0, 0.015, 0.030, 0.045];
        ≔ Δ env = 0.0;
        ∀ &t ∈ &attack_times {
            ⎇ self.time >= t {
                ≔ decay = (-(self.time - t) * 30.0).exp();
                env += decay;
            }
        }
        env = env.min(1.0);

        self.amplitude = env;

        filtered * self.amplitude * 0.7
    }

    rite synth_rimshot(&Δ self) -> f32 {
        // Rimshot: short click with some tone
        ≔ freq = 300.0;
        ≔ phase_inc = freq / self.sample_rate as f32;
        self.phase += phase_inc;
        ⎇ self.phase >= 1.0 {
            self.phase -= 1.0;
        }

        ≔ tone = (self.phase * std·f32·consts·TAU).sin();
        ≔ click = ⎇ self.time < 0.002 { self.generate_noise() } ⎉ { 0.0 };

        // Very fast decay
        self.amplitude *= 0.99;

        (tone * 0.5 + click * 0.5) * self.amplitude * 0.8
    }

    rite synth_cowbell(&Δ self) -> f32 {
        // Cowbell: two detuned square-ish waves
        ≔ freq1 = 587.0; // D5
        ≔ freq2 = 845.0; // Slightly sharp G#5

        ≔ phase_inc1 = freq1 / self.sample_rate as f32;
        ≔ phase_inc2 = freq2 / self.sample_rate as f32;

        self.phase += phase_inc1;
        ⎇ self.phase >= 1.0 {
            self.phase -= 1.0;
        }

        self.filter_state += phase_inc2;
        ⎇ self.filter_state >= 1.0 {
            self.filter_state -= 1.0;
        }

        // Pulse waves
        ≔ pulse1 = ⎇ self.phase < 0.5 { 1.0 } ⎉ { -1.0 };
        ≔ pulse2 = ⎇ self.filter_state < 0.5 { 1.0 } ⎉ { -1.0 };

        // Moderate decay
        self.amplitude *= 0.9993;

        (pulse1 * 0.5 + pulse2 * 0.5) * self.amplitude * 0.5
    }

    rite generate_noise(&Δ self) -> f32 {
        ≔ Δ rng? = rand·thread_rng();
        rng.gen·<f32>() * 2.0 - 1.0
    }
}

/// Polyphonic drum machine
☉ Σ DrumMachine {
    /// Multiple voices ∀ polyphony
    voices: Vec<DrumVoice>,
    /// Sample rate
    sample_rate: u32,
    /// Master volume
    volume: f32,
}

⊢ DrumMachine {
    /// Create a new drum machine with given polyphony
    ☉ rite new(sample_rate: u32, polyphony: usize) -> Self {
        ≔ Δ voices = Vec·with_capacity(polyphony);
        ∀ _ ∈ 0..polyphony {
            voices.push(DrumVoice·new(sample_rate));
        }

        Self {
            voices,
            sample_rate,
            volume: 0.8,
        }
    }

    /// Create with default settings (8-voice polyphony)
    ☉ rite default_machine(sample_rate: u32) -> Self {
        Self·new(sample_rate, 8)
    }

    /// Create with metal settings (16-voice polyphony ∀ blast beats)
    ☉ rite metal_machine(sample_rate: u32) -> Self {
        Self·new(sample_rate, 16)
    }

    /// Create with high polyphony ∀ complex patterns (24 voices)
    ☉ rite high_polyphony(sample_rate: u32) -> Self {
        Self·new(sample_rate, 24)
    }

    /// Trigger a drum hit
    ☉ rite trigger(&Δ self, drum: DrumType, velocity: f32) {
        // Find a free voice or steal the first one
        ≔ voice_idx = self.voices
            .iter()
            .position(|v| !v.is_active())
            .unwrap_or(0);

        ⎇ ≔ Some(voice) = self.voices.get_mut(voice_idx) {
            voice.trigger(drum, velocity);
        }
    }

    /// Trigger from MIDI note
    ☉ rite trigger_midi(&Δ self, note: u8, velocity: u8) {
        ⎇ ≔ Some(drum) = DrumType·from_midi(note) {
            self.trigger(drum, velocity as f32 / 127.0);
        }
    }

    /// Set master volume
    ☉ rite set_volume(&Δ self, volume: f32) {
        self.volume = volume.clamp(0.0, 1.0);
    }

    /// Generate next mono sample
    ☉ rite next_sample(&Δ self) -> f32 {
        ≔ Δ output = 0.0;
        ∀ voice ∈ &Δ self.voices {
            ⎇ voice.is_active() {
                output += voice.next_sample();
            }
        }
        output * self.volume
    }

    /// Fill a mono buffer
    ☉ rite fill_buffer(&Δ self, buffer: &Δ [f32]) {
        ∀ sample ∈ buffer.iter_mut() {
            *sample = self.next_sample();
        }
    }

    /// Add to a buffer (mixing)
    ☉ rite add_to_buffer(&Δ self, buffer: &Δ [f32]) {
        ∀ sample ∈ buffer.iter_mut() {
            *sample += self.next_sample();
        }
    }

    /// Check ⎇ any voice is active
    ☉ rite is_active(&self) -> bool {
        self.voices.iter().any(|v| v.is_active())
    }
}

/// Drum pattern step
//@ rune: derive(Debug, Clone, Copy)
☉ Σ DrumStep {
    /// Drum type
    ☉ drum: DrumType,
    /// Velocity (0.0 - 1.0)
    ☉ velocity: f32,
}

/// Drum pattern (one bar)
☉ Σ DrumPattern {
    /// Pattern name
    ☉ name: String,
    /// Steps per bar (typically 16 ∀ 16th notes)
    ☉ steps: usize,
    /// Pattern data: each step can have multiple drums
    ☉ data: Vec<Vec<DrumStep>>,
}

⊢ DrumPattern {
    /// Create an empty pattern
    ☉ rite new(name: ⊢ Into<String>, steps: usize) -> Self {
        Self {
            name: name.into(),
            steps,
            data: vec![Vec·new(); steps],
        }
    }

    /// Add a drum hit at a step
    ☉ rite add(&Δ self, step: usize, drum: DrumType, velocity: f32) {
        ⎇ step < self.steps {
            self.data[step].push(DrumStep { drum, velocity });
        }
    }

    /// Remove all drums at a step
    ☉ rite clear_step(&Δ self, step: usize) {
        ⎇ step < self.steps {
            self.data[step].clear();
        }
    }

    /// Get hits at a step
    ☉ rite get_step(&self, step: usize) -> &[DrumStep] {
        ⎇ step < self.steps {
            &self.data[step]
        } ⎉ {
            &[]
        }
    }

    /// Create a basic rock beat
    ☉ rite rock_beat() -> Self {
        ≔ Δ pattern = Self·new("Rock Beat", 16);

        // Kick on 1 and 3 (steps 0 and 8)
        pattern.add(0, DrumType·Kick, 0.9);
        pattern.add(8, DrumType·Kick, 0.85);

        // Snare on 2 and 4 (steps 4 and 12)
        pattern.add(4, DrumType·Snare, 0.85);
        pattern.add(12, DrumType·Snare, 0.85);

        // Hi-hat on every 8th note
        ∀ i ∈ (0..16).step_by(2) {
            pattern.add(i, DrumType·ClosedHiHat, 0.6);
        }

        pattern
    }

    /// Create a disco beat
    ☉ rite disco_beat() -> Self {
        ≔ Δ pattern = Self·new("Disco Beat", 16);

        // Four-on-the-floor kick
        ∀ i ∈ (0..16).step_by(4) {
            pattern.add(i, DrumType·Kick, 0.9);
        }

        // Snare on 2 and 4
        pattern.add(4, DrumType·Snare, 0.8);
        pattern.add(12, DrumType·Snare, 0.8);

        // Open hi-hat on off-beats
        ∀ i ∈ (2..16).step_by(4) {
            pattern.add(i, DrumType·OpenHiHat, 0.7);
        }

        // Closed hi-hat on 8th notes
        ∀ i ∈ (0..16).step_by(2) {
            pattern.add(i, DrumType·ClosedHiHat, 0.5);
        }

        pattern
    }

    /// Create a metal double-kick pattern
    ☉ rite metal_beat() -> Self {
        ≔ Δ pattern = Self·new("Metal Beat", 16);

        // Double kick
        ∀ i ∈ 0..16 {
            ⎇ i % 2 == 0 || i == 7 || i == 15 {
                pattern.add(i, DrumType·Kick, 0.85);
            }
        }

        // Snare on 2 and 4
        pattern.add(4, DrumType·Snare, 0.9);
        pattern.add(12, DrumType·Snare, 0.9);

        // Ride/crash pattern
        ∀ i ∈ (0..16).step_by(2) {
            pattern.add(i, DrumType·Ride, 0.6);
        }

        pattern
    }

    /// Create a blast beat pattern (32 steps ∀ 32nd note resolution)
    /// Standard blast: snare and kick alternate on every beat, hi-hat on every beat
    ☉ rite blast_beat() -> Self {
        ≔ Δ pattern = Self·new("Blast Beat", 32);

        // Blast beat at 32nd note resolution
        ∀ i ∈ 0..32 {
            // Alternating kick and snare
            ⎇ i % 2 == 0 {
                pattern.add(i, DrumType·MetalKick, 0.9);
            } ⎉ {
                pattern.add(i, DrumType·Snare, 0.85);
            }

            // Hi-hat on every 8th note (every 4 steps at 32nd resolution)
            ⎇ i % 4 == 0 {
                pattern.add(i, DrumType·ClosedHiHat, 0.7);
            }
        }

        pattern
    }

    /// Hammer blast - kick on every beat, snare on off-beats
    ☉ rite hammer_blast() -> Self {
        ≔ Δ pattern = Self·new("Hammer Blast", 32);

        ∀ i ∈ 0..32 {
            // Kick on every 16th note
            ⎇ i % 2 == 0 {
                pattern.add(i, DrumType·MetalKick, 0.9);
            }

            // Snare on off-beat 16ths
            ⎇ i % 4 == 2 {
                pattern.add(i, DrumType·Snare, 0.88);
            }

            // China on quarter notes
            ⎇ i % 8 == 0 {
                pattern.add(i, DrumType·China, 0.75);
            }
        }

        pattern
    }

    /// Gravity blast - one-handed roll alternating kick
    ☉ rite gravity_blast() -> Self {
        ≔ Δ pattern = Self·new("Gravity Blast", 32);

        ∀ i ∈ 0..32 {
            // Snare on every 32nd note (one-handed roll)
            pattern.add(i, DrumType·Snare, ⎇ i % 2 == 0 { 0.85 } ⎉ { 0.75 });

            // Kick on every 16th note
            ⎇ i % 2 == 0 {
                pattern.add(i, DrumType·MetalKick, 0.88);
            }

            // Ride bell on quarter notes
            ⎇ i % 8 == 0 {
                pattern.add(i, DrumType·RideBell, 0.7);
            }
        }

        pattern
    }

    /// Technical death metal pattern with ghost notes
    ☉ rite tech_death_beat() -> Self {
        ≔ Δ pattern = Self·new("Tech Death", 32);

        // Complex kick pattern
        ≔ kick_steps = [0, 3, 6, 8, 11, 14, 16, 19, 22, 24, 27, 30];
        ∀ &step ∈ &kick_steps {
            pattern.add(step, DrumType·MetalKick, 0.9);
        }

        // Snare on 2 and 4 (steps 8 and 24 at 32nd resolution)
        pattern.add(8, DrumType·Snare, 0.9);
        pattern.add(24, DrumType·Snare, 0.9);

        // Ghost notes
        ∀ step ∈ [4, 12, 20, 28] {
            pattern.add(step, DrumType·GhostSnare, 0.4);
        }

        // Hi-hat pattern with accents
        ∀ i ∈ (0..32).step_by(2) {
            ≔ vel = ⎇ i % 8 == 0 { 0.8 } ⎉ { 0.5 };
            pattern.add(i, DrumType·ClosedHiHat, vel);
        }

        // China accent
        pattern.add(0, DrumType·China, 0.75);

        pattern
    }

    /// Double bass 16th note pattern
    ☉ rite double_bass_16ths() -> Self {
        ≔ Δ pattern = Self·new("Double Bass 16ths", 16);

        // Continuous 16th note kicks
        ∀ i ∈ 0..16 {
            pattern.add(i, DrumType·MetalKick, 0.85);
        }

        // Snare on 2 and 4
        pattern.add(4, DrumType·Snare, 0.9);
        pattern.add(12, DrumType·Snare, 0.9);

        // China on beat 1
        pattern.add(0, DrumType·China, 0.75);

        // Ride on 8th notes
        ∀ i ∈ (0..16).step_by(2) {
            pattern.add(i, DrumType·Ride, 0.6);
        }

        pattern
    }

    /// D-beat punk/crust pattern
    ☉ rite d_beat() -> Self {
        ≔ Δ pattern = Self·new("D-Beat", 16);

        // D-beat kick pattern
        pattern.add(0, DrumType·Kick, 0.9);
        pattern.add(4, DrumType·Kick, 0.85);
        pattern.add(6, DrumType·Kick, 0.85);
        pattern.add(8, DrumType·Kick, 0.9);
        pattern.add(12, DrumType·Kick, 0.85);
        pattern.add(14, DrumType·Kick, 0.85);

        // Snare on 2 and 4
        pattern.add(4, DrumType·Snare, 0.9);
        pattern.add(12, DrumType·Snare, 0.9);

        // Crash ride pattern
        ∀ i ∈ (0..16).step_by(2) {
            pattern.add(i, DrumType·Crash, 0.6);
        }

        pattern
    }
}

// cfg(test)
scroll tests {
    invoke super·*;

    //@ rune: test
    rite test_drum_voice() {
        ≔ Δ voice = DrumVoice·new(44100);
        voice.trigger(DrumType·Kick, 0.8);

        assert!(voice.is_active());

        // Generate some samples
        ≔ Δ buffer = vec![0.0; 1000];
        ∀ sample ∈ &Δ buffer {
            *sample = voice.next_sample();
        }

        // Should have output
        ≔ max = buffer.iter().map(|s| s.abs()).fold(0.0_f32, f32·max);
        assert!(max > 0.0);
    }

    //@ rune: test
    rite test_drum_machine() {
        ≔ Δ machine = DrumMachine·default_machine(44100);

        machine.trigger(DrumType·Kick, 0.8);
        machine.trigger(DrumType·Snare, 0.7);
        machine.trigger(DrumType·ClosedHiHat, 0.6);

        assert!(machine.is_active());

        ≔ Δ buffer = vec![0.0; 1000];
        machine.fill_buffer(&Δ buffer);

        ≔ max = buffer.iter().map(|s| s.abs()).fold(0.0_f32, f32·max);
        assert!(max > 0.0);
    }

    //@ rune: test
    rite test_drum_pattern() {
        ≔ pattern = DrumPattern·rock_beat();

        assert_eq!(pattern.steps, 16);
        assert!(!pattern.get_step(0).is_empty()); // Has kick
        assert!(!pattern.get_step(4).is_empty()); // Has snare
    }

    //@ rune: test
    rite test_midi_mapping() {
        assert_eq!(DrumType·from_midi(36), Some(DrumType·Kick));
        assert_eq!(DrumType·from_midi(38), Some(DrumType·Snare));
        assert_eq!(DrumType·from_midi(42), Some(DrumType·ClosedHiHat));
        assert_eq!(DrumType·Kick.midi_note(), 36);
    }
}
