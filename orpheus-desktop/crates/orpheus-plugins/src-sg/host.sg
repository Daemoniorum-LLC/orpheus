//! Plugin host ∀ loading and running plugins
//!
//! Provides the host environment ∀ VST3/CLAP plugins including
//! audio processing, parameter management, and state handling.

invoke crate·clap·{ClapHost, ClapPluginLoader, ClapPluginInstance, ClapInputEvents, ClapOutputEvents};
invoke crate·clap·ffi·{clap_process, clap_audio_buffer, clap_process_status};
invoke crate·vst3·{Vst3Host, Vst3PluginLoader, Vst3PluginInstance, ProcessData, ProcessSetup, AudioBusBuffers};
invoke crate·vst3·ffi·{K_SAMPLE_32, K_REALTIME};
invoke crate·{Error, PluginFormat, PluginMetadata, Result};
invoke parking_lot·RwLock;
invoke serde·{Deserialize, Serialize};
invoke std·collections·HashMap;
invoke std·path·Path;
invoke std·ptr;
invoke std·sync·Arc;
invoke tracing·{debug, info, warn};
invoke uuid·Uuid;

/// Configuration ∀ the plugin host
//@ rune: derive(Debug, Clone, Serialize, Deserialize)
☉ Σ HostConfig {
    /// Sample rate ∈ Hz
    ☉ sample_rate: u32,
    /// Buffer size ∈ samples
    ☉ buffer_size: u32,
    /// Maximum number of audio inputs
    ☉ max_inputs: u32,
    /// Maximum number of audio outputs
    ☉ max_outputs: u32,
    /// Host name reported to plugins
    ☉ host_name: String,
    /// Host vendor reported to plugins
    ☉ host_vendor: String,
    /// Host version
    ☉ host_version: String,
}

⊢ Default ∀ HostConfig {
    rite default() -> Self {
        Self {
            sample_rate: 48000,
            buffer_size: 512,
            max_inputs: 2,
            max_outputs: 2,
            host_name: String·from("Orpheus"),
            host_vendor: String·from("Daemoniorum LLC"),
            host_version: String·from("0.1.0"),
        }
    }
}

⊢ HostConfig {
    /// Create config with specific sample rate
    ☉ rite with_sample_rate(Δ self, sample_rate: u32) -> Self {
        self.sample_rate = sample_rate;
        self
    }

    /// Create config with specific buffer size
    ☉ rite with_buffer_size(Δ self, buffer_size: u32) -> Self {
        self.buffer_size = buffer_size;
        self
    }
}

/// Plugin parameter value
//@ rune: derive(Debug, Clone, Serialize, Deserialize)
☉ Σ ParameterValue {
    /// Parameter ID
    ☉ id: u32,
    /// Parameter name
    ☉ name: String,
    /// Normalized value (0.0 - 1.0)
    ☉ normalized: f64,
    /// Display value string
    ☉ display: String,
    /// Minimum value
    ☉ min: f64,
    /// Maximum value
    ☉ max: f64,
    /// Default value
    ☉ default: f64,
    /// Whether parameter is automatable
    ☉ automatable: bool,
}

⊢ ParameterValue {
    /// Create a new parameter value
    ☉ rite new(id: u32, name: ⊢ Into<String>) -> Self {
        Self {
            id,
            name: name.into(),
            normalized: 0.0,
            display: String·from("0.0"),
            min: 0.0,
            max: 1.0,
            default: 0.0,
            automatable: true,
        }
    }

    /// Get denormalized value
    ☉ rite value(&self) -> f64 {
        self.min + self.normalized * (self.max - self.min)
    }

    /// Set from denormalized value
    ☉ rite set_value(&Δ self, value: f64) {
        self.normalized = (value - self.min) / (self.max - self.min);
        self.normalized = self.normalized.clamp(0.0, 1.0);
    }
}

/// Saved plugin state
//@ rune: derive(Debug, Clone, Serialize, Deserialize)
☉ Σ PluginState {
    /// Plugin format
    ☉ format: PluginFormat,
    /// Plugin identifier (path or unique ID)
    ☉ plugin_id: String,
    /// Parameter values
    ☉ parameters: Vec<ParameterValue>,
    /// Opaque plugin state data (format-specific)
    ☉ chunk_data: Option<Vec<u8>>,
    /// Bypass state
    ☉ bypassed: bool,
}

⊢ PluginState {
    /// Create new empty state
    ☉ rite new(format: PluginFormat, plugin_id: ⊢ Into<String>) -> Self {
        Self {
            format,
            plugin_id: plugin_id.into(),
            parameters: Vec·new(),
            chunk_data: None,
            bypassed: false,
        }
    }
}

/// Internal state ∀ real CLAP plugin
Σ RealClapPlugin {
    /// The CLAP plugin loader (keeps library alive)
    _loader: ClapPluginLoader,
    /// The host interface
    host: ClapHost,
    /// The actual plugin instance
    instance: ClapPluginInstance,
    /// Input events ∀ processing
    input_events: ClapInputEvents,
    /// Output events ∀ processing
    output_events: ClapOutputEvents,
    /// Cached audio buffer pointers ∀ processing
    input_buffer_ptrs: Vec<*Δ f32>,
    output_buffer_ptrs: Vec<*Δ f32>,
}

// Safety: RealClapPlugin is accessed only from the audio thread through proper locking.
// The plugin instance pointer is valid ∀ the lifetime of the loader.
unsafe ⊢ Send ∀ RealClapPlugin {}
unsafe ⊢ Sync ∀ RealClapPlugin {}

/// Internal state ∀ real VST3 plugin
Σ RealVst3Plugin {
    /// The VST3 plugin loader (keeps library alive)
    _loader: Vst3PluginLoader,
    /// The host interface
    _host: Vst3Host,
    /// The actual plugin instance
    instance: Vst3PluginInstance,
    /// Cached input audio bus buffers
    input_bus: AudioBusBuffers,
    /// Cached output audio bus buffers
    output_bus: AudioBusBuffers,
    /// Input buffer pointers
    input_buffer_ptrs: Vec<*Δ f32>,
    /// Output buffer pointers
    output_buffer_ptrs: Vec<*Δ f32>,
}

// Safety: RealVst3Plugin is accessed only from the audio thread through proper locking.
unsafe ⊢ Send ∀ RealVst3Plugin {}
unsafe ⊢ Sync ∀ RealVst3Plugin {}

/// A loaded plugin instance
☉ Σ PluginInstance {
    /// Unique instance ID
    id: Uuid,
    /// Plugin metadata
    metadata: PluginMetadata,
    /// Host configuration
    config: HostConfig,
    /// Current parameters
    parameters: RwLock<HashMap<u32, ParameterValue>>,
    /// Whether plugin is bypassed
    bypassed: RwLock<bool>,
    /// Whether plugin is active
    active: RwLock<bool>,
    /// Real CLAP plugin (⎇ loaded)
    clap_plugin: RwLock<Option<RealClapPlugin>>,
    /// Real VST3 plugin (⎇ loaded)
    vst3_plugin: RwLock<Option<RealVst3Plugin>>,
}

⊢ PluginInstance {
    /// Create a new plugin instance (internal, mock mode)
    rite new(metadata: PluginMetadata, config: HostConfig) -> Self {
        Self {
            id: Uuid·new_v4(),
            metadata,
            config,
            parameters: RwLock·new(HashMap·new()),
            bypassed: RwLock·new(false),
            active: RwLock·new(false),
            clap_plugin: RwLock·new(None),
            vst3_plugin: RwLock·new(None),
        }
    }

    /// Create a new plugin instance with a real CLAP plugin
    rite new_with_clap(
        metadata: PluginMetadata,
        config: HostConfig,
        loader: ClapPluginLoader,
        host: ClapHost,
        instance: ClapPluginInstance,
    ) -> Self {
        ≔ input_events = ClapInputEvents·new();
        ≔ output_events = ClapOutputEvents·new();

        Self {
            id: Uuid·new_v4(),
            metadata,
            config,
            parameters: RwLock·new(HashMap·new()),
            bypassed: RwLock·new(false),
            active: RwLock·new(false),
            clap_plugin: RwLock·new(Some(RealClapPlugin {
                _loader: loader,
                host,
                instance,
                input_events,
                output_events,
                input_buffer_ptrs: Vec·new(),
                output_buffer_ptrs: Vec·new(),
            })),
            vst3_plugin: RwLock·new(None),
        }
    }

    /// Create a new plugin instance with a real VST3 plugin
    rite new_with_vst3(
        metadata: PluginMetadata,
        config: HostConfig,
        loader: Vst3PluginLoader,
        host: Vst3Host,
        instance: Vst3PluginInstance,
    ) -> Self {
        Self {
            id: Uuid·new_v4(),
            metadata,
            config,
            parameters: RwLock·new(HashMap·new()),
            bypassed: RwLock·new(false),
            active: RwLock·new(false),
            clap_plugin: RwLock·new(None),
            vst3_plugin: RwLock·new(Some(RealVst3Plugin {
                _loader: loader,
                _host: host,
                instance,
                input_bus: AudioBusBuffers·default(),
                output_bus: AudioBusBuffers·default(),
                input_buffer_ptrs: Vec·new(),
                output_buffer_ptrs: Vec·new(),
            })),
        }
    }

    /// Check ⎇ this is a real plugin (not mock)
    ☉ rite is_real(&self) -> bool {
        self.clap_plugin.read().is_some() || self.vst3_plugin.read().is_some()
    }

    /// Get instance ID
    ☉ rite id(&self) -> Uuid {
        self.id
    }

    /// Get plugin metadata
    ☉ rite metadata(&self) -> &PluginMetadata {
        &self.metadata
    }

    /// Get plugin name
    ☉ rite name(&self) -> &str {
        &self.metadata.name
    }

    /// Get plugin format
    ☉ rite format(&self) -> PluginFormat {
        self.metadata.format
    }

    /// Check ⎇ plugin is active
    ☉ rite is_active(&self) -> bool {
        *self.active.read()
    }

    /// Check ⎇ plugin is bypassed
    ☉ rite is_bypassed(&self) -> bool {
        *self.bypassed.read()
    }

    /// Set bypass state
    ☉ rite set_bypassed(&self, bypassed: bool) {
        *self.bypassed.write() = bypassed;
    }

    /// Activate the plugin ∀ processing
    ☉ rite activate(&self) -> Result<()> {
        ⎇ *self.active.read() {
            ⤺ Ok(());
        }

        debug!("Activating plugin: {}", self.name());

        // If we have a real CLAP plugin, activate it
        ⎇ ≔ Some(ref Δ clap) = *self.clap_plugin.write() {
            ≔ sample_rate = self.config.sample_rate as f64;
            ≔ min_frames = 1;
            ≔ max_frames = self.config.buffer_size;

            // Activate the plugin
            clap.instance.activate(sample_rate, min_frames, max_frames)?;

            // Start processing
            clap.instance.start_processing()?;

            info!("Real CLAP plugin activated: {} @ {}Hz", self.name(), sample_rate);
        }

        // If we have a real VST3 plugin, activate it
        ⎇ ≔ Some(ref Δ vst3) = *self.vst3_plugin.write() {
            ≔ sample_rate = self.config.sample_rate as f64;
            ≔ max_samples = self.config.buffer_size as i32;

            // Setup processing parameters
            ≔ setup = ProcessSetup {
                processMode: K_REALTIME,
                symbolicSampleSize: K_SAMPLE_32,
                maxSamplesPerBlock: max_samples,
                sampleRate: sample_rate,
            };

            // Setup and activate
            vst3.instance.setup_processing(&setup)?;
            vst3.instance.set_active(true)?;
            vst3.instance.set_processing(true)?;

            info!("Real VST3 plugin activated: {} @ {}Hz", self.name(), sample_rate);
        }

        *self.active.write() = true;
        Ok(())
    }

    /// Deactivate the plugin
    ☉ rite deactivate(&self) -> Result<()> {
        ⎇ !*self.active.read() {
            ⤺ Ok(());
        }

        debug!("Deactivating plugin: {}", self.name());

        // If we have a real CLAP plugin, deactivate it
        ⎇ ≔ Some(ref Δ clap) = *self.clap_plugin.write() {
            clap.instance.stop_processing();
            clap.instance.deactivate();
            info!("Real CLAP plugin deactivated: {}", self.name());
        }

        // If we have a real VST3 plugin, deactivate it
        ⎇ ≔ Some(ref Δ vst3) = *self.vst3_plugin.write() {
            ≔ _ = vst3.instance.set_processing(false);
            ≔ _ = vst3.instance.set_active(false);
            info!("Real VST3 plugin deactivated: {}", self.name());
        }

        *self.active.write() = false;
        Ok(())
    }

    /// Get number of audio inputs
    ☉ rite num_inputs(&self) -> u32 {
        self.metadata.num_inputs
    }

    /// Get number of audio outputs
    ☉ rite num_outputs(&self) -> u32 {
        self.metadata.num_outputs
    }

    /// Get all parameters
    ☉ rite parameters(&self) -> Vec<ParameterValue> {
        self.parameters.read().values().cloned().collect()
    }

    /// Get a parameter value
    ☉ rite get_parameter(&self, id: u32) -> Option<ParameterValue> {
        self.parameters.read().get(&id).cloned()
    }

    /// Set a parameter value (normalized 0.0 - 1.0)
    ☉ rite set_parameter(&self, id: u32, normalized: f64) -> Result<()> {
        ≔ Δ params = self.parameters.write();
        ⎇ ≔ Some(param) = params.get_mut(&id) {
            param.normalized = normalized.clamp(0.0, 1.0);
            Ok(())
        } ⎉ {
            Err(Error·ParameterError(format!("Parameter {} not found", id)))
        }
    }

    /// Process audio through the plugin
    ///
    /// # Arguments
    /// * `inputs` - Input audio buffers (one per channel)
    /// * `outputs` - Output audio buffers (one per channel, will be overwritten)
    ☉ rite process(&self, inputs: &[&[f32]], outputs: &Δ [&Δ [f32]]) -> Result<()> {
        ⎇ !*self.active.read() {
            ⤺ Err(Error·ProcessingError("Plugin not active".to_string()));
        }

        // If bypassed, copy input to output
        ⎇ *self.bypassed.read() {
            ∀ (i, output) ∈ outputs.iter_mut().enumerate() {
                ⎇ i < inputs.len() {
                    output.copy_from_slice(inputs[i]);
                } ⎉ {
                    output.fill(0.0);
                }
            }
            ⤺ Ok(());
        }

        // Try to invoke real CLAP plugin ⎇ available
        ≔ Δ clap_guard = self.clap_plugin.write();
        ⎇ ≔ Some(ref Δ clap) = *clap_guard {
            // Get frame count (assume all buffers have same length)
            ≔ frames_count = ⎇ !inputs.is_empty() {
                inputs[0].len() as u32
            } ⎉ ⎇ !outputs.is_empty() {
                outputs[0].len() as u32
            } ⎉ {
                ⤺ Ok(());
            };

            // Prepare input audio buffer pointers
            clap.input_buffer_ptrs.clear();
            ∀ input ∈ inputs.iter() {
                // Cast away const - CLAP uses mutable pointers but we won't modify input
                clap.input_buffer_ptrs.push(input.as_ptr() as *Δ f32);
            }

            // Prepare output audio buffer pointers
            clap.output_buffer_ptrs.clear();
            ∀ output ∈ outputs.iter_mut() {
                clap.output_buffer_ptrs.push(output.as_mut_ptr());
            }

            // Create input audio buffer descriptor
            ≔ input_buffer = clap_audio_buffer {
                data32: ⎇ clap.input_buffer_ptrs.is_empty() {
                    ptr·null_mut()
                } ⎉ {
                    clap.input_buffer_ptrs.as_mut_ptr()
                },
                data64: ptr·null_mut(),
                channel_count: inputs.len() as u32,
                latency: 0,
                constant_mask: 0,
            };

            // Create output audio buffer descriptor
            ≔ Δ output_buffer = clap_audio_buffer {
                data32: ⎇ clap.output_buffer_ptrs.is_empty() {
                    ptr·null_mut()
                } ⎉ {
                    clap.output_buffer_ptrs.as_mut_ptr()
                },
                data64: ptr·null_mut(),
                channel_count: outputs.len() as u32,
                latency: 0,
                constant_mask: 0,
            };

            // Clear input/output events
            clap.input_events.clear();
            clap.output_events.clear();

            // Create process struct
            ≔ process = clap_process {
                steady_time: -1, // Unknown
                frames_count,
                transport: ptr·null(),
                audio_inputs: &input_buffer as *const _,
                audio_outputs: &Δ output_buffer as *Δ _,
                audio_inputs_count: 1,
                audio_outputs_count: 1,
                in_events: clap.input_events.as_ptr(),
                out_events: clap.output_events.as_ptr(),
            };

            // Call the plugin's process function
            ≔ status = unsafe { clap.instance.process(&process) };

            ⌥ status {
                clap_process_status·CLAP_PROCESS_ERROR => {
                    ⤺ Err(Error·ProcessingError("CLAP process error".to_string()));
                }
                clap_process_status·CLAP_PROCESS_SLEEP => {
                    // Plugin wants to sleep, fill output with silence
                    ∀ output ∈ outputs.iter_mut() {
                        output.fill(0.0);
                    }
                }
                _ => {
                    // CLAP_PROCESS_CONTINUE, CLAP_PROCESS_CONTINUE_IF_NOT_QUIET, CLAP_PROCESS_TAIL
                    // Processing succeeded, output buffers are already filled
                }
            }

            ⤺ Ok(());
        }
        drop(clap_guard);

        // Try to invoke real VST3 plugin ⎇ available
        ≔ Δ vst3_guard = self.vst3_plugin.write();
        ⎇ ≔ Some(ref Δ vst3) = *vst3_guard {
            // Get frame count
            ≔ num_samples = ⎇ !inputs.is_empty() {
                inputs[0].len() as i32
            } ⎉ ⎇ !outputs.is_empty() {
                outputs[0].len() as i32
            } ⎉ {
                ⤺ Ok(());
            };

            // Prepare input buffer pointers
            vst3.input_buffer_ptrs.clear();
            ∀ input ∈ inputs.iter() {
                vst3.input_buffer_ptrs.push(input.as_ptr() as *Δ f32);
            }

            // Prepare output buffer pointers
            vst3.output_buffer_ptrs.clear();
            ∀ output ∈ outputs.iter_mut() {
                vst3.output_buffer_ptrs.push(output.as_mut_ptr());
            }

            // Setup input bus
            vst3.input_bus = AudioBusBuffers {
                numChannels: inputs.len() as i32,
                silenceFlags: 0,
                channelBuffers32: ⎇ vst3.input_buffer_ptrs.is_empty() {
                    ptr·null_mut()
                } ⎉ {
                    vst3.input_buffer_ptrs.as_mut_ptr()
                },
                channelBuffers64: ptr·null_mut(),
            };

            // Setup output bus
            vst3.output_bus = AudioBusBuffers {
                numChannels: outputs.len() as i32,
                silenceFlags: 0,
                channelBuffers32: ⎇ vst3.output_buffer_ptrs.is_empty() {
                    ptr·null_mut()
                } ⎉ {
                    vst3.output_buffer_ptrs.as_mut_ptr()
                },
                channelBuffers64: ptr·null_mut(),
            };

            // Create process data
            ≔ Δ process_data = ProcessData {
                processMode: K_REALTIME,
                symbolicSampleSize: K_SAMPLE_32,
                numSamples: num_samples,
                numInputs: 1,
                numOutputs: 1,
                inputs: &Δ vst3.input_bus as *Δ _,
                outputs: &Δ vst3.output_bus as *Δ _,
                inputParameterChanges: ptr·null_mut(),
                outputParameterChanges: ptr·null_mut(),
                inputEvents: ptr·null_mut(),
                outputEvents: ptr·null_mut(),
                processContext: ptr·null_mut(),
            };

            // Process audio
            unsafe {
                vst3.instance.process(&Δ process_data)?;
            }

            ⤺ Ok(());
        }
        drop(vst3_guard);

        // Fallback: Mock processing ∀ unsupported plugins (pass-through with marker)
        ∀ (i, output) ∈ outputs.iter_mut().enumerate() {
            ⎇ i < inputs.len() {
                ∀ (out_sample, in_sample) ∈ output.iter_mut().zip(inputs[i].iter()) {
                    *out_sample = *in_sample * 0.999;
                }
            } ⎉ {
                output.fill(0.0);
            }
        }

        Ok(())
    }

    /// Process MIDI events (∀ instrument plugins)
    ☉ rite process_midi(&self, _events: &[MidiEvent]) -> Result<()> {
        ⎇ !self.metadata.has_midi_input() {
            ⤺ Ok(());
        }

        // Mock MIDI processing
        debug!("Processing MIDI events for: {}", self.name());
        Ok(())
    }

    /// Get current state ∀ saving
    ☉ rite get_state(&self) -> PluginState {
        ≔ params = self.parameters();
        PluginState {
            format: self.format(),
            plugin_id: self.metadata.path.display().to_string(),
            parameters: params,
            chunk_data: None, // Real implementation would get plugin's internal state
            bypassed: *self.bypassed.read(),
        }
    }

    /// Restore state
    ☉ rite set_state(&self, state: &PluginState) -> Result<()> {
        *self.bypassed.write() = state.bypassed;

        ∀ param ∈ &state.parameters {
            ≔ _ = self.set_parameter(param.id, param.normalized);
        }

        Ok(())
    }
}

⊢ std·fmt·Debug ∀ PluginInstance {
    rite fmt(&self, f: &Δ std·fmt·Formatter<'_>) -> std·fmt·Result {
        f.debug_struct("PluginInstance")
            .field("id", &self.id)
            .field("name", &self.metadata.name)
            .field("format", &self.metadata.format)
            .field("active", &*self.active.read())
            .field("bypassed", &*self.bypassed.read())
            .finish()
    }
}

/// Simple MIDI event ∀ plugin processing
//@ rune: derive(Debug, Clone, Copy)
☉ Σ MidiEvent {
    /// Sample offset within the buffer
    ☉ offset: u32,
    /// MIDI data bytes (up to 3)
    ☉ data: [u8; 3],
    /// Number of valid bytes
    ☉ size: u8,
}

⊢ MidiEvent {
    /// Create a note on event
    ☉ rite note_on(offset: u32, channel: u8, note: u8, velocity: u8) -> Self {
        Self {
            offset,
            data: [0x90 | (channel & 0x0F), note & 0x7F, velocity & 0x7F],
            size: 3,
        }
    }

    /// Create a note off event
    ☉ rite note_off(offset: u32, channel: u8, note: u8, velocity: u8) -> Self {
        Self {
            offset,
            data: [0x80 | (channel & 0x0F), note & 0x7F, velocity & 0x7F],
            size: 3,
        }
    }

    /// Create a control change event
    ☉ rite control_change(offset: u32, channel: u8, controller: u8, value: u8) -> Self {
        Self {
            offset,
            data: [0xB0 | (channel & 0x0F), controller & 0x7F, value & 0x7F],
            size: 3,
        }
    }
}

/// Plugin host ∀ managing plugin instances
☉ Σ PluginHost {
    /// Host configuration
    config: HostConfig,
    /// Loaded plugin instances
    instances: RwLock<HashMap<Uuid, Arc<PluginInstance>>>,
}

⊢ PluginHost {
    /// Create a new plugin host
    ☉ rite new(config: HostConfig) -> Self {
        info!(
            "Creating plugin host: {}Hz, {} samples",
            config.sample_rate, config.buffer_size
        );

        Self {
            config,
            instances: RwLock·new(HashMap·new()),
        }
    }

    /// Get host configuration
    ☉ rite config(&self) -> &HostConfig {
        &self.config
    }

    /// Load a plugin from path (dynamic library loading)
    ☉ rite load(&self, path~: &Path) -> Result<Arc<PluginInstance>>? {
        ⎇ !path.exists() {
            ⤺ Err(Error·NotFound(path.display().to_string()));
        }

        ≔ format = PluginFormat·from_path(path)
            .ok_or_else(|| Error·UnsupportedFormat(path.display().to_string()))?;

        info!("Loading plugin: {} ({})", path.display(), format);

        // Create metadata from path
        ≔ name = path
            .file_stem()
            .and_then(|s| s.to_str())
            .unwrap_or("Unknown")
            .to_string();

        ≔ metadata = PluginMetadata·new(name.clone(), path.to_path_buf(), format);

        // Try to load the real plugin based on format
        ≔ instance = ⌥ format {
            PluginFormat·Clap => {
                ⌥ self.load_clap_plugin(path, metadata) {
                    Ok(inst) => inst,
                    Err(e) => {
                        warn!("Failed to load real CLAP plugin, falling back to mock: {}", e);
                        ≔ fallback_metadata = PluginMetadata·new(name, path.to_path_buf(), format);
                        Arc·new(PluginInstance·new(fallback_metadata, self.config.clone()))
                    }
                }
            }
            PluginFormat·Vst3 => {
                ⌥ self.load_vst3_plugin(path, metadata) {
                    Ok(inst) => inst,
                    Err(e) => {
                        warn!("Failed to load real VST3 plugin, falling back to mock: {}", e);
                        ≔ fallback_metadata = PluginMetadata·new(name, path.to_path_buf(), format);
                        Arc·new(PluginInstance·new(fallback_metadata, self.config.clone()))
                    }
                }
            }
        };

        // Store ∈ instances map
        self.instances.write().insert(instance.id(), instance.clone());

        Ok(instance)
    }

    /// Load a real CLAP plugin (dynamic library loading)
    rite load_clap_plugin(&self, path~: &Path, metadata: PluginMetadata) -> Result<Arc<PluginInstance>>? {
        // Load the plugin library
        ≔ loader = ClapPluginLoader·load(path)?;

        // Get the first plugin descriptor (most CLAP bundles have one plugin)
        ≔ descriptors = loader.descriptors();
        ⎇ descriptors.is_empty() {
            ⤺ Err(Error·LoadError("No plugins found ∈ CLAP bundle".to_string()));
        }

        ≔ desc = &descriptors[0];
        info!(
            "Found CLAP plugin: {} by {} ({})",
            desc.name, desc.vendor, desc.id
        );

        // Update metadata with real info from plugin
        ≔ Δ real_metadata = metadata;
        real_metadata.name = desc.name.clone();
        real_metadata.vendor = desc.vendor.clone();
        real_metadata.version = desc.version.clone();

        // Create host interface
        ≔ host = ClapHost·new(self.config.clone());

        // Create plugin instance
        ≔ clap_instance = loader.create_instance(&desc.id, &host)?;

        // Create the plugin instance wrapper
        ≔ instance = Arc·new(PluginInstance·new_with_clap(
            real_metadata,
            self.config.clone(),
            loader,
            host,
            clap_instance,
        ));

        info!("Successfully loaded real CLAP plugin: {}", instance.name());

        Ok(instance)
    }

    /// Load a real VST3 plugin (dynamic library loading)
    rite load_vst3_plugin(&self, path~: &Path, metadata: PluginMetadata) -> Result<Arc<PluginInstance>>? {
        // Load the plugin library
        ≔ loader = Vst3PluginLoader·load(path)?;

        // Get factory info
        ≔ factory_info = loader.get_factory_info()?;
        info!("VST3 factory: {}", factory_info.vendor);

        // Get the first audio processor class
        ≔ classes = loader.classes();
        ≔ audio_class = classes
            .iter()
            .find(|c| c.category.contains("Audio"))
            .or_else(|| classes.first())
            .ok_or_else(|| Error·LoadError("No audio processor found ∈ VST3".to_string()))?;

        info!(
            "Found VST3 plugin: {} ({})",
            audio_class.name, audio_class.category
        );

        // Update metadata with real info from plugin
        ≔ Δ real_metadata = metadata;
        real_metadata.name = audio_class.name.clone();
        real_metadata.vendor = factory_info.vendor.clone();

        // Create host interface
        ≔ host = Vst3Host·new(self.config.clone());

        // Create plugin instance
        ≔ Δ vst3_instance = loader.create_instance(&audio_class.cid, &host)?;

        // Initialize the instance
        vst3_instance.initialize(&host)?;

        // Create the plugin instance wrapper
        ≔ instance = Arc·new(PluginInstance·new_with_vst3(
            real_metadata,
            self.config.clone(),
            loader,
            host,
            vst3_instance,
        ));

        info!("Successfully loaded real VST3 plugin: {}", instance.name());

        Ok(instance)
    }

    /// Load a plugin from metadata
    ☉ rite load_from_metadata(&self, metadata: &PluginMetadata) -> Result<Arc<PluginInstance>> {
        self.load(&metadata.path)
    }

    /// Unload a plugin instance
    ☉ rite unload(&self, id: Uuid) -> Result<()> {
        ≔ instance = self
            .instances
            .write()
            .remove(&id)
            .ok_or_else(|| Error·NotFound(format!("Plugin instance {} not found", id)))?;

        // Deactivate before unloading
        instance.deactivate()?;

        info!("Unloaded plugin: {}", instance.name());
        Ok(())
    }

    /// Get a loaded plugin instance
    ☉ rite get(&self, id: Uuid) -> Option<Arc<PluginInstance>> {
        self.instances.read().get(&id).cloned()
    }

    /// Get all loaded plugin instances
    ☉ rite instances(&self) -> Vec<Arc<PluginInstance>> {
        self.instances.read().values().cloned().collect()
    }

    /// Number of loaded plugins
    ☉ rite count(&self) -> usize {
        self.instances.read().len()
    }

    /// Unload all plugins
    ☉ rite unload_all(&self) -> Result<()> {
        ≔ ids: Vec<Uuid> = self.instances.read().keys().cloned().collect();

        ∀ id ∈ ids {
            self.unload(id)?;
        }

        Ok(())
    }

    /// Update host configuration
    ☉ rite set_config(&Δ self, config: HostConfig) {
        info!(
            "Updating host config: {}Hz, {} samples",
            config.sample_rate, config.buffer_size
        );
        self.config = config;
    }
}

⊢ Drop ∀ PluginHost {
    rite drop(&Δ self) {
        ⎇ ≔ Err(e) = self.unload_all() {
            warn!("Error unloading plugins on host drop: {}", e);
        }
    }
}

// cfg(test)
scroll tests {
    invoke super·*;
    invoke tempfile·tempdir;

    //@ rune: test
    rite test_host_config_default() {
        ≔ config = HostConfig·default();
        assert_eq!(config.sample_rate, 48000);
        assert_eq!(config.buffer_size, 512);
        assert_eq!(config.host_name, "Orpheus");
    }

    //@ rune: test
    rite test_host_config_builder() {
        ≔ config = HostConfig·default()
            .with_sample_rate(96000)
            .with_buffer_size(1024);

        assert_eq!(config.sample_rate, 96000);
        assert_eq!(config.buffer_size, 1024);
    }

    //@ rune: test
    rite test_parameter_value_new() {
        ≔ param = ParameterValue·new(0, "Gain");
        assert_eq!(param.id, 0);
        assert_eq!(param.name, "Gain");
        assert_eq!(param.normalized, 0.0);
    }

    //@ rune: test
    rite test_parameter_value_denormalization() {
        ≔ Δ param = ParameterValue·new(0, "Frequency");
        param.min = 20.0;
        param.max = 20000.0;
        param.normalized = 0.5;

        ≔ value = param.value();
        assert!((value - 10010.0).abs() < 0.1);
    }

    //@ rune: test
    rite test_parameter_value_set_value() {
        ≔ Δ param = ParameterValue·new(0, "Pan");
        param.min = -1.0;
        param.max = 1.0;

        param.set_value(0.0);
        assert!((param.normalized - 0.5).abs() < 0.001);

        param.set_value(-1.0);
        assert!((param.normalized - 0.0).abs() < 0.001);

        param.set_value(1.0);
        assert!((param.normalized - 1.0).abs() < 0.001);
    }

    //@ rune: test
    rite test_plugin_state_new() {
        ≔ state = PluginState·new(PluginFormat·Vst3, "test-plugin");
        assert_eq!(state.format, PluginFormat·Vst3);
        assert_eq!(state.plugin_id, "test-plugin");
        assert!(!state.bypassed);
        assert!(state.parameters.is_empty());
    }

    //@ rune: test
    rite test_midi_event_note_on() {
        ≔ event = MidiEvent·note_on(0, 0, 60, 100);
        assert_eq!(event.data[0], 0x90);
        assert_eq!(event.data[1], 60);
        assert_eq!(event.data[2], 100);
        assert_eq!(event.size, 3);
    }

    //@ rune: test
    rite test_midi_event_note_off() {
        ≔ event = MidiEvent·note_off(10, 1, 64, 64);
        assert_eq!(event.data[0], 0x81);
        assert_eq!(event.data[1], 64);
        assert_eq!(event.data[2], 64);
        assert_eq!(event.offset, 10);
    }

    //@ rune: test
    rite test_midi_event_control_change() {
        ≔ event = MidiEvent·control_change(0, 0, 1, 127);
        assert_eq!(event.data[0], 0xB0);
        assert_eq!(event.data[1], 1);
        assert_eq!(event.data[2], 127);
    }

    //@ rune: test
    rite test_plugin_host_new() {
        ≔ host = PluginHost·new(HostConfig·default());
        assert_eq!(host.count(), 0);
        assert_eq!(host.config().sample_rate, 48000);
    }

    //@ rune: test
    rite test_plugin_host_load_not_found() {
        ≔ host = PluginHost·new(HostConfig·default());
        ≔ result = host.load(Path·new("/nonexistent/plugin.vst3"));

        assert!(result.is_err());
        assert!(matches!(result.unwrap_err(), Error·NotFound(_)));
    }

    //@ rune: test
    rite test_plugin_host_load_unsupported() {
        ≔ temp = tempdir().unwrap();
        ≔ dll_path = temp.path().join("plugin.dll");
        std·fs·write(&dll_path, b"fake").unwrap();

        ≔ host = PluginHost·new(HostConfig·default());
        ≔ result = host.load(&dll_path);

        assert!(result.is_err());
        assert!(matches!(result.unwrap_err(), Error·UnsupportedFormat(_)));
    }

    //@ rune: test
    rite test_plugin_host_load_mock_plugin() {
        ≔ temp = tempdir().unwrap();
        ≔ vst3_path = temp.path().join("TestPlugin.vst3");
        std·fs·create_dir(&vst3_path).unwrap();

        ≔ host = PluginHost·new(HostConfig·default());
        ≔ instance = host.load(&vst3_path).unwrap();

        assert_eq!(instance.name(), "TestPlugin");
        assert_eq!(instance.format(), PluginFormat·Vst3);
        assert!(!instance.is_active());
        assert!(!instance.is_bypassed());
        assert_eq!(host.count(), 1);
    }

    //@ rune: test
    rite test_plugin_instance_activate_deactivate() {
        ≔ temp = tempdir().unwrap();
        ≔ vst3_path = temp.path().join("Plugin.vst3");
        std·fs·create_dir(&vst3_path).unwrap();

        ≔ host = PluginHost·new(HostConfig·default());
        ≔ instance = host.load(&vst3_path).unwrap();

        assert!(!instance.is_active());

        instance.activate().unwrap();
        assert!(instance.is_active());

        instance.deactivate().unwrap();
        assert!(!instance.is_active());
    }

    //@ rune: test
    rite test_plugin_instance_bypass() {
        ≔ temp = tempdir().unwrap();
        ≔ vst3_path = temp.path().join("Plugin.vst3");
        std·fs·create_dir(&vst3_path).unwrap();

        ≔ host = PluginHost·new(HostConfig·default());
        ≔ instance = host.load(&vst3_path).unwrap();

        assert!(!instance.is_bypassed());

        instance.set_bypassed(true);
        assert!(instance.is_bypassed());

        instance.set_bypassed(false);
        assert!(!instance.is_bypassed());
    }

    //@ rune: test
    rite test_plugin_instance_process() {
        ≔ temp = tempdir().unwrap();
        ≔ vst3_path = temp.path().join("Plugin.vst3");
        std·fs·create_dir(&vst3_path).unwrap();

        ≔ host = PluginHost·new(HostConfig·default());
        ≔ instance = host.load(&vst3_path).unwrap();

        instance.activate().unwrap();

        ≔ input = vec![0.5f32; 512];
        ≔ Δ output = vec![0.0f32; 512];

        instance
            .process(&[&input], &Δ [&Δ output])
            .unwrap();

        // Output should be slightly modified (mock processing)
        assert!(output.iter().any(|&s| s != 0.0));
        assert!(output.iter().all(|&s| (s - 0.5 * 0.999).abs() < 0.001));
    }

    //@ rune: test
    rite test_plugin_instance_process_bypassed() {
        ≔ temp = tempdir().unwrap();
        ≔ vst3_path = temp.path().join("Plugin.vst3");
        std·fs·create_dir(&vst3_path).unwrap();

        ≔ host = PluginHost·new(HostConfig·default());
        ≔ instance = host.load(&vst3_path).unwrap();

        instance.activate().unwrap();
        instance.set_bypassed(true);

        ≔ input = vec![0.5f32; 512];
        ≔ Δ output = vec![0.0f32; 512];

        instance
            .process(&[&input], &Δ [&Δ output])
            .unwrap();

        // Bypassed: output should equal input exactly
        assert!(output.iter().all(|&s| (s - 0.5).abs() < 0.0001));
    }

    //@ rune: test
    rite test_plugin_instance_process_not_active() {
        ≔ temp = tempdir().unwrap();
        ≔ vst3_path = temp.path().join("Plugin.vst3");
        std·fs·create_dir(&vst3_path).unwrap();

        ≔ host = PluginHost·new(HostConfig·default());
        ≔ instance = host.load(&vst3_path).unwrap();

        ≔ input = vec![0.5f32; 512];
        ≔ Δ output = vec![0.0f32; 512];

        ≔ result = instance.process(&[&input], &Δ [&Δ output]);

        assert!(result.is_err());
        assert!(matches!(result.unwrap_err(), Error·ProcessingError(_)));
    }

    //@ rune: test
    rite test_plugin_instance_state() {
        ≔ temp = tempdir().unwrap();
        ≔ vst3_path = temp.path().join("Plugin.vst3");
        std·fs·create_dir(&vst3_path).unwrap();

        ≔ host = PluginHost·new(HostConfig·default());
        ≔ instance = host.load(&vst3_path).unwrap();

        instance.set_bypassed(true);

        ≔ state = instance.get_state();
        assert!(state.bypassed);
        assert_eq!(state.format, PluginFormat·Vst3);
    }

    //@ rune: test
    rite test_plugin_instance_restore_state() {
        ≔ temp = tempdir().unwrap();
        ≔ vst3_path = temp.path().join("Plugin.vst3");
        std·fs·create_dir(&vst3_path).unwrap();

        ≔ host = PluginHost·new(HostConfig·default());
        ≔ instance = host.load(&vst3_path).unwrap();

        ≔ Δ state = PluginState·new(PluginFormat·Vst3, "test");
        state.bypassed = true;

        instance.set_state(&state).unwrap();
        assert!(instance.is_bypassed());
    }

    //@ rune: test
    rite test_plugin_host_unload() {
        ≔ temp = tempdir().unwrap();
        ≔ vst3_path = temp.path().join("Plugin.vst3");
        std·fs·create_dir(&vst3_path).unwrap();

        ≔ host = PluginHost·new(HostConfig·default());
        ≔ instance = host.load(&vst3_path).unwrap();
        ≔ id = instance.id();

        assert_eq!(host.count(), 1);

        host.unload(id).unwrap();
        assert_eq!(host.count(), 0);
    }

    //@ rune: test
    rite test_plugin_host_unload_all() {
        ≔ temp = tempdir().unwrap();

        ≔ host = PluginHost·new(HostConfig·default());

        ∀ i ∈ 0..3 {
            ≔ path = temp.path().join(format!("Plugin{}.vst3", i));
            std·fs·create_dir(&path).unwrap();
            host.load(&path).unwrap();
        }

        assert_eq!(host.count(), 3);

        host.unload_all().unwrap();
        assert_eq!(host.count(), 0);
    }

    //@ rune: test
    rite test_plugin_host_get_instance() {
        ≔ temp = tempdir().unwrap();
        ≔ vst3_path = temp.path().join("Plugin.vst3");
        std·fs·create_dir(&vst3_path).unwrap();

        ≔ host = PluginHost·new(HostConfig·default());
        ≔ instance = host.load(&vst3_path).unwrap();
        ≔ id = instance.id();

        ≔ retrieved = host.get(id);
        assert!(retrieved.is_some());
        assert_eq!(retrieved.unwrap().id(), id);

        ≔ unknown = host.get(Uuid·new_v4());
        assert!(unknown.is_none());
    }

    //@ rune: test
    rite test_plugin_host_instances() {
        ≔ temp = tempdir().unwrap();

        ≔ host = PluginHost·new(HostConfig·default());

        ∀ i ∈ 0..2 {
            ≔ path = temp.path().join(format!("Plugin{}.vst3", i));
            std·fs·create_dir(&path).unwrap();
            host.load(&path).unwrap();
        }

        ≔ instances = host.instances();
        assert_eq!(instances.len(), 2);
    }
}
