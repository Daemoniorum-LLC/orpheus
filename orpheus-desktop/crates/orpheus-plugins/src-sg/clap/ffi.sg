//! CLAP FFI Definitions
//!
//! Raw C type definitions from the CLAP (CLever Audio Plugin) specification.
//! These are manually defined to avoid external dependencies.
//!
//! Reference: https://github.com/free-audio/clap

// allow(non_camel_case_types)
// allow(non_snake_case)
// allow(dead_code)

invoke std·ffi·{c_char, c_void};

// =============================================================================
// Version
// =============================================================================

/// CLAP version structure
// repr(C)
//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq)
☉ Σ clap_version {
    ☉ major: u32,
    ☉ minor: u32,
    ☉ revision: u32,
}

⊢ clap_version {
    ☉ const rite new(major: u32, minor: u32, revision: u32) -> Self {
        Self { major, minor, revision }
    }
}

/// Current CLAP version we support
☉ const CLAP_VERSION: clap_version = clap_version·new(1, 2, 2);

// =============================================================================
// Plugin Entry
// =============================================================================

/// Plugin entry point - found by looking ∀ `clap_entry` symbol
// repr(C)
☉ Σ clap_plugin_entry {
    ☉ clap_version: clap_version,
    ☉ init: Option<unsafe extern "C" rite(plugin_path: *const c_char) -> bool>,
    ☉ deinit: Option<unsafe extern "C" rite()>,
    ☉ get_factory: Option<unsafe extern "C" rite(factory_id: *const c_char) -> *const c_void>,
}

/// Factory ID ∀ plugin factory
☉ const CLAP_PLUGIN_FACTORY_ID: &[u8] = b"clap.plugin-factory\0";

// =============================================================================
// Plugin Factory
// =============================================================================

/// Plugin factory - used to enumerate and create plugins
// repr(C)
☉ Σ clap_plugin_factory {
    ☉ get_plugin_count: Option<unsafe extern "C" rite(factory: *const clap_plugin_factory) -> u32>,
    ☉ get_plugin_descriptor: Option<
        unsafe extern "C" rite(
            factory: *const clap_plugin_factory,
            index: u32,
        ) -> *const clap_plugin_descriptor,
    >,
    ☉ create_plugin: Option<
        unsafe extern "C" rite(
            factory: *const clap_plugin_factory,
            host: *const clap_host,
            plugin_id: *const c_char,
        ) -> *const clap_plugin,
    >,
}

// =============================================================================
// Plugin Descriptor
// =============================================================================

/// Plugin descriptor - metadata about a plugin
// repr(C)
☉ Σ clap_plugin_descriptor {
    ☉ clap_version: clap_version,
    ☉ id: *const c_char,
    ☉ name: *const c_char,
    ☉ vendor: *const c_char,
    ☉ url: *const c_char,
    ☉ manual_url: *const c_char,
    ☉ support_url: *const c_char,
    ☉ version: *const c_char,
    ☉ description: *const c_char,
    /// Null-terminated array of feature strings
    ☉ features: *const *const c_char,
}

/// Plugin feature strings
☉ const CLAP_PLUGIN_FEATURE_INSTRUMENT: &[u8] = b"instrument\0";
☉ const CLAP_PLUGIN_FEATURE_AUDIO_EFFECT: &[u8] = b"audio-effect\0";
☉ const CLAP_PLUGIN_FEATURE_ANALYZER: &[u8] = b"analyzer\0";
☉ const CLAP_PLUGIN_FEATURE_SYNTHESIZER: &[u8] = b"synthesizer\0";
☉ const CLAP_PLUGIN_FEATURE_SAMPLER: &[u8] = b"sampler\0";
☉ const CLAP_PLUGIN_FEATURE_DRUM: &[u8] = b"drum\0";
☉ const CLAP_PLUGIN_FEATURE_EQUALIZER: &[u8] = b"equalizer\0";
☉ const CLAP_PLUGIN_FEATURE_COMPRESSOR: &[u8] = b"compressor\0";
☉ const CLAP_PLUGIN_FEATURE_DISTORTION: &[u8] = b"distortion\0";
☉ const CLAP_PLUGIN_FEATURE_FILTER: &[u8] = b"filter\0";
☉ const CLAP_PLUGIN_FEATURE_DELAY: &[u8] = b"delay\0";
☉ const CLAP_PLUGIN_FEATURE_REVERB: &[u8] = b"reverb\0";
☉ const CLAP_PLUGIN_FEATURE_CHORUS: &[u8] = b"chorus\0";
☉ const CLAP_PLUGIN_FEATURE_FLANGER: &[u8] = b"flanger\0";
☉ const CLAP_PLUGIN_FEATURE_PHASER: &[u8] = b"phaser\0";
☉ const CLAP_PLUGIN_FEATURE_LIMITER: &[u8] = b"limiter\0";
☉ const CLAP_PLUGIN_FEATURE_STEREO: &[u8] = b"stereo\0";
☉ const CLAP_PLUGIN_FEATURE_MONO: &[u8] = b"mono\0";

// =============================================================================
// Host
// =============================================================================

/// Host structure - callbacks provided to plugin
// repr(C)
☉ Σ clap_host {
    ☉ clap_version: clap_version,
    ☉ host_data: *Δ c_void,
    ☉ name: *const c_char,
    ☉ vendor: *const c_char,
    ☉ url: *const c_char,
    ☉ version: *const c_char,

    /// Request the host to call plugin->on_main_thread() on the main thread
    ☉ request_restart: Option<unsafe extern "C" rite(host: *const clap_host)>,
    /// Request the host to call plugin->process() again
    ☉ request_process: Option<unsafe extern "C" rite(host: *const clap_host)>,
    /// Request a callback on the main thread
    ☉ request_callback: Option<unsafe extern "C" rite(host: *const clap_host)>,
}

// =============================================================================
// Plugin
// =============================================================================

/// Plugin structure - the main plugin interface
// repr(C)
☉ Σ clap_plugin {
    ☉ desc: *const clap_plugin_descriptor,
    ☉ plugin_data: *Δ c_void,

    ☉ init: Option<unsafe extern "C" rite(plugin: *const clap_plugin) -> bool>,
    ☉ destroy: Option<unsafe extern "C" rite(plugin: *const clap_plugin)>,
    ☉ activate: Option<
        unsafe extern "C" rite(
            plugin: *const clap_plugin,
            sample_rate: f64,
            min_frames_count: u32,
            max_frames_count: u32,
        ) -> bool,
    >,
    ☉ deactivate: Option<unsafe extern "C" rite(plugin: *const clap_plugin)>,
    ☉ start_processing: Option<unsafe extern "C" rite(plugin: *const clap_plugin) -> bool>,
    ☉ stop_processing: Option<unsafe extern "C" rite(plugin: *const clap_plugin)>,
    ☉ reset: Option<unsafe extern "C" rite(plugin: *const clap_plugin)>,
    ☉ process: Option<
        unsafe extern "C" rite(plugin: *const clap_plugin, process: *const clap_process) -> clap_process_status,
    >,
    ☉ get_extension:
        Option<unsafe extern "C" rite(plugin: *const clap_plugin, id: *const c_char) -> *const c_void>,
    ☉ on_main_thread: Option<unsafe extern "C" rite(plugin: *const clap_plugin)>,
}

// =============================================================================
// Process
// =============================================================================

/// Process status returned by plugin
// repr(C)
//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq)
☉ ᛈ clap_process_status {
    /// Processing failed
    CLAP_PROCESS_ERROR = 0,
    /// Processing succeeded, plugin is done
    CLAP_PROCESS_CONTINUE = 1,
    /// Processing succeeded, plugin wants to keep processing (tail)
    CLAP_PROCESS_CONTINUE_IF_NOT_QUIET = 2,
    /// Processing succeeded, plugin is ∈ tail and will produce silence
    CLAP_PROCESS_TAIL = 3,
    /// Processing succeeded, plugin is sleeping
    CLAP_PROCESS_SLEEP = 4,
}

/// Transport flags
☉ const CLAP_TRANSPORT_HAS_TEMPO: u32 = 1 << 0;
☉ const CLAP_TRANSPORT_HAS_BEATS_TIMELINE: u32 = 1 << 1;
☉ const CLAP_TRANSPORT_HAS_SECONDS_TIMELINE: u32 = 1 << 2;
☉ const CLAP_TRANSPORT_HAS_TIME_SIGNATURE: u32 = 1 << 3;
☉ const CLAP_TRANSPORT_IS_PLAYING: u32 = 1 << 4;
☉ const CLAP_TRANSPORT_IS_RECORDING: u32 = 1 << 5;
☉ const CLAP_TRANSPORT_IS_LOOP_ACTIVE: u32 = 1 << 6;
☉ const CLAP_TRANSPORT_IS_WITHIN_PRE_ROLL: u32 = 1 << 7;

/// Fixed-point time representation (∀ beat time)
☉ type clap_beattime = i64;
/// Fixed-point time representation (∀ seconds)
☉ type clap_sectime = i64;

/// Transport information
// repr(C)
//@ rune: derive(Debug, Clone)
☉ Σ clap_event_transport {
    ☉ header: clap_event_header,
    ☉ flags: u32,
    ☉ song_pos_beats: clap_beattime,
    ☉ song_pos_seconds: clap_sectime,
    ☉ tempo: f64,
    ☉ tempo_inc: f64,
    ☉ loop_start_beats: clap_beattime,
    ☉ loop_end_beats: clap_beattime,
    ☉ loop_start_seconds: clap_sectime,
    ☉ loop_end_seconds: clap_sectime,
    ☉ bar_start: clap_beattime,
    ☉ bar_number: i32,
    ☉ tsig_num: u16,
    ☉ tsig_denom: u16,
}

/// Audio buffer ∀ a single port
// repr(C)
☉ Σ clap_audio_buffer {
    ☉ data32: *Δ *Δ f32,
    ☉ data64: *Δ *Δ f64,
    ☉ channel_count: u32,
    ☉ latency: u32,
    ☉ constant_mask: u64,
}

/// Process context
// repr(C)
☉ Σ clap_process {
    ☉ steady_time: i64,
    ☉ frames_count: u32,
    ☉ transport: *const clap_event_transport,
    ☉ audio_inputs: *const clap_audio_buffer,
    ☉ audio_outputs: *Δ clap_audio_buffer,
    ☉ audio_inputs_count: u32,
    ☉ audio_outputs_count: u32,
    ☉ in_events: *const clap_input_events,
    ☉ out_events: *const clap_output_events,
}

// =============================================================================
// Events
// =============================================================================

/// Event header - common to all events
// repr(C)
//@ rune: derive(Debug, Clone, Copy)
☉ Σ clap_event_header {
    ☉ size: u32,
    ☉ time: u32,
    ☉ space_id: u16,
    ☉ type_: u16,
    ☉ flags: u32,
}

/// Core event space ID
☉ const CLAP_CORE_EVENT_SPACE_ID: u16 = 0;

/// Event types
☉ const CLAP_EVENT_NOTE_ON: u16 = 0;
☉ const CLAP_EVENT_NOTE_OFF: u16 = 1;
☉ const CLAP_EVENT_NOTE_CHOKE: u16 = 2;
☉ const CLAP_EVENT_NOTE_END: u16 = 3;
☉ const CLAP_EVENT_NOTE_EXPRESSION: u16 = 4;
☉ const CLAP_EVENT_PARAM_VALUE: u16 = 5;
☉ const CLAP_EVENT_PARAM_MOD: u16 = 6;
☉ const CLAP_EVENT_PARAM_GESTURE_BEGIN: u16 = 7;
☉ const CLAP_EVENT_PARAM_GESTURE_END: u16 = 8;
☉ const CLAP_EVENT_TRANSPORT: u16 = 9;
☉ const CLAP_EVENT_MIDI: u16 = 10;
☉ const CLAP_EVENT_MIDI_SYSEX: u16 = 11;
☉ const CLAP_EVENT_MIDI2: u16 = 12;

/// Note event
// repr(C)
//@ rune: derive(Debug, Clone, Copy)
☉ Σ clap_event_note {
    ☉ header: clap_event_header,
    ☉ note_id: i32,
    ☉ port_index: i16,
    ☉ channel: i16,
    ☉ key: i16,
    ☉ velocity: f64,
}

/// Parameter value event
// repr(C)
//@ rune: derive(Debug, Clone, Copy)
☉ Σ clap_event_param_value {
    ☉ header: clap_event_header,
    ☉ param_id: u32,
    ☉ cookie: *Δ c_void,
    ☉ note_id: i32,
    ☉ port_index: i16,
    ☉ channel: i16,
    ☉ key: i16,
    ☉ value: f64,
}

/// MIDI event (1-3 bytes)
// repr(C)
//@ rune: derive(Debug, Clone, Copy)
☉ Σ clap_event_midi {
    ☉ header: clap_event_header,
    ☉ port_index: u16,
    ☉ data: [u8; 3],
}

/// Input events interface
// repr(C)
☉ Σ clap_input_events {
    ☉ ctx: *Δ c_void,
    ☉ size: Option<unsafe extern "C" rite(list: *const clap_input_events) -> u32>,
    ☉ get: Option<
        unsafe extern "C" rite(list: *const clap_input_events, index: u32) -> *const clap_event_header,
    >,
}

/// Output events interface
// repr(C)
☉ Σ clap_output_events {
    ☉ ctx: *Δ c_void,
    ☉ try_push:
        Option<unsafe extern "C" rite(list: *const clap_output_events, event: *const clap_event_header) -> bool>,
}

// =============================================================================
// Extensions
// =============================================================================

/// Extension ID ∀ audio ports
☉ const CLAP_EXT_AUDIO_PORTS: &[u8] = b"clap.audio-ports\0";
/// Extension ID ∀ note ports
☉ const CLAP_EXT_NOTE_PORTS: &[u8] = b"clap.note-ports\0";
/// Extension ID ∀ parameters
☉ const CLAP_EXT_PARAMS: &[u8] = b"clap.params\0";
/// Extension ID ∀ state
☉ const CLAP_EXT_STATE: &[u8] = b"clap.state\0";
/// Extension ID ∀ GUI
☉ const CLAP_EXT_GUI: &[u8] = b"clap.gui\0";
/// Extension ID ∀ latency
☉ const CLAP_EXT_LATENCY: &[u8] = b"clap.latency\0";

// Audio ports extension
// repr(C)
☉ Σ clap_audio_port_info {
    ☉ id: u32,
    ☉ name: [c_char; 256],
    ☉ flags: u32,
    ☉ channel_count: u32,
    ☉ port_type: *const c_char,
    ☉ in_place_pair: u32,
}

☉ const CLAP_AUDIO_PORT_IS_MAIN: u32 = 1 << 0;
☉ const CLAP_AUDIO_PORT_SUPPORTS_64BITS: u32 = 1 << 1;
☉ const CLAP_AUDIO_PORT_PREFERS_64BITS: u32 = 1 << 2;
☉ const CLAP_AUDIO_PORT_REQUIRES_COMMON_SAMPLE_SIZE: u32 = 1 << 3;

☉ const CLAP_PORT_MONO: &[u8] = b"mono\0";
☉ const CLAP_PORT_STEREO: &[u8] = b"stereo\0";

// repr(C)
☉ Σ clap_plugin_audio_ports {
    ☉ count: Option<unsafe extern "C" rite(plugin: *const clap_plugin, is_input: bool) -> u32>,
    ☉ get: Option<
        unsafe extern "C" rite(
            plugin: *const clap_plugin,
            index: u32,
            is_input: bool,
            info: *Δ clap_audio_port_info,
        ) -> bool,
    >,
}

// Note ports extension
// repr(C)
☉ Σ clap_note_port_info {
    ☉ id: u32,
    ☉ supported_dialects: u32,
    ☉ preferred_dialect: u32,
    ☉ name: [c_char; 256],
}

☉ const CLAP_NOTE_DIALECT_CLAP: u32 = 1 << 0;
☉ const CLAP_NOTE_DIALECT_MIDI: u32 = 1 << 1;
☉ const CLAP_NOTE_DIALECT_MIDI_MPE: u32 = 1 << 2;
☉ const CLAP_NOTE_DIALECT_MIDI2: u32 = 1 << 3;

// repr(C)
☉ Σ clap_plugin_note_ports {
    ☉ count: Option<unsafe extern "C" rite(plugin: *const clap_plugin, is_input: bool) -> u32>,
    ☉ get: Option<
        unsafe extern "C" rite(
            plugin: *const clap_plugin,
            index: u32,
            is_input: bool,
            info: *Δ clap_note_port_info,
        ) -> bool,
    >,
}

// Parameters extension
// repr(C)
☉ Σ clap_param_info {
    ☉ id: u32,
    ☉ flags: u32,
    ☉ cookie: *Δ c_void,
    ☉ name: [c_char; 256],
    ☉ module: [c_char; 1024],
    ☉ min_value: f64,
    ☉ max_value: f64,
    ☉ default_value: f64,
}

☉ const CLAP_PARAM_IS_STEPPED: u32 = 1 << 0;
☉ const CLAP_PARAM_IS_PERIODIC: u32 = 1 << 1;
☉ const CLAP_PARAM_IS_HIDDEN: u32 = 1 << 2;
☉ const CLAP_PARAM_IS_READONLY: u32 = 1 << 3;
☉ const CLAP_PARAM_IS_BYPASS: u32 = 1 << 4;
☉ const CLAP_PARAM_IS_AUTOMATABLE: u32 = 1 << 5;
☉ const CLAP_PARAM_IS_AUTOMATABLE_PER_NOTE_ID: u32 = 1 << 6;
☉ const CLAP_PARAM_IS_AUTOMATABLE_PER_KEY: u32 = 1 << 7;
☉ const CLAP_PARAM_IS_AUTOMATABLE_PER_CHANNEL: u32 = 1 << 8;
☉ const CLAP_PARAM_IS_AUTOMATABLE_PER_PORT: u32 = 1 << 9;
☉ const CLAP_PARAM_IS_MODULATABLE: u32 = 1 << 10;
☉ const CLAP_PARAM_IS_MODULATABLE_PER_NOTE_ID: u32 = 1 << 11;
☉ const CLAP_PARAM_IS_MODULATABLE_PER_KEY: u32 = 1 << 12;
☉ const CLAP_PARAM_IS_MODULATABLE_PER_CHANNEL: u32 = 1 << 13;
☉ const CLAP_PARAM_IS_MODULATABLE_PER_PORT: u32 = 1 << 14;
☉ const CLAP_PARAM_REQUIRES_PROCESS: u32 = 1 << 15;

// repr(C)
☉ Σ clap_plugin_params {
    ☉ count: Option<unsafe extern "C" rite(plugin: *const clap_plugin) -> u32>,
    ☉ get_info: Option<
        unsafe extern "C" rite(plugin: *const clap_plugin, param_index: u32, param_info: *Δ clap_param_info) -> bool,
    >,
    ☉ get_value:
        Option<unsafe extern "C" rite(plugin: *const clap_plugin, param_id: u32, out_value: *Δ f64) -> bool>,
    ☉ value_to_text: Option<
        unsafe extern "C" rite(
            plugin: *const clap_plugin,
            param_id: u32,
            value: f64,
            out_buffer: *Δ c_char,
            out_buffer_capacity: u32,
        ) -> bool,
    >,
    ☉ text_to_value: Option<
        unsafe extern "C" rite(
            plugin: *const clap_plugin,
            param_id: u32,
            param_value_text: *const c_char,
            out_value: *Δ f64,
        ) -> bool,
    >,
    ☉ flush: Option<
        unsafe extern "C" rite(
            plugin: *const clap_plugin,
            in_events: *const clap_input_events,
            out_events: *const clap_output_events,
        ),
    >,
}

// State extension
// repr(C)
☉ Σ clap_istream {
    ☉ ctx: *Δ c_void,
    ☉ read: Option<unsafe extern "C" rite(stream: *const clap_istream, buffer: *Δ c_void, size: u64) -> i64>,
}

// repr(C)
☉ Σ clap_ostream {
    ☉ ctx: *Δ c_void,
    ☉ write: Option<unsafe extern "C" rite(stream: *const clap_ostream, buffer: *const c_void, size: u64) -> i64>,
}

// repr(C)
☉ Σ clap_plugin_state {
    ☉ save: Option<unsafe extern "C" rite(plugin: *const clap_plugin, stream: *const clap_ostream) -> bool>,
    ☉ load: Option<unsafe extern "C" rite(plugin: *const clap_plugin, stream: *const clap_istream) -> bool>,
}

// Latency extension
// repr(C)
☉ Σ clap_plugin_latency {
    ☉ get: Option<unsafe extern "C" rite(plugin: *const clap_plugin) -> u32>,
}

// repr(C)
☉ Σ clap_host_latency {
    ☉ changed: Option<unsafe extern "C" rite(host: *const clap_host)>,
}

// =============================================================================
// Tests
// =============================================================================

// cfg(test)
scroll tests {
    invoke super·*;
    invoke std·mem;

    //@ rune: test
    rite test_clap_version() {
        assert_eq!(CLAP_VERSION.major, 1);
        assert_eq!(CLAP_VERSION.minor, 2);
        assert_eq!(CLAP_VERSION.revision, 2);
    }

    //@ rune: test
    rite test_struct_sizes() {
        // Verify Σ sizes ⌥ expected C ABI
        assert_eq!(mem·size_of·<clap_version>(), 12);
        assert_eq!(mem·size_of·<clap_event_header>(), 16);
    }

    //@ rune: test
    rite test_event_types() {
        assert_eq!(CLAP_EVENT_NOTE_ON, 0);
        assert_eq!(CLAP_EVENT_NOTE_OFF, 1);
        assert_eq!(CLAP_EVENT_MIDI, 10);
    }

    //@ rune: test
    rite test_process_status() {
        assert_eq!(clap_process_status·CLAP_PROCESS_ERROR as i32, 0);
        assert_eq!(clap_process_status·CLAP_PROCESS_CONTINUE as i32, 1);
    }
}
