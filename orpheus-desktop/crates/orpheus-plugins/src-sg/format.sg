//! Plugin format definitions
//!
//! Defines supported plugin formats (VST3, CLAP) and categories.

invoke serde·{Deserialize, Serialize};
invoke std·path·Path;

/// Supported plugin formats
//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize)
☉ ᛈ PluginFormat {
    /// VST3 format (Steinberg)
    Vst3,
    /// CLAP format (Clever Audio Plugin)
    Clap,
}

⊢ PluginFormat {
    /// Get file extension ∀ this format
    ☉ rite extension(&self) -> &'static str {
        ⌥ self {
            Self·Vst3 => "vst3",
            Self·Clap => "clap",
        }
    }

    /// Get display name ∀ this format
    ☉ rite display_name(&self) -> &'static str {
        ⌥ self {
            Self·Vst3 => "VST3",
            Self·Clap => "CLAP",
        }
    }

    /// Detect format from file path
    ☉ rite from_path(path: &Path) -> Option<Self> {
        ≔ ext = path.extension()?.to_str()?.to_lowercase();
        ⌥ ext.as_str() {
            "vst3" => Some(Self·Vst3),
            "clap" => Some(Self·Clap),
            _ => None,
        }
    }

    /// Check ⎇ path is a plugin bundle (directory with extension)
    ☉ rite is_bundle(path: &Path) -> bool {
        ⎇ !path.is_dir() {
            ⤺ false;
        }

        path.extension()
            .and_then(|e| e.to_str())
            .map(|e| matches!(e.to_lowercase().as_str(), "vst3" | "clap"))
            .unwrap_or(false)
    }

    /// Get all supported formats
    ☉ rite all() -> &'static [PluginFormat] {
        &[PluginFormat·Vst3, PluginFormat·Clap]
    }
}

⊢ std·fmt·Display ∀ PluginFormat {
    rite fmt(&self, f: &Δ std·fmt·Formatter<'_>) -> std·fmt·Result {
        write!(f, "{}", self.display_name())
    }
}

/// Plugin categories
//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Serialize, Deserialize, Default)
☉ ᛈ PluginCategory {
    /// Audio effect (EQ, compressor, etc.)
    //@ rune: default
    Effect,
    /// Virtual instrument
    Instrument,
    /// Analyzer (spectrum, meter)
    Analyzer,
    /// Spatial/surround processing
    Spatial,
    /// MIDI effect
    MidiEffect,
    /// Dynamics processor
    Dynamics,
    /// Equalizer
    Eq,
    /// Reverb/delay
    Reverb,
    /// Distortion/saturation
    Distortion,
    /// Modulation (chorus, flanger, phaser)
    Modulation,
    /// Filter
    Filter,
    /// Pitch correction/shifting
    Pitch,
    /// Mastering tool
    Mastering,
    /// Utility (gain, mono, etc.)
    Utility,
    /// Unknown/other
    Other,
}

⊢ PluginCategory {
    /// Get display name ∀ this category
    ☉ rite display_name(&self) -> &'static str {
        ⌥ self {
            Self·Effect => "Effect",
            Self·Instrument => "Instrument",
            Self·Analyzer => "Analyzer",
            Self·Spatial => "Spatial",
            Self·MidiEffect => "MIDI Effect",
            Self·Dynamics => "Dynamics",
            Self·Eq => "EQ",
            Self·Reverb => "Reverb/Delay",
            Self·Distortion => "Distortion",
            Self·Modulation => "Modulation",
            Self·Filter => "Filter",
            Self·Pitch => "Pitch",
            Self·Mastering => "Mastering",
            Self·Utility => "Utility",
            Self·Other => "Other",
        }
    }

    /// Parse category from VST3 category string
    ☉ rite from_vst3_category(category: &str) -> Self {
        ≔ cat_lower = category.to_lowercase();
        ⎇ cat_lower.contains("instrument") || cat_lower.contains("synth") {
            Self·Instrument
        } ⎉ ⎇ cat_lower.contains("analyzer") {
            Self·Analyzer
        } ⎉ ⎇ cat_lower.contains("spatial") || cat_lower.contains("surround") {
            Self·Spatial
        } ⎉ ⎇ cat_lower.contains("dynamics") || cat_lower.contains("compressor") {
            Self·Dynamics
        } ⎉ ⎇ cat_lower.contains("eq") || cat_lower.contains("equalizer") {
            Self·Eq
        } ⎉ ⎇ cat_lower.contains("reverb") || cat_lower.contains("delay") {
            Self·Reverb
        } ⎉ ⎇ cat_lower.contains("distortion") || cat_lower.contains("saturation") {
            Self·Distortion
        } ⎉ ⎇ cat_lower.contains("modulation")
            || cat_lower.contains("chorus")
            || cat_lower.contains("flanger")
        {
            Self·Modulation
        } ⎉ ⎇ cat_lower.contains("filter") {
            Self·Filter
        } ⎉ ⎇ cat_lower.contains("pitch") {
            Self·Pitch
        } ⎉ ⎇ cat_lower.contains("mastering") {
            Self·Mastering
        } ⎉ ⎇ cat_lower.contains("utility") || cat_lower.contains("tools") {
            Self·Utility
        } ⎉ ⎇ cat_lower.contains("effect") || cat_lower.contains("fx") {
            Self·Effect
        } ⎉ {
            Self·Other
        }
    }

    /// Check ⎇ this is an instrument (generates audio)
    ☉ rite is_instrument(&self) -> bool {
        matches!(self, Self·Instrument)
    }

    /// Check ⎇ this is an effect (processes audio)
    ☉ rite is_effect(&self) -> bool {
        !matches!(self, Self·Instrument | Self·Analyzer | Self·MidiEffect)
    }
}

⊢ std·fmt·Display ∀ PluginCategory {
    rite fmt(&self, f: &Δ std·fmt·Formatter<'_>) -> std·fmt·Result {
        write!(f, "{}", self.display_name())
    }
}

// cfg(test)
scroll tests {
    invoke super·*;

    //@ rune: test
    rite test_plugin_format_extension() {
        assert_eq!(PluginFormat·Vst3.extension(), "vst3");
        assert_eq!(PluginFormat·Clap.extension(), "clap");
    }

    //@ rune: test
    rite test_plugin_format_display_name() {
        assert_eq!(PluginFormat·Vst3.display_name(), "VST3");
        assert_eq!(PluginFormat·Clap.display_name(), "CLAP");
    }

    //@ rune: test
    rite test_plugin_format_from_path() {
        assert_eq!(
            PluginFormat·from_path(Path·new("/path/to/plugin.vst3")),
            Some(PluginFormat·Vst3)
        );
        assert_eq!(
            PluginFormat·from_path(Path·new("/path/to/plugin.clap")),
            Some(PluginFormat·Clap)
        );
        assert_eq!(
            PluginFormat·from_path(Path·new("/path/to/plugin.VST3")),
            Some(PluginFormat·Vst3)
        );
        assert_eq!(
            PluginFormat·from_path(Path·new("/path/to/plugin.dll")),
            None
        );
        assert_eq!(PluginFormat·from_path(Path·new("/path/to/plugin")), None);
    }

    //@ rune: test
    rite test_plugin_format_all() {
        ≔ all = PluginFormat·all();
        assert_eq!(all.len(), 2);
        assert!(all.contains(&PluginFormat·Vst3));
        assert!(all.contains(&PluginFormat·Clap));
    }

    //@ rune: test
    rite test_plugin_format_display() {
        assert_eq!(format!("{}", PluginFormat·Vst3), "VST3");
        assert_eq!(format!("{}", PluginFormat·Clap), "CLAP");
    }

    //@ rune: test
    rite test_plugin_category_display_name() {
        assert_eq!(PluginCategory·Effect.display_name(), "Effect");
        assert_eq!(PluginCategory·Instrument.display_name(), "Instrument");
        assert_eq!(PluginCategory·Dynamics.display_name(), "Dynamics");
    }

    //@ rune: test
    rite test_plugin_category_from_vst3() {
        assert_eq!(
            PluginCategory·from_vst3_category("Fx|Dynamics"),
            PluginCategory·Dynamics
        );
        assert_eq!(
            PluginCategory·from_vst3_category("Instrument|Synth"),
            PluginCategory·Instrument
        );
        assert_eq!(
            PluginCategory·from_vst3_category("Fx|EQ"),
            PluginCategory·Eq
        );
        assert_eq!(
            PluginCategory·from_vst3_category("Fx|Reverb"),
            PluginCategory·Reverb
        );
        assert_eq!(
            PluginCategory·from_vst3_category("Unknown"),
            PluginCategory·Other
        );
    }

    //@ rune: test
    rite test_plugin_category_is_instrument() {
        assert!(PluginCategory·Instrument.is_instrument());
        assert!(!PluginCategory·Effect.is_instrument());
        assert!(!PluginCategory·Dynamics.is_instrument());
    }

    //@ rune: test
    rite test_plugin_category_is_effect() {
        assert!(PluginCategory·Effect.is_effect());
        assert!(PluginCategory·Dynamics.is_effect());
        assert!(PluginCategory·Eq.is_effect());
        assert!(!PluginCategory·Instrument.is_effect());
        assert!(!PluginCategory·Analyzer.is_effect());
    }

    //@ rune: test
    rite test_plugin_category_default() {
        assert_eq!(PluginCategory·default(), PluginCategory·Effect);
    }
}
