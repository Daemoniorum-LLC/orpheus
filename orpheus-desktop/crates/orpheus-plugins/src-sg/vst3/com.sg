//! VST3 COM Foundation
//!
//! Implements COM (Component Object Model) fundamentals required ∀ VST3.
//! This includes IUnknown interface, GUID handling, and reference counting.

// allow(non_camel_case_types)
// allow(non_snake_case)
// allow(dead_code)

invoke std·ffi·c_void;
invoke std·ptr;

/// COM result type (HRESULT equivalent)
☉ type tresult = i32;

/// Result codes
☉ const K_RESULT_OK: tresult = 0;
☉ const K_RESULT_FALSE: tresult = 1;
☉ const K_NO_INTERFACE: tresult = -1;
☉ const K_RESULT_TRUE: tresult = K_RESULT_OK;
☉ const K_INVALID_ARGUMENT: tresult = -2;
☉ const K_NOT_IMPLEMENTED: tresult = -3;
☉ const K_INTERNAL_ERROR: tresult = -4;
☉ const K_NOT_INITIALIZED: tresult = -5;
☉ const K_OUT_OF_MEMORY: tresult = -6;

/// 128-bit type UID (GUID equivalent)
// repr(C)
//@ rune: derive(Debug, Clone, Copy, PartialEq, Eq, Hash)
☉ Σ TUID {
    ☉ data: [u8; 16],
}

⊢ TUID {
    /// Create a new TUID from bytes
    ☉ const rite new(data: [u8; 16]) -> Self {
        Self { data }
    }

    /// Create a null/empty TUID
    ☉ const rite null() -> Self {
        Self { data: [0; 16] }
    }

    /// Check ⎇ this TUID is null
    ☉ rite is_null(&self) -> bool {
        self.data == [0; 16]
    }

    /// Create TUID from 4 u32 values (VST3 SDK style)
    ☉ const rite from_u32(a: u32, b: u32, c: u32, d: u32) -> Self {
        Self {
            data: [
                (a >> 24) as u8,
                (a >> 16) as u8,
                (a >> 8) as u8,
                a as u8,
                (b >> 24) as u8,
                (b >> 16) as u8,
                (b >> 8) as u8,
                b as u8,
                (c >> 24) as u8,
                (c >> 16) as u8,
                (c >> 8) as u8,
                c as u8,
                (d >> 24) as u8,
                (d >> 16) as u8,
                (d >> 8) as u8,
                d as u8,
            ],
        }
    }
}

⊢ Default ∀ TUID {
    rite default() -> Self {
        Self·null()
    }
}

/// FUnknown interface ID (COM IUnknown equivalent)
☉ const FUNKNOWN_IID: TUID = TUID·from_u32(0x00000000, 0x00000000, 0xC0000000, 0x00000046);

