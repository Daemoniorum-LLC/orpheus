# Maestro AI - Environment Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maestro
DB_USER=postgres
DB_PASSWORD=postgres

# =============================================================================
# Cache Configuration (Redis)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379

# =============================================================================
# Object Storage Configuration (MinIO / S3)
# =============================================================================
S3_BUCKET=maestro-audio
S3_ENDPOINT=http://localhost:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# =============================================================================
# Audio Service Configuration (Rust gRPC)
# =============================================================================
AUDIO_SERVICE_HOST=localhost
AUDIO_SERVICE_PORT=50051
RUST_LOG=info

# =============================================================================
# Backend API Configuration (Spring Boot)
# =============================================================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT Configuration (for production, change these!)
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRATION=86400000

# =============================================================================
# Frontend Configuration (Vite + React)
# =============================================================================
VITE_API_URL=http://localhost:8080
VITE_AUDIO_SERVICE_URL=http://localhost:50051
VITE_WS_URL=ws://localhost:8080/ws

# =============================================================================
# Development Settings
# =============================================================================
# Set to 'true' to enable development mode features
DEV_MODE=true

# Enable detailed logging
DEBUG=false

# =============================================================================
# Production Settings (uncomment for production deployment)
# =============================================================================
# SPRING_PROFILES_ACTIVE=prod
# SERVER_PORT=443
# JWT_SECRET=<generate-strong-secret-here>
# VITE_API_URL=https://your-domain.com
# S3_ENDPOINT=https://s3.amazonaws.com
# AWS_ACCESS_KEY_ID=<your-aws-key>
# AWS_SECRET_ACCESS_KEY=<your-aws-secret>
