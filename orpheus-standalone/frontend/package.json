{
  "name": "orpheus-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Orpheus - Unified Music Production Suite Workspace",
  "author": {
    "name": "Lilith Crook",
    "email": "lilith@daemoniorum.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paraphilic-ecchymosis/persona-framework.git",
    "directory": "orpheus"
  },
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:all": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace=@orpheus/app-web",
    "clean": "find packages -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "test": "vitest",
    "test:unit": "vitest --run src/**/*.test.{ts,tsx}",
    "test:integration": "vitest --run src/integration/**/*.integration.test.{ts,tsx}",
    "test:integration:ui": "vitest --ui src/integration/**/*.integration.test.{ts,tsx}",
    "test:integration:coverage": "vitest --coverage src/integration/**/*.integration.test.{ts,tsx}",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:all": "vitest --run"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "vitest": "^1.0.4",
    "@vitest/ui": "^1.0.4",
    "@testing-library/react": "^14.1.2",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/user-event": "^14.5.1",
    "@vitest/coverage-v8": "^1.0.4",
    "jsdom": "^23.0.1",
    "happy-dom": "^12.10.3"
  }
}
