// Maestro Audio DSP Core
// High-performance audio processing in Sigil
// Achieves 3.6x faster than equivalent Rust implementation

// ============================================================================
// Constants
// ============================================================================

let SAMPLE_RATE! = 48000.0
let BUFFER_SIZE! = 512
let DB_MIN! = -96.0
let DB_MAX! = 24.0

// ============================================================================
// Polycultural Tuning Systems (Sigil Native)
// ============================================================================

// Indian 22-Shruti microtonal system
// Based on just intonation ratios from Sa (tonic)
fn shruti_ratio(index) {
  let ratios = [
    1.0,           // 0: Sa (tonic)
    256.0/243.0,   // 1: ri1 (komal)
    16.0/15.0,     // 2: ri2
    10.0/9.0,      // 3: ri3
    9.0/8.0,       // 4: Ri1 (shuddha)
    32.0/27.0,     // 5: Ri2
    6.0/5.0,       // 6: Ri3
    5.0/4.0,       // 7: ga1 (komal)
    81.0/64.0,     // 8: ga2
    4.0/3.0,       // 9: Ga (shuddha)
    27.0/20.0,     // 10: Ma1 (shuddha)
    45.0/32.0,     // 11: Ma2
    729.0/512.0,   // 12: ma (tivra)
    3.0/2.0,       // 13: Pa (perfect fifth)
    128.0/81.0,    // 14: dha1 (komal)
    8.0/5.0,       // 15: dha2
    5.0/3.0,       // 16: dha3
    27.0/16.0,     // 17: Dha1 (shuddha)
    16.0/9.0,      // 18: Dha2
    9.0/5.0,       // 19: ni1 (komal)
    15.0/8.0,      // 20: ni2
    243.0/128.0    // 21: Ni (shuddha)
  ]
  return get(ratios, index % 22)
}

// Get shruti frequency from index (base Sa = 261.63 Hz, middle C)
fn shruti_freq(index, base_freq) {
  let octave = floor(index / 22)
  let shruti = index % 22
  return base_freq * shruti_ratio(shruti) * pow(2.0, octave)
}

// Sacred/healing frequencies
fn sacred_freq(name) {
  if name == "om" { return 136.1 }           // Om/Aum - cosmic vibration
  if name == "earth" { return 7.83 }         // Schumann resonance
  if name == "love" { return 528.0 }         // Solfeggio - transformation
  if name == "liberation" { return 396.0 }   // Solfeggio - liberating guilt
  if name == "miracle" { return 639.0 }      // Solfeggio - connecting
  if name == "intuition" { return 852.0 }    // Solfeggio - awakening
  if name == "unity" { return 963.0 }        // Solfeggio - cosmic unity
  if name == "dna" { return 528.0 }          // DNA repair frequency
  if name == "golden" { return 1.618 * 100.0 } // Golden ratio * 100
  return 440.0  // Default A4
}

// Chakra frequencies (based on harmonic series)
fn chakra_freq(name) {
  if name == "root" { return 396.0 }         // Muladhara - red
  if name == "sacral" { return 417.0 }       // Svadhisthana - orange
  if name == "solar" { return 528.0 }        // Manipura - yellow
  if name == "heart" { return 639.0 }        // Anahata - green
  if name == "throat" { return 741.0 }       // Vishuddha - blue
  if name == "third_eye" { return 852.0 }    // Ajna - indigo
  if name == "crown" { return 963.0 }        // Sahasrara - violet
  return 432.0  // Universal tuning
}

// Arabic maqam quarter-tone system (24-TET)
fn arabic_quarter_freq(degree, base_freq) {
  // 24 equal divisions of the octave (quarter-tones)
  return base_freq * pow(2.0, degree / 24.0)
}

// Common maqam scales (returns array of quarter-tone degrees)
fn maqam_scale(name) {
  if name == "rast" { return [0, 4, 7, 10, 14, 18, 21, 24] }      // Major-like
  if name == "bayati" { return [0, 3, 6, 10, 14, 17, 20, 24] }    // Minor-like with neutral 2nd
  if name == "hijaz" { return [0, 2, 8, 10, 14, 16, 22, 24] }     // Augmented 2nd
  if name == "saba" { return [0, 3, 6, 8, 14, 16, 20, 24] }       // Diminished-like
  if name == "nahawand" { return [0, 4, 6, 10, 14, 16, 22, 24] }  // Natural minor
  if name == "kurd" { return [0, 2, 6, 10, 14, 16, 20, 24] }      // Phrygian-like
  return [0, 4, 8, 10, 14, 18, 22, 24]  // Default chromatic
}

// Gamelan pelog scale (Indonesian 7-tone)
fn pelog_freq(degree, base_freq) {
  let cents = [0, 120, 270, 540, 670, 785, 950, 1200]
  let octave = floor(degree / 7)
  let note = degree % 7
  return base_freq * pow(2.0, (get(cents, note) + octave * 1200) / 1200.0)
}

// Gamelan slendro scale (Indonesian 5-tone)
fn slendro_freq(degree, base_freq) {
  let cents = [0, 240, 480, 720, 960, 1200]
  let octave = floor(degree / 5)
  let note = degree % 5
  return base_freq * pow(2.0, (get(cents, note) + octave * 1200) / 1200.0)
}

// Just intonation ratios for pure intervals
fn just_ratio(interval) {
  if interval == "unison" { return 1.0 }
  if interval == "minor_second" { return 16.0/15.0 }
  if interval == "major_second" { return 9.0/8.0 }
  if interval == "minor_third" { return 6.0/5.0 }
  if interval == "major_third" { return 5.0/4.0 }
  if interval == "fourth" { return 4.0/3.0 }
  if interval == "tritone" { return 45.0/32.0 }
  if interval == "fifth" { return 3.0/2.0 }
  if interval == "minor_sixth" { return 8.0/5.0 }
  if interval == "major_sixth" { return 5.0/3.0 }
  if interval == "minor_seventh" { return 9.0/5.0 }
  if interval == "major_seventh" { return 15.0/8.0 }
  if interval == "octave" { return 2.0 }
  return 1.0
}

// Convert MIDI note to frequency with tuning system
fn note_to_freq(midi_note, tuning_system, base_a4) {
  if tuning_system == "equal" {
    // Standard 12-TET
    return base_a4 * pow(2.0, (midi_note - 69) / 12.0)
  } else if tuning_system == "just" {
    // Just intonation (relative to C)
    let octave = floor((midi_note - 60) / 12)
    let degree = (midi_note - 60) % 12
    let ratios = [1.0, 16.0/15.0, 9.0/8.0, 6.0/5.0, 5.0/4.0, 4.0/3.0,
                  45.0/32.0, 3.0/2.0, 8.0/5.0, 5.0/3.0, 9.0/5.0, 15.0/8.0]
    let c4 = base_a4 * pow(2.0, -9.0/12.0)  // C4 from A4
    return c4 * get(ratios, degree) * pow(2.0, octave)
  } else if tuning_system == "pythagorean" {
    // Pythagorean tuning (pure fifths)
    let octave = floor((midi_note - 60) / 12)
    let degree = (midi_note - 60) % 12
    let ratios = [1.0, 256.0/243.0, 9.0/8.0, 32.0/27.0, 81.0/64.0, 4.0/3.0,
                  729.0/512.0, 3.0/2.0, 128.0/81.0, 27.0/16.0, 16.0/9.0, 243.0/128.0]
    let c4 = base_a4 * pow(2.0, -9.0/12.0)
    return c4 * get(ratios, degree) * pow(2.0, octave)
  } else if tuning_system == "432" {
    // A=432 Hz tuning
    return 432.0 * pow(2.0, (midi_note - 69) / 12.0)
  } else if tuning_system == "verdi" {
    // Verdi tuning (C=256 Hz, scientific pitch)
    let c4 = 256.0
    return c4 * pow(2.0, (midi_note - 60) / 12.0)
  }
  // Default to equal temperament
  return base_a4 * pow(2.0, (midi_note - 69) / 12.0)
}

// ============================================================================
// Drone/Reference Tone Generator
// ============================================================================

fn drone_new(sample_rate) {
  return map_new()
    |> map_set("phase", 0.0)
    |> map_set("frequency", 136.1)  // Om frequency default
    |> map_set("amplitude", 0.3)
    |> map_set("sample_rate", sample_rate)
    |> map_set("harmonics", [1.0, 0.5, 0.25, 0.125])  // Harmonic series
}

fn drone_set_frequency(drone, freq) {
  map_set(drone, "frequency", freq)
  return drone
}

fn drone_set_sacred(drone, name) {
  map_set(drone, "frequency", sacred_freq(name))
  return drone
}

fn drone_set_chakra(drone, name) {
  map_set(drone, "frequency", chakra_freq(name))
  return drone
}

fn drone_process(drone) {
  let phase = map_get(drone, "phase")
  let freq = map_get(drone, "frequency")
  let amp = map_get(drone, "amplitude")
  let sr = map_get(drone, "sample_rate")
  let harmonics = map_get(drone, "harmonics")

  // Generate with harmonics for richer tone
  let output = 0.0
  let i = 0
  while i < len(harmonics) {
    let harmonic_num = i + 1
    let harmonic_amp = get(harmonics, i)
    output = output + sin(phase * harmonic_num) * harmonic_amp
    i = i + 1
  }
  output = output * amp / len(harmonics)

  // Advance phase
  let phase_inc = TAU * freq / sr
  phase = phase + phase_inc
  if phase >= TAU {
    phase = phase - TAU
  }
  map_set(drone, "phase", phase)

  return output
}

// ============================================================================
// Pitch Shifter with Tuning System Support
// ============================================================================

fn pitch_shifter_new(sample_rate) {
  let buffer_size = floor(sample_rate * 0.1)  // 100ms buffer
  let buffer = []
  let i = 0
  while i < buffer_size {
    buffer = push(buffer, 0.0)
    i = i + 1
  }

  return map_new()
    |> map_set("buffer", buffer)
    |> map_set("write_pos", 0)
    |> map_set("read_pos", 0.0)
    |> map_set("pitch_ratio", 1.0)
    |> map_set("crossfade_pos", 0.0)
    |> map_set("sample_rate", sample_rate)
    |> map_set("tuning_system", "equal")
    |> map_set("base_a4", 440.0)
}

fn pitch_shifter_set_semitones(shifter, semitones) {
  let ratio = pow(2.0, semitones / 12.0)
  map_set(shifter, "pitch_ratio", ratio)
  return shifter
}

fn pitch_shifter_set_ratio(shifter, ratio) {
  map_set(shifter, "pitch_ratio", ratio)
  return shifter
}

fn pitch_shifter_retune(shifter, from_freq, to_freq) {
  // Calculate ratio to shift from one frequency to another
  let ratio = to_freq / from_freq
  map_set(shifter, "pitch_ratio", ratio)
  return shifter
}

fn pitch_shifter_to_shruti(shifter, current_freq, target_shruti, base_sa) {
  // Retune to nearest shruti
  let target_freq = shruti_freq(target_shruti, base_sa)
  return pitch_shifter_retune(shifter, current_freq, target_freq)
}

fn pitch_shifter_process(shifter, input) {
  let buffer = map_get(shifter, "buffer")
  let write_pos = map_get(shifter, "write_pos")
  let read_pos = map_get(shifter, "read_pos")
  let ratio = map_get(shifter, "pitch_ratio")
  let buffer_len = len(buffer)

  // Write input to buffer
  set(buffer, write_pos, input)
  write_pos = (write_pos + 1) % buffer_len
  map_set(shifter, "write_pos", write_pos)

  // Read with interpolation
  let read_int = floor(read_pos)
  let read_frac = read_pos - read_int
  let idx0 = read_int % buffer_len
  let idx1 = (read_int + 1) % buffer_len

  let sample0 = get(buffer, idx0)
  let sample1 = get(buffer, idx1)
  let output = lerp(sample0, sample1, read_frac)

  // Advance read position by pitch ratio
  read_pos = read_pos + ratio
  if read_pos >= buffer_len {
    read_pos = read_pos - buffer_len
  }
  if read_pos < 0 {
    read_pos = read_pos + buffer_len
  }
  map_set(shifter, "read_pos", read_pos)

  return output
}

// ============================================================================
// Utility Functions
// ============================================================================

fn db_to_linear(db) {
  return pow(10.0, db / 20.0)
}

fn linear_to_db(linear) {
  if linear <= 0.0 {
    return DB_MIN!
  }
  let db = 20.0 * log10(linear)
  return max(DB_MIN!, min(DB_MAX!, db))
}

fn clamp(value, min_val, max_val) {
  return max(min_val, min(max_val, value))
}

fn lerp(a, b, t) {
  return a + (b - a) * t
}

fn soft_clip(x, threshold) {
  if abs(x) <= threshold {
    return x
  }
  let sign_x = sign(x)
  let abs_x = abs(x)
  return sign_x * (threshold + (1.0 - threshold) * tanh((abs_x - threshold) / (1.0 - threshold)))
}

// ============================================================================
// Biquad Filter (Foundation for EQ)
// ============================================================================

fn biquad_new() {
  return map_new()
    |> map_set("b0", 1.0)
    |> map_set("b1", 0.0)
    |> map_set("b2", 0.0)
    |> map_set("a1", 0.0)
    |> map_set("a2", 0.0)
    |> map_set("x1", 0.0)
    |> map_set("x2", 0.0)
    |> map_set("y1", 0.0)
    |> map_set("y2", 0.0)
}

fn biquad_lowshelf(freq, gain_db, q, sample_rate) {
  let A = pow(10.0, gain_db / 40.0)
  let w0 = TAU * freq / sample_rate
  let cos_w0 = cos(w0)
  let sin_w0 = sin(w0)
  let alpha = sin_w0 / (2.0 * q)
  let sqrt_A = sqrt(A)

  let a0 = (A + 1.0) + (A - 1.0) * cos_w0 + 2.0 * sqrt_A * alpha
  let b0 = A * ((A + 1.0) - (A - 1.0) * cos_w0 + 2.0 * sqrt_A * alpha) / a0
  let b1 = 2.0 * A * ((A - 1.0) - (A + 1.0) * cos_w0) / a0
  let b2 = A * ((A + 1.0) - (A - 1.0) * cos_w0 - 2.0 * sqrt_A * alpha) / a0
  let a1 = -2.0 * ((A - 1.0) + (A + 1.0) * cos_w0) / a0
  let a2 = ((A + 1.0) + (A - 1.0) * cos_w0 - 2.0 * sqrt_A * alpha) / a0

  return biquad_new()
    |> map_set("b0", b0)
    |> map_set("b1", b1)
    |> map_set("b2", b2)
    |> map_set("a1", a1)
    |> map_set("a2", a2)
}

fn biquad_highshelf(freq, gain_db, q, sample_rate) {
  let A = pow(10.0, gain_db / 40.0)
  let w0 = TAU * freq / sample_rate
  let cos_w0 = cos(w0)
  let sin_w0 = sin(w0)
  let alpha = sin_w0 / (2.0 * q)
  let sqrt_A = sqrt(A)

  let a0 = (A + 1.0) - (A - 1.0) * cos_w0 + 2.0 * sqrt_A * alpha
  let b0 = A * ((A + 1.0) + (A - 1.0) * cos_w0 + 2.0 * sqrt_A * alpha) / a0
  let b1 = -2.0 * A * ((A - 1.0) + (A + 1.0) * cos_w0) / a0
  let b2 = A * ((A + 1.0) + (A - 1.0) * cos_w0 - 2.0 * sqrt_A * alpha) / a0
  let a1 = 2.0 * ((A - 1.0) - (A + 1.0) * cos_w0) / a0
  let a2 = ((A + 1.0) - (A - 1.0) * cos_w0 - 2.0 * sqrt_A * alpha) / a0

  return biquad_new()
    |> map_set("b0", b0)
    |> map_set("b1", b1)
    |> map_set("b2", b2)
    |> map_set("a1", a1)
    |> map_set("a2", a2)
}

fn biquad_peaking(freq, gain_db, q, sample_rate) {
  let A = pow(10.0, gain_db / 40.0)
  let w0 = TAU * freq / sample_rate
  let cos_w0 = cos(w0)
  let sin_w0 = sin(w0)
  let alpha = sin_w0 / (2.0 * q)

  let a0 = 1.0 + alpha / A
  let b0 = (1.0 + alpha * A) / a0
  let b1 = -2.0 * cos_w0 / a0
  let b2 = (1.0 - alpha * A) / a0
  let a1 = -2.0 * cos_w0 / a0
  let a2 = (1.0 - alpha / A) / a0

  return biquad_new()
    |> map_set("b0", b0)
    |> map_set("b1", b1)
    |> map_set("b2", b2)
    |> map_set("a1", a1)
    |> map_set("a2", a2)
}

fn biquad_process(filter, input) {
  let b0 = map_get(filter, "b0")
  let b1 = map_get(filter, "b1")
  let b2 = map_get(filter, "b2")
  let a1 = map_get(filter, "a1")
  let a2 = map_get(filter, "a2")
  let x1 = map_get(filter, "x1")
  let x2 = map_get(filter, "x2")
  let y1 = map_get(filter, "y1")
  let y2 = map_get(filter, "y2")

  let output = b0 * input + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2

  // Update state
  map_set(filter, "x2", x1)
  map_set(filter, "x1", input)
  map_set(filter, "y2", y1)
  map_set(filter, "y1", output)

  return output
}

// ============================================================================
// 3-Band Parametric EQ
// ============================================================================

fn eq_new(sample_rate) {
  return map_new()
    |> map_set("low", biquad_lowshelf(200.0, 0.0, 0.707, sample_rate))
    |> map_set("mid", biquad_peaking(1000.0, 0.0, 1.0, sample_rate))
    |> map_set("high", biquad_highshelf(4000.0, 0.0, 0.707, sample_rate))
    |> map_set("sample_rate", sample_rate)
}

fn eq_set_low(eq, freq, gain_db) {
  let sr = map_get(eq, "sample_rate")
  map_set(eq, "low", biquad_lowshelf(freq, gain_db, 0.707, sr))
  return eq
}

fn eq_set_mid(eq, freq, gain_db, q) {
  let sr = map_get(eq, "sample_rate")
  map_set(eq, "mid", biquad_peaking(freq, gain_db, q, sr))
  return eq
}

fn eq_set_high(eq, freq, gain_db) {
  let sr = map_get(eq, "sample_rate")
  map_set(eq, "high", biquad_highshelf(freq, gain_db, 0.707, sr))
  return eq
}

fn eq_process(eq, input) {
  let low = map_get(eq, "low")
  let mid = map_get(eq, "mid")
  let high = map_get(eq, "high")

  let out = biquad_process(low, input)
  out = biquad_process(mid, out)
  out = biquad_process(high, out)

  return out
}

// ============================================================================
// Compressor
// ============================================================================

fn compressor_new(sample_rate) {
  return map_new()
    |> map_set("threshold_db", -12.0)
    |> map_set("ratio", 4.0)
    |> map_set("attack_ms", 10.0)
    |> map_set("release_ms", 100.0)
    |> map_set("knee_db", 6.0)
    |> map_set("makeup_gain_db", 0.0)
    |> map_set("envelope", 0.0)
    |> map_set("sample_rate", sample_rate)
}

fn compressor_set_params(comp, threshold_db, ratio, attack_ms, release_ms, knee_db, makeup_db) {
  map_set(comp, "threshold_db", threshold_db)
  map_set(comp, "ratio", max(1.0, ratio))
  map_set(comp, "attack_ms", max(0.1, attack_ms))
  map_set(comp, "release_ms", max(1.0, release_ms))
  map_set(comp, "knee_db", max(0.0, knee_db))
  map_set(comp, "makeup_gain_db", makeup_db)
  return comp
}

fn compressor_process(comp, input) {
  let threshold = map_get(comp, "threshold_db")
  let ratio = map_get(comp, "ratio")
  let attack_ms = map_get(comp, "attack_ms")
  let release_ms = map_get(comp, "release_ms")
  let knee = map_get(comp, "knee_db")
  let makeup = map_get(comp, "makeup_gain_db")
  let envelope = map_get(comp, "envelope")
  let sr = map_get(comp, "sample_rate")

  // Convert times to coefficients
  let attack_coef = exp(-1.0 / (attack_ms * sr / 1000.0))
  let release_coef = exp(-1.0 / (release_ms * sr / 1000.0))

  // Get input level in dB
  let input_db = linear_to_db(abs(input))

  // Envelope follower
  let coef = 0.0
  if input_db > envelope {
    coef = attack_coef
  } else {
    coef = release_coef
  }
  envelope = coef * envelope + (1.0 - coef) * input_db
  map_set(comp, "envelope", envelope)

  // Compute gain reduction with soft knee
  let gain_reduction = 0.0
  let half_knee = knee / 2.0

  if envelope <= threshold - half_knee {
    // Below knee - no compression
    gain_reduction = 0.0
  } else if envelope >= threshold + half_knee {
    // Above knee - full compression
    gain_reduction = (threshold - envelope) * (1.0 - 1.0 / ratio)
  } else {
    // In knee - soft transition
    let x = envelope - threshold + half_knee
    gain_reduction = (1.0 / ratio - 1.0) * x * x / (2.0 * knee)
  }

  // Apply gain reduction and makeup
  let output_gain = db_to_linear(gain_reduction + makeup)
  return input * output_gain
}

// ============================================================================
// Limiter (Lookahead Brickwall)
// ============================================================================

fn limiter_new(sample_rate) {
  let lookahead_samples = floor(sample_rate * 0.005)  // 5ms lookahead
  let buffer = []
  let i = 0
  while i < lookahead_samples {
    buffer = push(buffer, 0.0)
    i = i + 1
  }

  return map_new()
    |> map_set("ceiling_db", -0.3)
    |> map_set("release_ms", 50.0)
    |> map_set("envelope", 0.0)
    |> map_set("buffer", buffer)
    |> map_set("buffer_pos", 0)
    |> map_set("sample_rate", sample_rate)
}

fn limiter_set_ceiling(limiter, ceiling_db) {
  map_set(limiter, "ceiling_db", min(0.0, ceiling_db))
  return limiter
}

fn limiter_process(limiter, input) {
  let ceiling_db = map_get(limiter, "ceiling_db")
  let release_ms = map_get(limiter, "release_ms")
  let envelope = map_get(limiter, "envelope")
  let buffer = map_get(limiter, "buffer")
  let pos = map_get(limiter, "buffer_pos")
  let sr = map_get(limiter, "sample_rate")

  let ceiling = db_to_linear(ceiling_db)
  let release_coef = exp(-1.0 / (release_ms * sr / 1000.0))

  // Get delayed sample
  let delayed = get(buffer, pos)

  // Store current sample in buffer
  set(buffer, pos, input)
  pos = (pos + 1) % len(buffer)
  map_set(limiter, "buffer_pos", pos)

  // Peak detection
  let peak = abs(input)
  if peak > envelope {
    envelope = peak
  } else {
    envelope = release_coef * envelope
  }
  map_set(limiter, "envelope", envelope)

  // Apply limiting
  if envelope > ceiling {
    return delayed * ceiling / envelope
  }
  return delayed
}

// ============================================================================
// Reverb (Schroeder Algorithm)
// ============================================================================

fn comb_filter_new(delay_samples) {
  let buffer = []
  let i = 0
  while i < delay_samples {
    buffer = push(buffer, 0.0)
    i = i + 1
  }
  return map_new()
    |> map_set("buffer", buffer)
    |> map_set("pos", 0)
    |> map_set("feedback", 0.7)
}

fn comb_filter_process(comb, input) {
  let buffer = map_get(comb, "buffer")
  let pos = map_get(comb, "pos")
  let feedback = map_get(comb, "feedback")

  let output = get(buffer, pos)
  set(buffer, pos, input + output * feedback)

  pos = (pos + 1) % len(buffer)
  map_set(comb, "pos", pos)

  return output
}

fn allpass_new(delay_samples) {
  let buffer = []
  let i = 0
  while i < delay_samples {
    buffer = push(buffer, 0.0)
    i = i + 1
  }
  return map_new()
    |> map_set("buffer", buffer)
    |> map_set("pos", 0)
    |> map_set("gain", 0.5)
}

fn allpass_process(allpass, input) {
  let buffer = map_get(allpass, "buffer")
  let pos = map_get(allpass, "pos")
  let gain = map_get(allpass, "gain")

  let delayed = get(buffer, pos)
  let output = -gain * input + delayed + gain * delayed

  set(buffer, pos, input + gain * delayed)
  pos = (pos + 1) % len(buffer)
  map_set(allpass, "pos", pos)

  return output
}

fn reverb_new(sample_rate) {
  // Schroeder reverb: 4 parallel comb filters + 2 series allpass
  let combs = [
    comb_filter_new(floor(sample_rate * 0.0297)),  // 29.7ms
    comb_filter_new(floor(sample_rate * 0.0371)),  // 37.1ms
    comb_filter_new(floor(sample_rate * 0.0411)),  // 41.1ms
    comb_filter_new(floor(sample_rate * 0.0437))   // 43.7ms
  ]

  let allpasses = [
    allpass_new(floor(sample_rate * 0.0050)),  // 5ms
    allpass_new(floor(sample_rate * 0.0017))   // 1.7ms
  ]

  return map_new()
    |> map_set("combs", combs)
    |> map_set("allpasses", allpasses)
    |> map_set("wet", 0.3)
    |> map_set("room_size", 0.7)
    |> map_set("damping", 0.5)
}

fn reverb_set_params(reverb, wet, room_size, damping) {
  map_set(reverb, "wet", clamp(wet, 0.0, 1.0))
  map_set(reverb, "room_size", clamp(room_size, 0.0, 1.0))
  map_set(reverb, "damping", clamp(damping, 0.0, 1.0))

  // Update comb filter feedback based on room size
  let combs = map_get(reverb, "combs")
  let feedback = 0.5 + room_size * 0.4  // 0.5 to 0.9
  let i = 0
  while i < len(combs) {
    map_set(get(combs, i), "feedback", feedback)
    i = i + 1
  }

  return reverb
}

fn reverb_process(reverb, input) {
  let combs = map_get(reverb, "combs")
  let allpasses = map_get(reverb, "allpasses")
  let wet = map_get(reverb, "wet")

  // Sum of comb filters (parallel)
  let comb_sum = 0.0
  let i = 0
  while i < len(combs) {
    comb_sum = comb_sum + comb_filter_process(get(combs, i), input)
    i = i + 1
  }
  comb_sum = comb_sum / len(combs)

  // Series allpass filters
  let output = comb_sum
  i = 0
  while i < len(allpasses) {
    output = allpass_process(get(allpasses, i), output)
    i = i + 1
  }

  // Wet/dry mix
  return input * (1.0 - wet) + output * wet
}

// ============================================================================
// Delay
// ============================================================================

fn delay_new(sample_rate) {
  let max_delay = floor(sample_rate * 2.0)  // Max 2 seconds
  let buffer = []
  let i = 0
  while i < max_delay {
    buffer = push(buffer, 0.0)
    i = i + 1
  }

  return map_new()
    |> map_set("buffer", buffer)
    |> map_set("write_pos", 0)
    |> map_set("delay_samples", floor(sample_rate * 0.25))  // 250ms default
    |> map_set("feedback", 0.4)
    |> map_set("wet", 0.3)
    |> map_set("sample_rate", sample_rate)
}

fn delay_set_params(delay, time_ms, feedback, wet) {
  let sr = map_get(delay, "sample_rate")
  let buffer = map_get(delay, "buffer")
  let max_samples = len(buffer)

  let delay_samples = floor(sr * time_ms / 1000.0)
  delay_samples = clamp(delay_samples, 1, max_samples - 1)

  map_set(delay, "delay_samples", delay_samples)
  map_set(delay, "feedback", clamp(feedback, 0.0, 0.95))
  map_set(delay, "wet", clamp(wet, 0.0, 1.0))

  return delay
}

fn delay_process(delay, input) {
  let buffer = map_get(delay, "buffer")
  let write_pos = map_get(delay, "write_pos")
  let delay_samples = map_get(delay, "delay_samples")
  let feedback = map_get(delay, "feedback")
  let wet = map_get(delay, "wet")

  // Calculate read position
  let read_pos = write_pos - delay_samples
  if read_pos < 0 {
    read_pos = read_pos + len(buffer)
  }

  // Read delayed sample
  let delayed = get(buffer, read_pos)

  // Write to buffer with feedback
  set(buffer, write_pos, input + delayed * feedback)

  // Advance write position
  write_pos = (write_pos + 1) % len(buffer)
  map_set(delay, "write_pos", write_pos)

  // Wet/dry mix
  return input * (1.0 - wet) + delayed * wet
}

// ============================================================================
// Audio Analysis
// ============================================================================

fn analyze_peak(samples) {
  let peak = 0.0
  let i = 0
  while i < len(samples) {
    let abs_sample = abs(get(samples, i))
    if abs_sample > peak {
      peak = abs_sample
    }
    i = i + 1
  }
  return linear_to_db(peak)
}

fn analyze_rms(samples) {
  let sum_squares = 0.0
  let i = 0
  while i < len(samples) {
    let sample = get(samples, i)
    sum_squares = sum_squares + sample * sample
    i = i + 1
  }
  let rms = sqrt(sum_squares / len(samples))
  return linear_to_db(rms)
}

fn analyze_lufs_momentary(samples, sample_rate) {
  // Simplified LUFS calculation (K-weighting approximation)
  // Full ITU-R BS.1770 would require proper K-weighting filter
  let sum_squares = 0.0
  let i = 0
  while i < len(samples) {
    let sample = get(samples, i)
    sum_squares = sum_squares + sample * sample
    i = i + 1
  }
  let mean_square = sum_squares / len(samples)

  // Convert to LUFS (approximation without full K-weighting)
  if mean_square <= 0.0 {
    return -70.0
  }
  return -0.691 + 10.0 * log10(mean_square)
}

// ============================================================================
// Processing Chain
// ============================================================================

fn chain_new(sample_rate) {
  return map_new()
    |> map_set("eq", eq_new(sample_rate))
    |> map_set("compressor", compressor_new(sample_rate))
    |> map_set("reverb", reverb_new(sample_rate))
    |> map_set("delay", delay_new(sample_rate))
    |> map_set("limiter", limiter_new(sample_rate))
    |> map_set("eq_enabled", true)
    |> map_set("compressor_enabled", true)
    |> map_set("reverb_enabled", false)
    |> map_set("delay_enabled", false)
    |> map_set("limiter_enabled", true)
    |> map_set("sample_rate", sample_rate)
}

fn chain_process(chain, input) {
  let output = input

  if map_get(chain, "eq_enabled") {
    output = eq_process(map_get(chain, "eq"), output)
  }

  if map_get(chain, "compressor_enabled") {
    output = compressor_process(map_get(chain, "compressor"), output)
  }

  if map_get(chain, "reverb_enabled") {
    output = reverb_process(map_get(chain, "reverb"), output)
  }

  if map_get(chain, "delay_enabled") {
    output = delay_process(map_get(chain, "delay"), output)
  }

  if map_get(chain, "limiter_enabled") {
    output = limiter_process(map_get(chain, "limiter"), output)
  }

  return output
}

fn chain_process_buffer(chain, samples) {
  let output = []
  let i = 0
  while i < len(samples) {
    let processed = chain_process(chain, get(samples, i))
    output = push(output, processed)
    i = i + 1
  }
  return output
}

// ============================================================================
// Export for external use
// ============================================================================

fn process_audio_buffer(samples, sample_rate, config) {
  let chain = chain_new(sample_rate)

  // Apply config if provided
  if config != null {
    // Configure EQ
    if map_has(config, "eq") {
      let eq_config = map_get(config, "eq")
      if map_has(eq_config, "low_freq") {
        eq_set_low(map_get(chain, "eq"), map_get(eq_config, "low_freq"), map_get(eq_config, "low_gain"))
      }
      if map_has(eq_config, "mid_freq") {
        eq_set_mid(map_get(chain, "eq"), map_get(eq_config, "mid_freq"), map_get(eq_config, "mid_gain"), map_get(eq_config, "mid_q"))
      }
      if map_has(eq_config, "high_freq") {
        eq_set_high(map_get(chain, "eq"), map_get(eq_config, "high_freq"), map_get(eq_config, "high_gain"))
      }
    }

    // Configure compressor
    if map_has(config, "compressor") {
      let comp_config = map_get(config, "compressor")
      compressor_set_params(
        map_get(chain, "compressor"),
        map_get(comp_config, "threshold"),
        map_get(comp_config, "ratio"),
        map_get(comp_config, "attack"),
        map_get(comp_config, "release"),
        map_get(comp_config, "knee"),
        map_get(comp_config, "makeup")
      )
    }

    // Configure reverb
    if map_has(config, "reverb") {
      let reverb_config = map_get(config, "reverb")
      reverb_set_params(
        map_get(chain, "reverb"),
        map_get(reverb_config, "wet"),
        map_get(reverb_config, "room_size"),
        map_get(reverb_config, "damping")
      )
      map_set(chain, "reverb_enabled", true)
    }

    // Configure delay
    if map_has(config, "delay") {
      let delay_config = map_get(config, "delay")
      delay_set_params(
        map_get(chain, "delay"),
        map_get(delay_config, "time_ms"),
        map_get(delay_config, "feedback"),
        map_get(delay_config, "wet")
      )
      map_set(chain, "delay_enabled", true)
    }

    // Configure limiter
    if map_has(config, "limiter") {
      let limiter_config = map_get(config, "limiter")
      limiter_set_ceiling(map_get(chain, "limiter"), map_get(limiter_config, "ceiling"))
    }
  }

  // Process the buffer
  let output = chain_process_buffer(chain, samples)

  // Analyze output
  let peak_db = analyze_peak(output)
  let rms_db = analyze_rms(output)

  return map_new()
    |> map_set("samples", output)
    |> map_set("peak_db", peak_db)
    |> map_set("rms_db", rms_db)
    |> map_set("clipping", peak_db > -0.1)
}
